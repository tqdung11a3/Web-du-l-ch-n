//- Mixins hiển thị chỗ ngồi em bé / người trông (dùng chung pending + success)

mixin babySeatsSummary(display)
  if display && display.lines && display.lines.length
    .cart-baby-seats-info
      .cart-baby-seats-info__title
        i.fa-solid.fa-baby-carriage
        | Chỗ ngồi em bé
      each line in display.lines
        .cart-baby-seats-info__row
          if line.kind === 'shared'
            i.fa-solid.fa-link.icon-shared
          else if line.kind === 'auto'
            i.fa-solid.fa-chair.icon-auto
          else
            i.fa-solid.fa-chair.icon-private
          span
            if line.kind === 'shared' && line.guardianName
              = line.babyName + ': ngồi cùng '
              strong= line.guardianName
            else
              = line.text
      if display.feeTotal > 0
        .cart-baby-seats-info__fee
          | Tổng phí ghế riêng: 
          strong +#{Number(display.feeTotal).toLocaleString('vi-VN')}đ

mixin babySeatPassengerRow(p)
  if p.babySeatDisplay
    span.cart-passenger-guardian
      if p.babySeatDisplay.kind === 'private'
        i.fa-solid.fa-chair.icon-private
        | Ghế ngồi riêng
      else if p.babySeatDisplay.kind === 'shared' && p.babySeatDisplay.guardianName
        i.fa-solid.fa-link.icon-shared
        | Ngồi cùng: 
        strong= p.babySeatDisplay.guardianName
      else if p.babySeatDisplay.kind === 'auto'
        i.fa-solid.fa-chair.icon-auto
        = p.babySeatDisplay.label

mixin roomGuardianRow(p, adultByIdx)
  -
    var needsRoomGuardian =
      p.type === 'child' ||
      (p.type === 'adult' && Number(p.age || 0) < 18);
    // Em bé: ưu tiên roomGuardianIdx (mới), fallback guardianIdx
    var babyRoomIdx = null;
    if (p.type === 'baby') {
      babyRoomIdx = (p.roomGuardianIdx !== null && p.roomGuardianIdx !== undefined)
        ? p.roomGuardianIdx
        : p.guardianIdx;
    }
  if needsRoomGuardian
    - var guardian = adultByIdx[p.guardianIdx];
    span.pending-passenger-guardian
      i.fa-solid.fa-link.icon-muted
      |  Ở cùng: 
      strong #{guardian ? (guardian.name || ('Người lớn #' + (guardian.idx + 1))) : '—'}
  else if p.type === 'baby' && babyRoomIdx !== null && adultByIdx[babyRoomIdx]
    span.pending-passenger-guardian
      i.fa-solid.fa-bed.icon-muted
      |  Ở phòng cùng: 
      strong= adultByIdx[babyRoomIdx].name || ('Người lớn #' + (babyRoomIdx + 1))

//- Ô bảng admin order-edit
mixin adminBabySeatCell(p)
  if p.babySeatDisplay
    if p.babySeatDisplay.kind === 'private'
      span.badge.badge--gray(style="font-size:11.5px") Ghế ngồi riêng
    else if p.babySeatDisplay.kind === 'shared'
      | Ngồi cùng: 
      strong= p.babySeatDisplay.guardianName
    else if p.babySeatDisplay.kind === 'auto'
      = p.babySeatDisplay.label
  else if p.type === 'baby'
    | —

mixin adminRoomGuardianCell(p, adultByIdx)
  -
    var GUARDIAN_MIN = 18;
    var isAnchor = p && p.type === 'adult' && Number(p.age || 0) >= GUARDIAN_MIN;
    var needsRoom =
      p.type === 'child' ||
      (p.type === 'adult' && Number(p.age || 0) < GUARDIAN_MIN);
    var babyRoomIdx = null;
    if (p && p.type === 'baby') {
      babyRoomIdx = (p.roomGuardianIdx !== null && p.roomGuardianIdx !== undefined)
        ? p.roomGuardianIdx
        : p.guardianIdx;
    }
  if isAnchor
    span(style="color:#64748b") (Tự lập)
  else if needsRoom
    - var guardian = adultByIdx[p.guardianIdx];
    if guardian
      | Ở cùng: 
      strong= guardian.name || ('Người lớn #' + (p.guardianIdx + 1))
    else
      | —
  else if p && p.type === 'baby' && babyRoomIdx !== null && adultByIdx[babyRoomIdx]
    | Ở phòng cùng: 
    strong= adultByIdx[babyRoomIdx].name || ('Người lớn #' + (babyRoomIdx + 1))
  else
    | —
