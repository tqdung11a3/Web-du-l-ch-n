.box-filter
  .inner-head
    .inner-title Bộ Lọc
    i.fa-solid.fa-filter
  .inner-body
    // === Ô nhập địa điểm muốn đến (keyword theo tiêu đề tour) ===
    .inner-group
      .inner-label Địa điểm (gõ tên nơi muốn đến)
      input(
        type="text"
        name="q"
        placeholder="VD: Hạ Long, Sapa, Phú Quốc..."
        value=(query && query.q) || ""
      )
    .inner-group
      .inner-label Ngày khởi hành
      input(
        name="departureDate"  
        type="date"
        )
    // 👇 THAY TOÀN BỘ KHỐI NÀY
    .inner-group
      .inner-label Số chỗ trống tối thiểu
      input(
        name="minSeats"
        type="number"
        min="0"
        value="0"
        placeholder="Ví dụ: 5"
      )
    .inner-group
      .inner-label Mức giá
      select(name="price")
        option(value="") -- Chọn khoảng giá --
        option(value="0-999999") Dưới 1tr
        option(value="1000000-3000000") Từ 1tr đến 3tr
        option(value="3000000-6000000") Từ 3tr đến 6tr
        option(value="6000000-10000000") Từ 6tr đến 10tr
        option(value="10000000-1000000000") Trên 10tr
    // Lọc theo Tags (loại hình trải nghiệm)
    - const selectedTags = query && query.tags ? (Array.isArray(query.tags) ? query.tags : [query.tags]) : [];
    .inner-group
      .inner-label Loại hình trải nghiệm
      .inner-checkbox-list
        - const allTags = ["phiêu lưu", "biển", "văn hóa", "leo núi", "tham quan thành phố"];
        each tag in allTags
          .inner-checkbox-item
            - const tagId = `filter-tag-${tag}`;
            input(
              type="checkbox"
              id=tagId
              name="tags"
              value=tag
              checked=(selectedTags.includes(tag))
            )
            label(for=tagId)= tag
    .inner-group
      button.inner-button Áp Dụng
.inner-overlay