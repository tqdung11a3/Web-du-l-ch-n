        button.lightbox-reset(type="button" aria-label="Đặt lại")
          i.fa-solid.fa-rotate-left
      .lightbox-title

  script.
    // Lightbox functionality with size adjustment
    document.addEventListener('DOMContentLoaded', function() {
      const lightboxImages = document.querySelectorAll('.lightbox-image');
      const lightboxModal = document.getElementById('lightboxModal');
      if (!lightboxModal) return;
      
      const lightboxImageLarge = lightboxModal.querySelector('.lightbox-image-large');
      const lightboxImageWrapper = lightboxModal.querySelector('.lightbox-image-wrapper');
      const lightboxTitle = lightboxModal.querySelector('.lightbox-title');
      const lightboxClose = lightboxModal.querySelector('.lightbox-close');
      const lightboxOverlay = lightboxModal.querySelector('.lightbox-overlay');
      const zoomInBtn = lightboxModal.querySelector('.lightbox-zoom-in');
      const zoomOutBtn = lightboxModal.querySelector('.lightbox-zoom-out');
      const resetBtn = lightboxModal.querySelector('.lightbox-reset');

      let currentScale = 1;
      const minScale = 0.5;
      const maxScale = 3;
      const scaleStep = 0.25;

      // Reset size
      function resetSize() {
        currentScale = 1;
        originalDisplayWidth = 0;
        originalDisplayHeight = 0;
        updateImageSize();
      }

      // Store original display size
      let originalDisplayWidth = 0;
      let originalDisplayHeight = 0;

      // Update image size
      function updateImageSize() {
        if (lightboxImageLarge) {
          // Get container dimensions
          const containerWidth = window.innerWidth * 0.9;
          const containerHeight = window.innerHeight * 0.85;
          
          // On first load, calculate original fit size
          if (originalDisplayWidth === 0 || originalDisplayHeight === 0) {
            const img = new Image();
            img.src = lightboxImageLarge.src;
            const naturalWidth = lightboxImageLarge.naturalWidth || img.width;
            const naturalHeight = lightboxImageLarge.naturalHeight || img.height;
            
            // Calculate size to fit container while maintaining aspect ratio
            const widthRatio = containerWidth / naturalWidth;
            const heightRatio = containerHeight / naturalHeight;
            const fitRatio = Math.min(widthRatio, heightRatio);
            
            originalDisplayWidth = naturalWidth * fitRatio;
            originalDisplayHeight = naturalHeight * fitRatio;
          }
          
          // Apply current scale
          const newWidth = originalDisplayWidth * currentScale;
          const newHeight = originalDisplayHeight * currentScale;
          
          lightboxImageLarge.style.width = newWidth + 'px';
          lightboxImageLarge.style.height = newHeight + 'px';
          lightboxImageLarge.style.maxWidth = 'none';
          lightboxImageLarge.style.maxHeight = 'none';
        }
      }

      // Zoom in (make image bigger)
      function zoomIn() {
        currentScale = Math.min(currentScale + scaleStep, maxScale);
        updateImageSize();
      }

      // Zoom out (make image smaller)
      function zoomOut() {
        currentScale = Math.max(currentScale - scaleStep, minScale);
        updateImageSize();
      }

      // Open lightbox
      lightboxImages.forEach(img => {
        img.style.cursor = 'pointer';
        img.addEventListener('click', function() {
          const imageSrc = this.src;
          const imageTitle = this.getAttribute('data-title') || this.alt || '';
          
          // Reset before loading new image
          originalDisplayWidth = 0;
          originalDisplayHeight = 0;
          currentScale = 1;
          
          lightboxImageLarge.src = imageSrc;
          lightboxTitle.textContent = imageTitle;
          
          // Wait for image to load before setting size
          lightboxImageLarge.onload = function() {
            originalDisplayWidth = 0;
            originalDisplayHeight = 0;
            updateImageSize();
          };
          
          lightboxModal.classList.add('active');
          document.body.style.overflow = 'hidden';
          
          // If image already loaded
          if (lightboxImageLarge.complete) {
            setTimeout(() => {
              originalDisplayWidth = 0;
              originalDisplayHeight = 0;
              updateImageSize();
            }, 100);
          }
        });
      });

      // Close lightbox
      function closeLightbox() {
        lightboxModal.classList.remove('active');
        document.body.style.overflow = '';
        resetSize();
      }

      if (lightboxClose) {
        lightboxClose.addEventListener('click', closeLightbox);
      }
      if (lightboxOverlay) {
        lightboxOverlay.addEventListener('click', function(e) {
          if (e.target === lightboxOverlay) {
            closeLightbox();
          }
        });
      }

      // Zoom controls
      if (zoomInBtn) {
        zoomInBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          zoomIn();
        });
      }
      if (zoomOutBtn) {
        zoomOutBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          zoomOut();
        });
      }
      if (resetBtn) {
        resetBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          resetSize();
        });
      }

      // Mouse wheel zoom
      if (lightboxImageWrapper) {
        lightboxImageWrapper.addEventListener('wheel', function(e) {
          if (!lightboxModal.classList.contains('active')) return;
          e.preventDefault();
          const delta = e.deltaY > 0 ? -scaleStep : scaleStep;
          currentScale = Math.max(minScale, Math.min(maxScale, currentScale + delta));
          updateImageSize();
        });
      }

      // Close on Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && lightboxModal.classList.contains('active')) {
          closeLightbox();
        }
      });
    });

    // Initialize Swiper for room image carousels
    document.addEventListener('DOMContentLoaded', function() {
      const roomCarousels = document.querySelectorAll('.room-image-swiper');
      roomCarousels.forEach((carousel, index) => {
        const slides = carousel.querySelectorAll('.swiper-slide');
        const hasMultipleImages = slides.length > 1;
        
        const swiperConfig = {
          slidesPerView: 1,
          spaceBetween: 0,
          loop: hasMultipleImages,
          pagination: {
            el: carousel.querySelector('.swiper-pagination'),
            clickable: true,
          },
        };
        
        // Chỉ thêm navigation nếu có nhiều hơn 1 ảnh
        if (hasMultipleImages) {
          swiperConfig.navigation = {
            nextEl: carousel.querySelector('.swiper-button-next'),
            prevEl: carousel.querySelector('.swiper-button-prev'),
          };
        } else {
          // Ẩn navigation và pagination nếu chỉ có 1 ảnh
          const prevBtn = carousel.querySelector('.swiper-button-prev');
          const nextBtn = carousel.querySelector('.swiper-button-next');
          const pagination = carousel.querySelector('.swiper-pagination');
          if (prevBtn) prevBtn.style.display = 'none';
          if (nextBtn) nextBtn.style.display = 'none';
          if (pagination) pagination.style.display = 'none';
        }
        
        new Swiper(carousel, swiperConfig);
      });
    });

    // Hotel review form submission
    document.addEventListener('DOMContentLoaded', function() {
      const reviewForm = document.getElementById('hotel-review-form');
      if (!reviewForm) return;

      reviewForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const hotelId = reviewForm.querySelector('input[name="hotelId"]').value;
        const ratingOverall = reviewForm.querySelector('input[name="ratingOverall"]:checked')?.value;
        const content = reviewForm.querySelector('textarea[name="content"]').value.trim();
        
        if (!ratingOverall) {
          notify.error('Vui lòng chọn điểm tổng thể!');
          return;
        }

        const formData = {
          ratingOverall: parseInt(ratingOverall),
          content: content,
        };

        // Lấy các điểm chi tiết nếu có
        const ratingLocation = reviewForm.querySelector('input[name="ratingLocation"]:checked')?.value;
        const ratingCleanliness = reviewForm.querySelector('input[name="ratingCleanliness"]:checked')?.value;
        const ratingFacilities = reviewForm.querySelector('input[name="ratingFacilities"]:checked')?.value;
        const ratingService = reviewForm.querySelector('input[name="ratingService"]:checked')?.value;
        const ratingValue = reviewForm.querySelector('input[name="ratingValue"]:checked')?.value;

        if (ratingLocation) formData.ratingLocation = parseInt(ratingLocation);
        if (ratingCleanliness) formData.ratingCleanliness = parseInt(ratingCleanliness);
        if (ratingFacilities) formData.ratingFacilities = parseInt(ratingFacilities);
        if (ratingService) formData.ratingService = parseInt(ratingService);
        if (ratingValue) formData.ratingValue = parseInt(ratingValue);

        try {
          const token = document.cookie.split('; ').find(row => row.startsWith('client_token='))?.split('=')[1];
          const response = await fetch(`/hotel/${hotelId}/reviews`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': token ? `Bearer ${token}` : '',
            },
            credentials: 'include',
            body: JSON.stringify(formData),
          });

          const result = await response.json();
          
          if (result.code === 'success') {
            notify.success(result.message);
            setTimeout(() => {
              window.location.reload();
            }, 1000);
          } else {
            notify.error(result.message || 'Không thể gửi đánh giá!');
          }
        } catch (error) {
          console.error('Review submission error:', error);
          notify.error('Có lỗi xảy ra khi gửi đánh giá!');
        }
      });
    });

    // Room Allocation Logic
    document.addEventListener('DOMContentLoaded', function() {
      const allocationSection = document.getElementById('roomAllocation');
      if (!allocationSection) return;
      
      const roomOptions = !{JSON.stringify(roomOptions || [])};
      const selectors = allocationSection.querySelectorAll('.room-type-selector');
      const addButton = document.getElementById('addSelectedRoomsToCart');
      
      // Get roomsData from URL
      const urlParams = new URLSearchParams(window.location.search);
      const roomsDataParam = urlParams.get('roomsData');
      let parsedRoomsData = [];
      try {
        parsedRoomsData = JSON.parse(decodeURIComponent(roomsDataParam));
      } catch (e) {
        console.error('Failed to parse roomsData:', e);
      }
      
      // Function to calculate effective occupancy (client-side version)
      function calculateEffectiveOccupancy(room, ageBands) {
        let totalEffective = room.adults || 0;
        
        if (room.children && Array.isArray(room.children)) {
          room.children.forEach(child => {
            const age = child.age;
            
            // Find matching age band
            const band = ageBands.find(b => {
              const minAge = b.minAge || 0;
              const maxAge = b.maxAge;
              
              if (maxAge === null || maxAge === undefined) {
                return age >= minAge;
              } else {
                return age >= minAge && age <= maxAge;
              }
            });
            
            if (band && band.countInOccupancy) {
              totalEffective += (band.occupancyWeight || 1);
            }
          });
        }
        
        return totalEffective;
      }
      
      // Populate room type options for each room selector
      selectors.forEach((select, idx) => {
        const roomData = parsedRoomsData[idx];
        if (!roomData) {
          console.warn(`No room data for selector ${idx}`);
          return;
        }
        
        let hasValidOptions = false;
        
        // Filter room options to only show types that fit this specific room
        roomOptions.forEach(roomType => {
          const effectiveOccupancy = calculateEffectiveOccupancy(roomData, roomType.ageBands || []);
          const maxOccupancy = roomType.maxOccupancy || 2;
          
          // Only add option if this room fits in this room type
          if (effectiveOccupancy <= maxOccupancy) {
            const option = document.createElement('option');
            option.value = roomType.roomTypeId;
            option.textContent = `${roomType.title} - ${Number(roomType.pricePerNight || 0).toLocaleString('vi-VN')} ${roomType.currency || 'đ'}/đêm (Còn ${roomType.vacantRooms || 0} phòng)`;
            option.dataset.roomData = JSON.stringify(roomType);
            select.appendChild(option);
            hasValidOptions = true;
          }
        });
        
        // If no valid options, hide select and show warning
        const warningElement = document.getElementById(`room-warning-${idx}`);
        if (!hasValidOptions) {
          select.style.display = 'none';
          select.previousElementSibling.style.display = 'none'; // Hide label
          if (warningElement) {
            warningElement.style.display = 'flex';
          }
        } else {
          select.style.display = 'block';
          select.previousElementSibling.style.display = 'block'; // Show label
          if (warningElement) {
            warningElement.style.display = 'none';
          }
        }
      });
      
      // Enable/disable add button based on selections
      function updateAddButton() {
        // Check if all visible selectors have a selection
        const allSelected = Array.from(selectors).every(s => {
          // If selector is hidden (no valid options), skip it
          if (s.style.display === 'none') return true;
          return s.value !== '';
        });
        
        // Check if there are any hidden selectors (rooms that can't be booked)
        const hasInvalidRooms = Array.from(selectors).some(s => s.style.display === 'none');
        
        // Disable button if not all selected OR if there are invalid rooms
        addButton.disabled = !allSelected || hasInvalidRooms;
      }
      
      selectors.forEach(select => {
        select.addEventListener('change', updateAddButton);
      });
      
      // Initial button state update
      updateAddButton();
      
      // Add to cart handler
      addButton.addEventListener('click', async function() {
        const selections = {};
        
        // Group rooms by room type
        selectors.forEach(select => {
          const roomTypeId = select.value;
          if (!roomTypeId) return;
          
          if (!selections[roomTypeId]) {
            selections[roomTypeId] = {
              roomTypeId,
              roomData: JSON.parse(select.options[select.selectedIndex].dataset.roomData),
              roomIndices: []
            };
          }
          selections[roomTypeId].roomIndices.push(parseInt(select.dataset.roomIndex));
        });
        
        // Get search params
        const urlParams = new URLSearchParams(window.location.search);
        const checkInDate = urlParams.get('checkInDate');
        const checkOutDate = urlParams.get('checkOutDate');
        const roomsData = urlParams.get('roomsData');
        const hotelId = '#{hotel._id}';
        
        // Parse roomsData to get details for each room
        let parsedRoomsData = [];
        try {
          parsedRoomsData = JSON.parse(decodeURIComponent(roomsData));
        } catch (e) {
          console.error('Failed to parse roomsData:', e);
        }
        
        // Xóa giỏ KS cũ trước để ghi đè (không cộng dồn vào giỏ cũ)
        try {
          await fetch('/hotel-cart/clear', { method: 'DELETE' });
        } catch (clearErr) {
          console.warn('Không thể xóa giỏ cũ:', clearErr);
        }

        // Add each room type to cart
        let successCount = 0;
        let errorCount = 0;
        
        for (const [roomTypeId, data] of Object.entries(selections)) {
          const quantity = data.roomIndices.length;
          
          // Build roomsData for this room type (only the rooms assigned to it)
          const roomsForThisType = data.roomIndices.map(idx => parsedRoomsData[idx]);
          const roomsDataForType = encodeURIComponent(JSON.stringify(roomsForThisType));
          
          // Calculate totals for this room type
          const totalAdults = roomsForThisType.reduce((sum, r) => sum + (r.adults || 0), 0);
          const totalChildren = roomsForThisType.reduce((sum, r) => sum + (r.children?.length || 0), 0);
          
          try {
            const response = await fetch('/hotel-cart/add', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                hotelId,
                roomTypeId,
                quantity,
                checkInDate,
                checkOutDate,
                roomsData: roomsDataForType,
                adults: totalAdults,
                children: totalChildren,
                rooms: quantity
              })
            });
            
            const result = await response.json();
            if (result.code === 'success') {
              successCount++;
            } else {
              errorCount++;
              const errMsg = result.message || 'Có lỗi xảy ra';
              const isHeldByOther = result.type === 'room_held_by_other';
              if (typeof Notyf !== 'undefined') {
                const notyf = new Notyf({
                  duration: isHeldByOther ? 6000 : 4000,
                  position: { x: 'right', y: 'top' },
                  dismissible: true,
                });
                notyf.error(errMsg);
              }
              console.error('Failed to add room type:', errMsg);
            }
          } catch (error) {
            errorCount++;
            console.error('Error adding to cart:', error);
          }
        }
        
        // Show notification
        if (successCount > 0) {
          if (typeof Notyf !== 'undefined') {
            const notyf = new Notyf({
              duration: 3000,
              position: { x: 'right', y: 'top' }
            });
            notyf.success(`Đã thêm ${successCount} loại phòng vào giỏ hàng`);
          }
          // Redirect to cart after a short delay
          setTimeout(() => {
            window.location.href = '/cart?tab=hotel';
          }, 1000);
        }
      });
    });

    // Room Detail Modal
    document.addEventListener('DOMContentLoaded', function() {
      const roomModal = document.getElementById('roomDetailModal');
      if (!roomModal) return;

      const roomCards = document.querySelectorAll('.room-card[data-room-info]');
      const modalBody = roomModal.querySelector('.room-detail-modal__body');
      const modalClose = roomModal.querySelector('.room-detail-modal__close');
      const modalOverlay = roomModal.querySelector('.room-detail-modal__overlay');

      function formatPrice(price) {
        return Number(price || 0).toLocaleString('vi-VN');
      }

      function openRoomModal(roomData) {
        const room = JSON.parse(roomData.replace(/&quot;/g, '"'));
        
        let html = `
          <div class="room-detail-content">
            <div class="room-detail-header">
              <h2 class="room-detail-title">${room.title || ''}</h2>
              <div class="room-detail-price-box">
                <div class="price-label">Giá phòng từ</div>
                <div class="price-value">${formatPrice(room.pricePerNight)} <span class="price-currency">${room.currency || 'VND'}</span></div>
                <div class="price-unit">/ đêm</div>
                <div class="price-info-grid">
                  <div class="price-info-item">
                    <span>Base occupancy</span>
                    <strong>${room.baseOccupancy || 2} người</strong>
                  </div>
                  <div class="price-info-item">
                    <span>Diện tích</span>
                    <strong>${room.sizeM2 || 50} m²</strong>
                  </div>
                  <div class="price-info-item">
                    <span>Loại giường</span>
                    <strong>${room.bedInfo || '2 giường đôi'}</strong>
                  </div>
                </div>
              </div>
            </div>
            
            ${room.description ? `
            <div class="room-detail-section">
              <p class="room-detail-description">${room.description}</p>
            </div>
            ` : ''}

            <!-- Chi tiết phòng -->
            ${room.sizeM2 || room.view || room.bedInfo || room.smokingPolicy ? `
            <div class="room-detail-section">
              <h3>Chi tiết phòng</h3>
              <div class="room-detail-info-grid">
                ${room.sizeM2 ? `
                <div class="room-detail-info-item">
                  <i class="fa-regular fa-square"></i>
                  <div>
                    <div class="info-label">Diện tích phòng</div>
                    <div class="info-value">${room.sizeM2} m²</div>
                  </div>
                </div>
                ` : ''}
                ${room.view ? `
                <div class="room-detail-info-item">
                  <i class="fa-regular fa-eye"></i>
                  <div>
                    <div class="info-label">Tầm nhìn</div>
                    <div class="info-value">${room.view}</div>
                  </div>
                </div>
                ` : ''}
                ${room.bedInfo ? `
                <div class="room-detail-info-item">
                  <i class="fa-solid fa-bed"></i>
                  <div>
                    <div class="info-label">Thông tin giường</div>
                    <div class="info-value">${room.bedInfo}</div>
                  </div>
                </div>
                ` : ''}
                ${room.smokingPolicy ? `
                <div class="room-detail-info-item">
                  <i class="fa-solid fa-ban-smoking"></i>
                  <div>
                    <div class="info-label">Chính sách hút thuốc</div>
                    <div class="info-value">${room.smokingPolicy}</div>
                  </div>
                </div>
                ` : ''}
              </div>
            </div>
            ` : ''}

            <!-- Thiết lập sức chứa chung -->
            <div class="room-detail-section">
              <h3>Thiết lập sức chứa chung</h3>
              <div class="room-detail-occupancy-box">
                <div class="occupancy-item">
                  <i class="fa-solid fa-users"></i>
                  <span>Số người đã bao gồm trong giá</span>
                  <strong>${room.baseOccupancy || 2} người</strong>
                </div>
                <div class="occupancy-item">
                  <i class="fa-solid fa-users"></i>
                  <span>Tối đa người có thể ở</span>
                  <strong>${room.maxOccupancy || 3} người</strong>
                </div>
                <div class="occupancy-item">
                  <i class="fa-solid fa-bed"></i>
                  <span>Tối đa giường phụ</span>
                  <strong>${room.maxExtraBeds || 0} giường</strong>
                </div>
                ${room.extraBedFeePerNight > 0 ? `
                <div class="occupancy-item occupancy-fee">
                  <span>Phí giường phụ/đêm</span>
                  <strong class="fee-value">+${formatPrice(room.extraBedFeePerNight)} VND</strong>
                </div>
                ` : ''}
              </div>
            </div>

            <!-- Tiện nghi phòng -->
            ${room.roomAmenities && room.roomAmenities.length > 0 ? `
            <div class="room-detail-section">
              <h3>Tiện nghi trong phòng</h3>
              <div class="room-detail-amenity-list">
                ${room.roomAmenities.map(amenity => `
                  <div class="amenity-list-item">
                    <i class="fa-solid fa-check-circle"></i>
                    <span>${amenity}</span>
                  </div>
                `).join('')}
              </div>
            </div>
            ` : ''}

            <!-- Tiện nghi phòng tắm -->
            ${room.bathroomAmenities && room.bathroomAmenities.length > 0 ? `
            <div class="room-detail-section">
              <h3>Tiện nghi phòng tắm</h3>
              <div class="room-detail-amenity-list">
                ${room.bathroomAmenities.map(amenity => `
                  <div class="amenity-list-item">
                    <i class="fa-solid fa-check-circle"></i>
                    <span>${amenity}</span>
                  </div>
                `).join('')}
              </div>
            </div>
            ` : ''}

            <!-- Hình ảnh phòng -->
            ${room.images && room.images.length > 0 ? `
            <div class="room-detail-section">
              <h3>Hình ảnh phòng</h3>
              <div class="room-detail-images">
                ${room.images.map((img, idx) => `
                  <div class="room-detail-image-item">
                    <img src="${img}" alt="Ảnh phòng ${idx + 1}" />
                  </div>
                `).join('')}
              </div>
            </div>
            ` : ''}
          </div>
        `;

        modalBody.innerHTML = html;
        roomModal.style.display = 'block';
        document.body.style.overflow = 'hidden';
      }

      function closeRoomModal() {
        roomModal.style.display = 'none';
        document.body.style.overflow = '';
      }

      // Open modal on room card click
      roomCards.forEach(card => {
        card.addEventListener('click', function(e) {
          // Không mở modal nếu click vào các nút hoặc link
          if (e.target.closest('button') || e.target.closest('a')) {
            return;
          }
          const roomData = card.getAttribute('data-room-info');
          if (roomData) {
            openRoomModal(roomData);
          }
        });
      });

      // Close modal handlers
      if (modalClose) {
        modalClose.addEventListener('click', closeRoomModal);
      }
      if (modalOverlay) {
        modalOverlay.addEventListener('click', function(e) {
          if (e.target === modalOverlay) {
            closeRoomModal();
          }
        });
      }

      // Close on Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && roomModal.style.display === 'block') {
          closeRoomModal();
        }
      });
    });
