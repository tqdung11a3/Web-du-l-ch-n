  // ================== LIGHTBOX MODAL ==================
  .lightbox-modal#lightboxModal
    .lightbox-overlay
    .lightbox-content
      button.lightbox-close(type="button" aria-label="Đóng")
        i.fa-solid.fa-xmark
      .lightbox-image-wrapper
        img.lightbox-image-large(src="" alt="")
      .lightbox-controls
        button.lightbox-zoom-in(type="button" aria-label="Phóng to")
          i.fa-solid.fa-plus
        button.lightbox-zoom-out(type="button" aria-label="Thu nhỏ")
