//- views/client/pages/hotel-detail.pug
extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug

block main
  +box-breadcrumb(breadcrumb || [
    { name: 'Khách sạn', slug: '/hotel/search' },
    { 
      name: `Đặt phòng ${hotel && hotel.name}`, 
      slug: '',
      avatar: (hotel && hotel.avatar) || (hotel && Array.isArray(hotel.images) && hotel.images[0]) || ''
    }
  ])

  .hotel-detail-container
    // ================== HEADER ==================
    .detail-header
      h1.detail-title= hotel.name
      if hotel.starRating
        - const starNum = Number(hotel.starRating || 0);
        .detail-stars
          - for (let i = 0; i < starNum; i++) {
            i.fa-solid.fa-star
          - }
      - const provinceName = hotel.province && hotel.province.name ? hotel.province.name : (hotel.cityName || '')
      if provinceName
        p.detail-province
          i.fa-solid.fa-map-marker-alt
          | #{provinceName}
      if hotel.address
        p.detail-address
          i.fa-solid.fa-location-dot
          | #{hotel.address}
      if hotel.phone
        p.detail-phone
          i.fa-solid.fa-phone
          a(href=`tel:${hotel.phone}`)= hotel.phone

      if ratingStats && ratingStats.overall
        .detail-rating-summary
          span.detail-rating-summary__score #{ratingStats.overall.toFixed(1)}
          span.detail-rating-summary__text Tuyệt vời
          if ratingStats.count
            span.detail-rating-summary__count (Dựa trên #{ratingStats.count} đánh giá)

    // ================== GALLERY ==================
    .detail-gallery
      .detail-gallery__left
        if galleryImages && galleryImages.length
          each imgUrl, idx in galleryImages
            a.gallery-thumb(href=imgUrl target="_blank")
              img(src=imgUrl alt=`Ảnh ${idx + 1}`)
        else
          a.gallery-thumb(href=mainImage target="_blank")
            img(src=mainImage alt="Ảnh khách sạn")

      .detail-gallery__main
        img(src=mainImage alt=`Ảnh khách sạn ${hotel.name}`)

    // ================== GIỚI THIỆU + MAP / VỊ TRÍ ==================
    .detail-about
      .about-left
        h2 Tổng quan chỗ nghỉ
        .about-box
          if hotel.shortDescription
            p= hotel.shortDescription
          if hotel.description
            p= hotel.description
          if highlights && highlights.length
            h3 Điểm nổi bật nhất
            ul.highlight-list
              each item in highlights
                li
                  if item.image
                    img.highlight-image.lightbox-image(src=item.image alt=item.title || '' data-title=item.title || '')
                  i.fa-solid.fa-check
                  |  #{item.title || item}
      .about-right
        h2 Vị trí
        .map-box
          if googleMapsEmbedUrl
            iframe(
              src=googleMapsEmbedUrl
              width="100%"
              height="400"
              style="border:0; border-radius: 8px;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            )
          else if hotel.googleMapsLink
            // Fallback: nếu không convert được, hiển thị link
            .map-share-link
              a.map-link-button(href=hotel.googleMapsLink target="_blank" rel="noopener noreferrer")
                i.fa-solid.fa-map-location-dot
                span Xem trên Google Maps
              p.map-link-hint Nhấp vào để xem vị trí trên Google Maps
          else
            .map-placeholder
              i.fa-solid.fa-map-location-dot
              span Bản đồ vị trí sẽ được hiển thị tại đây

    // ================== KHUYẾN MẠI / GỢI Ý ==================
    if promotionShortText
      .promo-section
        h2 Đang có khuyến mại kỳ nghỉ ngắn
        p.promo-text= promotionShortText

    // ================== LÊN KẾ HOẠCH ĐẾN KHÁCH SẠN ==================
    if transportOptions && transportOptions.length
      .transport-section
        h2 Lên kế hoạch đến khách sạn
        .transport-cards
          each t in transportOptions
            .transport-card
              i.fa-solid.fa-car-side
              span= t

    // ================== TIỆN NGHI ==================
    if amenities && amenities.length
      .amenities
        h2 Tiện nghi
        .amenities-list
          each amenity in amenities
            - const amenityName = typeof amenity === 'string' ? amenity : (amenity.name || '')
            - const amenityFeatures = typeof amenity === 'object' && amenity.features ? amenity.features : []
            .amenity-item
              .amenity-header
                i.fa-solid.fa-check
                h3.amenity-name= amenityName
              if amenityFeatures.length > 0
                ul.amenity-features
                  each feature in amenityFeatures
                    li= feature

    // ================== CƠ SỞ VẬT CHẤT ==================
    if facilities && facilities.length
      .facilities
        h2 Cơ sở vật chất
        .facilities-grid
          each facility in facilities
            - const facilityName = facility.name || ''
            - const facilityCategory = facility.category || ''
            - const facilityImage = facility.image || ''
            .facility-card
              if facilityImage
                .facility-image
                  img.lightbox-image(src=facilityImage alt=facilityName data-title=facilityName)
              .facility-content
                h3.facility-name= facilityName
                if facilityCategory
                  span.facility-category= facilityCategory

    // ================== TOP BAR ==================
    .detail-top
      ul.detail-top__info
        li
          i.fa-regular.fa-calendar-days
          if searchInfo
            span #{searchInfo.checkInLabel} → #{searchInfo.checkOutLabel}
          else
            span Chưa chọn ngày
        li
          i.fa-regular.fa-building
          span #{(searchInfo && searchInfo.rooms) || 1} phòng
        li
          i.fa-regular.fa-user
          span #{(searchInfo && searchInfo.adults) || 1} người lớn#{(searchInfo && searchInfo.children) ? `, ${searchInfo.children} trẻ em` : ''}
      .detail-top__actions
        button.detail-top__btn#editSearchBtn(type="button" aria-label="Sửa tìm kiếm")
          i.fa-regular.fa-pen-to-square
        a.detail-top__primary(href="#rooms") Xem giá

    // ================== MODAL EDIT SEARCH ==================
    .edit-search-modal#editSearchModal(style="display: none;")
      .edit-search-modal__overlay
      .edit-search-modal__content
        .edit-search-modal__header
          h3 Chỉnh sửa tìm kiếm
          button.edit-search-modal__close(type="button" aria-label="Đóng")
            i.fa-solid.fa-times
        .edit-search-modal__body
          form#editSearchForm(action="" method="get")
            .form-group
              label(for="editCheckInDate") Ngày nhận phòng
              input#editCheckInDate(
                type="date"
                name="checkInDate"
                value=(searchInfo && searchInfo.checkInDate) || ""
              )
            .form-group
              label(for="editCheckOutDate") Ngày trả phòng
              input#editCheckOutDate(
                type="date"
                name="checkOutDate"
                value=(searchInfo && searchInfo.checkOutDate) || ""
              )
            .form-group
              label(for="editGuests") Số khách
              button#editGuestBtn.edit-search-guests-btn(type="button" aria-expanded="false")
                - const qRooms = Number((searchInfo && searchInfo.rooms) || 1)
                - const qAdults = Number((searchInfo && searchInfo.adults) || 1)
                - const qChildren = Number((searchInfo && searchInfo.children) || 0)
                span#editGuestText
                  | #{qRooms} phòng - #{qAdults} người lớn#{qChildren > 0 ? `, ${qChildren} trẻ em` : ''}
                i.fa-solid.fa-chevron-down
              .edit-guests-popup#editGuestsPopup(aria-hidden="true")
                #editRoomsContainer.edit-guests-rooms-container
                  // Phòng sẽ được render bằng JavaScript
                .edit-guests-popup__add-room
                  button#editAddRoomBtn.edit-guests-popup__add-room-btn(type="button") + Thêm phòng khác
                input(type="hidden" name="roomsData" id="editRoomsDataInput" value=(searchInfo && searchInfo.roomsData) || "")
                input(type="hidden" name="rooms" id="editRoomsInput" value=(searchInfo && searchInfo.rooms) || "1")
                input(type="hidden" name="adults" id="editAdultsInput" value=(searchInfo && searchInfo.adults) || "1")
                input(type="hidden" name="children" id="editChildrenInput" value=(searchInfo && searchInfo.children) || "0")
                .edit-guests-popup__done-row
                  button#editGuestsDoneBtn.edit-guests-popup__done-btn(type="button")
                    i.fa-solid.fa-check
                    |  Xong
            .form-group.form-group--actions
              button.btn-cancel(type="button") Hủy
              button.btn-submit(type="submit") Áp dụng

    // ================== PHÂN BỔ PHÒNG ==================
    if searchInfo && searchInfo.roomsData
      - var parsedRoomsData = [];
      - try {
      -   parsedRoomsData = JSON.parse(decodeURIComponent(searchInfo.roomsData));
      - } catch (e) {
      -   parsedRoomsData = [];
      - }
      if parsedRoomsData && parsedRoomsData.length > 0
        .room-allocation-section#roomAllocation
          h2 Phân bổ phòng
          p.allocation-hint Vui lòng chọn loại phòng cho từng phòng bạn muốn đặt
          .allocation-list
            each roomData, roomIdx in parsedRoomsData
              - var roomAdults = roomData.adults || 1
              - var roomChildren = Array.isArray(roomData.children) ? roomData.children : []
              - var roomChildrenCount = roomChildren.length
              .allocation-item(data-room-index=roomIdx)
                .allocation-item__info
                  h3.allocation-item__title Phòng #{roomIdx + 1}
                  .allocation-item__guests
                    span
                      i.fa-regular.fa-user
                      |  #{roomAdults} người lớn
                    if roomChildrenCount > 0
                      span
                        i.fa-solid.fa-child
                        |  #{roomChildrenCount} trẻ em (
                        each child, childIdx in roomChildren
                          if childIdx > 0
                            | , 
                          |#{child.age || 0} tuổi
                        | )
                .allocation-item__select
                  label(for=`room-type-select-${roomIdx}`) Chọn loại phòng:
                  select.room-type-selector(
                    id=`room-type-select-${roomIdx}`
                    data-room-index=roomIdx
                  )
                    option(value="" selected) -- Chọn loại phòng --
                    //- Options sẽ được render bởi JavaScript
                  .allocation-item__warning(
                    id=`room-warning-${roomIdx}`
                    style="display: none;"
                  )
                    i.fa-solid.fa-circle-exclamation
                    span.warning-text Không có loại phòng nào phù hợp với sức chứa của phòng này trong khoảng thời gian bạn chọn
          .allocation-actions
            button#addSelectedRoomsToCart.btn-add-allocation(type="button" disabled)
              i.fa-solid.fa-cart-plus
              |  Thêm tất cả vào giỏ hàng

    // ================== DANH SÁCH PHÒNG ==================
    .rooms#rooms
      h2 Các lựa chọn phòng
      if roomOptions && roomOptions.length
        .rooms-filter
          //- Gợi ý vài filter đơn giản, bạn style theo ý
          span.filter-chip Hủy miễn phí (nếu có)
          span.filter-chip Bao gồm bữa sáng
          span.filter-chip WiFi miễn phí
        each room, roomIndex in roomOptions
          - var roomDataObj = {};
          - roomDataObj.title = room.title || '';
          - roomDataObj.description = room.description || '';
          - roomDataObj.pricePerNight = room.pricePerNight || 0;
          - roomDataObj.currency = room.currency || 'đ';
          - roomDataObj.baseOccupancy = room.baseOccupancy || 2;
          - roomDataObj.maxOccupancy = room.maxOccupancy || 3;
          - roomDataObj.maxExtraBeds = room.maxExtraBeds || 0;
          - roomDataObj.extraBedFeePerNight = room.extraBedFeePerNight || 0;
          - roomDataObj.sizeM2 = (room.roomDetails && room.roomDetails.sizeM2) || null;
          - roomDataObj.bedInfo = (room.roomDetails && room.roomDetails.bedInfo) || '';
          - roomDataObj.view = (room.roomDetails && room.roomDetails.view) || '';
          - roomDataObj.smokingPolicy = (room.roomDetails && room.roomDetails.smokingPolicy) || '';
          - roomDataObj.bathroomAmenities = room.bathroomAmenities || [];
          - roomDataObj.roomAmenities = room.roomAmenities || [];
          - roomDataObj.images = room.images || [];
          - var roomData = JSON.stringify(roomDataObj).replace(/"/g, '&quot;');
          .room-card(
            data-room-info=roomData
            style="cursor: pointer;"
          )
            .room-card__left
              .room-card__image-carousel(class=`room-carousel-${roomIndex}`)
                .swiper.room-image-swiper
                  .swiper-wrapper
                    each image in room.images
                      .swiper-slide
                        img(src=image alt=room.title)
                  .swiper-button-prev
                  .swiper-button-next
                  .swiper-pagination
            .room-card__content
              h3= room.title
              .room-meta
                span
                  i.fa-regular.fa-user
                  |  Tối đa #{room.maxGuests} khách
                if room.vacantRooms !== undefined && room.vacantRooms !== null && room.vacantRooms >= 0
                  span.room-vacant-count
                    i.fa-solid.fa-bed
                    |  Còn #{room.vacantRooms} phòng trống
              if room.description
                ul.room-features
                  li= room.description
              if room.roomDetails
                ul.room-features
                  if room.roomDetails.sizeM2
                    li
                      strong Diện tích: 
                      | #{room.roomDetails.sizeM2} m²
                  if room.roomDetails.bedInfo
                    li
                      strong Thông tin giường: 
                      | #{room.roomDetails.bedInfo}
                  if room.roomDetails.view
                    li
                      strong Tầm nhìn: 
                      | #{room.roomDetails.view}
                  if room.roomDetails.smokingPolicy
                    li
                      strong Chính sách hút thuốc: 
                      | #{room.roomDetails.smokingPolicy}
            .room-card__right
              - const priceStr = Number(room.pricePerNight || 0).toLocaleString('vi-VN');
              - const hasDates = checkInDate && checkOutDate;
              .room-price #{priceStr} #{room.currency || 'đ'}
              small / 1 đêm
              small.room-policy-link(onclick="event.stopPropagation();") Quy định hủy phòng
      else
        p Hiện chưa có loại phòng nào được cấu hình cho khách sạn này.

    // ================== QUY ĐỊNH CHỖ NGHỈ ==================
    .policies
      h2 Quy định của chỗ nghỉ
      .policy-grid
        if rules && (rules.checkinTimeFrom || rules.checkoutTimeTo)
          .policy-card
            .policy-card__title
              i.fa-solid.fa-clock
              |  Nhận phòng / Trả phòng
            if rules.checkinTimeFrom
              p Nhận phòng từ: #{rules.checkinTimeFrom}
            if rules.checkoutTimeTo
              p Trả phòng đến: #{rules.checkoutTimeTo}
            if rules.earlyCheckinTime
              - const earlyFee = rules.earlyCheckinFee ? Number(rules.earlyCheckinFee).toLocaleString('vi-VN') : '0'
              p 
                i.fa-solid.fa-arrow-down(style="color: #28a745; margin-right: 5px;")
                |  Nhận phòng sớm từ #{rules.earlyCheckinTime}: +#{earlyFee} VND
            if rules.lateCheckoutTime
              - const lateFee = rules.lateCheckoutFee ? Number(rules.lateCheckoutFee).toLocaleString('vi-VN') : '0'
              p 
                i.fa-solid.fa-arrow-up(style="color: #ffc107; margin-right: 5px;")
                |  Trả phòng muộn đến #{rules.lateCheckoutTime}: +#{lateFee} VND
        if rules && rules.numberOfRooms
          .policy-card
            .policy-card__title
              i.fa-solid.fa-door-open
              |  Số lượng phòng
            p Có khoảng #{rules.numberOfRooms} phòng tại chỗ nghỉ.
        if rules && rules.children
          .policy-card
            .policy-card__title
              i.fa-solid.fa-child-reaching
              |  Trẻ em & giường phụ
            p= rules.children
        if rules && rules.pets
          .policy-card
            .policy-card__title
              i.fa-solid.fa-dog
              |  Thú cưng
            p= rules.pets
        if rules && rules.extraBed
          .policy-card
            .policy-card__title
              i.fa-solid.fa-bed
            p= rules.extraBed
      if rules && rules.other
        .policy-others
          h3 Thông tin khác
          p= rules.other

    // ================== CHÍNH SÁCH TRẺ EM VÀ GIƯỜNG PHỤ ==================
    // Ưu tiên hiển thị Age Bands mới, nếu không có thì dùng childrenPolicy cũ
    if ageBands && ageBands.length > 0
      .children-policy-section
        h2 Chính sách trẻ em và giường phụ
        .children-policy-grid
          each band in ageBands
            - const minAge = band.minAge || 0
            - const maxAge = band.maxAge !== null && band.maxAge !== undefined ? band.maxAge : null
            - const ageRange = maxAge ? `${minAge}-${maxAge} tuổi` : `${minAge} tuổi trở lên`
            - const bandName = band.bandName || (band.bandType === 'infant' ? 'Trẻ sơ sinh' : band.bandType === 'child' ? 'Trẻ em' : band.bandType === 'adult' ? 'Người lớn' : 'Khác')
            .policy-detail-card
              h3 #{bandName} (#{ageRange})
              .policy-detail-content
                // Tính vào sức chứa
                if band.countInOccupancy !== undefined
                  p
                    i.fa-solid.fa-check(style=band.countInOccupancy ? "color: #28a745;" : "color: #dc3545;")
                    |  #{band.countInOccupancy ? 'Tính vào số người' : 'Không tính vào số người'}
                  if band.countInOccupancy && band.occupancyWeight
                    p
                      i.fa-solid.fa-weight-hanging
                      |  Trọng số: #{band.occupancyWeight === 0.5 ? '0.5 (tính nửa người)' : '1 (tính đủ 1 người)'}
                
                // Ăn sáng
                if band.breakfastIsFree !== undefined
                  p
                    i.fa-solid.fa-utensils
                    |  Ăn sáng: #{band.breakfastIsFree ? 'Miễn phí' : 'Có phí'}
                  if !band.breakfastIsFree && band.breakfastFeePerPersonPerMeal > 0
                    - const breakfastFee = Number(band.breakfastFeePerPersonPerMeal).toLocaleString('vi-VN')
                    p
                      i.fa-solid.fa-money-bill
                      |  Phí ăn sáng: #{breakfastFee} VND/người/bữa
                
                // Extra person charge
                if band.countInOccupancy && band.extraPersonFeePerNight > 0
                  - const extraPersonFee = Number(band.extraPersonFeePerNight).toLocaleString('vi-VN')
                  p
                    i.fa-solid.fa-user-plus
                    |  Phụ thu vượt base occupancy: #{extraPersonFee} VND/đêm/người
    else if childrenPolicy && (childrenPolicy.infant0to1 || childrenPolicy.child2to5 || childrenPolicy.guest6Plus)
      // Fallback: Hiển thị childrenPolicy cũ nếu không có ageBands
      .children-policy-section
        h2 Chính sách trẻ em và giường phụ
        .children-policy-grid
          if childrenPolicy.infant0to1
            .policy-detail-card
              h3 Trẻ sơ sinh (0-1 tuổi)
              .policy-detail-content
                if childrenPolicy.infant0to1.freeWithExistingBed !== undefined
                  p
                    i.fa-solid.fa-check
                    |  #{childrenPolicy.infant0to1.freeWithExistingBed ? 'Miễn phí khi sử dụng giường có sẵn' : 'Có phí khi sử dụng giường có sẵn'}
                if childrenPolicy.infant0to1.cribAvailable
                  p
                    i.fa-solid.fa-check
                    |  Có cũi cho trẻ sơ sinh
                if childrenPolicy.infant0to1.note
                  p.note= childrenPolicy.infant0to1.note
          
          if childrenPolicy.child2to5
            .policy-detail-card
              h3 Trẻ em (2-5 tuổi)
              .policy-detail-content
                if childrenPolicy.child2to5.freeWithExistingBed !== undefined
                  p
                    i.fa-solid.fa-check
                    |  #{childrenPolicy.child2to5.freeWithExistingBed ? 'Miễn phí khi sử dụng giường có sẵn' : 'Có phí khi sử dụng giường có sẵn'}
                if childrenPolicy.child2to5.extraBedCharge > 0
                  - const extraBedPrice = Number(childrenPolicy.child2to5.extraBedCharge).toLocaleString('vi-VN')
                  p
                    i.fa-solid.fa-money-bill
                    |  Phí giường phụ: #{extraBedPrice} VND
                if childrenPolicy.child2to5.note
                  p.note= childrenPolicy.child2to5.note
          
          if childrenPolicy.guest6Plus
            .policy-detail-card
              h3 Khách từ 6 tuổi trở lên
              .policy-detail-content
                if childrenPolicy.guest6Plus.consideredAdult !== undefined
                  p
                    i.fa-solid.fa-check
                    |  #{childrenPolicy.guest6Plus.consideredAdult ? 'Được tính như người lớn' : 'Không được tính như người lớn'}
                if childrenPolicy.guest6Plus.extraBedRequired
                  p
                    i.fa-solid.fa-bed
                    |  Bắt buộc giường phụ
                if childrenPolicy.guest6Plus.extraBedCharge > 0
                  - const extraBedPrice = Number(childrenPolicy.guest6Plus.extraBedCharge).toLocaleString('vi-VN')
                  p
                    i.fa-solid.fa-money-bill
                    |  Phí giường phụ: #{extraBedPrice} VND
                if childrenPolicy.guest6Plus.note
                  p.note= childrenPolicy.guest6Plus.note

    // ================== THÔNG TIN HỮU ÍCH ==================
    if usefulInfo && (usefulInfo.distanceFromCityCenter || usefulInfo.timeToAirport || usefulInfo.airportTransferFee || usefulInfo.wifiFee || usefulInfo.breakfastFee || usefulInfo.builtYear || usefulInfo.numberOfFloors || usefulInfo.inRoomVoltage || usefulInfo.nonSmokingRooms || usefulInfo.numberOfRestaurants || usefulInfo.numberOfBars || usefulInfo.licenseNumber)
      .useful-info-section
        h2 Thông tin hữu ích
        .useful-info-grid
          // Di chuyển
          if usefulInfo.distanceFromCityCenter || usefulInfo.timeToAirport || usefulInfo.airportTransferFee
            .useful-info-card
              h3
                i.fa-solid.fa-car
                |  Di chuyển
              .useful-info-content
                if usefulInfo.distanceFromCityCenter
                  p
                    strong Khoảng cách từ trung tâm thành phố:
                    |  #{usefulInfo.distanceFromCityCenter}
                if usefulInfo.timeToAirport
                  p
                    strong Thời gian đến sân bay:
                    |  #{usefulInfo.timeToAirport}
                if usefulInfo.airportTransferFee > 0
                  - const transferFee = Number(usefulInfo.airportTransferFee).toLocaleString('vi-VN')
                  p
                    strong Phí đưa đón sân bay:
                    |  #{transferFee} VND
          
          // Thông tin khác
          if usefulInfo.wifiFee || usefulInfo.breakfastFee
            .useful-info-card
              h3
                i.fa-solid.fa-info-circle
                |  Thông tin khác
              .useful-info-content
                if usefulInfo.wifiFee > 0
                  - const wifiFee = Number(usefulInfo.wifiFee).toLocaleString('vi-VN')
                  p
                    strong Phí WiFi:
                    |  #{wifiFee} VND/ngày
                else if usefulInfo.wifiFee === 0
                  p
                    i.fa-solid.fa-check
                    |  WiFi miễn phí
                if usefulInfo.breakfastFee > 0
                  - const breakfastFee = Number(usefulInfo.breakfastFee).toLocaleString('vi-VN')
                  p
                    strong Phí bữa sáng:
                    |  #{breakfastFee} VND
          
          // Về khách sạn
          if usefulInfo.builtYear || usefulInfo.numberOfFloors || usefulInfo.inRoomVoltage || usefulInfo.nonSmokingRooms || usefulInfo.numberOfRestaurants || usefulInfo.numberOfBars || usefulInfo.licenseNumber
            .useful-info-card
              h3
                i.fa-solid.fa-building
                |  Về khách sạn
              .useful-info-content
                if usefulInfo.builtYear > 0
