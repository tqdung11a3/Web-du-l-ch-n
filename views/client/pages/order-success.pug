extends ../layouts/default.pug

block main
  .container
    .section-11(style="padding-top: 20px;")
      .inner-wrap
        h4(style="color: green;") Cảm ơn quý khách đã đặt tour! Chúng tôi sẽ liên hệ lại với quý khách trong thời gian sớm nhất.
        .inner-head
          .inner-title Thông tin đơn hàng
        p Mã đơn hàng: #{orderDetail.code}
        p Tên khách hàng: #{orderDetail.fullName}
        p Số điện thoại: #{orderDetail.phone}
        p Ghi chú: #{orderDetail.test}
        p Phương thức thanh toán: #{orderDetail.paymentMethodName}
        p Trạng thái thanh toán: #{orderDetail.paymentStatusName}
        p Trạng thái đơn hàng: #{orderDetail.statusName}
        p Ngày đặt: #{orderDetail.createdAtFormat}

    .section-11(style="padding-top: 20px;")
      .inner-wrap
        .inner-head
          .inner-title Danh sách tour
        .inner-tour-list
          each item in orderDetail.items
            - const tourDetailUrl = item.companySlug ? `/company/${item.companySlug}/tour/detail/${item.slug}` : `/tour/detail/${item.slug}`
            .inner-tour-item.inner-tour-item--readonly
              .inner-product
                .inner-image
                  a(href=tourDetailUrl)
                    img(
                      alt=item.name
                      src=item.avatar
                      )
                .inner-content
                  .inner-title
                    a(href=tourDetailUrl) #{item.name}
                  .inner-meta
                    .inner-meta-item
                      | Ngày Khởi Hành: 
                      b #{item.departureDateFormat}
                    .inner-meta-item
                      | Khởi Hành Tại: 
                      b #{item.cityName}
              .inner-quantity
                label.inner-label Số Lượng Hành Khách
                .inner-list
                  .inner-item
                    .inner-item-label Người lớn:
                    .inner-item-input
                      span.cart-qty-fixed #{item.quantityAdult}
                    .inner-item-price
                      span #{item.quantityAdult}
                      span x
                      span.inner-hl #{item.priceNewAdult.toLocaleString("vi-VN")}
                  .inner-item.inner-item--with-ages
                    .inner-item-label Trẻ em:
                    .inner-item-input
                      span.cart-qty-fixed #{item.quantityChildren}
                    .inner-item-price
                      span #{item.quantityChildren}
                      span x
                      span.inner-hl #{item.priceNewChildren.toLocaleString("vi-VN")}
                    if item.childrenAges && item.childrenAges.length
                      .inner-ages-info.inner-ages-info--inline
                        each age, idx in item.childrenAges
                          span.inner-age-tag Bé #{idx + 1}: #{age} tuổi
                  .inner-item.inner-item--with-ages
                    .inner-item-label Em bé:
                    .inner-item-input
                      span.cart-qty-fixed #{item.quantityBaby}
                    .inner-item-price
                      span #{item.quantityBaby}
                      span x
                      span.inner-hl #{item.priceNewBaby.toLocaleString("vi-VN")}
                    if item.babyAges && item.babyAges.length
                      .inner-ages-info.inner-ages-info--inline
                        each age, idx in item.babyAges
                          span.inner-age-tag Bé #{idx + 1}: #{age} tuổi
              if (item.roomSelections && item.roomSelections.length > 0) || (item.extraRoomCost && item.extraRoomCost > 0)
                .inner-success-booking-extra
                  if item.roomSelections && item.roomSelections.length > 0
                    .inner-room-selections
                      .inner-room-selections__title
                        i.fa-solid.fa-bed(style="margin-right:4px")
                        | Phòng khách sạn đã chọn:
                      each rs in item.roomSelections
                        .inner-room-selections__item
                          span.inner-room-selections__hotel= rs.hotelName
                          span.inner-room-selections__type= rs.roomTypeName + ' × ' + rs.selectedRooms + ' phòng' + (rs.baseOccupancy ? ' (' + rs.baseOccupancy + ' người/phòng)' : '')
                          span.inner-room-selections__date= rs.fromDate + ' → ' + rs.toDate
                  if item.extraRoomCost && item.extraRoomCost > 0
                    .inner-room-selections__extra
                      i.fa-solid.fa-circle-info(style="margin-right:4px;color:#b45309")
                      | Chi phí phòng dư: #{Number(item.extraRoomCost).toLocaleString('vi-VN')}đ
        .inner-list-price
          .inner-item
            .inner-label Tạm tính:
            .inner-price #{orderDetail.subTotal.toLocaleString("vi-VN")}đ
          .inner-item
            .inner-label Giảm:
            .inner-price -#{orderDetail.discount.toLocaleString("vi-VN")}đ
          .inner-item
            .inner-label Thanh toán:
            .inner-price-hl #{orderDetail.total.toLocaleString("vi-VN")}đ
