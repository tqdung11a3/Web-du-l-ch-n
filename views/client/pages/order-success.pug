extends ../layouts/default.pug

block main
  .container
    .section-11(style="padding-top: 20px;")
      .inner-wrap
        h4(style="color: green;") Cảm ơn quý khách đã đặt tour! Chúng tôi sẽ liên hệ lại với quý khách trong thời gian sớm nhất.
        .inner-head
          .inner-title Thông tin đơn hàng
        p Mã đơn hàng: #{orderDetail.code}
        p Tên khách hàng: #{orderDetail.fullName}
        p Số điện thoại: #{orderDetail.phone}
        p Ghi chú: #{orderDetail.test}
        p Phương thức thanh toán: #{orderDetail.paymentMethodName}
        p Trạng thái thanh toán: #{orderDetail.paymentStatusName}
        p Trạng thái đơn hàng: #{orderDetail.statusName}
        p Ngày đặt: #{orderDetail.createdAtFormat}

    .section-11(style="padding-top: 20px;")
      .inner-wrap
        .inner-head
          .inner-title Danh sách tour
        .inner-tour-list
          each item in orderDetail.items
            - const tourDetailUrl = item.companySlug ? `/company/${item.companySlug}/tour/detail/${item.slug}` : `/tour/detail/${item.slug}`
            .inner-tour-item.inner-tour-item--readonly
              .inner-product
                .inner-image
                  a(href=tourDetailUrl)
                    img(
                      alt=item.name
                      src=item.avatar
                      )
                .inner-content
                  .inner-title
                    a(href=tourDetailUrl) #{item.name}
                  .inner-meta
                    .inner-meta-item
                      | Ngày Khởi Hành: 
                      b #{item.departureDateFormat}
                    .inner-meta-item
                      | Khởi Hành Tại: 
                      b #{item.cityName}
              .inner-quantity
                label.inner-label Số Lượng Hành Khách
                .inner-list
                  .inner-item
                    .inner-item-label Người lớn:
                    .inner-item-input
                      span.cart-qty-fixed #{item.quantityAdult}
                    .inner-item-price
                      span #{item.quantityAdult}
                      span x
                      span.inner-hl #{item.priceNewAdult.toLocaleString("vi-VN")}
                  .inner-item.inner-item--with-ages
                    .inner-item-label Trẻ em:
                    .inner-item-input
                      span.cart-qty-fixed #{item.quantityChildren}
                    .inner-item-price
                      span #{item.quantityChildren}
                      span x
                      span.inner-hl #{item.priceNewChildren.toLocaleString("vi-VN")}
                    if item.childrenAges && item.childrenAges.length
                      .inner-ages-info.inner-ages-info--inline
                        each age, idx in item.childrenAges
                          span.inner-age-tag Bé #{idx + 1}: #{age} tuổi
                  .inner-item.inner-item--with-ages
                    .inner-item-label Em bé:
                    .inner-item-input
                      span.cart-qty-fixed #{item.quantityBaby}
                    .inner-item-price
                      span #{item.quantityBaby}
                      span x
                      span.inner-hl #{item.priceNewBaby.toLocaleString("vi-VN")}
                    if item.babyAges && item.babyAges.length
                      .inner-ages-info.inner-ages-info--inline
                        each age, idx in item.babyAges
                          span.inner-age-tag Bé #{idx + 1}: #{age} tuổi
              if (item.accommodationMode === 'shared' && item.sharedRoomRequest && item.sharedRoomRequest.length > 0) || (item.roomSelections && item.roomSelections.length > 0) || (item.extraRoomCost && item.extraRoomCost > 0)
                .inner-success-booking-extra
                  if item.accommodationMode === 'shared' && item.sharedRoomRequest && item.sharedRoomRequest.length > 0
                    .inner-room-selections
                      .inner-room-selections__title
                        i.fa-solid.fa-people-group(style="margin-right:4px")
                        | Hình thức ở ghép:
                      each rs in item.sharedRoomRequest
                        .inner-room-selections__item
                          .inner-room-selections__meta-row
                            if rs.candidateHotels && rs.candidateHotels.length > 1
                              span.inner-room-selections__hotel
                                | Hệ thống sẽ ưu tiên sắp xếp theo thứ tự:
                                each h, hi in rs.candidateHotels
                                  if hi > 0
                                    |  ·
                                  |  #{hi + 1}. #{h.hotelName || h.hotelId}
                            else
                              span.inner-room-selections__hotel= rs.hotelName
                            span.inner-room-selections__type= 'Số người lớn ở ghép: ' + (rs.males || 0) + ' nam, ' + (rs.females || 0) + ' nữ'
                            span.inner-room-selections__date= rs.fromDate + ' → ' + rs.toDate
                          span.inner-room-selections__note Khách sạn thực tế sẽ được hệ thống sắp xếp theo khả năng ghép phòng.
                    if item.passengers && item.passengers.length
                      -
                        var psList = item.passengers || [];
                        var adultByIdx = {};
                        psList.forEach(function(p){ if (p.type === 'adult') adultByIdx[p.idx] = p; });
                      .pending-passenger-list
                        .pending-passenger-list__title
                          i.fa-solid.fa-id-card(style="margin-right:6px")
                          | Danh sách hành khách (#{psList.length} người)
                        .pending-passenger-list__rows
                          each p in psList
                            .pending-passenger-row(class=`pending-passenger-row--${p.type || 'adult'}`)
                              span.pending-passenger-badge(class=`pending-passenger-badge--${p.type || 'adult'}`)
                                if p.type === 'adult'
                                  | Người lớn
                                else if p.type === 'child'
                                  | Trẻ em
                                else
                                  | Em bé
                              span.pending-passenger-name= p.name || '(chưa có tên)'
                              span.pending-passenger-age #{p.age} tuổi
                              if p.gender === 'male'
                                span.pending-passenger-gender
                                  i.fa-solid.fa-mars(style="color:#3b82f6")
                                  |  Nam
                              else if p.gender === 'female'
                                span.pending-passenger-gender
                                  i.fa-solid.fa-venus(style="color:#ec4899")
                                  |  Nữ
                              if p.type !== 'adult'
                                - var guardian = adultByIdx[p.guardianIdx];
                                span.pending-passenger-guardian
                                  i.fa-solid.fa-link(style="margin-right:3px")
                                  |  Ở cùng:
                                  strong #{guardian ? (guardian.name || ('Người lớn #' + (guardian.idx + 1))) : '—'}
                  if item.accommodationMode !== 'shared' && item.roomSelections && item.roomSelections.length > 0
                    -
                      var paxByIdxPrivate = {};
                      var adultByIdxPrivate = {};
                      (item.passengers || []).forEach(function(p){
                        paxByIdxPrivate[p.idx] = p;
                        if (p.type === 'adult') adultByIdxPrivate[p.idx] = p;
                      });
                    .inner-room-selections
                      .inner-room-selections__title
                        i.fa-solid.fa-bed(style="margin-right:4px")
                        | Phòng khách sạn đã chọn:
                      each rs in item.roomSelections
                        .inner-room-selections__item
                          .inner-room-selections__meta-row
                            span.inner-room-selections__hotel= rs.hotelName
                            span.inner-room-selections__type= rs.roomTypeName + ' × ' + rs.selectedRooms + ' phòng' + (rs.baseOccupancy ? ' (' + rs.baseOccupancy + ' người/phòng)' : '')
                            span.inner-room-selections__date= rs.fromDate + ' → ' + rs.toDate
                          if rs.roomAssignments && rs.roomAssignments.length && (item.passengers || []).length
                            .inner-room-assignments
                              each a, ridx in rs.roomAssignments
                                .inner-room-assign-row
                                  .inner-room-assign-row__title
                                    i.fa-solid.fa-bed(style="margin-right:4px;color:#0071c2")
                                    | Phòng #{rs.roomTypeName} #
                                    = (ridx + 1)
                                    if a.usedCapacity !== undefined && a.usedCapacity !== null
                                      |  · sức chứa quy đổi #{a.usedCapacity}/#{rs.baseOccupancy}
                                  .inner-room-assign-row__pax
                                    if !a.passengerIdxs || a.passengerIdxs.length === 0
                                      span.inner-room-assign-empty — chưa gán hành khách —
                                    else
                                      each idx in a.passengerIdxs
                                        - var p = paxByIdxPrivate[idx];
                                        if p
                                          span.inner-room-assign-pax(class=`inner-room-assign-pax--${p.type || 'adult'}`)
                                            strong= p.name || ('Hành khách #' + (idx + 1))
                                            span.inner-room-assign-pax__meta
                                              = (p.type === 'child' ? 'TE' : (p.type === 'baby' ? 'EB' : 'NL'))
                                              if p.age !== undefined && p.age !== ''
                                                =  ' · ' + p.age + 't'
                    if item.passengers && item.passengers.length
                      .pending-passenger-list
                        .pending-passenger-list__title
                          i.fa-solid.fa-id-card(style="margin-right:6px")
                          | Danh sách hành khách (#{item.passengers.length} người)
                        .pending-passenger-list__rows
                          each p in item.passengers
                            .pending-passenger-row(class=`pending-passenger-row--${p.type || 'adult'}`)
                              span.pending-passenger-badge(class=`pending-passenger-badge--${p.type || 'adult'}`)
                                if p.type === 'adult'
                                  | Người lớn
                                else if p.type === 'child'
                                  | Trẻ em
                                else
                                  | Em bé
                              span.pending-passenger-name= p.name || '(chưa có tên)'
                              span.pending-passenger-age #{p.age} tuổi
                              if p.gender === 'male'
                                span.pending-passenger-gender
                                  i.fa-solid.fa-mars(style="color:#3b82f6")
                                  |  Nam
                              else if p.gender === 'female'
                                span.pending-passenger-gender
                                  i.fa-solid.fa-venus(style="color:#ec4899")
                                  |  Nữ
                  if item.extraRoomCost && item.extraRoomCost > 0
                    .inner-room-selections__extra
                      i.fa-solid.fa-circle-info(style="margin-right:4px;color:#b45309")
                      | Chi phí phòng dư: #{Number(item.extraRoomCost).toLocaleString('vi-VN')}đ
        .inner-list-price
          .inner-item
            .inner-label Tạm tính:
            .inner-price #{orderDetail.subTotal.toLocaleString("vi-VN")}đ
          .inner-item
            .inner-label Giảm:
            .inner-price -#{orderDetail.discount.toLocaleString("vi-VN")}đ
          .inner-item
            .inner-label Thanh toán:
            .inner-price-hl #{orderDetail.total.toLocaleString("vi-VN")}đ

  style.
    .pending-passenger-list { margin-top: 10px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px; padding: 10px 12px; }
    .pending-passenger-list__title { font-size: 12.5px; font-weight: 600; color: #0369a1; margin-bottom: 8px; display: flex; align-items: center; }
    .pending-passenger-list__rows { display: flex; flex-direction: column; gap: 5px; }
    .pending-passenger-row { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; padding: 5px 8px; border-radius: 6px; font-size: 12.5px; background: #fff; border: 1px solid #e0f2fe; }
    .pending-passenger-row--adult { border-left: 3px solid #6366f1; }
    .pending-passenger-row--child { border-left: 3px solid #f59e0b; }
    .pending-passenger-row--baby { border-left: 3px solid #ec4899; }
    .pending-passenger-badge { font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 999px; white-space: nowrap; }
    .pending-passenger-badge--adult { background: #e0e7ff; color: #4338ca; }
    .pending-passenger-badge--child { background: #fef3c7; color: #92400e; }
    .pending-passenger-badge--baby { background: #fce7f3; color: #9d174d; }
    .pending-passenger-name { font-weight: 600; color: #0f172a; flex: 1; min-width: 80px; }
    .pending-passenger-age { color: #64748b; font-size: 12px; white-space: nowrap; }
    .pending-passenger-gender { color: #334155; font-size: 12px; white-space: nowrap; display: flex; align-items: center; gap: 3px; }
    .pending-passenger-guardian { font-size: 11.5px; color: #64748b; display: flex; align-items: center; flex-basis: 100%; }
    .pending-passenger-guardian strong { color: #0369a1; font-weight: 600; }
