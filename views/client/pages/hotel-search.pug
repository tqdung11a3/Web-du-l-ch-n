//- views/client/pages/hotel-search.pug
extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug
include ../partials/hotel-guest-picker.pug

block main
  +box-breadcrumb(breadcrumb)
  .section-13
    .container
      // ================== THANH TÌM KIẾM TRÊN ĐẦU ==================
      .hotel-search-top
        form.hotel-search-top__form(action="/hotel/search" method="get")
          .hotel-search-top__inner
            // Địa điểm
            .hotel-search-top__item.hotel-search-top__item--location
              .hotel-search-top__label
                | Địa điểm 
                span.required *
              .location-input-wrapper
                select#provinceIdTop.hotel-search-top__select(
                  name="provinceId"
                  style="display: none;"
                )
                  option(value="") -- Chọn tỉnh thành --
                  if provinceList && provinceList.length > 0
                    each province in provinceList
                      option(value=province.id selected=(query && query.provinceId === String(province.id)))= province.name
                input#locationTop.hotel-search-top__input(
                  type="text"
                  name="location"
                  placeholder="Tỉnh thành hoặc địa chỉ khách sạn"
                  value=(query && query.location) || ""
                  autocomplete="off"
                )
                input#addressTop(
                  type="hidden"
                  name="address"
                  value=(query && query.address) || ""
                )
            // Ngày nhận phòng
            .hotel-search-top__item
              .hotel-search-top__label Nhận phòng
              input#checkInDateTop.hotel-search-top__input(
                type="date"
                name="checkInDate"
                value=(query && query.checkInDate) || ""
              )

            // Ngày trả phòng
            .hotel-search-top__item
              .hotel-search-top__label Trả phòng
              input#checkOutDateTop.hotel-search-top__input(
                type="date"
                name="checkOutDate"
                value=(query && query.checkOutDate) || ""
              )

            // Số khách
            +hotelGuestPickerFields(query)

            // Nút search (cột cuối)
            button.hotel-search-top__submit(type="submit" aria-label="Tìm kiếm")
              i.fa-solid.fa-magnifying-glass

      +hotelGuestModal()

      // ================== PHẦN DƯỚI: DANH SÁCH ==================
      .inner-wrap(style="grid-template-columns: 1fr;")
        // ---------- DANH SÁCH KHÁCH SẠN ----------
        .inner-right(style="width: 100%;")
          .inner-info
            h2.inner-title Danh sách khách sạn
            if hasSearched && errorMessage
              p(style="color:red")= errorMessage

          .hotel-list
            if hotelList && hotelList.length > 0
              each hotel in hotelList
                .hotel-card-search
                  .hotel-card-search__image
                    if hotel.thumbnail
                      img(src=hotel.thumbnail alt=hotel.name)
                    else
                      img(src="/images/no-image.jpg" alt=hotel.name)
                  .hotel-card-search__content
                    h3.hotel-card-search__title= hotel.name
                    // Địa chỉ
                    if hotel.address
                      p.hotel-card-search__address
                        i.fa-solid.fa-location-dot
                        span= hotel.address
                    // Thông tin công ty
                    if hotel.companyName
                      p.hotel-card-search__company
                        i.fa-solid.fa-building
                        span= hotel.companyName
                    // Rating và sao
                    .hotel-card-search__rating-row
                      if hotel.rating
                        .hotel-card-search__rating
                          span.hotel-card-search__rating-score= hotel.rating
                          span.hotel-card-search__rating-text Rất tốt
                      if hotel.starRating > 0
                        .hotel-card-search__stars
                          - for (let i = 0; i < 5; i++)
                            i.fa-solid.fa-star(class=(i < hotel.starRating ? 'active' : ''))
                    // Mô tả ngắn
                    if hotel.shortDescription
                      p.hotel-card-search__description= hotel.shortDescription
                    // Thông tin phòng
                    .hotel-card-search__info
                      if hotel.roomTypesCount > 0
                        .hotel-card-search__info-item
                          i.fa-solid.fa-door-open
                          span #{hotel.roomTypesCount} loại phòng
                      if hotel.totalRooms > 0
                        .hotel-card-search__info-item
                          i.fa-solid.fa-bed
                          span #{hotel.totalRooms} phòng
                      if hotel.vacantRooms > 0
                        .hotel-card-search__info-item.hotel-card-search__info-item--available
                          i.fa-solid.fa-check-circle
                          span Còn #{hotel.vacantRooms} phòng trống
                    // Amenities
                    if hotel.tags && hotel.tags.length > 0
                      .hotel-card-search__amenities
                        each tag in hotel.tags
                          span.hotel-card-search__amenity-tag= tag
                  .hotel-card-search__price
                    - const priceStr = Number(hotel.pricePerNight || 0).toLocaleString('vi-VN')
                    .hotel-card-search__price-value #{priceStr}
                    .hotel-card-search__price-unit #{hotel.currency}
                    .hotel-card-search__price-label mỗi đêm
                    - const queryParams = []
                    - if (hotel.checkInDate) queryParams.push(`checkInDate=${hotel.checkInDate}`)
                    - if (hotel.checkOutDate) queryParams.push(`checkOutDate=${hotel.checkOutDate}`)
                    - if (hotel.roomsData) queryParams.push(`roomsData=${encodeURIComponent(hotel.roomsData)}`)
                    - if (hotel.rooms) queryParams.push(`rooms=${hotel.rooms}`)
                    - if (hotel.adults) queryParams.push(`adults=${hotel.adults}`)
                    - if (hotel.children) queryParams.push(`children=${hotel.children}`)
                    - const queryString = queryParams.length > 0 ? '?' + queryParams.join('&') : ''
                    .hotel-card-search__actions
                      button.hotel-compare-btn(
                        type="button"
                        data-hotel-id=hotel.id
                        data-hotel-name=hotel.name
                        data-hotel-slug=hotel.id
                        data-hotel-avatar=(hotel.thumbnail || '')
                        data-hotel-price=hotel.pricePerNight
                        data-hotel-city=hotel.cityName
                        data-hotel-address=hotel.address
                        data-hotel-rating=hotel.rating
                        data-hotel-star=hotel.starRating
                        data-hotel-company=hotel.companyName
                        title="So sánh khách sạn"
                      )
                        i.fa-solid.fa-code-compare
                        span.compare-btn-text  So sánh
                      a.hotel-card-search__button(href=`/hotel/detail/${hotel.id}${queryString}`)
                        | Xem chi tiết
            else
              if hasSearched
                p(style="text-align: center; padding: 50px; color: #999;") Không tìm thấy khách sạn phù hợp.
              else
                p(style="text-align: center; padding: 50px; color: #999;") Hãy nhập thông tin bên trái để tìm khách sạn.
