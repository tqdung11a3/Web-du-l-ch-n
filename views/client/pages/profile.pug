extends ../layouts/default.pug

block main
  .account-page
    // ===== Sidebar =====
    .account-sidebar
      .account-user
        .avatar #{(user.fullName && user.fullName[0]) || (user.email && user.email[0]) || 'U'}
        .name #{user.fullName || user.email || 'Người dùng'}
      ul.account-nav
        li
          a(href="/account/profile?tab=info" class=(tab==='info' ? 'active' : ''))
            i.fa-regular.fa-id-card
            |  Thông tin cá nhân
        li
          a(href="/account/profile?tab=upcoming" class=(tab==='upcoming' ? 'active' : ''))
            i.fa-regular.fa-calendar-check
            |  Chuyến đi sắp tới
        li
          a(href="/account/profile?tab=history" class=(tab==='history' ? 'active' : ''))
            i.fa-regular.fa-clock
            |  Lịch sử chuyến đi
        li
          a(href="/account/profile?tab=hotel-bookings" class=(tab==='hotel-bookings' ? 'active' : ''))
            i.fa-solid.fa-hotel
            |  Lịch sử đặt phòng

    // ===== Content =====
    .account-content
      h1.page-title Tài khoản của bạn

      // ========== TAB: THÔNG TIN CÁ NHÂN ==========
      if tab === 'info'
        - var bdayStr = (user && user.birthday) ? new Date(user.birthday).toISOString().slice(0,10) : ''
        - var totalTours = (user && typeof user.totalTours === 'number') ? user.totalTours : 0

        .panel
          .panel-head
            h3 Thông tin cá nhân
            p.desc Cập nhật thông tin của Quý khách
          form(id="profile-edit-form")
            .row
              .label Họ tên
              .value
                input.inner-input(type="text" id="fullName" name="fullName" placeholder="Nhập họ tên" value=user.fullName)
            .row
              .label Giới tính
              .value
                select.inner-input(id="gender" name="gender")
                  option(value="") — Chọn —
                  option(value="male" selected=(user.gender == "male" ? true : false)) Nam
                  option(value="female" selected=(user.gender == "female" ? true : false)) Nữ
            .row
              .label Ngày sinh
              .value
                input.inner-input(type="date" id="birthday" name="birthday" value=bdayStr)
            .row
              .label Điện thoại
              .value
                input.inner-input(type="tel" id="phone" name="phone" placeholder="Số điện thoại" value=user.phone)
            .row
              .label Email
              .value
                input.inner-input(type="email" id="email" name="email" value=user.email disabled)
            .row
              .label CMND/CCCD
              .value
                input.inner-input(type="text" id="idNumber" name="idNumber" placeholder="Số CMND/CCCD" value=user.idNumber)
            .row
              .label Quốc tịch
              .value
                input.inner-input(type="text" id="nationality" name="nationality" placeholder="VD: Việt Nam" value=user.nationality)
            .row
              .label Địa chỉ
              .value
                input.inner-input(type="text" id="address" name="address" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" value=user.address)
            .row
              .label Tổng số tour đã đặt
              .value #{totalTours}
              .act
            .form-actions
              button(class="btn-primary") Cập nhật

      // ========== TAB: CHUYẾN ĐI SẮP TỚI ==========
      if tab === 'upcoming'
        .panel
          .panel-head
            h3 Chuyến đi sắp tới
            p.desc Những tour có ngày khởi hành từ hôm nay trở đi (đơn không bị hủy).
          if !upcoming || upcoming.length === 0
            .empty-box Chưa có chuyến đi nào.
          else
            each it in upcoming
              - const tourDetailUrl = it.companySlug ? `/company/${it.companySlug}/tour/detail/${it.slug}` : `/tour/detail/${it.slug}`
              .trip-card
                .pic
                  a(href=tourDetailUrl)
                    img(src=it.avatar alt=it.name)
                .info
                  h3.title
                    a(href=tourDetailUrl)= it.name
                  .meta
                    span Ngày khởi hành: 
                    b= it.departureDateFormat
                    |  • Mã đơn: #{it.orderCode}
                    |  • Thanh toán: #{it.paymentStatus==='paid' ? 'Đã thanh toán' : 'Chưa thanh toán'}
                  .order-status-row
                    - var osMap = { initial: { label: 'Khởi tạo', cls: 'initial' }, done: { label: 'Hoàn thành', cls: 'done' }, cancel: { label: 'Đã hủy', cls: 'cancel' } }
                    - var osEntry = osMap[it.orderStatus] || { label: it.orderStatus || 'Khởi tạo', cls: 'initial' }
                    span.order-status-label Trạng thái đơn hàng:
                    span.order-status-badge(class='order-status-badge--' + osEntry.cls)= osEntry.label
                  .qty Số lượng: NL #{it.qtyA} • TE #{it.qtyC} • EB #{it.qtyB}
                  if it.roomSelections && it.roomSelections.length > 0
                    - var segMap = {}
                    each rs in it.roomSelections
                      - var key = (rs.fromDate||'') + '__' + (rs.toDate||'')
                      - if (!segMap[key]) segMap[key] = { fromDate: rs.fromDate, toDate: rs.toDate, items: [] }
                      - segMap[key].items.push(rs)
                    .trip-rooms
                      .trip-rooms__title
                        i.fa-solid.fa-bed(style="margin-right:4px")
                        | Phòng khách sạn:
                      each seg in Object.values(segMap)
                        .trip-rooms__seg
                          span.trip-rooms__seg-date= seg.fromDate + ' → ' + seg.toDate
                          each rs in seg.items
                            .trip-rooms__row
                              span.trip-rooms__hotel= rs.hotelName
                              span.trip-rooms__info= rs.roomTypeName + ' × ' + rs.selectedRooms + ' phòng' + (rs.baseOccupancy ? ' (' + rs.baseOccupancy + ' người/phòng)' : '')
                    if it.privateAssignments && it.privateAssignments.length > 0
                      .trip-rooms.trip-rooms--assigned
                        .trip-rooms__title
                          i.fa-solid.fa-key(style="margin-right:4px;color:#2563eb")
                          | Phân công phòng cụ thể:
                        - var paStatusMap = { confirmed: { label: 'Chưa nhận phòng', cls: 'waiting' }, checked_in: { label: 'Đã nhận phòng', cls: 'checkedin' }, checked_out: { label: 'Đã trả phòng', cls: 'checkedout' } }
                        each a in it.privateAssignments
                          .trip-rooms__assigned-room
                            .trip-rooms__assigned-header
                              span.trip-rooms__hotel= a.hotelName
                              span.trip-rooms__room-num
                                i.fa-solid.fa-door-open(style="margin-right:4px")
                                | Phòng #{a.roomNumber || '—'}
                              if a.roomTypeName
                                span.trip-rooms__room-type= a.roomTypeName
                              - var paEntry = paStatusMap[a.bookingStatus] || paStatusMap['confirmed']
                              span.trip-rooms__badge(class='trip-rooms__badge--' + paEntry.cls)= paEntry.label
                            if a.passengers && a.passengers.length > 0
                              .trip-rooms__passengers
                                each p in a.passengers
                                  span.trip-rooms__passenger
                                    - var ptLabel = p.type === 'child' ? 'TE' : p.type === 'baby' ? 'EB' : 'NL'
                                    | #{p.name}
                                    span.trip-rooms__pax-type= ' (' + ptLabel + (p.age != null ? ', ' + p.age + ' tuổi' : '') + ')'
                  else if it.accommodationMode === 'shared'
                    if it.sharedAssignments && it.sharedAssignments.length > 0
                      .trip-rooms.trip-rooms--assigned
                        .trip-rooms__title
                          i.fa-solid.fa-bed(style="margin-right:4px")
                          | Phòng khách sạn (ở ghép):
                        - var gsMap = { confirmed: { label: 'Chưa nhận phòng', cls: 'waiting' }, checked_in: { label: 'Đã nhận phòng', cls: 'checkedin' }, checked_out: { label: 'Đã trả phòng', cls: 'checkedout' } }
                        each a in it.sharedAssignments
                          .trip-rooms__assigned-room
                            .trip-rooms__assigned-header
                              span.trip-rooms__hotel= a.hotelName
                              span.trip-rooms__room-num
                                i.fa-solid.fa-door-open(style="margin-right:4px")
                                | Phòng #{a.roomNumber || '—'}
                              if a.roomTypeName
                                span.trip-rooms__room-type= a.roomTypeName
                              - var gsEntry = gsMap[a.displayStatus || a.bookingStatus || a.guestStatus] || gsMap['confirmed']
                              span.trip-rooms__badge(class='trip-rooms__badge--' + gsEntry.cls)= gsEntry.label
                            if a.passengers && a.passengers.length > 0
                              .trip-rooms__passengers
                                each p in a.passengers
                                  span.trip-rooms__passenger
                                    - var ptLabel = p.type === 'child' ? 'TE' : p.type === 'baby' ? 'EB' : 'NL'
                                    | #{p.name}
                                    span.trip-rooms__pax-type= ' (' + ptLabel + (p.age != null ? ', ' + p.age + ' tuổi' : '') + ')'
                            else
                              p.trip-rooms__pending(style="margin:4px 0 0;font-size:12px") Đang cập nhật danh sách khách trong phòng.
                    else
                      .trip-rooms
                        .trip-rooms__title
                          i.fa-solid.fa-bed(style="margin-right:4px")
                          | Phòng khách sạn (ở ghép):
                        if it.orderStatus === 'cancel'
                          p.trip-rooms__pending Đơn hàng đã hủy — không có phân phòng.
                        else
                          p.trip-rooms__pending Chưa được phân công phòng — vui lòng chờ thông báo.
                  if it.extraRoomCost && it.extraRoomCost > 0
                    .trip-extra-cost
                      i.fa-solid.fa-circle-info(style="margin-right:4px;color:#b45309")
                      | Chi phí phòng cộng thêm: 
                      strong #{Number(it.extraRoomCost).toLocaleString('vi-VN')}đ
                .money #{(it.total||0).toLocaleString('vi-VN')}đ

      // ========== TAB: LỊCH SỬ CHUYẾN ĐI ==========
      if tab === 'history'
        .panel
          .panel-head
            h3 Lịch sử chuyến đi
            p.desc Những tour đã khởi hành hoặc đơn đã hủy.
          if !history || history.length === 0
            .empty-box Chưa có lịch sử nào.
          else
            each it in history
              - const tourDetailUrl = it.companySlug ? `/company/${it.companySlug}/tour/detail/${it.slug}` : `/tour/detail/${it.slug}`
              .trip-card.is-muted
                .pic
                  a(href=tourDetailUrl)
                    img(src=it.avatar alt=it.name)
                .info
                  h3.title
                    a(href=tourDetailUrl)= it.name
                  .meta
                    span Ngày khởi hành: 
                    b= it.departureDateFormat || '—'
                    |  • Mã đơn: #{it.orderCode}
                    |  • Thanh toán: #{it.paymentStatus==='paid' ? 'Đã thanh toán' : 'Chưa thanh toán'}
                  .order-status-row
                    - var osMap3 = { initial: { label: 'Khởi tạo', cls: 'initial' }, done: { label: 'Hoàn thành', cls: 'done' }, cancel: { label: 'Đã hủy', cls: 'cancel' } }
                    - var osEntry3 = osMap3[it.orderStatus] || { label: it.orderStatus || 'Khởi tạo', cls: 'initial' }
                    span.order-status-label Trạng thái đơn hàng:
                    span.order-status-badge(class='order-status-badge--' + osEntry3.cls)= osEntry3.label
                  .qty Số lượng: NL #{it.qtyA} • TE #{it.qtyC} • EB #{it.qtyB}
                  if it.roomSelections && it.roomSelections.length > 0
                    - var segMap2 = {}
                    each rs in it.roomSelections
                      - var key2 = (rs.fromDate||'') + '__' + (rs.toDate||'')
                      - if (!segMap2[key2]) segMap2[key2] = { fromDate: rs.fromDate, toDate: rs.toDate, items: [] }
                      - segMap2[key2].items.push(rs)
                    .trip-rooms
                      .trip-rooms__title
                        i.fa-solid.fa-bed(style="margin-right:4px")
                        | Phòng khách sạn:
                      each seg in Object.values(segMap2)
                        .trip-rooms__seg
                          span.trip-rooms__seg-date= seg.fromDate + ' → ' + seg.toDate
                          each rs in seg.items
                            .trip-rooms__row
                              span.trip-rooms__hotel= rs.hotelName
                              span.trip-rooms__info= rs.roomTypeName + ' × ' + rs.selectedRooms + ' phòng' + (rs.baseOccupancy ? ' (' + rs.baseOccupancy + ' người/phòng)' : '')
                    if it.privateAssignments && it.privateAssignments.length > 0
                      .trip-rooms.trip-rooms--assigned
                        .trip-rooms__title
                          i.fa-solid.fa-key(style="margin-right:4px;color:#2563eb")
                          | Phân công phòng cụ thể:
                        - var paStatusMap2 = { confirmed: { label: 'Chưa nhận phòng', cls: 'waiting' }, checked_in: { label: 'Đã nhận phòng', cls: 'checkedin' }, checked_out: { label: 'Đã trả phòng', cls: 'checkedout' } }
                        each a in it.privateAssignments
                          .trip-rooms__assigned-room
                            .trip-rooms__assigned-header
                              span.trip-rooms__hotel= a.hotelName
                              span.trip-rooms__room-num
                                i.fa-solid.fa-door-open(style="margin-right:4px")
                                | Phòng #{a.roomNumber || '—'}
                              if a.roomTypeName
                                span.trip-rooms__room-type= a.roomTypeName
                              - var paEntry2 = paStatusMap2[a.bookingStatus] || paStatusMap2['confirmed']
                              span.trip-rooms__badge(class='trip-rooms__badge--' + paEntry2.cls)= paEntry2.label
                            if a.passengers && a.passengers.length > 0
                              .trip-rooms__passengers
                                each p in a.passengers
                                  span.trip-rooms__passenger
                                    - var ptLabel2 = p.type === 'child' ? 'TE' : p.type === 'baby' ? 'EB' : 'NL'
                                    | #{p.name}
                                    span.trip-rooms__pax-type= ' (' + ptLabel2 + (p.age != null ? ', ' + p.age + ' tuổi' : '') + ')'
                  else if it.accommodationMode === 'shared'
                    if it.sharedAssignments && it.sharedAssignments.length > 0
                      .trip-rooms.trip-rooms--assigned
                        .trip-rooms__title
                          i.fa-solid.fa-bed(style="margin-right:4px")
                          | Phòng khách sạn (ở ghép):
                        - var gsMap2 = { confirmed: { label: 'Chưa nhận phòng', cls: 'waiting' }, checked_in: { label: 'Đã nhận phòng', cls: 'checkedin' }, checked_out: { label: 'Đã trả phòng', cls: 'checkedout' } }
                        each a in it.sharedAssignments
                          .trip-rooms__assigned-room
                            .trip-rooms__assigned-header
                              span.trip-rooms__hotel= a.hotelName
                              span.trip-rooms__room-num
                                i.fa-solid.fa-door-open(style="margin-right:4px")
                                | Phòng #{a.roomNumber || '—'}
                              if a.roomTypeName
                                span.trip-rooms__room-type= a.roomTypeName
                              - var gsEntry2 = gsMap2[a.displayStatus || a.bookingStatus || a.guestStatus] || gsMap2['confirmed']
                              span.trip-rooms__badge(class='trip-rooms__badge--' + gsEntry2.cls)= gsEntry2.label
                            if a.passengers && a.passengers.length > 0
                              .trip-rooms__passengers
                                each p in a.passengers
                                  span.trip-rooms__passenger
                                    - var ptLabel2 = p.type === 'child' ? 'TE' : p.type === 'baby' ? 'EB' : 'NL'
                                    | #{p.name}
                                    span.trip-rooms__pax-type= ' (' + ptLabel2 + (p.age != null ? ', ' + p.age + ' tuổi' : '') + ')'
                            else
                              p.trip-rooms__pending(style="margin:4px 0 0;font-size:12px") Đang cập nhật danh sách khách trong phòng.
                    else
                      .trip-rooms
                        .trip-rooms__title
                          i.fa-solid.fa-bed(style="margin-right:4px")
                          | Phòng khách sạn (ở ghép):
                        if it.orderStatus === 'cancel'
                          p.trip-rooms__pending Đơn hàng đã hủy — không có phân phòng.
                        else if it.orderStatus === 'done'
                          p.trip-rooms__pending Tour đã hoàn thành — không còn dữ liệu phân phòng.
                        else
                          p.trip-rooms__pending Chưa được phân công phòng — vui lòng chờ thông báo.
                  if it.extraRoomCost && it.extraRoomCost > 0
                    .trip-extra-cost
                      i.fa-solid.fa-circle-info(style="margin-right:4px;color:#b45309")
                      | Chi phí phòng cộng thêm: 
                      strong #{Number(it.extraRoomCost).toLocaleString('vi-VN')}đ
                .money #{(it.total||0).toLocaleString('vi-VN')}đ

      // ========== TAB: LỊCH SỬ ĐẶT PHÒNG ==========
      if tab === 'hotel-bookings'
        .panel
          .panel-head
            h3 Lịch sử đặt phòng khách sạn
            p.desc Danh sách các phòng khách sạn bạn đã đặt.
          if !hotelBookings || hotelBookings.length === 0
            .empty-box Chưa có lịch sử đặt phòng nào.
          else
            each booking in hotelBookings
              - const hbStatusCls = booking.status === 'cancelled' ? 'is-muted' : ''
              - const hbHighlightCls = booking.isHighlighted ? ' trip-card--highlight' : ''
              .trip-card(class=hbStatusCls + hbHighlightCls data-booking-code=booking.code)
                .pic
                  if booking.hotelThumbnail
                    img(src=booking.hotelThumbnail alt=booking.hotelName)
                  else
                    img(src="/images/no-image.jpg" alt=booking.hotelName)
                .info
                  h3.title= booking.hotelName
                  if booking.hotelAddress
                    p.hotel-address
                      i.fa-solid.fa-location-dot
                      |  #{booking.hotelAddress}
                  .meta
                    span Nhận phòng: 
                    b= booking.checkInDate
                    |  • Trả phòng: 
                    b= booking.checkOutDate
                    |  (#{booking.nights} đêm)
                    br
                    | Mã đơn: 
                    b= booking.code
                  .hb-status-row
                    - const bookingStatusMap = { pending: { label: 'Chờ xác nhận', cls: 'hb-badge--pending' }, confirmed: { label: 'Đã xác nhận', cls: 'hb-badge--confirmed' }, checked_in: { label: 'Đã nhận phòng', cls: 'hb-badge--checkedin' }, checked_out: { label: 'Đã trả phòng', cls: 'hb-badge--done' }, cancelled: { label: 'Đã hủy', cls: 'hb-badge--cancelled' } }
                    - const paymentMap = { paid: { label: 'Đã thanh toán', cls: 'hb-badge--paid' }, unpaid: { label: 'Chưa thanh toán', cls: 'hb-badge--unpaid' } }
                    - const bsEntry = bookingStatusMap[booking.status] || { label: booking.statusLabel || booking.status, cls: 'hb-badge--pending' }
                    - const pyEntry = paymentMap[booking.paymentStatus] || { label: booking.paymentStatusLabel || booking.paymentStatus, cls: 'hb-badge--unpaid' }
                    span.hb-badge(class=bsEntry.cls)
                      i.fa-solid.fa-circle-dot
                      |  #{bsEntry.label}
                    span.hb-badge(class=pyEntry.cls)
                      i.fa-solid.fa-circle-dollar-to-slot
                      |  #{pyEntry.label}
                  .qty
                    | #{booking.rooms} phòng • #{booking.adults} người lớn
                    if booking.children > 0
                      |  • #{booking.children} trẻ em
                  if booking.assignedRooms && booking.assignedRooms.length > 0
                    .hb-assigned-rooms
                      i.fa-solid.fa-key(style="margin-right:5px;color:#2d3e90")
                      | Phòng đã xếp: 
                      each ar, ari in booking.assignedRooms
                        if ari > 0
                          | , 
                        strong Phòng #{ar.roomNumber}
                        if ar.floor
                          span  (Tầng #{ar.floor})
                        if ar.roomType
                          span  — #{ar.roomType}
                  .hb-detail-link
                    a(href=`/hotel-booking/pending?bookingCode=${booking.code}&phone=${user.phone || ''}`)
                      i.fa-solid.fa-arrow-right
                      |  Xem chi tiết đặt phòng
                .money #{(booking.totalAmount||0).toLocaleString('vi-VN')} VND

        //- Tự cuộn đến card được highlight
        if highlight
          script.
            (function () {
              var el = document.querySelector('[data-booking-code="!{highlight}"]');
              if (el) {
                setTimeout(function () { el.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 200);
              }
            })();

        style.
          .hb-status-row { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0 4px; }
          .hb-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
          .hb-badge--pending  { background: #fef9c3; color: #854d0e; }
          .hb-badge--confirmed { background: #dbeafe; color: #1d4ed8; }
          .hb-badge--checkedin { background: #d1fae5; color: #065f46; }
          .hb-badge--done { background: #e0e7ff; color: #3730a3; }
          .hb-badge--cancelled { background: #fee2e2; color: #991b1b; }
          .hb-badge--paid { background: #d1fae5; color: #065f46; }
          .hb-badge--unpaid { background: #fef3c7; color: #92400e; }
          .hb-assigned-rooms { margin: 6px 0 2px; font-size: 13px; color: #374151; background: #eef1fb; border: 1px solid #d8ddf0; border-radius: 8px; padding: 6px 10px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
          .hb-detail-link { margin-top: 6px; font-size: 13px; }
          .hb-detail-link a { color: #2d3e90; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; text-decoration: none; }
          .hb-detail-link a:hover { text-decoration: underline; }
          .trip-card--highlight { border: 2px solid #2d3e90 !important; box-shadow: 0 0 0 4px rgba(45,62,144,.12) !important; animation: hb-flash 1.4s ease-in-out 2; }
          @keyframes hb-flash { 0%,100% { background: inherit; } 50% { background: #eef1fb; } }
