extends ../layouts/default.pug

block main
  .order-pending-page
    .container
      .pending-content

        //- Icon & tiêu đề
        .pending-icon
          i.fa-solid.fa-clock
        h1.pending-title Đơn tour đang chờ xác nhận
        p.pending-message
          | Cảm ơn bạn đã đặt tour! Đơn hàng đang được giữ chỗ tạm thời.
          br
          | Vui lòng hoàn tất thanh toán trước khi hết thời gian.

        //- Countdown timer
        if orderDetail && orderDetail.isTemporaryHold && orderDetail.paymentStatus === 'unpaid' && orderDetail.holdExpiresAt
          .hold-warning
            .warning-icon
              i.fa-solid.fa-hourglass-half
            .warning-content
              p.warning-title ⏰ Thời gian giữ chỗ
              p.warning-message Vui lòng hoàn tất thanh toán trong vòng:
              .countdown-timer#countdownTimer
                span.countdown-minutes 00
                span.countdown-separator :
                span.countdown-seconds 00
              p.warning-note Đơn sẽ tự động hủy và ghế được trả lại nếu không thanh toán đúng hạn.

        if orderDetail
          .booking-info

            //- ── Thông tin đơn hàng ──
            .info-card
              h3.info-title
                i.fa-solid.fa-file-invoice(style="margin-right:8px;color:#3b82f6")
                | Thông tin đơn hàng
              .info-row
                span.info-label Mã đơn hàng:
                strong.info-value= orderDetail.code
              .info-row
                span.info-label Ngày đặt:
                span.info-value= orderDetail.createdAtFormat
              .info-row
                span.info-label Họ tên:
                span.info-value= orderDetail.fullName
              .info-row
                span.info-label Số điện thoại:
                span.info-value= orderDetail.phone
              .info-row
                span.info-label Phương thức thanh toán:
                span.info-value= orderDetail.paymentMethodName
              .info-row
                span.info-label Trạng thái:
                span.info-value
                  span.badge-pending Chưa thanh toán

            //- ── Danh sách tour ──
            .info-card
              h3.info-title
                i.fa-solid.fa-map-location-dot(style="margin-right:8px;color:#3b82f6")
                | Danh sách tour
              each item in orderDetail.items
                .pending-tour-item
                  if item.avatar
                    img.pending-tour-img(src=item.avatar alt=item.name)
                  .pending-tour-body
                    .pending-tour-name= item.name
                    .pending-tour-meta
                      if item.departureDateFormat
                        span
                          i.fa-solid.fa-calendar-day
                          |  Khởi hành: #{item.departureDateFormat}
                      if item.cityName
                        span
                          i.fa-solid.fa-location-dot
                          |  Tại: #{item.cityName}
                    .pending-tour-qty
                      if item.quantityAdult
                        span
                          i.fa-solid.fa-user
                          |  #{item.quantityAdult} người lớn
                          |  × #{Number(item.priceNewAdult).toLocaleString('vi-VN')}đ
                      if item.quantityChildren
                        .pending-tour-passenger-block
                          span
                            i.fa-solid.fa-child
                            |  #{item.quantityChildren} trẻ em
                            |  × #{Number(item.priceNewChildren).toLocaleString('vi-VN')}đ
                          if item.childrenAges && item.childrenAges.length
                            .pending-tour-ages
                              each age, idx in item.childrenAges
                                span.pending-tour-age-tag Trẻ em #{idx + 1}: #{age} tuổi
                      if item.quantityBaby
                        .pending-tour-passenger-block
                          span
                            i.fa-solid.fa-baby
                            |  #{item.quantityBaby} em bé
                            |  × #{Number(item.priceNewBaby).toLocaleString('vi-VN')}đ
                          if item.babyAges && item.babyAges.length
                            .pending-tour-ages
                              each age, idx in item.babyAges
                                span.pending-tour-age-tag Em bé #{idx + 1}: #{age} tuổi
                    if item.roomSelections && item.roomSelections.length > 0
                      .pending-tour-rooms
                        .pending-tour-rooms__title
                          i.fa-solid.fa-bed(style="margin-right:4px")
                          | Phòng khách sạn đã chọn:
                        each rs in item.roomSelections
                          .pending-tour-rooms__item
                            span.pending-tour-rooms__hotel= rs.hotelName
                            span.pending-tour-rooms__type= rs.roomTypeName + ' × ' + rs.selectedRooms + ' phòng' + (rs.baseOccupancy ? ' (' + rs.baseOccupancy + ' người/phòng)' : '')
                            span.pending-tour-rooms__date= rs.fromDate + ' → ' + rs.toDate
                    if item.extraRoomCost && item.extraRoomCost > 0
                      .pending-tour-extra-cost
                        i.fa-solid.fa-circle-info(style="margin-right:4px;color:#b45309")
                        | Chi phí phòng dư: #{Number(item.extraRoomCost).toLocaleString('vi-VN')}đ

            //- ── Tổng tiền ──
            .info-card.info-card--total
              .info-row
                span.info-label Tạm tính:
                span.info-value= Number(orderDetail.subTotal).toLocaleString('vi-VN') + 'đ'
              if orderDetail.discount > 0
                .info-row
                  span.info-label Giảm giá:
                  span.info-value.text-green -#{Number(orderDetail.discount).toLocaleString('vi-VN')}đ
              .info-row.info-row--total
                span.info-label Tổng thanh toán:
                strong.info-value.total-amount= Number(orderDetail.total).toLocaleString('vi-VN') + 'đ'

        //- ── Hướng dẫn thanh toán & CTA ──
        .pending-actions
          if orderDetail && orderDetail.paymentStatus === 'unpaid'
            if orderDetail.paymentMethod === 'vnpay'
              .payment-info.payment-info--highlight
                p
                  i.fa-solid.fa-circle-info
                  |  Bạn đã chọn thanh toán qua VNPay. Vui lòng bấm nút bên dưới để hoàn tất.
              a.btn-payment.btn-vnpay(href=`/order/payment-vnpay?orderCode=${orderDetail.code}&phone=${phone}`)
                i.fa-solid.fa-credit-card
                |  Thanh toán ngay qua VNPay

            else if orderDetail.paymentMethod === 'bank'
              .payment-info
                p
                  i.fa-solid.fa-building-columns
                  strong  Chuyển khoản ngân hàng
                .bank-details
                  .bank-details-row
                    span.bank-label Ngân hàng:
                    span.bank-value Vietcombank
                  .bank-details-row
                    span.bank-label Tên tài khoản:
                    span.bank-value Le Van A
                  .bank-details-row
                    span.bank-label Số tài khoản:
                    span.bank-value 0123456789
                p.bank-note Sau khi chuyển khoản, vui lòng gửi ảnh chứng từ bên dưới để chúng tôi xác nhận nhanh hơn.
              .transfer-proof-section
                h4.proof-title
                  i.fa-solid.fa-image
                  |  Ảnh chứng từ chuyển khoản
                if transferProofImages && transferProofImages.length
                  .proof-gallery
                    each img in transferProofImages
                      a.proof-gallery-item(href=img target="_blank" title="Xem ảnh gốc")
                        img(src=img alt="Chứng từ")
                  p.proof-sent ✅ Đã gửi #{transferProofImages.length} ảnh chứng từ. Bạn có thể gửi thêm nếu cần.
                else
                  p.proof-empty Chưa có ảnh chứng từ nào.
                .upload-area
                  input#transferProofInput(type="file" accept="image/*" multiple style="display:none")
                  label.btn-upload-label(for="transferProofInput")
                    i.fa-solid.fa-upload
                    |  Chọn ảnh
                  .upload-preview#uploadPreview
                  p#uploadStatus.upload-status
                  button#btnSubmitProof.btn-submit-proof(type="button" disabled)
                    i.fa-solid.fa-paper-plane
                    |  Gửi ảnh chứng từ

            else
              .payment-info
                p
                  i.fa-solid.fa-money-bill-wave
                  strong  Thanh toán tiền mặt
                p Nhân viên sẽ liên hệ với bạn để xác nhận và hướng dẫn thanh toán. Vui lòng giữ điện thoại để nhận cuộc gọi.

          a.btn-primary(href="/tour") Tìm thêm tour
          a.btn-secondary(href="/") Về trang chủ
          if orderDetail && orderDetail.isTemporaryHold && orderDetail.paymentStatus === 'unpaid'
            button#btnCancelHold.btn-cancel-hold(type="button")
              i.fa-solid.fa-xmark
              |  Hủy đơn & trả lại ghế

  //- sendBeacon: hủy đơn khi user thực sự rời đi (không thanh toán, không refresh)
  if orderDetail && orderDetail.isTemporaryHold && orderDetail.paymentStatus === 'unpaid'
    script.
      (function () {
        var orderCode     = "!{orderDetail.code}";
        var phone         = "!{phone}";
        var goingToPayment = false;

        // Đánh dấu khi user click nút thanh toán → KHÔNG hủy đơn
        var payBtn = document.querySelector('.btn-payment, .btn-vnpay');
        if (payBtn) {
          payBtn.addEventListener('click', function () { goingToPayment = true; });
        }

        // Nút "Hủy đơn" → gọi API với header explicit rồi về trang chủ
        var cancelBtn = document.getElementById('btnCancelHold');
        if (cancelBtn) {
          cancelBtn.addEventListener('click', function () {
            if (!confirm('Bạn chắc chắn muốn hủy đơn và trả lại ghế?')) return;
            goingToPayment = true; // tắt beacon tránh gọi 2 lần
            cancelBtn.disabled = true;
            cancelBtn.textContent = 'Đang hủy...';
            fetch('/order/cancel-hold?orderCode=' + encodeURIComponent(orderCode) +
                  '&phone=' + encodeURIComponent(phone), {
                    headers: { 'X-Cancel-Reason': 'explicit' }
                  })
              .finally(function () { window.location.href = '/'; });
          });
        }

        // Breadcrumb để phát hiện F5 refresh:
        // Mỗi lần pageshow (load bình thường), đặt flag trong sessionStorage.
        // Khi pagehide xảy ra do refresh, pageshow sẽ xóa flag ngay sau;
        // khi pagehide do điều hướng thật, flag vẫn còn → gửi beacon.
        var REFRESH_KEY = 'pendingRefresh_' + orderCode;

        window.addEventListener('pageshow', function (e) {
          // Xóa flag "vừa refresh" nếu có (load thành công sau F5)
          sessionStorage.removeItem(REFRESH_KEY);
        });

        window.addEventListener('pagehide', function (e) {
          if (e.persisted)    return; // BFCache – user có thể quay lại
          if (goingToPayment) return; // đang thanh toán – giữ đơn

          // Đánh dấu có thể là refresh, đợi pageshow xóa đi
          sessionStorage.setItem(REFRESH_KEY, '1');

          // Dùng setTimeout 0 để gửi beacon SAU khi trình duyệt xử lý xong.
          // Nếu đây là refresh, pageshow sẽ xóa key trước khi beacon thực sự được
          // xử lý trên server (tuy nhiên sendBeacon không thể bị hủy sau khi gửi).
          // Giải pháp: server CHECK lại holdExpiresAt trước khi cancel —
          // chỉ cancel nếu đã hết hạn. Nếu chưa hết hạn & user refresh → server
          // giữ nguyên đơn. Cron job xử lý sau.
          var body = 'orderCode=' + encodeURIComponent(orderCode) +
                     '&phone='     + encodeURIComponent(phone);
          navigator.sendBeacon('/order/cancel-hold', body);
        });
      })();

  //- Polling: kiểm tra trạng thái thanh toán mỗi 5 giây
  //- Khi admin đổi paymentStatus → "paid", tự động chuyển sang trang thành công
  if orderDetail && orderDetail.paymentStatus === 'unpaid'
    script.
      (function () {
        var orderCode = "!{orderDetail.code}";
        var phone     = "!{phone}";
        var INTERVAL  = 5000;
        var timer     = setInterval(function () {
          fetch(
            '/order/check-payment-status' +
            '?orderCode=' + encodeURIComponent(orderCode) +
            '&phone='     + encodeURIComponent(phone)
          )
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data.code === 'ok' && data.paymentStatus === 'paid') {
                clearInterval(timer);
                window.location.href =
                  '/order/success' +
                  '?orderCode=' + encodeURIComponent(orderCode) +
                  '&phone='     + encodeURIComponent(phone);
              }
            })
            .catch(function () {});
        }, INTERVAL);

        window.addEventListener('beforeunload', function () {
          clearInterval(timer);
        });
      })();

  //- JavaScript countdown timer
  if orderDetail && orderDetail.isTemporaryHold && orderDetail.paymentStatus === 'unpaid' && orderDetail.holdExpiresAt
    script.
      (function () {
        var holdExpiresAt = new Date("!{orderDetail.holdExpiresAt}");
        var orderCode     = "!{orderDetail.code}";
        var phone         = "!{phone}";
        var countdownEl   = document.getElementById('countdownTimer');
        if (!countdownEl) return;

        var minutesEl  = countdownEl.querySelector('.countdown-minutes');
        var secondsEl  = countdownEl.querySelector('.countdown-seconds');

        function updateCountdown() {
          var now  = new Date();
          var diff = holdExpiresAt - now;

          if (diff <= 0) {
            minutesEl.textContent = '00';
            secondsEl.textContent = '00';
            clearInterval(interval);

            // Gọi API hủy đơn, rồi thông báo và về trang chủ
            fetch('/order/cancel-hold?orderCode=' + orderCode + '&phone=' + phone)
              .catch(function () {})
              .finally(function () {
                alert('⏰ Đơn giữ chỗ đã hết hạn! Ghế đã được trả lại. Vui lòng đặt lại.');
                window.location.href = '/';
              });
            return;
          }

          var totalSeconds = Math.floor(diff / 1000);
          var minutes = Math.floor(totalSeconds / 60);
          var seconds = totalSeconds % 60;

          minutesEl.textContent = String(minutes).padStart(2, '0');
          secondsEl.textContent = String(seconds).padStart(2, '0');
        }

        updateCountdown();
        var interval = setInterval(updateCountdown, 1000);

        window.addEventListener('beforeunload', function () {
          clearInterval(interval);
        });
      })();

  //- Upload ảnh chứng từ chuyển khoản
  if orderDetail && orderDetail.paymentMethod === 'bank' && orderDetail.paymentStatus === 'unpaid'
    script.
      (function () {
        var orderCode  = "!{orderDetail.code}";
        var phone      = "!{phone}";
        var inputEl    = document.getElementById('transferProofInput');
        var previewEl  = document.getElementById('uploadPreview');
        var submitBtn  = document.getElementById('btnSubmitProof');
        var statusEl   = document.getElementById('uploadStatus');
        if (!inputEl) return;

        var selectedFiles = [];

        inputEl.addEventListener('change', function () {
          selectedFiles = Array.from(this.files);
          previewEl.innerHTML = '';
          selectedFiles.forEach(function (file) {
            var reader = new FileReader();
            reader.onload = function (e) {
              var img = document.createElement('img');
              img.src = e.target.result;
              img.className = 'upload-preview-img';
              previewEl.appendChild(img);
            };
            reader.readAsDataURL(file);
          });
          submitBtn.disabled = selectedFiles.length === 0;
          statusEl.textContent = '';
        });

        submitBtn.addEventListener('click', function () {
          if (selectedFiles.length === 0) return;
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang gửi...';
          statusEl.textContent = '';

          var formData = new FormData();
          selectedFiles.forEach(function (file) {
            formData.append('files', file);
          });

          fetch('/upload/images', { method: 'POST', body: formData })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (!data.success || !data.urls || data.urls.length === 0) {
                throw new Error('Upload ảnh thất bại');
              }
              return fetch('/order/transfer-proof', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderCode: orderCode, phone: phone, images: data.urls }),
              });
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data.code === 'ok') {
                statusEl.textContent = '✅ Gửi ảnh thành công!';
                statusEl.style.color = '#16a34a';
                setTimeout(function () { window.location.reload(); }, 1200);
              } else {
                throw new Error(data.message || 'Lỗi không xác định');
              }
            })
            .catch(function (err) {
              statusEl.textContent = '❌ ' + err.message;
              statusEl.style.color = '#dc2626';
              submitBtn.disabled = false;
              submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Gửi ảnh chứng từ';
            });
        });
      })();

  style.
    .bank-details { background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 10px; padding: 14px 18px; margin: 12px 0; }
    .bank-details-row { display: flex; gap: 8px; margin-bottom: 6px; font-size: 14px; }
    .bank-details-row:last-child { margin-bottom: 0; }
    .bank-label { font-weight: 600; color: #0369a1; min-width: 130px; }
    .bank-value { color: #1e3a5f; font-weight: 500; }
    .bank-note { font-size: 13px; color: #64748b; margin-top: 10px; }
    .transfer-proof-section { margin-top: 18px; padding: 16px; background: #fafafa; border: 1px dashed #d1d5db; border-radius: 10px; }
    .proof-title { font-size: 15px; font-weight: 600; color: #374151; margin: 0 0 12px; display: flex; align-items: center; gap: 6px; }
    .proof-gallery { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 10px; }
    .proof-gallery-item img { width: 100px; height: 100px; object-fit: cover; border-radius: 8px; border: 1px solid #e5e7eb; }
    .proof-sent { font-size: 13px; color: #16a34a; margin-bottom: 10px; }
    .proof-empty { font-size: 13px; color: #9ca3af; margin-bottom: 10px; }
    .upload-area { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
    .btn-upload-label { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #e0f2fe; color: #0369a1; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 600; border: 1px solid #bae6fd; transition: background .15s; }
    .btn-upload-label:hover { background: #bae6fd; }
    .upload-preview { display: flex; flex-wrap: wrap; gap: 8px; }
    .upload-preview-img { width: 72px; height: 72px; object-fit: cover; border-radius: 6px; border: 1px solid #e5e7eb; }
    .upload-status { font-size: 13px; font-weight: 600; margin: 0; width: 100%; }
    .btn-submit-proof { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; background: #2563eb; color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: background .15s; }
    .btn-submit-proof:hover:not(:disabled) { background: #1d4ed8; }
    .btn-submit-proof:disabled { background: #93c5fd; cursor: not-allowed; }
