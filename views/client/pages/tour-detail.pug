extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug

block main
  +box-breadcrumb(breadcrumb)

  .section-10
    .container
      .inner-wrap
        .inner-left
          // Danh sách ảnh
          .box-images
            .inner-images-main
              .swiper.swiper-box-images-main
                .swiper-wrapper
                  each image in tourDetail.images
                    .swiper-slide
                      .inner-image
                        img(
                          alt=""
                          src=image
                        )
            .inner-images-thumb
              .swiper.swiper-box-images-thumb
                .swiper-wrapper
                  each image in tourDetail.images
                    .swiper-slide
                      .inner-image
                        img(
                          alt=""
                          src=image
                        )
          // Hết Danh sách ảnh

          // Tabs nội dung tour
          .tour-tabs
            .tour-tabs-header
              button.tour-tab-btn.is-active(data-tab="overview") Tổng quan
              button.tour-tab-btn(data-tab="schedule") Lịch trình
              button.tour-tab-btn(data-tab="includes") Bao gồm
              button.tour-tab-btn(data-tab="reviews") Đánh giá
              if tourHotels && tourHotels.length > 0
                button.tour-tab-btn(data-tab="hotels") Khách sạn

            .tour-tabs-body
              // Tab: Tổng quan
              .tour-tab-panel.is-active(data-tab="overview")
                // Thông Tin Tour
                .box-tour-info
                  .inner-title Thông Tin Tour
                  .inner-content !{tourDetail.information}

                // Điểm nổi bật
                if tourDetail.highlights && tourDetail.highlights.length
                  .box-tour-highlights
                    .inner-title-main Điểm nổi bật
                    ul.list-highlights
                      each item in tourDetail.highlights
                        li= item

                // Những địa điểm có trong tour (accordion theo tỉnh/thành)
                if tourDetail.locations && tourDetail.locations.length
                  .box-tour-destinations
                    .inner-title-main Những địa điểm có trong tour
                    .dest-accordion
                      each loc, idx in tourDetail.locations
                        .dest-accordion-item(class= idx === 0 ? 'is-open' : '')
                          button.dest-accordion-header(type="button")
                            .dest-accordion-title
                              i.fa-solid.fa-location-dot
                              span
                                | 
                                = loc.cityName || loc.cityLabel || 'Địa điểm'
                            i.dest-accordion-icon.fa-solid.fa-chevron-down
                          .dest-accordion-body
                            if loc.spots && loc.spots.length
                              ul.dest-spots-list
                                each spot in loc.spots
                                  li= spot
                            else
                              p.dest-spots-empty
                                | Chưa có địa điểm nổi bật được thiết lập cho tỉnh/thành này.

              // Tab: Lịch trình
              .tour-tab-panel(data-tab="schedule")
                // Lịch Trình Tour
                .box-tour-schedule
                  .inner-title-main Lịch Trình Tour
                  .inner-list
                    each item in tourDetail.schedules
                      .inner-item
                        .inner-title #{item.title}
                        .inner-content !{item.description}

              // Tab: Bao gồm
              .tour-tab-panel(data-tab="includes")
                // Giá tour bao gồm
                if tourDetail.includes && tourDetail.includes.length
                  .box-tour-includes
                    .inner-title-main Giá tour bao gồm
                    ul.list-includes
                      each item in tourDetail.includes
                        li= item
                // Giá tour không bao gồm
                if tourDetail.excludes && tourDetail.excludes.length
                  .box-tour-excludes
                    .inner-title-main Giá tour không bao gồm
                    ul.list-excludes
                      each item in tourDetail.excludes
                        li= item

              // Tab: Đánh giá
              .tour-tab-panel(data-tab="reviews")
                // ==== ĐÁNH GIÁ & BÌNH LUẬN ====
                - const loggedIn = !!(account && account.id);
                .box-reviews(
                  id="box-reviews"
                  data-tour-id=tourDetail._id
                  data-logged-in=(loggedIn ? "1" : "0")
                )
                  .inner-title-main Đánh giá và bình luận

                  // Tổng quan sao
                  .review-summary
                    .avg
                      span.avg-number 0
                      span.avg-text / 5
                    .stars(role="img" aria-label="average stars")
                    .count (0 đánh giá)
                    // thanh phân bố 5→1 sao
                    ul.distribution
                      each s in [5,4,3,2,1]
                        li
                          span.star-label #{s} ★
                          .bar
                            .bar-inner(style="width:0%")
                          span.bar-count 0

                  // Form viết review (chỉ hiện nếu đã đăng nhập)
                  if loggedIn
                    form#review-form(class="review-form", action="", method="post")
                      .rating-input
                        span.label Đánh giá:
                        ul.star-input(aria-label="chọn số sao")
                          each i in [1,2,3,4,5]
                            li(data-value=i)
                              i.fa-solid.fa-star
                        input(type="hidden" name="rating" value="5")
                      .content-input
                        textarea(name="content" rows="4" placeholder="Chia sẻ cảm nhận của bạn")
                      button(type="submit").button-primary Gửi đánh giá
                  else
                    .login-hint
                      | Bạn cần đăng nhập để viết đánh giá.
                  // Danh sách review
                  .review-list
                    // sẽ render bằng JS
                  .review-pagination
                    button.btn-prev(disabled) Trước
                    span.page-info 1/1
                    button.btn-next(disabled) Sau

              // Tab: Khách sạn
              if tourHotels && tourHotels.length > 0
                .tour-tab-panel(data-tab="hotels")
                  .inner-title-main Khách sạn trong chuyến đi
                  .tour-hotels-grid
                    each h in tourHotels
                      a.tour-hotel-card(href=`/hotel/detail/${h._id}` target="_blank")
                        .tour-hotel-card__image
                          if h.avatar
                            img(src=h.avatar alt=h.name)
                          else
                            .tour-hotel-card__no-image
                        .tour-hotel-card__body
                          h4.tour-hotel-card__name= h.name
                          if h.starRating > 0
                            p.tour-hotel-card__rating-text #{h.starRating}/5 sao
                          if h.address
                            p.tour-hotel-card__address= h.address
                          if h.note
                            .tour-hotel-card__note= h.note
                          .tour-hotel-card__footer
                            if h.basePrice > 0
                              .tour-hotel-card__price
                                span.tour-hotel-card__price-from Từ 
                                span.tour-hotel-card__price-value= h.basePrice.toLocaleString('vi-VN')
                                span.tour-hotel-card__price-unit  #{h.currency || 'VND'}/đêm
                            span.tour-hotel-card__cta Xem chi tiết

        .inner-right
          // Truyền thêm dữ liệu cho JS
          - const babyMode      = tourDetail.babyPricingMode || 'fixed';
          - const babyRulesJson = JSON.stringify(tourDetail.babyPricingRules || []);
          - const priceAdult    = Number(tourDetail.priceNewAdult || 0);
          - const priceChild    = Number(tourDetail.priceNewChildren || 0);
          - const priceBabyFix  = Number(tourDetail.priceNewBaby || 0);
          - const babyUnit      = (babyMode === 'fixed' ? priceBabyFix.toLocaleString('vi-VN') : '0');
          - const ageBands      = tourDetail.tourAgeBands || {};
          - const babyMaxAge    = ageBands.babyMaxAge !== undefined ? ageBands.babyMaxAge : 3;
          - const childrenMaxAge = ageBands.childrenMaxAge !== undefined ? ageBands.childrenMaxAge : 11;
          - const childrenMinAge = babyMaxAge + 1;
          - const adultMinAge    = childrenMaxAge + 1;

          .box-tour-detail(
            data-seats-remaining=tourDetail.seatsRemaining
            data-price-adult=priceAdult
            data-price-children=priceChild
            data-price-baby=priceBabyFix
            data-baby-mode=babyMode
            data-baby-rules=babyRulesJson
            data-baby-max-age=babyMaxAge
            data-children-min-age=childrenMinAge
            data-children-max-age=childrenMaxAge
          )
            .inner-title-main Chuyến Đi Của Bạn
            .inner-product
              .inner-image
                img(alt=tourDetail.name src=tourDetail.avatar)
              .inner-info
                .inner-title #{tourDetail.name}

            .inner-meta
              .inner-item
                i.fa-solid.fa-calendar-days
                span Thời Gian:
                span.inner-hl #{tourDetail.time}
              .inner-item
                i.fa-solid.fa-car
                span Phương Tiện:
                span.inner-hl #{tourDetail.vehicle}
              .inner-item
                i.fa-solid.fa-calendar-days
                span Ngày Khởi Hành:
                - const departureDatesList = tourDetail.departureDatesFormatted && tourDetail.departureDatesFormatted.length ? tourDetail.departureDatesFormatted : (tourDetail.departureDateFormat ? [tourDetail.departureDateFormat] : []);
                - const seatsByDateJson = JSON.stringify(tourDetail.departureSeatsByDate || {})
                if departureDatesList && departureDatesList.length
                  select#departureDateSelect.departure-date-select(
                    name="departureDate"
                    data-has-multiple=(departureDatesList.length > 1 ? "1" : "0")
                    data-seats-by-date=seatsByDateJson
                  )
                    option(value="") Chọn ngày khởi hành
                    each d, idx in departureDatesList
                      option(
                        value=d
                        selected=(departureDatesList.length === 1 && idx === 0)
                      )= d
                else
                  span.inner-hl Chưa thiết lập ngày khởi hành
              .inner-item.inner-item--departure-seats
                i.fa-solid.fa-bed
                span Số chỗ còn lại:
                #departureSeatInfo.departure-seat-info(style="display:none")

            // Khởi hành tại: 1 điểm duy nhất
            .inner-group.departure
              .inner-label Khởi Hành Tại:
              .inner-value
                if tourDetail.departureCity && tourDetail.departureCityName
                  span.inner-hl #{tourDetail.departureCityName}
                else
                  span Chưa thiết lập điểm khởi hành
            .inner-group
              .inner-label Số Lượng Hành Khách
              .inner-list
                .inner-item
                  .inner-item-label Người lớn (từ #{adultMinAge} tuổi):
                  .inner-item-input
                    input(
                      value="1"
                      type="number"
                      min="0"
                      input-quantity="stockAdult"
                      data-price=priceAdult
                      name="quantityAdult"
                    )
                  .inner-item-price
                    span(label-quantity="stockAdult") 1
                    span x
                    span.inner-hl= priceAdult.toLocaleString('vi-VN')

                .inner-item
                  .inner-item-label Trẻ em (#{childrenMinAge}–#{childrenMaxAge} tuổi):
                  .inner-item-input
                    input(
                      value="0"
                      type="number"
                      min="0"
                      input-quantity="stockChildren"
                      data-price=priceChild
                      name="quantityChildren"
                    )
                  .inner-item-price
                    span(label-quantity="stockChildren") 0
                    span x
                    span.inner-hl= priceChild.toLocaleString('vi-VN')

                .inner-item
                  .inner-item-label Em bé (0–#{babyMaxAge} tuổi):
                  .inner-item-input
                    input(
                      value="0"
                      type="number"
                      min="0"
                      input-quantity="stockBaby"
                      data-price=priceBabyFix
                      name="quantityBaby"
                      data-baby-dynamic="1"
                    )
                  .inner-item-price
                    span(label-quantity="stockBaby") 0
                    span x
                    // chỉ còn 1 dòng, dùng biến đã tính sẵn
                    span.inner-hl(data-baby-unit)= babyUnit

                .inner-seat-option
                  label
                    input(type="checkbox" name="seatBaby" seat-baby-toggle)
                    |  Đặt chỗ ngồi riêng cho em bé

            // Khối nhập tuổi từng trẻ em / em bé — JS hiển thị khi số lượng > 0
            .age-inputs-wrapper(style="display:none")
              .age-inputs-header
                i.fa-solid.fa-child-reaching
                span Tuổi hành khách nhỏ
              .age-inputs-body
                .age-inputs-group#children-ages-group(style="display:none")
                  .age-inputs-group-label Trẻ em (#{childrenMinAge}–#{childrenMaxAge} tuổi)
                  .age-inputs-list#children-ages-list
                .age-inputs-group#babies-ages-group(style="display:none")
                  .age-inputs-group-label Em bé (0–#{babyMaxAge} tuổi)
                  .age-inputs-list#babies-ages-list

            //- Chọn phòng khách sạn (bắt buộc nếu tour có liên kết khách sạn)
            if tourRoomSegments && tourRoomSegments.length > 0
              - const _segmentsJson = JSON.stringify(tourRoomSegments)

              //- Chọn hình thức lưu trú: ở riêng (cộng full giá phòng) hoặc ở ghép (khai số nam/nữ).
              .accommodation-mode-picker(data-required="1")
                .accommodation-mode-picker__title Hình thức lưu trú
                .accommodation-mode-picker__hint
                  i.fa-solid.fa-circle-info
                  span  Chọn cách bạn muốn ở khi tham gia tour. Hình thức "Ở ghép" sẽ được hệ thống xếp tự động ghép cùng giới với các đoàn khác.
                .accommodation-mode-picker__options
                  label.accommodation-mode-option.is-selected
                    input(
                      type="radio"
                      name="accommodationMode"
                      value="private"
                      checked
                    )
                    .accommodation-mode-option__body
                      .accommodation-mode-option__title
                        i.fa-solid.fa-bed
                        span  Ở riêng
                      .accommodation-mode-option__desc Bạn chọn loại phòng cụ thể, được sử dụng riêng cả phòng. Toàn bộ tiền phòng được cộng vào tổng tour.
                  label.accommodation-mode-option
                    input(
                      type="radio"
                      name="accommodationMode"
                      value="shared"
                    )
                    .accommodation-mode-option__body
                      .accommodation-mode-option__title
                        i.fa-solid.fa-people-group
                        span  Ở ghép
                      .accommodation-mode-option__desc Khai số nam/nữ; hệ thống tự ghép cùng giới với các đoàn khác. Không tính thêm phụ phí phòng vào tổng tour.

              .inner-room-selection(data-room-segments=_segmentsJson data-required="1" data-mode="private")
                .inner-room-selection__header
                  .inner-label Chọn phòng khách sạn
                each seg in tourRoomSegments
                  .room-time-segment(data-from-date=seg.fromDate data-to-date=seg.toDate)
                    .room-time-segment__header
                      i.fa-solid.fa-calendar-days(style="margin-right:6px;color:#6366f1")
                      span.room-time-segment__label= seg.segmentLabel
                    .room-time-segment__occupancy-live(role="status" aria-live="polite")
                      span.room-time-segment__occupancy-live-label Tổng sức chứa quy đổi:
                      strong.room-time-segment__occupancy-live-value —
                      .room-time-segment__occupancy-live-detail
                    .room-time-segment__segment-warnings
                      .room-segment-extra-warning(style="display:none")
                      .room-segment-capacity-warning(style="display:none")
                    each hotel in seg.hotels
                      .room-hotel-block(
                        data-hotel-id=hotel.hotelId
                        data-tour-segment-id=hotel.tourSegmentId
                      )
                        .room-hotel-block__header
                          span.room-hotel-block__name= hotel.hotelName
                        if hotel.ageBands && hotel.ageBands.length > 0
                          .room-hotel-block__agebands
                            .room-hotel-block__agebands-title Chính sách sức chứa
                            ul.room-hotel-block__agebands-list
                              each band in hotel.ageBands
                                - var rangeText = band.maxAge === null || band.maxAge === undefined ? (band.minAge + ' tuổi trở lên') : (band.minAge + '–' + band.maxAge + ' tuổi')
                                - var weightText = band.countInOccupancy ? (band.occupancyWeight === 0.5 ? '0,5' : String(band.occupancyWeight)) : 'không tính'
                                li.room-hotel-block__agebands-item
                                  span.room-hotel-block__agebands-range= rangeText
                                  if band.bandName
                                    span.room-hotel-block__agebands-name= ' · ' + band.bandName
                                  span.room-hotel-block__agebands-weight= ': ' + weightText
                        each rt in hotel.roomTypes
                          .room-type-row(
                            data-room-type-id=rt.roomTypeId
                            data-hotel-id=hotel.hotelId
                            data-base-occupancy=rt.baseOccupancy
                            data-available-rooms=rt.availableRooms
                            data-price-per-night=rt.pricePerNight
                          )
                            .room-type-row__info
                              .room-type-row__name= rt.roomTypeName
                              .room-type-row__meta #{rt.baseOccupancy} người/phòng · còn #{rt.availableRooms} phòng
                              if Number(rt.pricePerNight) > 0
                                .room-type-row__price #{Number(rt.pricePerNight).toLocaleString('vi-VN')}đ/đêm
                            .room-type-row__input
                              input.room-qty-input(
                                type="number"
                                min="0"
                                max=rt.availableRooms
                                value="0"
                                placeholder="0"
                              )
                              span.room-type-row__input-unit phòng
                .room-selection-required-warning(style="display:none") Vui lòng chọn đủ phòng ở từng khung thời gian.

              //- Vùng "Thông tin hành khách" — dùng chung cho cả 2 mode (private/shared).
              //- JS render rows theo quantityAdult / Children / Baby.
              //- 1 đơn = 1 list cho cả tour.
              .shared-passenger-list(data-required="1" style="display:none")
                .shared-passenger-list__header
                  .inner-label Thông tin hành khách
                  .shared-passenger-list__hint
                    i.fa-solid.fa-circle-info
                    span  Khai đầy đủ họ tên, tuổi, giới tính cho mỗi người. Trẻ em / em bé phải chọn người lớn đi cùng phòng.
                .shared-passenger-list__rows
                  //- Rows được render bằng JS dựa trên số người lớn / trẻ em / em bé.
                .shared-passenger-list__warning(style="display:none") Vui lòng khai đầy đủ thông tin hành khách trước khi đặt tour.

              //- Mode "Ở riêng" — phân bổ từng hành khách vào từng phòng vật lý.
              //- JS render khi mode=private và đã chọn ≥ 1 phòng.
              .private-room-assignment(data-required="1" style="display:none")
                .private-room-assignment__header
                  .inner-label Phân bổ hành khách vào phòng
                  .private-room-assignment__hint
                    i.fa-solid.fa-circle-info
                    span  Mỗi người lớn và trẻ em phải được gán vào đúng 1 phòng trong cùng khung. Em bé có thể bỏ trống. Trẻ em / em bé phải ở cùng phòng với người lớn đã chọn.
                .private-room-assignment__segments
                  //- JS render skeleton per segment / hotel / physical room.
                .private-room-assignment__warning(style="display:none") Vui lòng phân bổ đầy đủ hành khách vào phòng.

              //- Tóm tắt số nam/nữ theo từng khung — auto-derive từ passengers.
              //- Mỗi khung có thể có nhiều khách sạn; hệ thống sẽ ưu tiên khách
              //- sạn đầu, tự fallback / kết hợp các khách sạn còn lại nếu cần.
              .inner-shared-room-selection(data-room-segments=_segmentsJson data-required="1" style="display:none")
                .inner-shared-room-selection__header
                  .inner-label Tóm tắt phân bổ phòng theo khung
                  .inner-shared-room-selection__hint
                    i.fa-solid.fa-circle-info
                    span  Hệ thống ưu tiên xếp đoàn vào khách sạn đầu tiên; nếu hết chỗ sẽ tự kết hợp các khách sạn khác trong cùng khung.
                each seg in tourRoomSegments
                  - var _segTourSegmentId = (seg.hotels && seg.hotels[0]) ? seg.hotels[0].tourSegmentId : ''
                  .shared-room-segment(
                    data-from-date=seg.fromDate
                    data-to-date=seg.toDate
                    data-tour-segment-id=_segTourSegmentId
                  )
                    .shared-room-segment__header
                      i.fa-solid.fa-calendar-days(style="margin-right:6px;color:#6366f1")
                      span.shared-room-segment__label= seg.segmentLabel
                    .shared-room-hotel-block
                      .shared-room-hotel-block__name
                        i.fa-solid.fa-hotel(style="margin-right:6px;color:#6366f1")
                        span Phân bổ tự động theo thứ tự ưu tiên
                      if seg.hotels && seg.hotels.length > 0
                        .shared-room-hotel-block__candidates
                          each hotel, hIdx in seg.hotels
                            .shared-room-hotel-block__candidate(
                              data-hotel-id=hotel.hotelId
                              data-hotel-name=hotel.hotelName
                            )
                              span.shared-room-hotel-block__candidate-rank #{hIdx + 1}.
                              span.shared-room-hotel-block__candidate-name= hotel.hotelName
                              if hIdx === 0
                                span.shared-room-hotel-block__candidate-tag Ưu tiên 1
                      .shared-room-hotel-block__inputs
                        .shared-gender-display
                          span.shared-gender-display__label Số nam (người lớn)
                          span.shared-gender-display__value.shared-male-display 0
                          input.shared-male-input(type="hidden" value="0")
                        .shared-gender-display
                          span.shared-gender-display__label Số nữ (người lớn)
                          span.shared-gender-display__value.shared-female-display 0
                          input.shared-female-input(type="hidden" value="0")
                      .shared-room-hotel-block__hint
                        span Đoàn này có 
                        strong.shared-room-hotel-block__expected 1
                        span  người lớn. Hệ thống tự xếp vào các khách sạn ở trên.
                .shared-room-required-warning(style="display:none") Tổng số nam + nữ ở danh sách hành khách chưa khớp số người lớn đoàn.

            //- Khối cảnh báo phòng dư – hiển thị ngay trên Tổng cộng
            .room-selection-global-extra-warning(style="display:none")

            .inner-total
              .inner-label Tổng cộng:
              .inner-price
                span(total-price)= priceAdult.toLocaleString('vi-VN')
                span đ
            .inner-actions
              button.inner-button-add-cart(tour-id=tourDetail._id) Đặt ngay
              // Nút thêm vào so sánh
              button.inner-compare-btn(
                type="button"
                data-tour-id=tourDetail._id
                data-tour-name=tourDetail.name
                data-tour-slug=tourDetail.slug
                data-tour-avatar=tourDetail.avatar
                data-tour-price=tourDetail.priceNewAdult || tourDetail.priceAdult || 0
                data-tour-price-old=tourDetail.priceAdult || 0
                data-tour-discount=tourDetail.discount || 0
                data-tour-company=(tourDetail.company ? JSON.stringify(tourDetail.company) : '{}')
                title="Thêm tour này vào so sánh"
              )
                i.fa-solid.fa-code-compare
                span.compare-btn-text So sánh

            // Thông tin công ty tổ chức
            if tourDetail.company
              .inner-company-info
