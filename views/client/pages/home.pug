extends ../layouts/default.pug
include ../mixins/product.pug
include ../mixins/blog.pug
include ../mixins/company-card.pug

block main
  // Section 1
  section.section-1
    .container
      .inner-wrap
        h1.inner-title(
          data-aos-duration="800" 
          data-aos="fade-up"
          )
          | Du lịch trong nước – Trọn vẹn Việt Nam
          br
          | Đi nơi đâu bạn muốn
        p.inner-desc(
          data-aos-delay="150" 
          data-aos-duration="800" 
          data-aos="fade-up"
          )
          | Hãy tận hưởng trải nghiệm du lịch chuyên nghiệp, mang lại cho bạn những khoảnh khắc tuyệt vời và nâng tầm cuộc sống. Chúng tôi cam kết mang đến những chuyến đi đáng nhớ, giúp bạn khám phá thế giới theo cách hoàn hảo nhất.
        form.inner-form(
          data-aos-delay="300"
          data-aos-duration="800"
          data-aos="fade-up"
          form-search
        )
          // Địa điểm (tìm trong tiêu đề tour)
          .inner-box.inner-address
            .inner-input-group
              img.inner-icon(src="/assets/images/icon-address.svg")
              input.inner-input(
                type="text"
                name="q"
                placeholder="Bạn muốn đi đâu?"
                autocomplete="off"
              )
          // Tổng số thành viên (thay cho NL/TE/EB)
          .inner-box.inner-user
            .inner-input-group
              img.inner-icon(src="/assets/images/icon-user.svg")
              // Cho phép nhập trực tiếp số lượng thành viên (không dropdown)
              input.inner-input(
                type="number"
                name="minSeats"
                min="1"
                placeholder="Số lượng thành viên"
              )
          // Ngày khởi hành
          .inner-box.inner-calendar
            .inner-input-group
              img.inner-icon(src="/assets/images/icon-calendar.svg")
              input.inner-input(
                type="date"
                name="departureDate"
                placeholder="Lịch khởi hành"
              )
          // Giá (khoảng)
          .inner-box.inner-price
            .inner-input-group(inner-price-trigger role="button" tabindex="0" aria-haspopup="listbox" aria-expanded="false")
              img.inner-icon(src="/assets/images/icon-cart.svg" alt="")
              input(type="hidden" name="price")
              span.inner-price-label -- Chọn khoảng giá --
              i.fa-solid.fa-angle-down.inner-down
            .inner-price-options(role="listbox")
              button.inner-price-option(type="button" data-value="" role="option") -- Chọn khoảng giá --
              button.inner-price-option(type="button" data-value="0-999999" role="option") Dưới 1 triệu
              button.inner-price-option(type="button" data-value="1000000-3000000" role="option") 1–3 triệu
              button.inner-price-option(type="button" data-value="3000000-6000000" role="option") 3–6 triệu
              button.inner-price-option(type="button" data-value="6000000-10000000" role="option") 6–10 triệu
              button.inner-price-option(type="button" data-value="10000000-1000000000" role="option") Trên 10 triệu
          button.inner-button(type="submit")
            i.fa-solid.fa-magnifying-glass
            |  Tìm Kiếm
  // End Section 1
  // Section 2 - chỉ hiển thị khi có tour khuyến mãi
  if tourListSection2 && tourListSection2.length
    .section-2(
      data-aos-duration="800" 
      data-aos="fade-up"
    )
      .container
        .inner-wrap
          .inner-info
            h2.inner-title
              | ƯU ĐÃI 2025
              br
              | TOUR GIỜ CHÓT
            .inner-desc Nhanh tay nắm bắt cơ hội giảm giá cuối cùng. Đặt ngay để không bỏ lỡ!

            // dòng nổi bật thêm
            .inner-highlight
              span
              |  Giảm giá cực sốc, lên tới 
              span.inner-highlight-number 30%
              br
              | Hãy nhanh tay vào đặt thôi!

          .inner-list
            .swiper.swiper-section-2
              .swiper-wrapper
                each item in tourListSection2
                  .swiper-slide
                    +product-item(item)

        // Nút Xem tất cả tour khuyến mãi
        .section-2-more
          a.btn-view-all(href="/tour/discount") Xem tất cả tour khuyến mãi
  // End Section 2
  // Section 3
  //- .section-3
  //-   .container
  //-     h2.box-title(
  //-       data-aos-duration="800" 
  //-       data-aos="fade-up"
  //-       ) Khuyến Mại Bùng Nổ - Đánh Tan Nóng Bức
  //-     .inner-wrap(
  //-       data-aos-delay="150" 
  //-       data-aos-duration="800" 
  //-       data-aos="fade-up"
  //-       )
  //-       .swiper.swiper-section-3
  //-         .swiper-wrapper
  //-           .swiper-slide
  //-             .inner-item
  //-               a(href="#")
  //-                 img(
  //-                   alt="" 
  //-                   src="/assets/images/banner-1.png"
  //-                   )
  //-           .swiper-slide
  //-             .inner-item
  //-               a(href="#")
  //-                 img(
  //-                   alt="" 
  //-                   src="/assets/images/banner-2.png"
  //-                   )
  //-           .swiper-slide
  //-             .inner-item
  //-               a(href="#")
  //-                 img(
  //-                   alt="" 
  //-                   src="/assets/images/banner-3.png"
  //-                   )
  //-           .swiper-slide
  //-             .inner-item
  //-               a(href="#")
  //-                 img(
  //-                   alt="" 
  //-                   src="/assets/images/banner-2.png"
  //-                   )
  //-           .swiper-slide
  //-             .inner-item
  //-               a(href="#")
  //-                 img(
  //-                   alt="" 
  //-                   src="/assets/images/banner-3.png"
  //-                   )
  //-         .swiper-pagination
  // End Section 3
  // Section 4 — mỗi danh mục cấu hình một block
  if sections4Blocks && sections4Blocks.length
    each block in sections4Blocks
      if block.category
        .section-4
          .container
            h2.box-title(
              data-aos-duration="800"
              data-aos="fade-up"
            ) #{block.category.name}
            if (block.tours && block.tours.length > 0)
              .inner-wrap(
                data-aos-delay="150"
                data-aos-duration="800"
                data-aos="fade-up"
              )
                each item in block.tours
                  +product-item(item)
            else
              div.no-data(
                data-aos-delay="150"
                data-aos-duration="800"
                data-aos="fade-up"
              ) Không có dữ liệu.
            .inner-button(
              data-aos-delay="300"
              data-aos-duration="800"
              data-aos="fade-up"
            )
              a.button-outline(href=`/category/${block.category.slug}`) Xem tất cả
  // End Section 4
  // Section Hotels
  if hotelListHome && hotelListHome.length > 0
    .section-hotels
      .container
        h2.box-title(
          data-aos-duration="800"
          data-aos="fade-up"
        ) Khách Sạn Nổi Bật
        .hotel-list(
          data-aos-delay="150"
          data-aos-duration="800"
          data-aos="fade-up"
        )
          each hotel in hotelListHome
            .hotel-card-search
              .hotel-card-search__image
                if hotel.thumbnail
                  img(src=hotel.thumbnail alt=hotel.name)
                else
                  img(src="/images/no-image.jpg" alt=hotel.name)
              .hotel-card-search__content
                h3.hotel-card-search__title= hotel.name
                if hotel.address
                  p.hotel-card-search__address
                    i.fa-solid.fa-location-dot
                    span= hotel.address
                if hotel.companyName
                  p.hotel-card-search__company
                    i.fa-solid.fa-building
                    span= hotel.companyName
                .hotel-card-search__rating-row
                  if hotel.rating
                    .hotel-card-search__rating
                      span.hotel-card-search__rating-score= hotel.rating
                      span.hotel-card-search__rating-text Rất tốt
                  if hotel.starRating > 0
                    .hotel-card-search__stars
                      - for (let i = 0; i < 5; i++)
                        i.fa-solid.fa-star(class=(i < hotel.starRating ? 'active' : ''))
                if hotel.shortDescription
                  p.hotel-card-search__description= hotel.shortDescription
                .hotel-card-search__info
                  if hotel.roomTypesCount > 0
                    .hotel-card-search__info-item
                      i.fa-solid.fa-door-open
                      span #{hotel.roomTypesCount} loại phòng
                  if hotel.totalRooms > 0
                    .hotel-card-search__info-item
                      i.fa-solid.fa-bed
                      span #{hotel.totalRooms} phòng
                  if hotel.vacantRooms > 0
                    .hotel-card-search__info-item.hotel-card-search__info-item--available
                      i.fa-solid.fa-check-circle
                      span Còn #{hotel.vacantRooms} phòng trống
                if hotel.tags && hotel.tags.length > 0
                  .hotel-card-search__amenities
                    each tag in hotel.tags
                      span.hotel-card-search__amenity-tag= tag
              .hotel-card-search__price
                - const priceStr = Number(hotel.pricePerNight || 0).toLocaleString('vi-VN')
                .hotel-card-search__price-value #{priceStr}
                .hotel-card-search__price-unit #{hotel.currency}
                .hotel-card-search__price-label mỗi đêm
                .hotel-card-search__actions
                  button.hotel-compare-btn(
                    type="button"
                    data-hotel-id=hotel.id
                    data-hotel-name=hotel.name
                    data-hotel-slug=hotel.id
                    data-hotel-avatar=(hotel.thumbnail || '')
                    data-hotel-price=hotel.pricePerNight
                    data-hotel-city=hotel.cityName
                    data-hotel-address=hotel.address
                    data-hotel-rating=hotel.rating
                    data-hotel-star=hotel.starRating
                    data-hotel-company=hotel.companyName
                    title="So sánh khách sạn"
                  )
                    i.fa-solid.fa-code-compare
                    span.compare-btn-text  So sánh
                  a.hotel-card-search__button(href=`/hotel/detail/${hotel.id}`) Xem chi tiết
        .section-hotels__more(
          data-aos-delay="300"
          data-aos-duration="800"
          data-aos="fade-up"
        )
          a.button-outline(href="/hotel/search") Xem tất cả khách sạn
  // End Section Hotels
  // Section 8
  .section-8
    .container
      h2.box-title(
        data-aos-duration="800" 
        data-aos="fade-up"
        ) Tin Tức Mới
      .inner-wrap(
        data-aos-delay="150" 
        data-aos-duration="800" 
        data-aos="fade-up"
        )
        if featuredNews
          .blog-item-2
            a(href=`/news/${featuredNews.slug}`)
              .inner-image
                if featuredNews.avatar
                  img(alt=featuredNews.title src=featuredNews.avatar)
                else
                  img(alt=featuredNews.title src="/assets/images/blog-2.jpg")
              .inner-content
                .inner-date= featuredNews.publishedAtFormat
                h3.inner-title= featuredNews.title
                if featuredNews.shortDescription
                  .inner-desc= featuredNews.shortDescription
        if regularNews && regularNews.length > 0
          each news in regularNews
            .blog-item-2
              a(href=`/news/${news.slug}`)
                .inner-image
                  if news.avatar
                    img(alt=news.title src=news.avatar)
                  else
                    img(alt=news.title src="/assets/images/blog-1.jpg")
                .inner-content
                  .inner-date= news.publishedAtFormat
                  h3.inner-title= news.title
                  if news.shortDescription
                    .inner-desc= news.shortDescription
  // End Section 8

  // Section 9 - Đối tác của chúng tôi
  if partnerCompanies && partnerCompanies.length
    .section-partners
      .container
        h2.box-title(
          data-aos-duration="800"
          data-aos="fade-up"
        ) Đối tác của chúng tôi
        .company-grid(
          data-aos-delay="150"
          data-aos-duration="800"
          data-aos="fade-up"
        )
          each c in partnerCompanies
            +company-card(c)
  // End Section 9

  // Section 10 - Thống kê nhanh
  if stats
    .section-10-stats
      .container
        .stats-grid
          .stat-item
            .stat-number #{stats.totalTours || 0}
            .stat-label Tour du lịch
          .stat-item
            .stat-number #{stats.totalHotels || 0}
            .stat-label Khách sạn
          .stat-item
            .stat-number #{stats.totalPartners || 0}
            .stat-label Đối tác
          .stat-item
            .stat-number #{stats.totalCustomers || 0}
            .stat-label Khách hàng
          .stat-item
            - const ratingOutOf10 = (stats.avgRating || 0) * 2
            - const formattedRating = typeof ratingOutOf10 === 'number' ? ratingOutOf10.toFixed(1) : ratingOutOf10
            .stat-number #{formattedRating}
            .stat-label Đánh giá trung bình
  // End Section 10