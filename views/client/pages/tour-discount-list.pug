extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug
include ../mixins/product.pug

block main
  // Breadcrumb: dùng biến breadcrumb truyền từ controller
  +box-breadcrumb(breadcrumb)

  .section-9
    .container
      .inner-wrap
        // ==== CỘT TRÁI: dùng lại box-filter giống tour-list ====
        .inner-left
          include ../partials/box-filter.pug

        // ==== CỘT PHẢI: danh sách tour ====
        .inner-right
          .inner-info
            h2.inner-title Tour đang khuyến mãi
            .inner-desc
              | Tổng hợp các tour đang trong thời gian giảm giá từ nhiều công ty lữ hành.

          .inner-info-2
            .inner-sort
              .inner-label Sắp xếp :
              a.inner-item(
                class=(sort === 'price_asc' ? 'active' : ''),
                href=sortHrefs.priceAsc
              )
                | Giá tăng dần
                i.fa-solid.fa-square-caret-up
              a.inner-item(
                class=(sort === 'price_desc' ? 'active' : ''),
                href=sortHrefs.priceDesc
              )
                | Giá giảm dần
                i.fa-solid.fa-square-caret-down
              a.inner-item(
                class=(sort === 'rating' ? 'active' : ''),
                href=sortHrefs.rating
              )
                | Đánh giá
                i.fa-solid.fa-tag

            .inner-total-item
              | Tất cả:
              b #{pagination.totalRecord} Tour

            button.inner-filter-mobile
              | Bộ Lọc
              i.fa-solid.fa-filter

          .inner-product-list
            if tourList && tourList.length
              each item in tourList
                +product-item(item)
            else
              div Không tìm thấy tour nào đang khuyến mãi.

          // ==== PHÂN TRANG (giống Section 7 bên tour-list) ====
          if pagination && pagination.totalPage > 1
            .section-7
              span.inner-label
                | Hiển thị #{pagination.skip + 1}
                | - #{pagination.skip + tourList.length}
                | của #{pagination.totalRecord}
              select(class="inner-pagination" box-pagination data-base="/tour/discount")
                - for (let i = 1; i <= pagination.totalPage; i++)
                  option(
                    value=i
                    selected=(i === pagination.page)
                  ) Trang #{i}
