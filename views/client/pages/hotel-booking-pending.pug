//- views/client/pages/hotel-booking-pending.pug
extends ../layouts/default.pug

block main
  .hotel-booking-pending-page
    .container
      .pending-content
        .pending-icon
          i.fa-solid.fa-clock
        h1.pending-title Đơn đặt phòng tạm thời
        p.pending-message Đơn của bạn đang được giữ chỗ. Vui lòng thanh toán trong thời gian quy định.
        
        //- Hiển thị countdown timer
        if bookingDetail && bookingDetail.isTemporaryHold && bookingDetail.paymentStatus === 'unpaid' && bookingDetail.holdExpiresAt
          .hold-warning
            .warning-icon
              i.fa-solid.fa-hourglass-half
            .warning-content
              p.warning-title ⏰ Thời gian giữ chỗ
              p.warning-message Vui lòng thanh toán trong vòng:
              .countdown-timer#countdownTimer
                span.countdown-minutes 00
                span.countdown-separator :
                span.countdown-seconds 00
              p.warning-note Đơn sẽ tự động hủy và phòng được trả lại nếu không thanh toán đúng hạn.

        if bookingDetail
          .booking-info
            .info-card
              h3.info-title Thông tin đặt phòng
              .info-row
                span.info-label Mã đặt phòng:
                strong.info-value= bookingDetail.code
              .info-row
                span.info-label Khách sạn:
                strong.info-value= bookingDetail.hotel.name
              .info-row
                span.info-label Địa chỉ:
                span.info-value= bookingDetail.hotel.address || 'N/A'
              .info-row
                span.info-label Ngày nhận phòng:
                strong.info-value= bookingDetail.checkIn
              .info-row
                span.info-label Ngày trả phòng:
                strong.info-value= bookingDetail.checkOut
              .info-row
                span.info-label Trạng thái thanh toán:
                strong.info-value.status-unpaid Chưa thanh toán

            if bookingDetail.roomItems && bookingDetail.roomItems.length > 0
              .info-card
                h3.info-title Các phòng đã chọn
                .pending-room-list
                  each item, idx in bookingDetail.roomItems
                    .pending-room-item
                      .pending-room-item__image
                        img(src=item.roomTypeImage, alt=item.roomTypeName)
                      .pending-room-item__body
                        .pending-room-item__header
                          h4.pending-room-item__title= item.roomTypeName
                          span.pending-room-item__badge #{item.quantity} phòng × #{item.nights} đêm
                        .pending-room-item__meta
                          span
                            i.fa-regular.fa-user
                            |  #{item.adultsCount} người lớn
                            if item.childrenCount > 0
                              | , #{item.childrenCount} trẻ em
                            if item.babiesCount > 0
                              | , #{item.babiesCount} em bé
                          span.pending-room-item__price
                            | #{Number(item.pricePerNight).toLocaleString('vi-VN')} #{bookingDetail.currency} / đêm
                        if item.roomsDetails && item.roomsDetails.length > 0
                          ul.pending-room-item__rooms
                            each rd, rIdx in item.roomsDetails
                              li
                                strong Phòng #{rIdx + 1}: 
                                if rd.adultCount > 0
                                  span #{rd.adultCount} người lớn
                                  if rd.adults && rd.adults.length
                                    |  (
                                    each a, ai in rd.adults
                                      if ai > 0
                                        | , 
                                      |#{a.age} tuổi
                                    | )
                                if rd.childCount > 0
                                  | , #{rd.childCount} trẻ em
                                  if rd.children && rd.children.length
                                    |  (
                                    each c, ci in rd.children
                                      if ci > 0
                                        | , 
                                      |#{c.age} tuổi
                                    | )
                                if rd.babyCount > 0
                                  | , #{rd.babyCount} em bé
                                  if rd.babies && rd.babies.length
                                    |  (
                                    each b, bi in rd.babies
                                      if bi > 0
                                        | , 
                                      |#{b.age} tuổi
                                    | )
                        if item.services && item.services.length > 0
                          .pending-room-item__services
                            .pending-room-item__services-title Dịch vụ thêm:
                            ul
                              each svc in item.services
                                li
                                  span.svc-name= svc.name
                                  if svc.detail
                                    span.svc-detail  · #{svc.detail}
                                  span.svc-price  — #{Number(svc.price).toLocaleString('vi-VN')} #{bookingDetail.currency}
                        .pending-room-item__subtotal
                          span.pending-room-item__subtotal-base
                            | Phòng: #{Number(item.roomBaseSubtotal).toLocaleString('vi-VN')} #{bookingDetail.currency}
                          if item.services && item.services.length > 0
                            span.pending-room-item__subtotal-sep  + 
                            span.pending-room-item__subtotal-svc
                              | Dịch vụ: #{Number(item.subtotal - item.roomBaseSubtotal).toLocaleString('vi-VN')} #{bookingDetail.currency}
                          .pending-room-item__subtotal-total
                            | Thành tiền: 
                            strong #{Number(item.subtotal).toLocaleString('vi-VN')} #{bookingDetail.currency}

                if bookingDetail.globalServices && bookingDetail.globalServices.length > 0
                  .pending-global-services
                    h4.pending-global-services__title Dịch vụ chung
                    ul
                      each svc in bookingDetail.globalServices
                        li
                          span= svc.name
                          span.svc-price  — #{Number(svc.price).toLocaleString('vi-VN')} #{bookingDetail.currency}

            if bookingDetail.priceSummary
              - const ps = bookingDetail.priceSummary
              .info-card
                h3.info-title Chi tiết thanh toán
                .pending-price-summary
                  .pending-price-row
                    span Thuế VAT (#{ps.taxPercent}%):
                    strong= Number(ps.tax).toLocaleString('vi-VN') + ' ' + bookingDetail.currency
                  .pending-price-row
                    span Phí dịch vụ (#{ps.feePercent}%):
                    strong= Number(ps.fee).toLocaleString('vi-VN') + ' ' + bookingDetail.currency
                  .pending-price-row.pending-price-row--total
                    span Tổng cộng:
                    strong.total-amount= Number(ps.orderTotal).toLocaleString('vi-VN') + ' ' + bookingDetail.currency

            if bookingDetail.guest
              .info-card
                h3.info-title Thông tin khách hàng
                .info-row
                  span.info-label Họ tên:
                  span.info-value= bookingDetail.guest.fullName
                .info-row
                  span.info-label Số điện thoại:
                  span.info-value= bookingDetail.guest.phone
                if bookingDetail.guest.email
                  .info-row
                    span.info-label Email:
                    span.info-value= bookingDetail.guest.email

        .pending-actions
          //- Hiển thị nút thanh toán nếu chưa thanh toán
          if bookingDetail && bookingDetail.paymentStatus === 'unpaid'
            if bookingDetail.paymentMethod === 'vnpay'
              .payment-info.payment-info--highlight
                p
                  i.fa-solid.fa-circle-info
                  |  Bạn đã chọn thanh toán qua VNPay. Vui lòng bấm nút bên dưới để hoàn tất.
              a.btn-payment.btn-vnpay(href=`/hotel-booking/payment-vnpay?bookingCode=${bookingDetail.code}&phone=${bookingDetail.phone}`)
                i.fa-solid.fa-credit-card
                |  Thanh toán ngay qua VNPay
            else if bookingDetail.paymentMethod === 'bank'
              .payment-info
                p
                  i.fa-solid.fa-building-columns
                  strong  Chuyển khoản ngân hàng
                .bank-details
                  .bank-details-row
                    span.bank-label Ngân hàng:
                    span.bank-value Vietcombank
                  .bank-details-row
                    span.bank-label Tên tài khoản:
                    span.bank-value Le Van A
                  .bank-details-row
                    span.bank-label Số tài khoản:
                    span.bank-value 0123456789
                p.bank-note Sau khi chuyển khoản, vui lòng gửi ảnh chứng từ bên dưới để chúng tôi xác nhận nhanh hơn.
              .transfer-proof-section
                h4.proof-title
                  i.fa-solid.fa-image
                  |  Ảnh chứng từ chuyển khoản
                if bookingDetail.transferProofImages && bookingDetail.transferProofImages.length
                  .proof-gallery
                    each img in bookingDetail.transferProofImages
                      a.proof-gallery-item(href=img target="_blank" title="Xem ảnh gốc")
                        img(src=img alt="Chứng từ")
                  p.proof-sent ✅ Đã gửi #{bookingDetail.transferProofImages.length} ảnh chứng từ. Bạn có thể gửi thêm nếu cần.
                else
                  p.proof-empty Chưa có ảnh chứng từ nào.
                .upload-area
                  input#transferProofInput(type="file" accept="image/*" multiple style="display:none")
                  label.btn-upload-label(for="transferProofInput")
                    i.fa-solid.fa-upload
                    |  Chọn ảnh
                  .upload-preview#uploadPreview
                  p#uploadStatus.upload-status
                  button#btnSubmitProof.btn-submit-proof(type="button" disabled)
                    i.fa-solid.fa-paper-plane
                    |  Gửi ảnh chứng từ
            else if bookingDetail.paymentMethod === 'money'
              .payment-info
                p
                  i.fa-solid.fa-money-bill-wave
                  strong  Tiền mặt khi nhận phòng
                p Vui lòng đến khách sạn đúng giờ để nhận phòng và thanh toán.
          
          a.btn-primary(href="/hotel/search") Tìm kiếm khách sạn khác
          a.btn-secondary(href="/") Về trang chủ
          if bookingDetail && bookingDetail.isTemporaryHold && bookingDetail.paymentStatus === 'unpaid'
            button#btnCancelHold.btn-cancel-hold(type="button")
              i.fa-solid.fa-xmark
              |  Hủy đặt phòng & trả lại phòng

            //- Modal xác nhận hủy (thay cho confirm trình duyệt)
            #cancelHoldModal.cancel-hold-modal(aria-hidden="true")
              button.cancel-hold-modal__overlay(type="button" tabindex="-1" aria-label="Đóng")
              .cancel-hold-modal__dialog(role="dialog" aria-modal="true" aria-labelledby="cancelHoldModalTitle")
                h3#cancelHoldModalTitle Xác nhận hủy đặt phòng
                p.cancel-hold-modal__lead
                  | Bạn chắc chắn muốn hủy đặt phòng và trả lại các phòng đã giữ?
                .cancel-hold-modal__actions
                  button#cancelHoldModalDismiss.cancel-hold-modal__btn.cancel-hold-modal__btn--muted(type="button") Không, giữ đơn
                  button#cancelHoldModalConfirm.cancel-hold-modal__btn.cancel-hold-modal__btn--danger(type="button") Xác nhận hủy đơn

  //- sendBeacon: hủy khi user rời trang (trừ khi đang thanh toán hoặc refresh)
  if bookingDetail && bookingDetail.isTemporaryHold && bookingDetail.paymentStatus === 'unpaid'
    script.
      (function () {
        var bookingCode   = "!{bookingDetail.code}";
        var phone         = "!{bookingDetail.phone}";
        var goingToPayment = false;

        // Đánh dấu khi user click nút thanh toán → KHÔNG hủy
        var payBtn = document.querySelector('.btn-payment, .btn-vnpay');
        if (payBtn) {
          payBtn.addEventListener('click', function () { goingToPayment = true; });
        }

        // Nút "Hủy đặt phòng" → modal xác nhận → gọi API explicit rồi về trang chủ
        var cancelBtn = document.getElementById('btnCancelHold');
        var cancelModal = document.getElementById('cancelHoldModal');
        var cancelModalDismiss = document.getElementById('cancelHoldModalDismiss');
        var cancelModalConfirm = document.getElementById('cancelHoldModalConfirm');
        var cancelModalOverlay = cancelModal ? cancelModal.querySelector('.cancel-hold-modal__overlay') : null;

        function openCancelHoldModal() {
          if (!cancelModal) return;
          cancelModal.classList.add('is-open');
          cancelModal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          if (cancelModalConfirm) cancelModalConfirm.focus();
        }
        function closeCancelHoldModal() {
          if (!cancelModal) return;
          cancelModal.classList.remove('is-open');
          cancelModal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        function runCancelHoldRequest() {
          goingToPayment = true; // tắt beacon tránh gọi 2 lần
          if (cancelBtn) {
            cancelBtn.disabled = true;
            cancelBtn.textContent = 'Đang hủy...';
          }
          fetch('/hotel-booking/cancel-hold?bookingCode=' + encodeURIComponent(bookingCode) +
                '&phone=' + encodeURIComponent(phone), {
                  headers: { 'X-Cancel-Reason': 'explicit' }
                })
            .finally(function () { window.location.href = '/'; });
        }

        if (cancelBtn && cancelModal) {
          cancelBtn.addEventListener('click', function (e) {
            e.preventDefault();
            openCancelHoldModal();
          });
        }
        if (cancelModalDismiss) {
          cancelModalDismiss.addEventListener('click', function () { closeCancelHoldModal(); });
        }
        if (cancelModalOverlay) {
          cancelModalOverlay.addEventListener('click', function () { closeCancelHoldModal(); });
        }
        if (cancelModalConfirm) {
          cancelModalConfirm.addEventListener('click', function () {
            closeCancelHoldModal();
            runCancelHoldRequest();
          });
        }
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && cancelModal && cancelModal.classList.contains('is-open')) {
            closeCancelHoldModal();
          }
        });

        // pagehide: gửi beacon khi đóng tab / điều hướng ra ngoài
        // Server chỉ cancel nếu đơn đã hết hạn (tránh hủy khi F5 hoặc mở tab mới)
        window.addEventListener('pagehide', function (e) {
          if (e.persisted)    return; // BFCache – user có thể quay lại
          if (goingToPayment) return; // đang sang VNPay – giữ đơn

          var body = 'bookingCode=' + encodeURIComponent(bookingCode) +
                     '&phone='      + encodeURIComponent(phone);
          navigator.sendBeacon('/hotel-booking/cancel-hold', body);
        });
      })();

  //- Polling: kiểm tra trạng thái thanh toán mỗi 5 giây
  //- Khi admin đổi paymentStatus → "paid", tự động chuyển sang trang thành công
  if bookingDetail && bookingDetail.paymentStatus === 'unpaid'
    script.
      (function () {
        var bookingCode = "!{bookingDetail.code}";
        var phone       = "!{bookingDetail.phone}";
        var INTERVAL    = 5000;
        var timer       = setInterval(function () {
          fetch(
            '/hotel-booking/check-payment-status' +
            '?bookingCode=' + encodeURIComponent(bookingCode) +
            '&phone='       + encodeURIComponent(phone)
          )
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data.code === 'ok' && data.paymentStatus === 'paid') {
                clearInterval(timer);
                window.location.href =
                  '/hotel-booking/success' +
                  '?bookingCode=' + encodeURIComponent(bookingCode) +
                  '&phone='       + encodeURIComponent(phone);
              }
            })
            .catch(function () {});
        }, INTERVAL);

        window.addEventListener('beforeunload', function () {
          clearInterval(timer);
        });
      })();

  //- JavaScript countdown timer
  if bookingDetail && bookingDetail.isTemporaryHold && bookingDetail.paymentStatus === 'unpaid' && bookingDetail.holdExpiresAt
    script.
      (function () {
        var holdExpiresAt = new Date("!{bookingDetail.holdExpiresAt}");
        var bookingCode   = "!{bookingDetail.code}";
        var phone         = "!{bookingDetail.phone}";
        var countdownEl   = document.getElementById('countdownTimer');
        if (!countdownEl) return;

        var minutesEl = countdownEl.querySelector('.countdown-minutes');
        var secondsEl = countdownEl.querySelector('.countdown-seconds');

        function updateCountdown() {
          var now  = new Date();
          var diff = holdExpiresAt - now;

          if (diff <= 0) {
            minutesEl.textContent = '00';
            secondsEl.textContent = '00';
            clearInterval(interval);

            // Gọi API hủy (GET = explicit), rồi thông báo và về trang tìm kiếm
            fetch('/hotel-booking/cancel-hold?bookingCode=' + bookingCode + '&phone=' + phone)
              .catch(function () {})
              .finally(function () {
                alert('⏰ Đơn đặt phòng đã hết hạn! Phòng đã được trả lại. Vui lòng đặt lại.');
                window.location.href = '/hotel/search';
              });
            return;
          }

          var totalSeconds = Math.floor(diff / 1000);
          var minutes = Math.floor(totalSeconds / 60);
          var seconds = totalSeconds % 60;

          minutesEl.textContent = String(minutes).padStart(2, '0');
          secondsEl.textContent = String(seconds).padStart(2, '0');
        }

        updateCountdown();
        var interval = setInterval(updateCountdown, 1000);

        window.addEventListener('beforeunload', function () {
          clearInterval(interval);
        });
      })();

  //- Upload ảnh chứng từ chuyển khoản
  if bookingDetail && bookingDetail.paymentMethod === 'bank' && bookingDetail.paymentStatus === 'unpaid'
    script.
      (function () {
        var bookingCode = "!{bookingDetail.code}";
        var phone       = "!{bookingDetail.phone}";
        var inputEl     = document.getElementById('transferProofInput');
        var previewEl   = document.getElementById('uploadPreview');
        var submitBtn   = document.getElementById('btnSubmitProof');
        var statusEl    = document.getElementById('uploadStatus');
        if (!inputEl) return;

        var selectedFiles = [];

        inputEl.addEventListener('change', function () {
          selectedFiles = Array.from(this.files);
          previewEl.innerHTML = '';
          selectedFiles.forEach(function (file) {
            var reader = new FileReader();
            reader.onload = function (e) {
              var img = document.createElement('img');
              img.src = e.target.result;
              img.className = 'upload-preview-img';
              previewEl.appendChild(img);
            };
            reader.readAsDataURL(file);
          });
          submitBtn.disabled = selectedFiles.length === 0;
          statusEl.textContent = '';
        });

        submitBtn.addEventListener('click', function () {
          if (selectedFiles.length === 0) return;
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang gửi...';
          statusEl.textContent = '';

          var formData = new FormData();
          selectedFiles.forEach(function (file) {
            formData.append('files', file);
          });

          fetch('/upload/images', { method: 'POST', body: formData })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (!data.success || !data.urls || data.urls.length === 0) {
                throw new Error('Upload ảnh thất bại');
              }
              return fetch('/hotel-booking/transfer-proof', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ bookingCode: bookingCode, phone: phone, images: data.urls }),
              });
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data.code === 'ok') {
                statusEl.textContent = '✅ Gửi ảnh thành công!';
                statusEl.style.color = '#16a34a';
                setTimeout(function () { window.location.reload(); }, 1200);
              } else {
                throw new Error(data.message || 'Lỗi không xác định');
              }
            })
            .catch(function (err) {
              statusEl.textContent = '❌ ' + err.message;
              statusEl.style.color = '#dc2626';
              submitBtn.disabled = false;
              submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Gửi ảnh chứng từ';
            });
        });
      })();

  style.
    /* Khối các phòng đã chọn */
    .pending-room-list { display: flex; flex-direction: column; gap: 14px; }
    .pending-room-item { display: flex; gap: 14px; padding: 14px; border: 1px solid #e5e7eb; border-radius: 12px; background: #fafafa; }
    .pending-room-item__image { flex: 0 0 120px; }
    .pending-room-item__image img { width: 120px; height: 90px; object-fit: cover; border-radius: 8px; border: 1px solid #e5e7eb; }
    .pending-room-item__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
    .pending-room-item__header { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
    .pending-room-item__title { margin: 0; font-size: 16px; font-weight: 700; color: #1e293b; }
    .pending-room-item__badge { font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: #e0f2fe; color: #0369a1; white-space: nowrap; }
    .pending-room-item__meta { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 13px; color: #475569; }
    .pending-room-item__meta i { margin-right: 4px; }
    .pending-room-item__price { color: #2d3e90; font-weight: 600; }
    .pending-room-item__rooms { list-style: none; padding: 8px 12px; margin: 0; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 13px; color: #334155; }
    .pending-room-item__rooms li { padding: 3px 0; }
    .pending-room-item__rooms li + li { border-top: 1px dashed #e5e7eb; }
    .pending-room-item__services { padding: 8px 12px; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 8px; font-size: 13px; color: #9a3412; }
    .pending-room-item__services-title { font-weight: 600; margin-bottom: 4px; }
    .pending-room-item__services ul { list-style: none; padding: 0; margin: 0; }
    .pending-room-item__services li { padding: 2px 0; }
    .pending-room-item__services .svc-price { color: #c2410c; font-weight: 600; }
    .pending-room-item__subtotal { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; justify-content: flex-end; font-size: 13px; color: #475569; border-top: 1px solid #e5e7eb; padding-top: 8px; margin-top: 4px; }
    .pending-room-item__subtotal-total { width: 100%; text-align: right; font-size: 14px; color: #334155; }
    .pending-room-item__subtotal-total strong { color: #dc2626; font-size: 16px; margin-left: 4px; }
    .pending-room-item__subtotal-sep { color: #94a3b8; }
    .pending-global-services { margin-top: 14px; padding: 12px 14px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 10px; }
    .pending-global-services__title { margin: 0 0 8px; font-size: 14px; font-weight: 700; color: #0369a1; }
    .pending-global-services ul { list-style: none; padding: 0; margin: 0; font-size: 13px; color: #1e3a5f; }
    .pending-global-services li { padding: 3px 0; display: flex; justify-content: space-between; }
    .pending-global-services .svc-price { font-weight: 600; color: #0c4a6e; }
    .pending-price-summary { display: flex; flex-direction: column; gap: 8px; }
    .pending-price-row { display: flex; justify-content: space-between; align-items: center; font-size: 14px; color: #475569; padding: 6px 0; border-bottom: 1px dashed #e5e7eb; }
    .pending-price-row:last-child { border-bottom: none; }
    .pending-price-row strong { color: #1e293b; font-weight: 600; }
    .pending-price-row--extra strong { color: #b45309; }
    .pending-price-row--total { margin-top: 6px; padding-top: 12px; border-top: 2px solid #e5e7eb; border-bottom: none; font-size: 16px; font-weight: 700; color: #1e293b; }
    .pending-price-row--total .total-amount { color: #dc2626; font-size: 18px; }
    @media (max-width: 640px) {
      .pending-room-item { flex-direction: column; }
      .pending-room-item__image, .pending-room-item__image img { width: 100%; height: 180px; }
    }
    .bank-details { background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 10px; padding: 14px 18px; margin: 12px 0; }
    .bank-details-row { display: flex; gap: 8px; margin-bottom: 6px; font-size: 14px; }
    .bank-details-row:last-child { margin-bottom: 0; }
    .bank-label { font-weight: 600; color: #0369a1; min-width: 130px; }
    .bank-value { color: #1e3a5f; font-weight: 500; }
    .bank-note { font-size: 13px; color: #64748b; margin-top: 10px; }
    .transfer-proof-section { margin-top: 18px; padding: 16px; background: #fafafa; border: 1px dashed #d1d5db; border-radius: 10px; }
    .proof-title { font-size: 15px; font-weight: 600; color: #374151; margin: 0 0 12px; display: flex; align-items: center; gap: 6px; }
    .proof-gallery { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 10px; }
    .proof-gallery-item img { width: 100px; height: 100px; object-fit: cover; border-radius: 8px; border: 1px solid #e5e7eb; }
    .proof-sent { font-size: 13px; color: #16a34a; margin-bottom: 10px; }
    .proof-empty { font-size: 13px; color: #9ca3af; margin-bottom: 10px; }
    .upload-area { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
    .btn-upload-label { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #e0f2fe; color: #0369a1; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 600; border: 1px solid #bae6fd; transition: background .15s; }
    .btn-upload-label:hover { background: #bae6fd; }
    .upload-preview { display: flex; flex-wrap: wrap; gap: 8px; }
    .upload-preview-img { width: 72px; height: 72px; object-fit: cover; border-radius: 6px; border: 1px solid #e5e7eb; }
    .upload-status { font-size: 13px; font-weight: 600; margin: 0; width: 100%; }
    .btn-submit-proof { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; background: #2563eb; color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: background .15s; }
    .btn-submit-proof:hover:not(:disabled) { background: #1d4ed8; }
    .btn-submit-proof:disabled { background: #93c5fd; cursor: not-allowed; }
