//- views/admin/partials/hotel-selector.pug
//- Ưu tiên dùng hotelListForSelector (toàn bộ hotels), fallback về hotelList (có thể đã filter)
- const hotelListData = (typeof hotelListForSelector !== 'undefined' && hotelListForSelector) || (typeof hotelList !== 'undefined' ? hotelList : [])
- const selectedHotelIdValue = typeof selectedHotelId !== 'undefined' ? selectedHotelId : ''
.hotel-selector-bar(style="display: flex;")
  .search-box
    i.fa-solid.fa-magnifying-glass
    input(type="text" placeholder="Tìm kiếm đặt phòng, khách hàng, phòng..." id="hotelGlobalSearch")
  .hotel-dropdown-wrapper
    select.hotel-dropdown(id="hotelSelector" onchange="handleHotelChange(this)")
      if hotelListData && hotelListData.length > 0
        each hotel in hotelListData
          option(value=hotel._id selected=(String(hotel._id) === String(selectedHotelIdValue)))= hotel.name

script.
  function handleHotelChange(select) {
    const selectedHotelId = select.value;
    console.log('[Hotel Change] Selected:', selectedHotelId);
    
    // Lưu vào localStorage
    localStorage.setItem('selectedHotelId', selectedHotelId);
    
    const currentPath = window.location.pathname;
    console.log('[Hotel Change] Current path:', currentPath);
    
    // Tạo URL mới với hotelId
    const urlParams = new URLSearchParams(window.location.search);
    urlParams.set('hotelId', selectedHotelId);
    const newUrl = window.location.pathname + '?' + urlParams.toString();
    
    console.log('[Hotel Change] Redirecting to:', newUrl);
    window.location.href = newUrl;
  }

