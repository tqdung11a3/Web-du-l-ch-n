.sider-overlay
nav.sider.super-admin-sider
  //- 1. Dashboard
  .sider-group-title Dashboard
  ul.inner-menu
    li
      a(href=`/${pathAdmin}/super-admin/dashboard`) <i class="fa-solid fa-crown"></i> Tổng quan hệ thống
    li
      a(href=`/${pathAdmin}/super-admin/finance`) <i class="fa-solid fa-chart-line"></i> Báo cáo tài chính

  //- 2. Công ty & Admin
  .sider-group-title Công ty
  ul.inner-menu
    li
      a(href=`/${pathAdmin}/super-admin/company`) <i class="fa-solid fa-building"></i> Quản lý công ty
    li
      a(href=`/${pathAdmin}/super-admin/admin`)
        <i class="fa-solid fa-user-shield"></i> Quản lý Admin
        if locals.pendingAdminCount && locals.pendingAdminCount > 0
          span.badge.badge-orange(style="margin-left: 8px;")= pendingAdminCount
    li
      a(href=`/${pathAdmin}/super-admin/customers`) <i class="fa-solid fa-users"></i> Quản lý Khách hàng

  //- 3. Nội dung (catalog cross-company)
  .sider-group-title Nội dung
  ul.inner-menu
    li
      a(href=`/${pathAdmin}/super-admin/category`) <i class="fa-solid fa-table-cells-large"></i> Quản lý danh mục
    li
      a(href=`/${pathAdmin}/super-admin/news`) <i class="fa-solid fa-newspaper"></i> Quản lý tin tức
    li
      a(href=`/${pathAdmin}/super-admin/tours`) <i class="fa-solid fa-plane"></i> Xem tất cả Tours
    li
      a(href=`/${pathAdmin}/super-admin/hotels`) <i class="fa-solid fa-hotel"></i> Xem tất cả Hotels
    li
      a(href=`/${pathAdmin}/super-admin/orders`) <i class="fa-solid fa-shopping-cart"></i> Đơn hàng theo công ty

  //- 4. Giám sát (moderation + cross-company ops)
  .sider-group-title Giám sát
  ul.inner-menu
    //- Tạm ẩn tab Liên hệ khách hàng
    //- li
    //-   a(href=`/${pathAdmin}/super-admin/contacts`) <i class="fa-solid fa-envelope"></i> Liên hệ khách hàng
    li
      a(href=`/${pathAdmin}/super-admin/reviews`) <i class="fa-solid fa-star"></i> Kiểm duyệt đánh giá
    //- Tạm ẩn tab Thông báo hệ thống
    //- li
    //-   a(href=`/${pathAdmin}/super-admin/notifications`) <i class="fa-solid fa-bell"></i> Thông báo hệ thống
    li
      a(href=`/${pathAdmin}/super-admin/hotel-link-requests`) <i class="fa-solid fa-link"></i> Liên kết Tour-Hotel
    li
      a(href=`/${pathAdmin}/super-admin/audit`) <i class="fa-solid fa-clipboard-list"></i> Nhật ký thao tác

  //- 5. Hệ thống
  .sider-group-title Hệ thống
  ul.inner-menu
    li
      a(href=`/${pathAdmin}/super-admin/setting/website-info`) <i class="fa-solid fa-gear"></i> Thông tin website

  hr
  ul.inner-menu
    li
      a(href=`/${pathAdmin}/super-admin/profile/edit`) <i class="fa-solid fa-user-gear"></i> Thông tin cá nhân
    li
      a(href="javascript:;" class="inner-logout") <i class="fa-solid fa-power-off"></i> Đăng xuất
