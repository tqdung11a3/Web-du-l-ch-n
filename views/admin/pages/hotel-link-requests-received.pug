extends ../layouts/default.pug

block main
  - var lf = lrFilter || {}
  - var _lrReceivedBase = `/${pathAdmin}/hotel/link-requests`
  - var _hotelsR = Array.isArray(allHotelsForFilter) ? allHotelsForFilter : []
  - var _hSelR = (lf.hotelId && String(lf.hotelId)) || (typeof selectedHotelId !== 'undefined' && selectedHotelId ? String(selectedHotelId) : '')
  .link-requests-page
    h1.box-title Yêu cầu liên kết khách sạn
    p.lr-subtitle Các công ty khác đang yêu cầu giữ phòng tại khách sạn của bạn để phục vụ tour du lịch.

    form.lr-filter-form(method="GET" action=_lrReceivedBase)
      .lr-filter-bar
        .lr-filter-field.lr-filter-field--grow
          label(for="lr-q-received") Tìm kiếm
          input#lr-q-received(type="search" name="q" value=lf.q placeholder="Tour, khách sạn, công ty gửi, ghi chú…")
        .lr-filter-field
          label(for="lr-hotel-received") Khách sạn
          select#lr-hotel-received(name="hotelId")
            option(value="" selected=!_hSelR) Tất cả khách sạn
            each h in _hotelsR
              option(value=h._id selected=(_hSelR === String(h._id)))= h.name
        .lr-filter-field
          label(for="lr-status-received") Trạng thái
          select#lr-status-received(name="status")
            option(value="" selected=(lf.status === "" || !lf.status)) Tất cả
            option(value="pending" selected=(lf.status === "pending")) Chờ duyệt
            option(value="approved" selected=(lf.status === "approved")) Đã duyệt
            option(value="rejected" selected=(lf.status === "rejected")) Từ chối
        .lr-filter-field
          label(for="lr-dep-from-r") Khởi hành từ
          input#lr-dep-from-r(type="date" name="departureFrom" value=lf.departureFrom)
        .lr-filter-field
          label(for="lr-dep-to-r") Khởi hành đến
          input#lr-dep-to-r(type="date" name="departureTo" value=lf.departureTo)
        .lr-filter-actions
          button.lr-filter-btn.lr-filter-btn--primary(type="submit")
            i.fa-solid.fa-filter
            |  Lọc
          a.lr-filter-btn.lr-filter-btn--ghost(href=_lrReceivedBase)
            i.fa-solid.fa-rotate-left
            |  Xóa lọc

    if receivedRequests && receivedRequests.length > 0
      each req in receivedRequests
        - var _autoTagBadgeR = hotelLinkAutoBySenderTag || ''
        - var _isAutoClosedR = req.status === 'rejected' && _autoTagBadgeR && (req.responseNote || '').indexOf(_autoTagBadgeR) === 0
        .lr-card(class=(_isAutoClosedR ? 'lr-card--auto-closed' : `lr-card--${req.status}`))
          .lr-card-header
            .lr-card-info
              h3.lr-card-title= req.tourName
              .lr-card-meta
                span.lr-meta-item.lr-meta-item--tour
                  i.fa-solid.fa-calendar-day
                  |  Lịch tour: #{req.departureDateDisplay} → #{req.endDateDisplay}
                if req.hotelStayFrames && req.hotelStayFrames.length > 0
                  each frame, fi in req.hotelStayFrames
                    span.lr-meta-item.lr-meta-item--hotel-stay
                      i.fa-solid.fa-bed
                      if req.hotelStayFrames.length > 1
                        |  Khung #{fi + 1} (KS): #{frame.fromDateDisplay} → #{frame.toDateDisplay}
                      else
                        |  Lưu trú KS: #{frame.fromDateDisplay} → #{frame.toDateDisplay}
                span.lr-meta-item
                  i.fa-solid.fa-building
                  |  Từ công ty: #{req.fromCompanyName}
                span.lr-meta-item
                  i.fa-solid.fa-hotel
                  |  Khách sạn: #{req.hotelName}
                span.lr-meta-item
                  i.fa-solid.fa-clock
                  |  #{req.createdAtDisplay}
            .lr-card-status
              if req.status === 'pending'
                span.lr-badge.lr-badge--pending Chờ duyệt
              else if req.status === 'approved'
                span.lr-badge.lr-badge--approved Đã duyệt
              else if req.status === 'partially_approved'
                span.lr-badge.lr-badge--partial Duyệt một phần
              else if _isAutoClosedR
                span.lr-badge.lr-badge--auto-closed(title="Hệ thống đóng do bên gửi cấu hình lại — bạn không phải từ chối yêu cầu này") Đóng tự động
              else
                span.lr-badge.lr-badge--rejected Từ chối

          .lr-card-body
            h4 Phòng được yêu cầu (#{req.totalRequestedRooms} phòng)
            table.lr-table
              thead
                tr
                  th Loại phòng
                  th Số phòng yêu cầu
                  th Sức chứa
                  th Khung KS
                  th Check-in
                  th Check-out
                  th(
                    title="Số phòng trống ước tính trong khoảng ngày yêu cầu (theo đặt phòng hiện tại và phòng trạng thái trống)"
                  ) Trống (khoảng yêu cầu)
                  if req.status !== 'pending'
                    th Đã duyệt
              tbody
                each rr in req.requestedRooms
                  tr
                    td= rr.roomTypeName
                    td= rr.assignedRooms
                    td= rr.baseOccupancy + ' người/phòng'
                    td= rr.stayFrameIndex ? ('Khung ' + rr.stayFrameIndex) : '—'
                    td= rr.fromDateDisplay
                    td= rr.toDateDisplay
                    td= rr.availableFreeRooms != null ? rr.availableFreeRooms : '—'
                    if req.status !== 'pending'
                      - const approved = (req.approvedRooms || []).find(a => String(a.roomTypeId) === String(rr.roomTypeId))
                      td= approved ? approved.approvedRooms : 0

            if req.note
              .lr-note
                strong Ghi chú từ công ty gửi:
                |  #{req.note}

            //- Khối reviewer info (duyệt / từ chối)
            if req.status !== 'pending' && req.status !== 'cancelled' && req.reviewerName && !_isAutoClosedR
              .lr-reviewer-info
                i.fa-solid.fa-user-check
                if req.status === 'rejected'
                  |  Từ chối bởi: 
                else
                  |  Duyệt bởi: 
                strong= req.reviewerName
                if req.reviewedAtDisplay
                  span.lr-reviewer-time  — #{req.reviewedAtDisplay}

            if req.responseNote
              - var _autoTagR = hotelLinkAutoBySenderTag || ''
              - var _isAutoSenderNote = _autoTagR && req.responseNote.indexOf(_autoTagR) === 0
              - var _legacyGeneric = !_isAutoSenderNote && /Đã huỷ do (company admin huỷ cấu hình|xác nhận lại segment)/.test(req.responseNote)
              - var _noteBodyR = _isAutoSenderNote ? req.responseNote.slice(_autoTagR.length) : req.responseNote
              .lr-note.lr-note--response
                if _isAutoSenderNote
                  .lr-note-head
                    strong Đóng tự động — phía công ty gửi yêu cầu «#{req.fromCompanyName}»
                    span.lr-note-hint  (không phải do bạn từ chối trên trang này)
                  p.lr-note-body= _noteBodyR
                else if _legacyGeneric
                  .lr-note-head
                    strong Yêu cầu đã đóng từ phía công ty «#{req.fromCompanyName}»
                  p.lr-note-body= req.responseNote
                else
                  .lr-note-head
                    strong Phản hồi của bạn (công ty chủ khách sạn)
                  p.lr-note-body= req.responseNote

          if req.status === 'pending'
            .lr-card-actions
              button.lr-btn.lr-btn--approve(
                type="button"
                onclick=`approveRequest('${req._id}')`
              )
                i.fa-solid.fa-check
                |  Duyệt
              button.lr-btn.lr-btn--reject(
                type="button"
                onclick=`openRejectModal('${req._id}')`
              )
                i.fa-solid.fa-xmark
                |  Từ chối
    else
      .lr-empty
        i.fa-solid.fa-inbox
        p Không có yêu cầu nào

    //- Modal từ chối yêu cầu
    #rejectModal.lr-modal
      .lr-modal-overlay(onclick="closeRejectModal()")
      .lr-modal-content
        .lr-modal-header
          h3 Từ chối yêu cầu liên kết
          button.lr-modal-close(onclick="closeRejectModal()")
            i.fa-solid.fa-xmark
        .lr-modal-body
          p Vui lòng nhập lý do từ chối để gửi phản hồi tới công ty yêu cầu:
          .lr-form-group
            label Lý do từ chối
            textarea#reject-response-note.lr-textarea(rows="3" placeholder="Nhập lý do từ chối...")
        .lr-modal-footer
          button.lr-btn.lr-btn--cancel(onclick="closeRejectModal()") Huỷ
          button.lr-btn.lr-btn--reject(onclick="submitRejection()") Xác nhận từ chối

    //- Xác nhận (thay window.confirm)
    #th-app-dialog.th-app-dialog(aria-hidden="true")
      .th-app-dialog__backdrop
      .th-app-dialog__panel(role="dialog" aria-modal="true" aria-labelledby="th-app-dialog-title")
        .th-app-dialog__header
          h3#th-app-dialog-title.th-app-dialog__title Xác nhận
          button#th-app-dialog-close.th-app-dialog__close(type="button" aria-label="Đóng")
            i.fa-solid.fa-xmark
        #th-app-dialog-body.th-app-dialog__body
        .th-app-dialog__footer
          button#th-app-dialog-cancel.th-app-dialog__btn.th-app-dialog__btn--secondary(type="button") Huỷ
          button#th-app-dialog-ok.th-app-dialog__btn.th-app-dialog__btn--primary(type="button") Tiếp tục

  style.
    .link-requests-page { padding: 20px; max-width: 1100px; }
    .lr-filter-form { margin-bottom: 18px; }
    .lr-filter-bar {
      display: flex; flex-wrap: wrap; gap: 12px 14px; align-items: flex-end;
      padding: 14px 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;
    }
    .lr-filter-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .lr-filter-field--grow { flex: 1 1 200px; }
    .lr-filter-field label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .03em; color: #64748b; }
    .lr-filter-field input, .lr-filter-field select {
      min-height: 38px; padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 8px;
      font-size: 13px; color: #1e293b; background: #fff; max-width: 100%;
    }
    .lr-filter-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-left: auto; }
    .lr-filter-btn {
      display: inline-flex; align-items: center; gap: 6px; min-height: 38px;
      padding: 0 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
      cursor: pointer; text-decoration: none; border: 1px solid transparent;
    }
    .lr-filter-btn--primary { background: #2d3e90; color: #fff; border-color: #2d3e90; }
    .lr-filter-btn--primary:hover { filter: brightness(1.08); }
    .lr-filter-btn--ghost { background: #fff; color: #475569; border-color: #cbd5e1; }
    .lr-filter-btn--ghost:hover { background: #f1f5f9; }
    .lr-subtitle { color: #64748b; font-size: 14px; margin: -8px 0 20px; }
    .lr-card {
      background: #fff; border: 1px solid #e5e7eb; border-radius: 12px;
      margin-bottom: 16px; overflow: hidden; transition: box-shadow .2s;
    }
    .lr-card:hover { box-shadow: 0 4px 12px rgba(0,0,0,.08); }
    .lr-card--pending { border-left: 4px solid #f59e0b; }
    .lr-card--approved { border-left: 4px solid #22c55e; }
    .lr-card--partially_approved { border-left: 4px solid #3b82f6; }
    .lr-card--rejected { border-left: 4px solid #ef4444; opacity: .7; }
    .lr-card--auto-closed { border-left: 4px solid #94a3b8; opacity: .75; }
    .lr-card-header {
      display: flex; justify-content: space-between; align-items: flex-start;
      padding: 16px 20px; background: #f8fafc;
    }
    .lr-card-title { margin: 0 0 6px; font-size: 16px; color: #1e293b; font-weight: 600; }
    .lr-card-meta { display: flex; flex-wrap: wrap; gap: 12px; font-size: 13px; color: #64748b; }
    .lr-meta-item i { margin-right: 4px; color: #94a3b8; }
    .lr-badge {
      display: inline-block; padding: 4px 12px; border-radius: 20px;
      font-size: 12px; font-weight: 600; white-space: nowrap;
    }
    .lr-badge--pending  { background: #fef3c7; color: #92400e; }
    .lr-badge--approved { background: #dcfce7; color: #166534; }
    .lr-badge--partial  { background: #dbeafe; color: #1e40af; }
    .lr-badge--rejected { background: #fee2e2; color: #991b1b; }
    .lr-badge--auto-closed { background: #e2e8f0; color: #475569; border: 1px dashed #94a3b8; }
    .lr-card-body { padding: 16px 20px; }
    .lr-card-body h4 { margin: 0 0 10px; font-size: 14px; color: #475569; font-weight: 600; }
    .lr-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .lr-table th { background: #f1f5f9; padding: 8px 12px; text-align: left; font-weight: 600; color: #334155; border-bottom: 1px solid #e2e8f0; }
    .lr-table td { padding: 8px 12px; border-bottom: 1px solid #f1f5f9; }
    .lr-reviewer-info {
      display: flex; align-items: center; gap: 6px;
      margin-top: 10px; padding: 7px 12px;
      background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px;
      font-size: 13px; color: #166534;
    }
    .lr-reviewer-info i { color: #16a34a; }
    .lr-reviewer-time { color: #4b5563; font-size: 12px; }
    .lr-note { margin-top: 10px; padding: 8px 12px; background: #f8fafc; border-radius: 6px; font-size: 13px; color: #64748b; }
    .lr-note--response { background: #fffbeb; border: 1px solid #fde68a; color: #78350f; }
    .lr-note-head { margin: 0 0 6px 0; font-size: 13px; line-height: 1.45; }
    .lr-note-hint { display: block; font-weight: 400; font-size: 12px; color: #92400e; margin-top: 4px; opacity: .95; }
    .lr-note-body { margin: 0; font-size: 13px; line-height: 1.55; color: #92400e; }
    .lr-card-actions {
      display: flex; gap: 8px; padding: 12px 20px; background: #f8fafc;
      border-top: 1px solid #e5e7eb;
    }
    .lr-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 16px; border: none; border-radius: 8px;
      font-size: 13px; font-weight: 500; cursor: pointer; transition: all .2s;
    }
    .lr-btn--approve { background: #22c55e; color: #fff; }
    .lr-btn--approve:hover { background: #16a34a; }
    .lr-btn--reject  { background: #ef4444; color: #fff; }
    .lr-btn--reject:hover  { background: #dc2626; }
    .lr-btn--cancel  { background: #e5e7eb; color: #334155; }
    .lr-btn--cancel:hover  { background: #d1d5db; }
    .lr-empty { text-align: center; padding: 60px 20px; color: #94a3b8; }
    .lr-empty i { font-size: 48px; margin-bottom: 12px; display: block; }
    .lr-empty p { font-size: 15px; }
    /* Modal */
    .lr-modal { display: none; position: fixed; inset: 0; z-index: 10000; }
    .lr-modal.active { display: flex; align-items: center; justify-content: center; }
    .lr-modal-overlay { position: absolute; inset: 0; background: rgba(0,0,0,.4); }
    .lr-modal-content {
      position: relative; background: #fff; border-radius: 12px;
      width: 560px; max-width: 95vw; max-height: 80vh; overflow-y: auto;
      box-shadow: 0 20px 60px rgba(0,0,0,.15); z-index: 1;
    }
    .lr-modal-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 16px 20px; border-bottom: 1px solid #e5e7eb;
    }
    .lr-modal-header h3 { margin: 0; font-size: 16px; }
    .lr-modal-close { background: none; border: none; font-size: 18px; cursor: pointer; color: #64748b; }
    .lr-modal-body { padding: 20px; }
    .lr-modal-footer {
      display: flex; justify-content: flex-end; gap: 8px;
      padding: 12px 20px; border-top: 1px solid #e5e7eb;
    }
    .lr-form-group { margin-top: 16px; }
    .lr-form-group label { display: block; font-size: 13px; font-weight: 500; margin-bottom: 6px; color: #475569; }
    .lr-textarea { width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 13px; resize: vertical; }

  script.
    let rejectRequestId = null;

    function lrToastSuccess(msg) {
      if (typeof notify !== 'undefined' && notify && typeof notify.success === 'function') notify.success(msg);
    }
    function lrToastError(msg) {
      if (typeof notify !== 'undefined' && notify && typeof notify.error === 'function') notify.error(msg);
    }

    function showLrConfirm(opts) {
      const message = opts.message || '';
      const title = opts.title || 'Xác nhận';
      const confirmText = opts.confirmText || 'Tiếp tục';
      const cancelText = opts.cancelText || 'Huỷ';
      const wrap = document.getElementById('th-app-dialog');
      if (!wrap) return Promise.resolve(window.confirm(message));

      return new Promise(function (resolve) {
        const titleEl = document.getElementById('th-app-dialog-title');
        const bodyEl = document.getElementById('th-app-dialog-body');
        const okBtn = document.getElementById('th-app-dialog-ok');
        const cancelBtn = document.getElementById('th-app-dialog-cancel');
        const closeBtn = document.getElementById('th-app-dialog-close');
        const backdrop = wrap.querySelector('.th-app-dialog__backdrop');
        if (!titleEl || !bodyEl || !okBtn || !cancelBtn || !closeBtn || !backdrop) {
          resolve(window.confirm(message));
          return;
        }

        titleEl.textContent = title;
        bodyEl.textContent = message;
        okBtn.textContent = confirmText;
        cancelBtn.textContent = cancelText;

        var settled = false;
        function finish(val) {
          if (settled) return;
          settled = true;
          wrap.classList.remove('is-open');
          wrap.setAttribute('aria-hidden', 'true');
          document.removeEventListener('keydown', onKey);
          okBtn.removeEventListener('click', onOk);
          cancelBtn.removeEventListener('click', onCancel);
          closeBtn.removeEventListener('click', onCancel);
          backdrop.removeEventListener('click', onCancel);
          resolve(val);
        }
        function onOk() { finish(true); }
        function onCancel() { finish(false); }
        function onKey(ev) { if (ev.key === 'Escape') onCancel(); }

        okBtn.addEventListener('click', onOk);
        cancelBtn.addEventListener('click', onCancel);
        closeBtn.addEventListener('click', onCancel);
        backdrop.addEventListener('click', onCancel);
        document.addEventListener('keydown', onKey);

        wrap.classList.add('is-open');
        wrap.setAttribute('aria-hidden', 'false');
        okBtn.focus();
      });
    }

    async function approveRequest(requestId) {
      var ok = await showLrConfirm({
        title: 'Duyệt yêu cầu',
        message: 'Duyệt toàn bộ phòng trong yêu cầu này và giữ chỗ ngay?',
        confirmText: 'Duyệt & giữ chỗ',
        cancelText: 'Huỷ',
      });
      if (!ok) return;
      try {
        const res = await fetch(`/${pathAdmin}/hotel/link-requests/approve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ requestId }),
        });
        const data = await res.json();
        if (data.success) { lrToastSuccess(data.message); location.reload(); }
        else lrToastError(data.message);
      } catch (e) { lrToastError('Lỗi kết nối'); }
    }

    function openRejectModal(requestId) {
      rejectRequestId = requestId;
      document.getElementById('reject-response-note').value = '';
      document.getElementById('rejectModal').classList.add('active');
    }

    function closeRejectModal() {
      document.getElementById('rejectModal').classList.remove('active');
      rejectRequestId = null;
    }

    async function submitRejection() {
      if (!rejectRequestId) return;
      var responseNote = document.getElementById('reject-response-note').value.trim();
      var confirmReject = await showLrConfirm({
        title: 'Từ chối yêu cầu',
        message: 'Gửi từ chối cho yêu cầu này? Công ty gửi yêu cầu sẽ nhận được phản hồi của bạn.',
        confirmText: 'Gửi từ chối',
        cancelText: 'Quay lại',
      });
      if (!confirmReject) return;
      try {
        const res = await fetch(`/${pathAdmin}/hotel/link-requests/reject`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ requestId: rejectRequestId, responseNote: responseNote }),
        });
        const data = await res.json();
        if (data.success) {
          closeRejectModal();
          lrToastSuccess(data.message);
          location.reload();
        } else lrToastError(data.message);
      } catch (e) { lrToastError('Lỗi kết nối'); }
    }
