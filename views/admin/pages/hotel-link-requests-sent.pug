extends ../layouts/default.pug

block main
  - var lf = lrFilter || {}
  - var _lrSentBase = `/${pathAdmin}/tour-hotel/link-requests`
  - var _hotelsS = Array.isArray(allHotelsForFilter) ? allHotelsForFilter : []
  .link-requests-page
    h1.box-title Yêu cầu liên kết đã gửi
    p.lr-subtitle Các yêu cầu giữ phòng tại khách sạn thuộc công ty khác mà bạn đã gửi đi.

    form.lr-filter-form(method="GET" action=_lrSentBase)
      .lr-filter-bar
        .lr-filter-field.lr-filter-field--grow
          label(for="lr-q-sent") Tìm kiếm
          input#lr-q-sent(type="search" name="q" value=lf.q placeholder="Tour, khách sạn, công ty nhận, ghi chú…")
        .lr-filter-field
          label(for="lr-hotel-sent") Khách sạn
          select#lr-hotel-sent(name="hotelId")
            option(value="" selected=!lf.hotelId) Tất cả khách sạn
            each h in _hotelsS
              option(value=h._id selected=(String(lf.hotelId || '') === String(h._id)))= h.name
        .lr-filter-field
          label(for="lr-status-sent") Trạng thái
          select#lr-status-sent(name="status")
            option(value="" selected=(lf.status === "" || !lf.status)) Tất cả
            option(value="pending" selected=(lf.status === "pending")) Chờ duyệt
            option(value="approved" selected=(lf.status === "approved")) Đã duyệt
            option(value="rejected" selected=(lf.status === "rejected")) Từ chối
        .lr-filter-field
          label(for="lr-dep-from-s") Khởi hành từ
          input#lr-dep-from-s(type="date" name="departureFrom" value=lf.departureFrom)
        .lr-filter-field
          label(for="lr-dep-to-s") Khởi hành đến
          input#lr-dep-to-s(type="date" name="departureTo" value=lf.departureTo)
        .lr-filter-actions
          button.lr-filter-btn.lr-filter-btn--primary(type="submit")
            i.fa-solid.fa-filter
            |  Lọc
          a.lr-filter-btn.lr-filter-btn--ghost(href=_lrSentBase)
            i.fa-solid.fa-rotate-left
            |  Xóa lọc

    if sentRequests && sentRequests.length > 0
      each req in sentRequests
        .lr-card(class=`lr-card--${req.status}`)
          .lr-card-header
            .lr-card-info
              h3.lr-card-title= req.tourName
              .lr-card-meta
                span.lr-meta-item
                  i.fa-solid.fa-calendar-day
                  |  #{req.departureDateDisplay} → #{req.endDateDisplay}
                span.lr-meta-item
                  i.fa-solid.fa-building
                  |  Đến công ty: #{req.toCompanyName}
                span.lr-meta-item
                  i.fa-solid.fa-hotel
                  |  Khách sạn: #{req.hotelName}
                span.lr-meta-item
                  i.fa-solid.fa-clock
                  |  #{req.createdAtDisplay}
            .lr-card-actions
              if req.status === 'pending'
                span.lr-badge.lr-badge--pending Chờ duyệt
                button.lr-btn-cancel(type="button" onclick=`cancelRequest('${req._id}')` title="Thu hồi yêu cầu")
                  i.fa-solid.fa-xmark
                  |  Thu hồi
              else if req.status === 'approved'
                span.lr-badge.lr-badge--approved Đã duyệt
              else if req.status === 'partially_approved'
                span.lr-badge.lr-badge--partial Duyệt một phần
              else if req.status === 'cancelled'
                span.lr-badge.lr-badge--cancelled Đã thu hồi
              else
                span.lr-badge.lr-badge--rejected Từ chối

          .lr-card-body
            .lr-rooms-summary
              span.lr-rooms-label Số phòng yêu cầu:
              strong= ' ' + req.totalRequestedRooms + ' phòng'
              if req.status !== 'pending' && req.totalApprovedRooms > 0
                span.lr-rooms-approved
                  i.fa-solid.fa-circle-check
                  |  Đã duyệt: #{req.totalApprovedRooms} phòng
            table.lr-table
              thead
                tr
                  th Loại phòng
                  th Số phòng yêu cầu
                  th Sức chứa
                  th Từ ngày
                  th Đến ngày
                  if req.status !== 'pending'
                    th Đã duyệt
              tbody
                each rr in req.requestedRooms
                  tr
                    td= rr.roomTypeName
                    td= rr.assignedRooms
                    td= rr.baseOccupancy + ' người/phòng'
                    td= rr.fromDateDisplay
                    td= rr.toDateDisplay
                    if req.status !== 'pending'
                      - const approved = (req.approvedRooms || []).find(a => String(a.roomTypeId) === String(rr.roomTypeId))
                      td= approved ? approved.approvedRooms : 0

            //- Người duyệt / từ chối (phía công ty nhận)
            if req.status !== 'pending' && req.status !== 'cancelled' && req.reviewerName
              .lr-reviewer-info(class=(req.status === 'rejected' ? 'lr-reviewer-info--rejected' : ''))
                i.fa-solid.fa-user-check
                if req.status === 'rejected'
                  |  Từ chối bởi: 
                else
                  |  Duyệt bởi: 
                strong= req.reviewerName
                span  (công ty «#{req.toCompanyName}»)
                if req.reviewedAtDisplay
                  span.lr-reviewer-time  — #{req.reviewedAtDisplay}

            if req.responseNote
              - var _autoTag = hotelLinkAutoBySenderTag || ''
              - var _isAutoSender = _autoTag && req.responseNote.indexOf(_autoTag) === 0
              - var _noteBody = _isAutoSender ? req.responseNote.slice(_autoTag.length) : req.responseNote
              .lr-note
                i.fa-solid.fa-comment-dots
                if _isAutoSender
                  .lr-note-head
                    strong Đóng tự động — phía công ty bạn (công ty gửi yêu cầu / tổ chức tour)
                  p.lr-note-body= _noteBody
                else
                  .lr-note-head
                    strong Phản hồi từ công ty «#{req.toCompanyName}» (công ty chủ khách sạn / bên nhận yêu cầu)
                  p.lr-note-body= _noteBody
    else
      .lr-empty
        i.fa-solid.fa-paper-plane
        p Chưa gửi yêu cầu liên kết nào

    #th-app-dialog.th-app-dialog(aria-hidden="true")
      .th-app-dialog__backdrop
      .th-app-dialog__panel(role="dialog" aria-modal="true" aria-labelledby="th-app-dialog-title")
        .th-app-dialog__header
          h3#th-app-dialog-title.th-app-dialog__title Xác nhận
          button#th-app-dialog-close.th-app-dialog__close(type="button" aria-label="Đóng")
            i.fa-solid.fa-xmark
        #th-app-dialog-body.th-app-dialog__body
        .th-app-dialog__footer
          button#th-app-dialog-cancel.th-app-dialog__btn.th-app-dialog__btn--secondary(type="button") Huỷ
          button#th-app-dialog-ok.th-app-dialog__btn.th-app-dialog__btn--primary(type="button") Tiếp tục

  style.
    .link-requests-page { padding: 20px; max-width: 1100px; }
    .lr-filter-form { margin-bottom: 18px; }
    .lr-filter-bar {
      display: flex; flex-wrap: wrap; gap: 12px 14px; align-items: flex-end;
      padding: 14px 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;
    }
    .lr-filter-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .lr-filter-field--grow { flex: 1 1 200px; }
    .lr-filter-field label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .03em; color: #64748b; }
    .lr-filter-field input, .lr-filter-field select {
      min-height: 38px; padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 8px;
      font-size: 13px; color: #1e293b; background: #fff; max-width: 100%;
    }
    .lr-filter-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-left: auto; }
    .lr-filter-btn {
      display: inline-flex; align-items: center; gap: 6px; min-height: 38px;
      padding: 0 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
      cursor: pointer; text-decoration: none; border: 1px solid transparent;
    }
    .lr-filter-btn--primary { background: #2d3e90; color: #fff; border-color: #2d3e90; }
    .lr-filter-btn--primary:hover { filter: brightness(1.08); }
    .lr-filter-btn--ghost { background: #fff; color: #475569; border-color: #cbd5e1; }
    .lr-filter-btn--ghost:hover { background: #f1f5f9; }
    .lr-subtitle { color: #64748b; font-size: 14px; margin: -8px 0 20px; }
    .lr-card {
      background: #fff; border: 1px solid #e5e7eb; border-radius: 12px;
      margin-bottom: 16px; overflow: hidden; transition: box-shadow .2s;
    }
    .lr-card:hover { box-shadow: 0 4px 12px rgba(0,0,0,.08); }
    .lr-card--pending          { border-left: 4px solid #f59e0b; }
    .lr-card--approved         { border-left: 4px solid #22c55e; }
    .lr-card--partially_approved { border-left: 4px solid #3b82f6; }
    .lr-card--rejected         { border-left: 4px solid #ef4444; opacity: .7; }
    .lr-card--cancelled        { border-left: 4px solid #94a3b8; opacity: .6; }
    .lr-card-header {
      display: flex; justify-content: space-between; align-items: flex-start;
      padding: 16px 20px; background: #f8fafc;
    }
    .lr-card-title { margin: 0 0 6px; font-size: 16px; color: #1e293b; font-weight: 600; }
    .lr-card-meta { display: flex; flex-wrap: wrap; gap: 12px; font-size: 13px; color: #64748b; }
    .lr-meta-item i { margin-right: 4px; color: #94a3b8; }
    .lr-badge {
      display: inline-block; padding: 4px 12px; border-radius: 20px;
      font-size: 12px; font-weight: 600; white-space: nowrap;
    }
    .lr-badge--pending  { background: #fef3c7; color: #92400e; }
    .lr-badge--approved { background: #dcfce7; color: #166534; }
    .lr-badge--partial  { background: #dbeafe; color: #1e40af; }
    .lr-badge--rejected  { background: #fee2e2; color: #991b1b; }
    .lr-badge--cancelled { background: #f1f5f9; color: #64748b; }
    .lr-card-actions {
      display: flex; flex-direction: column; align-items: flex-end; gap: 8px;
    }
    .lr-btn-cancel {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 5px 14px; font-size: 12px; font-weight: 500;
      color: #dc2626; background: #fff; border: 1px solid #fca5a5;
      border-radius: 6px; cursor: pointer; transition: all .15s;
    }
    .lr-btn-cancel:hover { background: #fef2f2; border-color: #ef4444; }
    .lr-card-body { padding: 16px 20px; }
    .lr-rooms-summary {
      display: flex; align-items: center; gap: 12px;
      font-size: 13px; color: #475569; margin-bottom: 12px;
    }
    .lr-rooms-label { color: #64748b; }
    .lr-rooms-approved { color: #16a34a; font-size: 13px; font-weight: 500; }
    .lr-rooms-approved i { margin-right: 4px; }
    .lr-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .lr-table th { background: #f1f5f9; padding: 8px 12px; text-align: left; font-weight: 600; color: #334155; border-bottom: 1px solid #e2e8f0; }
    .lr-table td { padding: 8px 12px; border-bottom: 1px solid #f1f5f9; }
    .lr-reviewer-info {
      display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
      margin-top: 10px; padding: 7px 12px;
      background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px;
      font-size: 13px; color: #166534;
    }
    .lr-reviewer-info--rejected { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
    .lr-reviewer-info--rejected i { color: #dc2626; }
    .lr-reviewer-info i { color: #16a34a; }
    .lr-reviewer-time { color: #6b7280; font-size: 12px; }
    .lr-note { margin-top: 10px; padding: 10px 12px; background: #fffbeb; border-radius: 6px; font-size: 13px; color: #78350f; border: 1px solid #fde68a; }
    .lr-note i { margin-right: 6px; vertical-align: top; margin-top: 2px; }
    .lr-note-head { margin: 0 0 6px 0; font-size: 13px; line-height: 1.45; }
    .lr-note-body { margin: 0; padding-left: 0; font-size: 13px; line-height: 1.55; color: #92400e; }
    .lr-empty { text-align: center; padding: 60px 20px; color: #94a3b8; }
    .lr-empty i { font-size: 48px; margin-bottom: 12px; display: block; }
    .lr-empty p { font-size: 15px; }

  script.
    function lrToastSuccess(msg) {
      if (typeof notify !== 'undefined' && notify && typeof notify.success === 'function') notify.success(msg);
    }
    function lrToastError(msg) {
      if (typeof notify !== 'undefined' && notify && typeof notify.error === 'function') notify.error(msg);
    }

    function showLrConfirm(opts) {
      const message = opts.message || '';
      const title = opts.title || 'Xác nhận';
      const confirmText = opts.confirmText || 'Tiếp tục';
      const cancelText = opts.cancelText || 'Huỷ';
      const wrap = document.getElementById('th-app-dialog');
      if (!wrap) return Promise.resolve(window.confirm(message));

      return new Promise(function (resolve) {
        const titleEl = document.getElementById('th-app-dialog-title');
        const bodyEl = document.getElementById('th-app-dialog-body');
        const okBtn = document.getElementById('th-app-dialog-ok');
        const cancelBtn = document.getElementById('th-app-dialog-cancel');
        const closeBtn = document.getElementById('th-app-dialog-close');
        const backdrop = wrap.querySelector('.th-app-dialog__backdrop');
        if (!titleEl || !bodyEl || !okBtn || !cancelBtn || !closeBtn || !backdrop) {
          resolve(window.confirm(message));
          return;
        }

        titleEl.textContent = title;
        bodyEl.textContent = message;
        okBtn.textContent = confirmText;
        cancelBtn.textContent = cancelText;

        var settled = false;
        function finish(val) {
          if (settled) return;
          settled = true;
          wrap.classList.remove('is-open');
          wrap.setAttribute('aria-hidden', 'true');
          document.removeEventListener('keydown', onKey);
          okBtn.removeEventListener('click', onOk);
          cancelBtn.removeEventListener('click', onCancel);
          closeBtn.removeEventListener('click', onCancel);
          backdrop.removeEventListener('click', onCancel);
          resolve(val);
        }
        function onOk() { finish(true); }
        function onCancel() { finish(false); }
        function onKey(ev) { if (ev.key === 'Escape') onCancel(); }

        okBtn.addEventListener('click', onOk);
        cancelBtn.addEventListener('click', onCancel);
        closeBtn.addEventListener('click', onCancel);
        backdrop.addEventListener('click', onCancel);
        document.addEventListener('keydown', onKey);

        wrap.classList.add('is-open');
        wrap.setAttribute('aria-hidden', 'false');
        okBtn.focus();
      });
    }

    async function cancelRequest(requestId) {
      var ok = await showLrConfirm({
        title: 'Thu hồi yêu cầu',
        message: 'Bạn có chắc chắn muốn thu hồi yêu cầu liên kết này? Công ty nhận sẽ được thông báo.',
        confirmText: 'Thu hồi',
        cancelText: 'Huỷ',
      });
      if (!ok) return;
      try {
        const res = await fetch(`/${pathAdmin}/hotel/link-requests/cancel`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ requestId }),
        });
        const data = await res.json();
        if (data.success) { lrToastSuccess(data.message); location.reload(); }
        else lrToastError(data.message);
      } catch (e) { lrToastError('Lỗi kết nối'); }
    }
