extends ../layouts/default.pug

block main
  .booking-detail-page
    .page-header
      h1.page-title Chi tiết đơn đặt phòng
      .page-actions
        a.btn-back(href=`/${pathAdmin}/hotel/booking/list`)
          i.fa-solid.fa-arrow-left
          |  Quay lại danh sách

    if bookingDetail
      .booking-detail-container
        //- Thông tin khách hàng
        .booking-section
          .section-header
            i.fa-solid.fa-user
            h3 Thông tin khách hàng
            button#editGuestBtn.btn-edit-guest(type="button" onclick="openEditGuestModal()")
              i.fa-solid.fa-pen-to-square
              |  Chỉnh sửa
          .section-content
            .info-grid
              .info-item
                .label Họ và tên:
                .value#guestDisplayName= bookingDetail.guest.fullName || "—"
              .info-item
                .label Số điện thoại:
                .value#guestDisplayPhone= bookingDetail.guest.phone || "—"
              .info-item
                .label Email:
                .value#guestDisplayEmail= bookingDetail.guest.email || "—"
            if bookingDetail.guest.cccdImages && bookingDetail.guest.cccdImages.length
              .cccd-section
                .label
                  i.fa-solid.fa-id-card
                  |  Ảnh CCCD / Hộ chiếu
                .cccd-gallery.cccd-gallery--detail
                  each img in bookingDetail.guest.cccdImages
                    a.cccd-gallery-item(href=img target="_blank" title="Xem ảnh gốc")
                      img(src=img alt="CCCD")

        //- Modal chỉnh sửa thông tin khách hàng
        #editGuestModal.edit-guest-modal(style="display:none")
          .edit-guest-modal__overlay(onclick="closeEditGuestModal()")
          .edit-guest-modal__box
            .edit-guest-modal__header
              h4
                i.fa-solid.fa-user-pen
                |  Chỉnh sửa thông tin khách hàng
              button.edit-guest-modal__close(type="button" onclick="closeEditGuestModal()")
                i.fa-solid.fa-xmark
            .edit-guest-modal__body
              .edit-guest-field
                label(for="editGuestName") Họ và tên
                input#editGuestName(type="text" placeholder="Nhập họ và tên..." value=bookingDetail.guest.fullName || "")
              .edit-guest-field
                label(for="editGuestPhone") Số điện thoại
                input#editGuestPhone(type="text" placeholder="Nhập số điện thoại..." value=bookingDetail.guest.phone || "")
              .edit-guest-field
                label(for="editGuestEmail") Email
                input#editGuestEmail(type="email" placeholder="Nhập email..." value=bookingDetail.guest.email || "")
            .edit-guest-modal__footer
              button.btn-cancel-guest(type="button" onclick="closeEditGuestModal()") Hủy
              button#saveGuestBtn.btn-save-guest(type="button" onclick="saveGuestInfo()") 
                i.fa-solid.fa-floppy-disk
                |  Lưu thay đổi

        script.
          var _bookingCode = '!{bookingDetail.code}';
          var _pathAdmin = '!{pathAdmin}';

          function openEditGuestModal() {
            document.getElementById('editGuestModal').style.display = 'flex';
          }
          function closeEditGuestModal() {
            document.getElementById('editGuestModal').style.display = 'none';
          }
          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeEditGuestModal();
          });
          function saveGuestInfo() {
            var fullName = document.getElementById('editGuestName').value.trim();
            var phone    = document.getElementById('editGuestPhone').value.trim();
            var email    = document.getElementById('editGuestEmail').value.trim();
            if (!fullName) { alert('Vui lòng nhập họ và tên.'); return; }
            var btn = document.getElementById('saveGuestBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang lưu...';
            fetch('/' + _pathAdmin + '/hotel/booking/update-guest/' + _bookingCode, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ fullName: fullName, phone: phone, email: email }),
            })
              .then(function(r) { return r.json(); })
              .then(function(data) {
                if (data.code === 'success') {
                  document.getElementById('guestDisplayName').textContent  = fullName || '—';
                  document.getElementById('guestDisplayPhone').textContent = phone   || '—';
                  document.getElementById('guestDisplayEmail').textContent = email   || '—';
                  closeEditGuestModal();
                } else {
                  alert('Lỗi: ' + (data.message || 'Không thể cập nhật thông tin'));
                  btn.disabled = false;
                  btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi';
                }
              })
              .catch(function() {
                alert('Có lỗi kết nối, vui lòng thử lại.');
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi';
              });
          }

        //- Thông tin khách sạn
        .booking-section
          .section-header
            i.fa-solid.fa-hotel
            h3 Thông tin khách sạn
          .section-content
            .info-grid
              .info-item
                .label Tên khách sạn:
                .value= bookingDetail.hotel.name || "—"
              .info-item
                .label Địa chỉ:
                .value= bookingDetail.hotel.address || "—"

        //- Thông tin đặt phòng
        .booking-section
          .section-header
            i.fa-solid.fa-calendar-days
            h3 Thông tin đặt phòng
          .section-content
            .info-grid
              .info-item
                .label Mã đơn:
                .value
                  strong= bookingDetail.code
              .info-item
                .label Ngày nhận phòng:
                .value= bookingDetail.checkInDate
              .info-item
                .label Ngày trả phòng:
                .value= bookingDetail.checkOutDate
              .info-item
                .label Số đêm:
                .value= `${bookingDetail.nights} đêm`
              .info-item
                .label Số phòng:
                .value= bookingDetail.totalRooms
              .info-item
                .label Số người lớn:
                .value= bookingDetail.adults
              .info-item
                .label Số trẻ em:
                .value= bookingDetail.childrenText
              .info-item
                .label Trạng thái:
                .value
                  span.badge(class=bookingDetail.statusClass)= bookingDetail.status

        //- Chi tiết phòng
        .booking-section
          .section-header
            i.fa-solid.fa-bed
            h3 Chi tiết phòng
          .section-content
            .table-responsive
              table.booking-detail-table
                thead
                  tr
                    th Mã booking
                    th Loại phòng
                    th Giá / đêm
                    th Số phòng
                    th Chi tiết từng phòng
                    th Thành tiền
                tbody
                  each room in bookingDetail.roomDetails
                    tr
                      td= room.code
                      td= room.roomTypeName
                      td #{room.pricePerNightFormat} #{bookingDetail.currency}
                      td= room.rooms
                      td
                        if room.roomsDetails && room.roomsDetails.length > 0
                          .rooms-details-list
                            each detail in room.roomsDetails
                              .room-detail-item
                                strong Phòng #{detail.roomIndex}: 
                                span #{detail.adults} người lớn, #{detail.children} trẻ em
                                if detail.children > 0
                                  span.children-ages  (#{detail.childrenAges})
                        else
                          span Không có chi tiết
                      td
                        strong #{room.totalAmountFormat} #{bookingDetail.currency}

        //- Dịch vụ thêm
        .booking-section
          .section-header
            i.fa-solid.fa-plus-circle
            h3 Dịch vụ thêm
          .section-content
            //- Dịch vụ chung (global)
            if bookingDetail.additionalServices && bookingDetail.additionalServices.length > 0
              h4.services-subtitle Dịch vụ chung (cho toàn bộ booking)
              .additional-services-list
                each service in bookingDetail.additionalServices
                  .service-item
                    .service-info
                      i.fa-solid.fa-check-circle
                      span.service-name= service.name
                    .service-pricing
                      if service.quantity && service.quantity > 1
                        span.service-quantity Số lượng: #{service.quantity}
                        span.service-separator ×
                      span.service-price #{service.price} VND
            
            //- Dịch vụ theo từng loại phòng (perItem)
            if bookingDetail.perItemServices && bookingDetail.perItemServices.length > 0
              each itemService in bookingDetail.perItemServices
                if itemService.services && itemService.services.length > 0
                  h4.services-subtitle.mt-3 #{itemService.roomTypeName}
                  .additional-services-list
                    each service in itemService.services
                      .service-item
                        .service-info
                          i.fa-solid.fa-check-circle
                          span.service-name= service.name
                        .service-pricing
                          if service.quantity && service.quantity > 1
                            span.service-quantity Số lượng: #{service.quantity}
                            span.service-separator ×
                          span.service-price #{service.price} VND
            
            //- Nếu không có dịch vụ nào
            if (!bookingDetail.additionalServices || bookingDetail.additionalServices.length === 0) && (!bookingDetail.perItemServices || bookingDetail.perItemServices.length === 0)
              .empty-services
                i.fa-solid.fa-info-circle
                p Khách hàng không chọn dịch vụ thêm nào

        //- Thông tin thanh toán
        .booking-section
          .section-header
            i.fa-solid.fa-credit-card
            h3 Thông tin thanh toán
          .section-content
            .info-grid
              .info-item
                .label Phương thức thanh toán:
                .value= bookingDetail.paymentMethod
              .info-item
                .label Trạng thái thanh toán:
                .value
                  span.badge(class=bookingDetail.paymentStatusClass)= bookingDetail.paymentStatus
              .info-item
                .label Tổng tiền phòng:
                .value
                  strong #{bookingDetail.totalAmountFormat} #{bookingDetail.currency}
              .info-item
                .label Tổng đơn hàng:
                .value
                  strong.total-amount #{bookingDetail.orderTotalFormat} #{bookingDetail.currency}

        //- Ảnh chứng từ chuyển khoản
        if bookingDetail.transferProofImages && bookingDetail.transferProofImages.length
          .booking-section
            .section-header
              i.fa-solid.fa-money-bill-transfer
              h3 Ảnh chứng từ chuyển khoản
            .section-content
              .cccd-gallery.cccd-gallery--detail
                each img in bookingDetail.transferProofImages
                  a.cccd-gallery-item(href=img target="_blank" title="Xem ảnh gốc")
                    img(src=img alt="Chứng từ chuyển khoản")

        //- Ghi chú
        if bookingDetail.note
          .booking-section
            .section-header
              i.fa-solid.fa-note-sticky
              h3 Ghi chú
            .section-content
              .note-content= bookingDetail.note

        //- Thông tin khác
        .booking-section
          .section-header
            i.fa-solid.fa-info-circle
            h3 Thông tin khác
          .section-content
            .info-grid
              .info-item
                .label Ngày tạo:
                .value= bookingDetail.createdAt

    else
      .empty-state
        p Không tìm thấy thông tin đơn đặt phòng

  style.
    .cccd-section { margin-top: 16px; }
    .cccd-section .label { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 10px; }
    .cccd-section .label i { color: #6366f1; }
    .cccd-gallery--detail { display: flex; flex-wrap: wrap; gap: 12px; }
    .cccd-gallery--detail .cccd-gallery-item { display: block; border-radius: 8px; overflow: hidden; border: 1px solid #e5e7eb; box-shadow: 0 1px 4px rgba(0,0,0,.08); transition: box-shadow .15s; }
    .cccd-gallery--detail .cccd-gallery-item:hover { box-shadow: 0 4px 12px rgba(0,0,0,.15); }
    .cccd-gallery--detail .cccd-gallery-item img { display: block; width: 200px; height: 130px; object-fit: cover; }

    .services-subtitle {
      font-size: 14px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid #e5e7eb;
    }
    
    .mt-3 {
      margin-top: 24px;
    }
    
    .additional-services-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    
    .service-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px;
      background: #f9fafb;
      border-radius: 6px;
      border: 1px solid #e5e7eb;
    }
    
    .service-info {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .service-info i {
      color: #10b981;
      font-size: 16px;
    }
    
    .service-name {
      font-weight: 500;
      color: #374151;
    }
    
    .service-pricing {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      color: #6b7280;
    }
    
    .service-quantity {
      font-weight: 500;
      color: #374151;
    }
    
    .service-separator {
      color: #9ca3af;
    }
    
    .service-price {
      font-weight: 600;
      color: #059669;
    }

    /* Nút chỉnh sửa thông tin khách hàng */
    .section-header { display: flex; align-items: center; gap: 10px; }
    .btn-edit-guest {
      margin-left: auto;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      font-size: 12px;
      font-weight: 600;
      border: 1px solid #6366f1;
      border-radius: 6px;
      background: #eef2ff;
      color: #4338ca;
      cursor: pointer;
      transition: background .15s;
    }
    .btn-edit-guest:hover { background: #e0e7ff; }

    /* Modal chỉnh sửa */
    .edit-guest-modal {
      position: fixed; inset: 0; z-index: 10200;
      display: flex; align-items: center; justify-content: center;
    }
    .edit-guest-modal__overlay {
      position: absolute; inset: 0;
      background: rgba(0,0,0,.45);
    }
    .edit-guest-modal__box {
      position: relative; z-index: 1;
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 10px 40px rgba(0,0,0,.2);
      width: 100%; max-width: 460px;
      padding: 0;
      overflow: hidden;
    }
    .edit-guest-modal__header {
      display: flex; align-items: center; gap: 10px;
      padding: 18px 22px;
      background: #f5f7ff;
      border-bottom: 1px solid #e0e6ff;
    }
    .edit-guest-modal__header h4 {
      margin: 0; font-size: 15px; font-weight: 700; color: #1a2a6c;
      flex: 1; display: flex; align-items: center; gap: 8px;
    }
    .edit-guest-modal__close {
      background: none; border: none; cursor: pointer;
      color: #888; font-size: 16px; padding: 2px 6px; border-radius: 4px;
    }
    .edit-guest-modal__close:hover { background: #f0f0f0; color: #333; }
    .edit-guest-modal__body { padding: 22px; display: flex; flex-direction: column; gap: 16px; }
    .edit-guest-field { display: flex; flex-direction: column; gap: 6px; }
    .edit-guest-field label { font-size: 13px; font-weight: 600; color: #374151; }
    .edit-guest-field input {
      border: 1px solid #d1d5db; border-radius: 7px;
      padding: 9px 12px; font-size: 14px; color: #111;
      transition: border-color .2s, box-shadow .2s;
    }
    .edit-guest-field input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.12); outline: none; }
    .edit-guest-modal__footer {
      display: flex; justify-content: flex-end; gap: 10px;
      padding: 14px 22px;
      border-top: 1px solid #f0f0f0;
    }
    .btn-cancel-guest {
      padding: 8px 18px; border-radius: 7px; border: 1px solid #d1d5db;
      background: #fff; color: #555; font-size: 13px; font-weight: 600; cursor: pointer;
    }
    .btn-cancel-guest:hover { background: #f3f4f6; }
    .btn-save-guest {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 20px; border-radius: 7px; border: none;
      background: #4f46e5; color: #fff; font-size: 13px; font-weight: 600; cursor: pointer;
    }
    .btn-save-guest:hover { background: #4338ca; }
    .btn-save-guest:disabled { opacity: .65; cursor: not-allowed; }

