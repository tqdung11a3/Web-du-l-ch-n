extends ../../layouts/default.pug

block main

  .box-head
    a.button.button-outline(
      href=`/${pathAdmin}/super-admin/orders`
      style="margin-bottom:12px;display:inline-flex;align-items:center;gap:8px;"
    )
      i.fa-solid.fa-arrow-left
      |  Danh sách công ty
    h1.box-title(style="margin-top:0")= pageTitle || ('Đơn hàng — ' + company.name)

  .section-6(style="max-width:900px;")
    p(style="color:#64748b;margin-bottom:24px;")
      | Chọn loại đơn hàng cần xem cho công ty 
      strong= company.name
      | .

    .order-hub-cards(style="display:flex;flex-direction:column;gap:16px;")
      a.order-hub-card(
        href=`/${pathAdmin}/super-admin/orders/company/${company._id}/tours`
        style="display:flex;align-items:center;gap:16px;padding:20px;border:1px solid #e2e8f0;border-radius:12px;text-decoration:none;color:inherit;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.06);transition:box-shadow .2s,border-color .2s;"
      )
        span(style="width:48px;height:48px;border-radius:10px;background:#e0f2fe;display:flex;align-items:center;justify-content:center;color:#0369a1;")
          i.fa-solid.fa-suitcase-rolling(style="font-size:22px;")
        div(style="flex:1;")
          h2(style="margin:0 0 6px;font-size:18px;color:#0f172a;") Đơn hàng tour du lịch
          p(style="margin:0;color:#64748b;font-size:14px;") Danh sách đơn có tour thuộc công ty này.
        i.fa-solid.fa-chevron-right(style="color:#94a3b8;")

      a.order-hub-card(
        href=`/${pathAdmin}/super-admin/orders/company/${company._id}/hotel-bookings`
        style="display:flex;align-items:center;gap:16px;padding:20px;border:1px solid #e2e8f0;border-radius:12px;text-decoration:none;color:inherit;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.06);transition:box-shadow .2s,border-color .2s;"
      )
        span(style="width:48px;height:48px;border-radius:10px;background:#ccfbf1;display:flex;align-items:center;justify-content:center;color:#0f766e;")
          i.fa-solid.fa-hotel(style="font-size:22px;")
        div(style="flex:1;")
          h2(style="margin:0 0 6px;font-size:18px;color:#0f172a;") Đơn đặt phòng khách sạn
          p(style="margin:0;color:#64748b;font-size:14px;") Đặt phòng tại các khách sạn thuộc công ty này.
        i.fa-solid.fa-chevron-right(style="color:#94a3b8;")

  style.
    a.order-hub-card:hover {
      border-color: #0d9488 !important;
      box-shadow: 0 4px 14px rgba(13, 148, 136, 0.12) !important;
    }
