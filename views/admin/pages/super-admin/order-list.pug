extends ../../layouts/default.pug

block main
  
  .box-head
    h1.box-title Tất cả Đơn hàng

  //- Section 4: Bộ lọc
  .section-4
    form#form-filter(method="GET")
      .inner-form
        .inner-input
          input(
            type="text",
            name="keyword",
            placeholder="Tìm mã đơn hàng...",
            value=keyword || ""
          )
        .inner-select
          select(name="paymentStatus")
            option(value="") -- Trạng thái thanh toán --
            each item in paymentStatusList
              option(value=item.value selected=paymentStatusFilter === item.value)= item.label
        .inner-select
          select(name="status")
            option(value="") -- Trạng thái đơn hàng --
            each item in statusList
              option(value=item.value selected=statusFilter === item.value)= item.label
        .inner-button
          button.inner-submit(type="submit") Lọc

  //- Section 6: Danh sách
  .section-6
    .table-2
      table
        thead
          tr
            th STT
            th Mã đơn
            th Thông tin khách
            th Danh sách tour
            th Thanh toán
            th Trạng thái
            th.inner-center Ngày đặt
            th Hành động
        tbody
          if orderList && orderList.length > 0
            each orderDetail, index in orderList
              tr
                td= index + 1 + pagination.skip
                td
                  .inner-code= orderDetail.code
                td
                  div Họ tên: #{orderDetail.fullName}
                  div SĐT: #{orderDetail.phone}
                  if orderDetail.note
                    div Ghi chú: #{orderDetail.note}
                td
                  .inner-list
                    each item in orderDetail.items
                      .inner-item
                        .inner-image
                          if item.avatar
                            img(src=item.avatar, alt="")
                          else
                            div(style="width: 60px; height: 60px; background: #f5f5f5; border-radius: 4px;")
                        .inner-info
                          .inner-name= item.name
                          .inner-quantity
                            div Người lớn: #{item.quantityAdult} x #{item.priceNewAdult.toLocaleString("vi-VN")}đ
                            div Trẻ em: #{item.quantityChildren} x #{item.priceNewChildren.toLocaleString("vi-VN")}đ
                            div Em bé: #{item.quantityBaby} x #{item.babyUnitForUi.toLocaleString("vi-VN")}đ
                td
                  div Tạm tính: #{orderDetail.subTotalView.toLocaleString("vi-VN")}đ
                  div Giảm: #{orderDetail.discountView.toLocaleString("vi-VN")}đ
                  div Thanh toán: #{orderDetail.totalView.toLocaleString("vi-VN")}đ
                  div PTTT: #{orderDetail.paymentMethodName}
                  div TTTT: #{orderDetail.paymentStatusName}
                td
                  - const statusBadgeClass = `badge badge-${orderDetail.statusInfo.color}`
                  div(class=statusBadgeClass)= orderDetail.statusInfo.label
                td.inner-center
                  div= orderDetail.createdAtTime
                  div= orderDetail.createdAtDate
                td
                  .inner-buttons
                    a.inner-btn.inner-btn-view(href=`/${pathAdmin}/super-admin/orders/${orderDetail._id}`, title="Xem chi tiết")
                      <i class="fa-solid fa-eye"></i>
          else
            tr
              td(colspan="8", style="text-align: center; padding: 30px; color: #999;") Không có đơn hàng nào

  //- Section 7: Phân trang
  if pagination && pagination.totalPage > 1
    .section-7
      span.inner-label
        | Hiển thị #{pagination.skip + 1}
        | - #{pagination.skip + orderList.length}
        | của #{pagination.totalRecord}
      select(class="inner-pagination" box-pagination)
        - for (let i = 1; i <= pagination.totalPage; i++)
          option(value=i selected=(i === pagination.currentPage)) Trang #{i}
  //- End Section 7

