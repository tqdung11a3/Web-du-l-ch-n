extends ../../layouts/default.pug

block main

  .box-head
    a.button.button-outline(
      href=`/${pathAdmin}/super-admin/orders/company/${company._id}`
      style="margin-bottom:12px;display:inline-flex;align-items:center;gap:8px;"
    )
      i.fa-solid.fa-arrow-left
      |  Chọn loại đơn
    h1.box-title(style="margin-top:0")= pageTitle || ('Đặt phòng — ' + company.name)

  .section-4
    form.inner-search.order-search-form(method="GET" action=`/${pathAdmin}/super-admin/orders/company/${company._id}/hotel-bookings`)
      .order-search-fields
        .order-search-field
          i.fa-solid.fa-magnifying-glass
          input(
            type="text",
            name="search",
            placeholder="Mã đơn, tên khách, email...",
            value=searchQuery || ""
            autocomplete="off"
          )
        button.order-search-btn(type="submit")
          i.fa-solid.fa-magnifying-glass
          |  Tìm kiếm
        if searchQuery
          a.order-search-clear(
            href=`/${pathAdmin}/super-admin/orders/company/${company._id}/hotel-bookings`
            title="Xoá tìm kiếm"
            style="margin-left:8px;"
          )
            i.fa-solid.fa-xmark
            |  Xoá

  .section-6
    .table-2
      table
        thead
          tr
            th Mã
            th Khách sạn
            th Khách
            th Nhận phòng
            th Đêm
            th Loại phòng
            th Thanh toán
            th Trạng thái
            th Hành động
        tbody
          if bookings && bookings.length
            each row in bookings
              tr
                td
                  .inner-code= row.bookingId
                td= row.hotelName
                td
                  div= row.customerName
                  if row.customerEmail
                    div(style="font-size:12px;color:#64748b;")= row.customerEmail
                td= row.checkIn
                td.text-center= row.nights
                td
                  div(style="max-width:220px;font-size:13px;")= row.roomType
                  if row.groupCount > 1
                    div(style="font-size:11px;color:#94a3b8;") #{row.groupCount} dòng booking
                td
                  span(class=`badge badge-${row.paymentStatusColor}`)= row.paymentStatus
                td
                  span(class=`badge badge-${row.statusColor}`)= row.status
                td
                  a.inner-btn.inner-btn-view(
                    href=`/${pathAdmin}/super-admin/orders/company/${company._id}/hotel-booking/${encodeURIComponent(row.bookingId)}`
                    title="Xem chi tiết"
                  )
                    i.fa-solid.fa-eye
          else
            tr
              td(colspan="9" style="text-align:center;padding:28px;color:#94a3b8;") Chưa có đơn đặt phòng

  if pagination && pagination.totalPage > 1
    .section-7
      span.inner-label
        | Hiển thị #{pagination.skip + 1}
        | - #{pagination.skip + bookings.length}
        | của #{pagination.totalRecord}
      select(class="inner-pagination" box-pagination)
        - for (let i = 1; i <= pagination.totalPage; i++)
          option(value=i selected=(i === pagination.currentPage)) Trang #{i}
