extends ../../layouts/default.pug

block main
  
  .box-head
    h1.box-title Tổng quan hệ thống
    span.company-badge(style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 8px 16px; border-radius: 6px; font-weight: 600;")
      i.fa-solid.fa-crown(style="margin-right: 6px;")
      | Super Admin

  //- Section 1
  .section-1
    .inner-item
      .inner-icon
        img(src="/admin/assets/images/section-1-icon-1.svg", alt="")
      .inner-content
        .inner-title Tổng số công ty
        .inner-number #{stats.totalCompanies}
        small(style="color: #666;") #{stats.activeCompanies} đang hoạt động
    
    .inner-item
      .inner-icon
        img(src="/admin/assets/images/section-1-icon-1.svg", alt="")
      .inner-content
        .inner-title Company Admins
        .inner-number #{stats.totalCompanyAdmins}
        small(style="color: #666;") #{stats.activeCompanyAdmins} active, 
          span(style="color: #f39c12; font-weight: 600;") #{stats.pendingCompanyAdmins} chờ duyệt

    .inner-item
      .inner-icon
        img(src="/admin/assets/images/section-1-icon-2.svg", alt="")
      .inner-content
        .inner-title Tổng đơn hàng
        .inner-number #{stats.totalOrders}
        small(style="color: #666;") #{stats.completedOrders} đã hoàn thành

    .inner-item
      .inner-icon
        img(src="/admin/assets/images/section-1-icon-3.svg", alt="")
      .inner-content
        .inner-title Tổng doanh thu
        .inner-number #{stats.totalRevenue.toLocaleString('vi-VN')}đ
        small(style="color: #666;") Từ tất cả đơn hàng đã hoàn thành

  //- Section 1 Row 2
  .section-1(style="margin-top: 20px;")
    .inner-item
      .inner-icon
        img(src="/admin/assets/images/section-1-icon-2.svg", alt="")
      .inner-content
        .inner-title Tổng số Tours
        .inner-number #{stats.totalTours}
        small(style="color: #666;") #{stats.activeTours} đang active

    .inner-item
      .inner-icon
        img(src="/admin/assets/images/section-1-icon-2.svg", alt="")
      .inner-content
        .inner-title Tổng số Hotels
        .inner-number #{stats.totalHotels}
        small(style="color: #666;") #{stats.activeHotels} đang active

    .inner-item
      .inner-icon
        img(src="/admin/assets/images/section-1-icon-1.svg", alt="")
      .inner-content
        .inner-title Tổng khách hàng
        .inner-number #{stats.totalCustomers}
        small(style="color: #666;") Người dùng đã đăng ký
  //- End Section 1

  style.
    .sa-revenue-section { margin-top: 32px; }
    .sa-revenue-section__head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
    .sa-revenue-section__title { font-size: 18px; font-weight: 700; color: #1e293b; margin: 0; }
    .sa-revenue-section__hint { font-size: 13px; color: #64748b; max-width: 720px; line-height: 1.45; }
    /* Mỗi biểu đồ một hàng full width — dễ đọc hơn so với nhiều cột */
    .sa-company-chart-grid { display: flex; flex-direction: column; gap: 24px; }
    .sa-company-chart-card {
      border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; background: #fff;
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }
    .sa-company-chart-card__head { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
    .sa-company-chart-card__head img { width: 36px; height: 36px; border-radius: 8px; object-fit: cover; }
    .sa-company-chart-card__name { font-weight: 600; font-size: 15px; color: #0f172a; flex: 1; min-width: 0; }
    .sa-company-chart-card__total { font-size: 13px; color: #059669; font-weight: 600; white-space: nowrap; }
    .sa-chart-wrap { position: relative; height: min(380px, 55vh); min-height: 300px; width: 100%; }
    .sa-hotel-company-block { margin-bottom: 36px; padding-bottom: 28px; border-bottom: 1px solid #e2e8f0; }
    .sa-hotel-company-block:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .sa-hotel-company-head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
    .sa-hotel-company-head h3 { margin: 0; font-size: 16px; font-weight: 700; color: #0f172a; }
    .sa-hotel-company-head .sa-badge-count { font-size: 12px; color: #64748b; font-weight: 500; }

  //- Khối 1: Doanh thu theo tour
  .section-3.sa-revenue-section
    .sa-revenue-section__head
      h2.sa-revenue-section__title
        i.fa-solid.fa-route(style="margin-right:8px;color:#2563eb")
        | Doanh thu theo tour
      p.sa-revenue-section__hint
        | Chỉ tính đơn tour đã thanh toán (paymentStatus = paid); không yêu cầu trạng thái đơn «done». Theo ngày tạo đơn.

    if tourRevenueByCompany && tourRevenueByCompany.length
      .table-1(style="margin-bottom: 20px;")
        table
          thead
            tr
              th STT
              th Công ty
              th Doanh thu (tổng)
              th Số đơn hàng
          tbody
            each company, index in tourRevenueByCompany
              tr
                td= index + 1
                td
                  if company.companyLogo
                    img(src=company.companyLogo alt=company.companyName style="width: 24px; height: 24px; border-radius: 50%; margin-right: 8px; vertical-align: middle;")
                  = company.companyName || 'N/A'
                td
                  strong(style="color: #2563eb; font-size: 15px;")= company.revenue.toLocaleString('vi-VN') + ' đ'
                td.text-center= company.orderCount
    else
      p(style="padding: 12px 0; color: #94a3b8;") Chưa có doanh thu tour theo công ty.

    if companiesWithCharts && companiesWithCharts.length
      .sa-company-chart-grid
        each co in companiesWithCharts
          .sa-company-chart-card
            .sa-company-chart-card__head
              if co.logo
                img(src=co.logo alt=co.name)
              else
                span(style="width:36px;height:36px;border-radius:8px;background:#e2e8f0;display:inline-flex;align-items:center;justify-content:center;color:#64748b;")
                  i.fa-solid.fa-building
              span.sa-company-chart-card__name= co.name
              span.sa-company-chart-card__total 12 tháng: #{co.tourTotal12m.toLocaleString('vi-VN')}đ
            .sa-chart-wrap
              canvas(id=`sa-chart-tour-${co._id}`)
    else
      p(style="padding: 12px 0; color: #94a3b8;") Chưa có công ty nào trong hệ thống.

  //- Khối 2: Doanh thu theo từng khách sạn (theo công ty)
  .section-3.sa-revenue-section
    .sa-revenue-section__head
      h2.sa-revenue-section__title
        i.fa-solid.fa-hotel(style="margin-right:8px;color:#0d9488")
        | Doanh thu theo từng khách sạn
      p.sa-revenue-section__hint
        | Mỗi khách sạn một biểu đồ. Chỉ tính booking đã thanh toán và không hủy.

    if companiesWithHotelCharts && companiesWithHotelCharts.length
      each block in companiesWithHotelCharts
        .sa-hotel-company-block
          .sa-hotel-company-head
            if block.logo
              img(src=block.logo alt=block.name style="width:32px;height:32px;border-radius:8px;object-fit:cover;")
            else
              span(style="width:32px;height:32px;border-radius:8px;background:#e2e8f0;display:inline-flex;align-items:center;justify-content:center;color:#64748b;")
                i.fa-solid.fa-building
            h3= block.name
            span.sa-badge-count
              | #{block.hotels.length} khách sạn

          if !block.hotels || !block.hotels.length
            p(style="padding: 8px 0; color: #94a3b8;") Công ty chưa có khách sạn nào.
          else
            .table-1(style="margin-bottom: 20px;")
              table
                thead
                  tr
                    th STT
                    th Khách sạn
                    th Doanh thu (12 tháng)
                    th Số booking
                tbody
                  each h, hi in block.hotels
                    tr
                      td= hi + 1
                      td
                        strong(style="color:#0f172a")= h.name
                      td
                        strong(style="color: #0d9488; font-size: 15px;")= h.total12m.toLocaleString('vi-VN') + ' đ'
                      td.text-center= h.bookingCount12m

            .sa-company-chart-grid
              each h in block.hotels
                .sa-company-chart-card
                  .sa-company-chart-card__head
                    span(style="width:36px;height:36px;border-radius:8px;background:#ccfbf1;display:inline-flex;align-items:center;justify-content:center;color:#0f766e;")
                      i.fa-solid.fa-bed
                    span.sa-company-chart-card__name= h.name
                    span.sa-company-chart-card__total 12 tháng: #{h.total12m.toLocaleString('vi-VN')}đ
                  .sa-chart-wrap
                    canvas(id=`sa-chart-hotel-${h._id}`)
    else
      p(style="padding: 12px 0; color: #94a3b8;") Chưa có dữ liệu công ty / khách sạn.

  //- Pending Admins
  if pendingAdmins && pendingAdmins.length
    .section-3(style="margin-top: 30px;")
      .inner-title
        | Company Admin chờ phê duyệt 
        span.badge.badge-orange(style="margin-left: 10px;")= pendingAdmins.length
      .table-1
        table
          thead
            tr
              th Họ tên
              th Email
              th Công ty
              th Ngày đăng ký
              th Hành động
          tbody
            each admin in pendingAdmins
              tr
                td= admin.fullName
                td= admin.email
                td
                  if admin.companyId
                    = admin.companyId.name
                  else
                    | N/A
                td= new Date(admin.createdAt).toLocaleDateString('vi-VN')
                td
                  button.button.button-green(
                    onclick=`approveAdmin('${admin._id}')`
                    style="margin-right: 8px;"
                  ) 
                    i.fa-solid.fa-check
                    |  Phê duyệt
                  button.button.button-red(
                    onclick=`rejectAdmin('${admin._id}')`
                  )
                    i.fa-solid.fa-times
                    |  Từ chối

  script.
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof Chart === 'undefined') return;
      var monthLabels = !{JSON.stringify(monthLabels || [])};
      var companies = !{JSON.stringify(companiesWithCharts || [])};
      companies.forEach(function (c) {
        var tid = 'sa-chart-tour-' + c._id;
        var elTour = document.getElementById(tid);
        if (elTour) {
          new Chart(elTour, {
            type: 'bar',
            data: {
              labels: monthLabels,
              datasets: [
                {
                  label: 'Doanh thu tour (đ)',
                  data: c.tourByMonth,
                  backgroundColor: 'rgba(37, 99, 235, 0.55)',
                  borderColor: 'rgba(37, 99, 235, 1)',
                  borderWidth: 1,
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { display: true } },
              scales: {
                x: { ticks: { maxRotation: 45, minRotation: 0, font: { size: 10 } } },
                y: { beginAtZero: true, ticks: { callback: function (v) { return Number(v).toLocaleString('vi-VN'); } } },
              },
            },
          });
        }
      });

      var hotelBlocks = !{JSON.stringify(companiesWithHotelCharts || [])};
      hotelBlocks.forEach(function (block) {
        (block.hotels || []).forEach(function (h) {
          var elHotel = document.getElementById('sa-chart-hotel-' + h._id);
          if (!elHotel) return;
          new Chart(elHotel, {
            type: 'bar',
            data: {
              labels: monthLabels,
              datasets: [
                {
                  label: 'Doanh thu (đ)',
                  data: h.hotelByMonth,
                  backgroundColor: 'rgba(13, 148, 136, 0.55)',
                  borderColor: 'rgba(13, 148, 136, 1)',
                  borderWidth: 1,
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { display: true } },
              scales: {
                x: { ticks: { maxRotation: 45, minRotation: 0, font: { size: 10 } } },
                y: { beginAtZero: true, ticks: { callback: function (v) { return Number(v).toLocaleString('vi-VN'); } } },
              },
            },
          });
        });
      });
    });

    function approveAdmin(id) {
      if (!confirm('Phê duyệt tài khoản này?')) return;
      
      fetch(`/${pathAdmin}/super-admin/admin/approve`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      })
      .then(res => res.json())
      .then(data => {
        if (data.code === 'success') {
          drawNotify('success', data.message);
          setTimeout(() => location.reload(), 1000);
        } else {
          drawNotify('error', data.message);
        }
      })
      .catch(err => drawNotify('error', 'Có lỗi xảy ra!'));
    }

    function rejectAdmin(id) {
      if (!confirm('Từ chối tài khoản này?')) return;
      
      fetch(`/${pathAdmin}/super-admin/admin/reject`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      })
      .then(res => res.json())
      .then(data => {
        if (data.code === 'success') {
          drawNotify('success', data.message);
          setTimeout(() => location.reload(), 1000);
        } else {
          drawNotify('error', data.message);
        }
      })
      .catch(err => drawNotify('error', 'Có lỗi xảy ra!'));
    }


