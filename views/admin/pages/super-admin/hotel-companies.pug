extends ../../layouts/default.pug

block main

  .box-head
    h1.box-title Khách sạn theo công ty
    p.page-subtitle(style="margin:8px 0 0;color:#64748b;font-size:14px;")
      | Chọn công ty để xem danh sách khách sạn.

  //- Bộ lọc
  .section-4
    form#form-filter-companies(method="GET" action=`/${pathAdmin}/super-admin/hotels`)
      .inner-form
        .inner-input
          input(
            type="text",
            name="keyword",
            placeholder="Tìm tên công ty...",
            value=keyword || ""
          )
        .inner-select
          select(name="status")
            option(value="") -- Tất cả trạng thái --
            option(value="active", selected=statusFilter === "active") Hoạt động
            option(value="inactive", selected=statusFilter === "inactive") Tạm dừng
        .inner-button
          button.inner-submit(type="submit") Lọc

  //- Cài đặt ảnh breadcrumb (trang tìm kiếm khách sạn)
  .section-breadcrumb-setting(style="margin-bottom: 20px; padding: 20px; background: #f8f9fa; border-radius: 8px;")
    h3(style="margin-top: 0; margin-bottom: 15px; font-size: 18px;") Cài đặt ảnh breadcrumb cho trang tìm kiếm khách sạn
    form#form-breadcrumb-image(style="display: flex; gap: 15px; align-items: flex-end;")
      .form-group(style="flex: 1;")
        label(style="display: block; margin-bottom: 5px; font-weight: 500;") Ảnh breadcrumb (trang /hotel/search)
        input#breadcrumbImage(type="file" name="breadcrumbImage" accept="image/*" style="display: block; width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;")
        if hotelSearchBreadcrumbImage
          .current-image(style="margin-top: 10px;")
            span(style="display: block; margin-bottom: 5px; font-size: 14px; color: #666;") Ảnh hiện tại:
            img(src=hotelSearchBreadcrumbImage alt="Breadcrumb hiện tại" style="max-width: 300px; max-height: 150px; border-radius: 4px; border: 1px solid #ddd;")
        else
          p(style="margin-top: 10px; font-size: 14px; color: #999;") Chưa có ảnh breadcrumb
      .form-group
        button.btn.btn-primary(type="submit" style="padding: 8px 20px; background: #4502c7; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 500;")
          i.fa-solid.fa-upload(style="margin-right: 5px;")
          | Upload ảnh

  .section-6
    .table-2
      table
        thead
          tr
            th STT
            th Logo
            th Tên công ty
            th Số khách sạn
            th Trạng thái
            th Hành động
        tbody
          if companies && companies.length
            each company, index in companies
              tr
                td= index + 1
                td
                  if company.logo
                    img(src=company.logo alt=company.name style="width:56px;height:56px;object-fit:cover;border-radius:8px;")
                  else
                    span(style="color:#94a3b8;")
                      i.fa-solid.fa-building(style="font-size:28px;")
                td
                  strong= company.name
                td.text-center(style="color:#000;background:transparent;")= company.hotelCount || 0
                td.text-center(style="color:#000;background:transparent;")
                  if company.status === "active"
                    | Hoạt động
                  else
                    | Tạm dừng
                td
                  a.inner-btn.inner-btn-view(
                    href=`/${pathAdmin}/super-admin/hotels/company/${company._id}`
                    title="Xem danh sách khách sạn"
                  )
                    i.fa-solid.fa-eye
                    |  Xem chi tiết
          else
            tr
              td(colspan="6" style="text-align:center;padding:32px;color:#94a3b8;") Không có công ty nào

  script.
    var _hotelSaPath = '!{pathAdmin}';
    document.addEventListener('DOMContentLoaded', function() {
      var form = document.getElementById('form-breadcrumb-image');
      if (!form) return;
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        var fileInput = document.getElementById('breadcrumbImage');
        if (!fileInput.files || !fileInput.files[0]) {
          alert('Vui lòng chọn ảnh để upload!');
          return;
        }
        var formData = new FormData();
        formData.append('breadcrumbImage', fileInput.files[0]);
        try {
          var response = await fetch('/' + _hotelSaPath + '/super-admin/hotels/breadcrumb-image', {
            method: 'PATCH',
            body: formData,
            credentials: 'same-origin',
          });
          var data = await response.json();
          if (data.code === 'success') {
            alert('Upload ảnh breadcrumb thành công!');
            location.reload();
          } else {
            alert('Lỗi: ' + (data.message || 'Có lỗi xảy ra!'));
          }
        } catch (err) {
          console.error(err);
          alert('Có lỗi xảy ra khi upload ảnh!');
        }
      });
    });
