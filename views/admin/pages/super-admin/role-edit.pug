extends ../../layouts/default.pug

block main

  .box-head
    a.button.button-outline(
      href=`/${pathAdmin}/super-admin/roles`
      style="margin-bottom:12px;display:inline-flex;align-items:center;gap:8px;"
    )
      i.fa-solid.fa-arrow-left
      |  Danh sách vai trò
    h1.box-title(style="margin-top:0")= pageTitle

  .section-8
    form#sa-role-edit-form(data-id=String(roleDetail._id) style="max-width:760px;display:grid;gap:14px;")
      .inner-group
        label.inner-label(for="name") Tên nhóm quyền
        input#name(type="text" name="name" value=roleDetail.name required)
      .inner-group
        label.inner-label(for="description") Mô tả ngắn
        input#description(type="text" name="description" value=roleDetail.description)
      .inner-group
        label.inner-label Phân quyền
        .inner-checkbox-list
          each item in permissionList
            .inner-checkbox-item
              input(
                type="checkbox"
                id=`permission-${item.value}`
                name="permissions"
                value=item.value
                checked=(roleDetail.permissions || []).includes(item.value)
              )
              label(for=`permission-${item.value}`)= item.label
      .inner-button.inner-two-col
        button(type="submit") Cập nhật

  script.
    const form = document.getElementById('sa-role-edit-form');
    const id = form.getAttribute('data-id');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = {
        name: fd.get('name'),
        description: fd.get('description'),
        permissions: fd.getAll('permissions'),
      };
      fetch(`/${window.location.pathname.split('/')[1]}/super-admin/roles/edit/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(r => r.json())
        .then(d => {
          alert(d.message);
          if (d.code === 'success') location.href = `/${window.location.pathname.split('/')[1]}/super-admin/roles`;
        });
    });
