extends ../../layouts/default.pug

block main

  .box-head(style="display:flex;justify-content:space-between;align-items:center;")
    h1.box-title= pageTitle
    a.button.button-primary(href=`/${pathAdmin}/super-admin/roles/create`)
      i.fa-solid.fa-plus
      |  Tạo nhóm quyền

  .section-6
    .table-2
      table
        thead
          tr
            th STT
            th Tên nhóm
            th Mô tả
            th(class="inner-center") Số quyền
            th(class="inner-center") Đang dùng
            th Ngày tạo
            th(class="inner-center") Hành động
        tbody
          if roles && roles.length
            each r, idx in roles
              tr
                td= idx + 1
                td(style="font-weight:600;")= r.name
                td(style="color:#64748b;font-size:13px;")= r.description || '-'
                td(class="inner-center")= (r.permissions || []).length
                td(class="inner-center")
                  if r.usedBy > 0
                    span.badge.badge-blue #{r.usedBy} tài khoản
                  else
                    span(style="color:#94a3b8;") -
                td(style="font-size:12px;")= new Date(r.createdAt).toLocaleDateString('vi-VN')
                td(class="inner-center")
                  .inner-buttons
                    a.inner-edit(
                      href=`/${pathAdmin}/super-admin/roles/edit/${r._id}`
                      title="Sửa"
                    )
                      i.fa-regular.fa-pen-to-square
                    button(
                      type="button" class="inner-delete" title="Xoá"
                      onclick=`deleteRole('${r._id}', ${r.usedBy})`
                    )
                      i.fa-regular.fa-trash-can
          else
            tr
              td(colspan="7" class="inner-center" style="padding:24px;color:#94a3b8;") Chưa có nhóm quyền

  script.
    function deleteRole(id, usedBy) {
      if (usedBy > 0) {
        alert('Đang có ' + usedBy + ' tài khoản dùng vai trò này. Hãy gán vai trò khác trước.');
        return;
      }
      if (!confirm('Xoá vai trò này?')) return;
      fetch(`/${window.location.pathname.split('/')[1]}/super-admin/roles/${id}`, { method: 'DELETE' })
        .then(r => r.json())
        .then(d => { alert(d.message); if (d.code === 'success') location.reload(); });
    }
