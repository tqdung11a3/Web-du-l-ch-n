extends ../../layouts/default.pug

block main

  h1.box-title= pageTitle

  .section-4
    form.inner-wrap(method="GET" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;")
      .inner-item
        i.fa-solid.fa-filter
        |  Bộ lọc
      .inner-item
        input(
          type="text"
          name="keyword"
          placeholder="Email..."
          value=keyword
          style="height:38px;padding:0 12px;border:1px solid #d5d5d5;border-radius:4px;font-size:14px;"
        )
      .inner-item
        select(name="handled" style="height:38px;padding:0 12px;border:1px solid #d5d5d5;border-radius:4px;font-size:14px;")
          option(value="" selected=!handled) Tất cả
          option(value="no" selected=handled==='no') Chưa xử lý
          option(value="yes" selected=handled==='yes') Đã xử lý
      .inner-item
        input(type="date" name="startDate" value=startDate style="height:38px;padding:0 8px;border:1px solid #d5d5d5;border-radius:4px;")
        span.mx-2 -
        input(type="date" name="endDate" value=endDate style="height:38px;padding:0 8px;border:1px solid #d5d5d5;border-radius:4px;")
      .inner-item
        button(type="submit" style="height:38px;padding:0 18px;background:var(--color-primary);color:#fff;border:0;border-radius:4px;font-weight:600;cursor:pointer;") Lọc
        a(href=`/${pathAdmin}/super-admin/contacts` style="margin-left:8px;color:#64748b;") Xóa lọc

  .section-6
    .table-2
      table
        thead
          tr
            th STT
            th Email
            th Ngày gửi
            th Trạng thái
            th Người xử lý
            th Ghi chú
            th(class="inner-center") Hành động
        tbody
          if items && items.length
            each it, idx in items
              tr(data-id=it._id)
                td= (pagination.skip || 0) + idx + 1
                td= it.email
                td= it.createdAtFormat
                td
                  if it.handled
                    span.badge.badge-green Đã xử lý
                  else
                    span.badge.badge-orange Chưa xử lý
                td= it.handledByName || '-'
                td
                  span.contact-note(style="font-size:12px;color:#64748b;")= it.note || '-'
                td(class="inner-center")
                  .inner-buttons
                    button(
                      type="button"
                      class="inner-edit"
                      title=it.handled ? 'Đánh dấu chưa xử lý' : 'Đánh dấu đã xử lý'
                      onclick=`toggleHandled('${it._id}', ${it.handled ? 'false' : 'true'})`
                    )
                      if it.handled
                        i.fa-solid.fa-rotate-left
                      else
                        i.fa-solid.fa-check
                    button(
                      type="button"
                      class="inner-delete"
                      title="Xóa"
                      onclick=`deleteContact('${it._id}')`
                    )
                      i.fa-regular.fa-trash-can
          else
            tr
              td(colspan="7" class="inner-center" style="padding:24px;color:#94a3b8;") Không có dữ liệu

  if pagination && pagination.totalPage > 1
    .section-7
      span.inner-label
        | Hiển thị #{pagination.skip + 1} - #{Math.min(pagination.skip + pagination.limitItems, pagination.totalRecord)} của #{pagination.totalRecord}
      select(class="inner-pagination" box-pagination)
        - for (let i = 1; i <= pagination.totalPage; i++)
          option(value=i selected=(i === pagination.currentPage)) Trang #{i}

  script.
    function toggleHandled(id, handled) {
      const note = prompt('Ghi chú (có thể bỏ trống):', '');
      fetch(`/${window.location.pathname.split('/')[1]}/super-admin/contacts/mark-handled`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, handled, note: note || '' })
      })
      .then(r => r.json())
      .then(d => { alert(d.message); if (d.code === 'success') location.reload(); });
    }
    function deleteContact(id) {
      if (!confirm('Xóa liên hệ này?')) return;
      fetch(`/${window.location.pathname.split('/')[1]}/super-admin/contacts/${id}`, { method: 'DELETE' })
        .then(r => r.json())
        .then(d => { alert(d.message); if (d.code === 'success') location.reload(); });
    }
