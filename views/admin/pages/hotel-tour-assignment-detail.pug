extends ../layouts/default.pug

block main
  //- Giữ ?hotelId= khi điều hướng (đồng bộ hotel-selector-bar)
  - var _htaHid = (typeof selectedHotelId !== 'undefined' && selectedHotelId) ? String(selectedHotelId) : ''
  - var _htaTourListQs = _htaHid ? ('?hotelId=' + encodeURIComponent(_htaHid)) : ''
  - var _htaSegQs = _htaHid ? ('?hotelId=' + encodeURIComponent(_htaHid)) : ''
  - var _htaOrderHotelAmp = _htaHid ? ('&hotelId=' + encodeURIComponent(_htaHid)) : ''

  //- ══════════════════════════════════════════════════════════════════════════
  //- MODE 1: Danh sách khách hàng của 1 tour-segment (customer == null)
  //- ══════════════════════════════════════════════════════════════════════════
  if !customer
    h1.box-title Phân phòng khách tour – #{tour ? tour.name : 'Tour'}

    .th-breadcrumb
      a(href=`/${pathAdmin}/hotel/tour-assignments${_htaTourListQs}`)
        i.fa-solid.fa-arrow-left
        |  Phân phòng cho tour
      span.th-sep  /
      span Khởi hành #{departureDateDisplay}

    .assign-info-bar
      .assign-info-bar__item
        i.fa-solid.fa-map-route
        span= tour ? tour.name : 'Tour'
      .assign-info-bar__item
        i.fa-solid.fa-calendar-day
        span  Khởi hành: #{departureDateDisplay}
      .assign-info-bar__item
        i.fa-solid.fa-calendar-check
        span  Kết thúc: #{moment(tourSeg.endDate).format('DD/MM/YYYY')}
      .assign-info-bar__item
        i.fa-solid.fa-hotel
        span  Phòng (của bạn): #{holdsByHotel.reduce((s,h) => s + h.rooms.length, 0)}

    //- Tổng hợp nhu cầu lưu trú: phân loại "Ở riêng" vs "Ở ghép"
    //- để admin biết cần xếp bao nhiêu phòng riêng và bao nhiêu nhóm ghép.
    -
      var summaryPrivateOrders = 0
      var summarySharedOrders = 0
      var summarySharedMales = 0
      var summarySharedFemales = 0
      var summaryPrivateRoomsRequested = 0
      ;(customers || []).forEach(function(c){
        if (c.accommodationMode === 'shared') {
          summarySharedOrders += 1
          ;(c.sharedRoomRequest || []).forEach(function(r){
            summarySharedMales += Number(r.males) || 0
            summarySharedFemales += Number(r.females) || 0
          })
        } else {
          summaryPrivateOrders += 1
          ;(c.roomSelections || []).forEach(function(rs){
            summaryPrivateRoomsRequested += Number(rs.selectedRooms) || 0
          })
        }
      })
    if customers && customers.length > 0
      .assign-demand-summary(style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px")
        .assign-demand-summary__item(style="flex:1;min-width:240px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:10px 14px")
          .assign-demand-summary__title(style="font-weight:600;color:#1e293b;margin-bottom:4px")
            i.fa-solid.fa-bed(style="color:#475569;margin-right:6px")
            | Đã chọn phòng riêng
          .assign-demand-summary__value(style="font-size:13px;color:#475569")
            | #{summaryPrivateOrders} đơn · #{summaryPrivateRoomsRequested} phòng đã đặt
        .assign-demand-summary__item(style="flex:1;min-width:240px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:10px 14px")
          .assign-demand-summary__title(style="font-weight:600;color:#1e3a8a;margin-bottom:4px")
            i.fa-solid.fa-people-group(style="color:#1d4ed8;margin-right:6px")
            | Yêu cầu ở ghép (cộng dồn)
          .assign-demand-summary__value(style="font-size:13px;color:#1e3a8a")
            | #{summarySharedOrders} đơn · #{summarySharedMales} nam · #{summarySharedFemales} nữ

    .assign-customer-list-section
      h2.assign-col__title
        i.fa-solid.fa-list-check
        |  Khách hàng đã đặt phòng của bạn (#{customers.length} đơn)

      if !customers || customers.length === 0
        .assign-empty
          i.fa-solid.fa-circle-info
          |  Chưa có đơn hàng nào liên quan đến khách sạn của bạn trong lịch khởi hành này.
      else
        .assign-cust-table-wrap
          table.assign-cust-table
            thead
              tr
                th STT
                th Khách hàng
                th Số điện thoại
                th Mã đơn hàng
                th Số người
                th Hình thức
                th Trạng thái gán phòng
                th Thao tác
            tbody
              each cust, idx in customers
                tr
                  td= idx + 1
                  td
                    .assign-cust-table__name
                      i.fa-solid.fa-user
                      |  #{cust.guestName || 'Khách'}
                  td= cust.phone || '—'
                  td
                    span.assign-cust-table__code= '#' + cust.orderCode
                  td
                    span.assign-pax-badge.assign-pax-badge--adult
                      | #{cust.quantityAdult} NL
                    if cust.quantityChildren > 0
                      |  
                      span.assign-pax-badge.assign-pax-badge--child
                        | #{cust.quantityChildren} TE
                    if cust.quantityBaby > 0
                      |  
                      span.assign-pax-badge.assign-pax-badge--baby
                        | #{cust.quantityBaby} EB
                  td
                    if cust.accommodationMode === 'shared'
                      span.assign-pax-badge(style="background:#dbeafe;color:#1e3a8a")
                        i.fa-solid.fa-people-group
                        |  Ở ghép
                      //- Hiển thị số phòng thuộc CHÍNH hotel này (nếu khách
                      //- được phân ra nhiều hotel cùng segment).
                      -
                        var custRoomsHere = 0;
                        var custMalesAll = 0, custFemalesAll = 0;
                        var hasMultiHotelSplit = false;
                        (cust.sharedRoomRequest || []).forEach(function(r){
                          custMalesAll += Number(r.males) || 0;
                          custFemalesAll += Number(r.females) || 0;
                          if (Array.isArray(r.hotelAllocations) && r.hotelAllocations.length > 0) {
                            if (r.hotelAllocations.length > 1) hasMultiHotelSplit = true;
                            r.hotelAllocations.forEach(function(a){
                              if (selectedHotelId && String(a.hotelId) === String(selectedHotelId)) {
                                var roomCnt = Array.isArray(a.roomAssignments) ? a.roomAssignments.length : 0;
                                custRoomsHere += roomCnt || (a.atomLabels || []).length;
                              }
                            });
                          }
                        });
                      if custMalesAll > 0 || custFemalesAll > 0
                        br
                        span.assign-pax-ages= '(' + custMalesAll + ' nam, ' + custFemalesAll + ' nữ)'
                      if selectedHotelId && custRoomsHere > 0
                        br
                        span.assign-pax-ages(style="color:#0e7490;font-weight:600")= '· ' + custRoomsHere + ' phòng tại KS này'
                      if hasMultiHotelSplit
                        br
                        span.assign-pax-ages(style="color:#b45309") · Đoàn được chia trên nhiều KS
                    else
                      span.assign-pax-badge(style="background:#f1f5f9;color:#475569")
                        i.fa-solid.fa-bed
                        |  Ở riêng
                  td
                    if cust.assignStatus === 'complete'
                      span.assign-status-badge.assign-status-badge--complete
                        i.fa-solid.fa-circle-check
                        |  Đã gán đủ
                    else if cust.assignStatus === 'excess'
                      span.assign-status-badge.assign-status-badge--excess
                        i.fa-solid.fa-layer-group
                        |  Gán dư phòng
                    else if cust.assignStatus === 'partial'
                      span.assign-status-badge.assign-status-badge--partial
                        i.fa-solid.fa-clock
                        |  Gán chưa đủ (#{cust.assignedCount} phòng)
                    else
                      span.assign-status-badge.assign-status-badge--none
                        i.fa-solid.fa-triangle-exclamation
                        |  Chưa gán phòng
                  td
                    a.btn-assign-detail(href=`/${pathAdmin}/hotel/tour-assignments/${tourSeg._id}?orderId=${cust.orderId}${_htaOrderHotelAmp}`)
                      i.fa-solid.fa-user-tag
                      |  Phân phòng

  //- ══════════════════════════════════════════════════════════════════════════
  //- MODE 2: Phân phòng cho 1 khách hàng cụ thể
  //- ══════════════════════════════════════════════════════════════════════════
  else
    h1.box-title Phân phòng – #{customer.guestName || customer.orderCode}

    .th-breadcrumb
      a(href=`/${pathAdmin}/hotel/tour-assignments${_htaTourListQs}`)
        i.fa-solid.fa-arrow-left
        |  Phân phòng cho tour
      span.th-sep  /
      a(href=`/${pathAdmin}/hotel/tour-assignments/${tourSeg._id}${_htaSegQs}`) Danh sách khách
      span.th-sep  /
      span #{customer.guestName || customer.orderCode}

    .assign-info-bar
      .assign-info-bar__item
        i.fa-solid.fa-map-route
        span= tour ? tour.name : 'Tour'
      .assign-info-bar__item
        i.fa-solid.fa-calendar-day
        span  Khởi hành: #{departureDateDisplay}
      .assign-info-bar__item
        i.fa-solid.fa-calendar-check
        span  Kết thúc: #{moment(tourSeg.endDate).format('DD/MM/YYYY')}

    .assign-layout

      .assign-col.assign-col--left
        h2.assign-col__title
          i.fa-solid.fa-user-circle
          |  Thông tin khách hàng

        .assign-customer-card.assign-customer-card--single(data-order-id=customer.orderId)
          .assign-customer-card__header
            .assign-customer-card__meta
              span.assign-customer-card__name
                i.fa-solid.fa-user
                |  #{customer.guestName || 'Khách'}
              span.assign-customer-card__phone #{customer.phone}
            .assign-customer-card__code ##{customer.orderCode}
          if customer.note
            .assign-customer-card__note
              i.fa-solid.fa-note-sticky
              |  #{customer.note}
          .assign-customer-card__body
            .assign-customer-card__people
              if customer.quantityAdult > 0
                span.assign-pax-badge.assign-pax-badge--adult
                  i.fa-solid.fa-user
                  |  #{customer.quantityAdult} NL
              if customer.quantityChildren > 0
                span.assign-pax-badge.assign-pax-badge--child
                  i.fa-solid.fa-child
                  |  #{customer.quantityChildren} TE
                  if customer.childrenAges && customer.childrenAges.length
                    span.assign-pax-ages
                      |  (
                      each age, idx in customer.childrenAges
                        if idx > 0
                          | ,#{' '}
                        | #{age}t
                      | )
              if customer.quantityBaby > 0
                span.assign-pax-badge.assign-pax-badge--baby
                  i.fa-solid.fa-baby
                  |  #{customer.quantityBaby} EB
                  if customer.babyAges && customer.babyAges.length
                    span.assign-pax-ages
                      |  (
                      each age, idx in customer.babyAges
                        if idx > 0
                          | ,#{' '}
                        | #{age}t
                      | )
              span.assign-pax-total  · #{customer.totalPeople} người
            //- Hình thức lưu trú
            if customer.accommodationMode === 'shared'
              span.assign-pax-badge.assign-pax-badge--shared(style="background:#dbeafe;color:#1e3a8a")
                i.fa-solid.fa-people-group
                |  Ở ghép
            else if customer.accommodationMode === 'private'
              span.assign-pax-badge.assign-pax-badge--private(style="background:#f1f5f9;color:#475569")
                i.fa-solid.fa-bed
                |  Ở riêng

            -
              var _isAutoAssigned = false;
              if (customer.accommodationMode === 'shared' && Array.isArray(customer.sharedRoomRequest)) {
                for (var _ri = 0; _ri < customer.sharedRoomRequest.length; _ri++) {
                  var _rr = customer.sharedRoomRequest[_ri];
                  var _als = (_rr && _rr.hotelAllocations) || [];
                  for (var _ai = 0; _ai < _als.length; _ai++) {
                    var _al = _als[_ai];
                    if (selectedHotelId && String(_al.hotelId) !== String(selectedHotelId)) continue;
                    if ((_al.roomAssignments || []).length > 0) { _isAutoAssigned = true; break; }
                  }
                  if (_isAutoAssigned) break;
                }
              }
            if customer.accommodationMode === 'shared' && customer.sharedRoomRequest && customer.sharedRoomRequest.length > 0
              .assign-customer-card__booked-rooms
                .assign-customer-card__booked-rooms-title
                  i.fa-solid.fa-people-group(style="margin-right:4px")
                  | Yêu cầu ở ghép tại KS của bạn:
                each r in customer.sharedRoomRequest
                  .assign-booked-seg
                    .assign-booked-seg__date= r.fromDate + ' → ' + r.toDate
                    //- Đơn mới: render từng hotel trong hotelAllocations.
                    //- Đơn cũ: render hotelId/hotelName + males/females.
                    if r.hotelAllocations && r.hotelAllocations.length > 0
                      each a in r.hotelAllocations
                        - var _isHere = selectedHotelId && String(a.hotelId) === String(selectedHotelId)
                        .assign-booked-row(style=_isHere ? 'background:#ecfdf5;border-left:3px solid #10b981;padding-left:6px' : '')
                          span.assign-booked-row__hotel
                            i.fa-solid.fa-hotel(style="margin-right:4px;color:#6366f1")
                            = a.hotelName || '—'
                            if _isHere
                              span(style="font-size:11px;color:#047857;margin-left:4px") (KS này)
                          span.assign-booked-row__type= (a.atomLabels || []).length + ' nhóm · sức chứa ' + (a.totalEffectiveSize || 0)
                        if a.atomLabels && a.atomLabels.length
                          .assign-booked-row(style="flex-wrap:wrap;gap:4px;font-size:12px;color:#475569")
                            each lbl in a.atomLabels
                              span(style="background:#f1f5f9;border-radius:4px;padding:2px 6px") #{lbl}
                        //- Ưu tiên currentAssignmentsByHotel (đồng bộ sau khi admin đổi phòng)
                        //- Fallback về a.roomAssignments nếu chưa có dữ liệu từ tourSeg.
                        -
                          var _curByHotel = (customer.currentAssignmentsByHotel || []).find(function(h){ return String(h.hotelId) === String(a.hotelId); });
                          var _curRooms = _curByHotel ? _curByHotel.rooms : null;
                          var _useCurrent = _curRooms && _curRooms.length > 0;
                        .assign-booked-allocated(data-hotel-id=a.hotelId)
                          if _useCurrent
                            .assign-booked-row(style="flex-direction:column;align-items:flex-start;gap:4px;font-size:12.5px;margin-top:4px")
                              span(style="font-weight:600;color:#0f172a")
                                i.fa-solid.fa-bed(style="margin-right:4px;color:#0ea5e9")
                                | Phòng đã phân:
                              each ra in _curRooms
                                .assign-booked-row(style="gap:8px;background:#f0fdf4;padding:6px 8px;border-radius:6px;width:100%;align-items:center;border-left:3px solid #10b981")
                                  if ra.gender
                                    span(style="font-size:11px;padding:2px 6px;border-radius:4px;color:#fff;background:" + (ra.gender === 'female' ? '#ec4899' : '#3b82f6'))
                                      = ra.gender === 'female' ? 'Phòng nữ' : 'Phòng nam'
                                  span(style="font-weight:600") Phòng #{ra.roomNumber || '?'}
                                  span(style="color:#64748b") #{ra.roomTypeName || 'Phòng'}
                                  if ra.atomLabels && ra.atomLabels.length
                                    span(style="color:#0f172a") • #{ra.atomLabels.join(', ')}
                                  else if ra.guestName
                                    span(style="color:#0f172a") • #{ra.guestName}
                          else if a.roomAssignments && a.roomAssignments.length
                            .assign-booked-row(style="flex-direction:column;align-items:flex-start;gap:4px;font-size:12.5px;margin-top:4px")
                              span(style="font-weight:600;color:#0f172a")
                                i.fa-solid.fa-bed(style="margin-right:4px;color:#0ea5e9")
                                | Phòng tự gán:
                              each ra in a.roomAssignments
                                .assign-booked-row(style="gap:8px;background:#f8fafc;padding:6px 8px;border-radius:6px;width:100%;align-items:center")
                                  span(class=(ra.gender === 'female' ? 'badge badge--pink' : 'badge badge--blue'), style="font-size:11px;padding:2px 6px;border-radius:4px;color:#fff;background:" + (ra.gender === 'female' ? '#ec4899' : '#3b82f6'))
                                    = ra.gender === 'female' ? 'Phòng nữ' : 'Phòng nam'
                                  span(style="font-weight:600") #{ra.roomTypeName || 'Phòng'}
                                  span(style="color:#64748b") (#{ra.usedCapacity}/#{ra.baseOccupancy})
                                  if ra.atomLabels && ra.atomLabels.length
                                    span(style="color:#0f172a") • #{ra.atomLabels.join(', ')}
                      if r.hotelAllocations.length > 1
                        .assign-booked-row(style="font-size:12px;color:#b45309;margin-top:2px")
                          i.fa-solid.fa-circle-info(style="margin-right:4px")
                          | Đoàn được chia trên #{r.hotelAllocations.length} khách sạn cùng khung
                    else
                      .assign-booked-row
                        span.assign-booked-row__hotel= r.hotelName
                        span.assign-booked-row__type= 'Yêu cầu ' + (Number(r.males) || 0) + ' nam, ' + (Number(r.females) || 0) + ' nữ'

              //- Family unit (atom) cards: chỉ hiển thị khi chưa được hệ thống
              //- tự gán phòng — vì khi đã tự gán, danh sách "Phòng tự gán" ở
              //- trên đã thể hiện rõ ai ở cùng ai.
              if customer.passengers && customer.passengers.length && !_isAutoAssigned
                -
                  var psList = customer.passengers || [];
                  var adultMap = {};
                  var GUARDIAN_MIN_AGE_PUG = 18;
                  psList.forEach(function(p) {
                    if (p.type !== 'adult') return;
                    var ageNum = parseInt(p.age, 10);
                    if (!isNaN(ageNum) && ageNum >= GUARDIAN_MIN_AGE_PUG) {
                      adultMap[p.idx] = { adult: p, kids: [] };
                    }
                  });
                  psList.forEach(function(p) {
                    if (p.type === 'adult') {
                      var ageNum = parseInt(p.age, 10);
                      if (!isNaN(ageNum) && ageNum < GUARDIAN_MIN_AGE_PUG && p.guardianIdx != null && adultMap[p.guardianIdx]) {
                        adultMap[p.guardianIdx].kids.push(p);
                      }
                    } else if (p.type === 'baby') {
                      var babyAnchor = (p.roomGuardianIdx !== null && p.roomGuardianIdx !== undefined)
                        ? p.roomGuardianIdx
                        : p.guardianIdx;
                      if (babyAnchor != null && adultMap[babyAnchor]) {
                        adultMap[babyAnchor].kids.push(p);
                      }
                    } else if (adultMap[p.guardianIdx]) {
                      adultMap[p.guardianIdx].kids.push(p);
                    }
                  });
                  var atomList = Object.values(adultMap);
                .assign-customer-card__atoms(style="margin-top:8px")
                  .assign-customer-card__booked-rooms-title
                    i.fa-solid.fa-people-roof(style="margin-right:4px")
                    | #{atomList.length} nhóm cần ở cùng phòng:
                  .assign-atom-list(style="display:flex;flex-direction:column;gap:6px;margin-top:4px")
                    each atom in atomList
                      .assign-atom-card(style="border:1px solid #e2e8f0;border-radius:6px;padding:6px 8px;background:#f8fafc;font-size:12px")
                        div(style="font-weight:600;color:#0f172a")
                          if atom.adult.gender === 'male'
                            i.fa-solid.fa-mars(style="color:#3b82f6;margin-right:4px")
                          else
                            i.fa-solid.fa-venus(style="color:#ec4899;margin-right:4px")
                          | #{atom.adult.name || ('Người lớn #' + (atom.adult.idx + 1))} (#{atom.adult.age}t)
                        if atom.kids.length > 0
                          div(style="color:#475569;margin-top:2px")
                            | đi cùng:
                            each k in atom.kids
                              span(style="margin-left:6px;display:inline-block")
                                if k.type === 'child'
                                  span(style="background:#fef3c7;color:#92400e;padding:1px 5px;border-radius:4px;margin-right:3px") TE
                                else
                                  span(style="background:#fce7f3;color:#9d174d;padding:1px 5px;border-radius:4px;margin-right:3px") EB
                                | #{k.name || '?'} (#{k.age}t)
            else if customer.roomSelections && customer.roomSelections.length > 0
              -
                var _paxByIdxPrivate = {};
                (customer.passengers || []).forEach(function(p){ _paxByIdxPrivate[p.idx] = p; });
              .assign-customer-card__booked-rooms
                .assign-customer-card__booked-rooms-title
                  i.fa-solid.fa-bed(style="margin-right:4px")
                  | Phòng đã đặt tại KS của bạn:
                - var rsSegMap = {}
                each rs in customer.roomSelections
                  - var rsKey = (rs.fromDate||'') + '__' + (rs.toDate||'')
                  - if (!rsSegMap[rsKey]) rsSegMap[rsKey] = { fromDate: rs.fromDate, toDate: rs.toDate, items: [] }
                  - rsSegMap[rsKey].items.push(rs)
                each seg in Object.values(rsSegMap)
                  .assign-booked-seg
                    .assign-booked-seg__date= seg.fromDate + ' → ' + seg.toDate
                    each rs in seg.items
                      .assign-booked-row
                        span.assign-booked-row__hotel= rs.hotelName
                        span.assign-booked-row__type= rs.roomTypeName
                        span.assign-booked-row__qty= rs.selectedRooms + ' phòng'
                        if rs.baseOccupancy
                          span.assign-booked-row__occ= '(' + rs.baseOccupancy + ' người/phòng)'
                      if rs.roomAssignments && rs.roomAssignments.length && (customer.passengers || []).length
                        .inner-room-assignments(style="margin-top:4px;margin-left:2px")
                          each a, ridx in rs.roomAssignments
                            .inner-room-assign-row
                              .inner-room-assign-row__title
                                i.fa-solid.fa-bed(style="margin-right:4px;color:#0071c2")
                                | Phòng #{rs.roomTypeName} ##{ridx + 1}
                                if a.usedCapacity !== undefined && a.usedCapacity !== null
                                  span(style="font-size:11px;color:#64748b;margin-left:4px") · sức chứa quy đổi #{a.usedCapacity}/#{rs.baseOccupancy}
                              .inner-room-assign-row__pax
                                if !a.passengerIdxs || a.passengerIdxs.length === 0
                                  span.inner-room-assign-empty — chưa gán hành khách —
                                else
                                  each idx in a.passengerIdxs
                                    - var _p = _paxByIdxPrivate[idx]
                                    if _p
                                      span.inner-room-assign-pax(class=`inner-room-assign-pax--${_p.type || 'adult'}`)
                                        strong= _p.name || ('HK #' + (idx + 1))
                                        span.inner-room-assign-pax__meta
                                          = ' ' + (_p.type === 'child' ? 'TE' : _p.type === 'baby' ? 'EB' : 'NL')
                                          if _p.age !== undefined && _p.age !== ''
                                            = ' · ' + _p.age + 't'
                                          if _p.gender === 'male'
                                            = ' · Nam'
                                          else if _p.gender === 'female'
                                            = ' · Nữ'
              if customer.passengers && customer.passengers.length
                .assign-customer-card__atoms(style="margin-top:8px")
                  .assign-customer-card__booked-rooms-title
                    i.fa-solid.fa-id-card(style="margin-right:4px")
                    | Danh sách hành khách (#{customer.passengers.length} người):
                  table.passenger-admin-table(style="width:100%;border-collapse:collapse;font-size:12.5px;margin-top:4px")
                    thead
                      tr(style="background:#f1f5f9;color:#475569")
                        th(style="padding:5px 6px;text-align:left") #
                        th(style="padding:5px 6px;text-align:left") Họ tên
                        th(style="padding:5px 6px;text-align:center") Tuổi
                        th(style="padding:5px 6px;text-align:center") Loại
                        th(style="padding:5px 6px;text-align:center") Giới tính
                    tbody
                      each _p in customer.passengers
                        tr(style="border-top:1px solid #e2e8f0")
                          td(style="padding:5px 6px") #{_p.idx + 1}
                          td(style="padding:5px 6px") #{_p.name || '—'}
                          td(style="padding:5px 6px;text-align:center") #{_p.age}
                          td(style="padding:5px 6px;text-align:center")
                            if _p.type === 'adult'
                              span.badge.badge--blue(style="font-size:11px") Người lớn
                            else if _p.type === 'child'
                              span.badge.badge--yellow(style="font-size:11px") Trẻ em
                            else
                              span.badge.badge--pink(style="font-size:11px") Em bé
                          td(style="padding:5px 6px;text-align:center")
                            if _p.gender === 'male'
                              | Nam
                            else if _p.gender === 'female'
                              | Nữ
                            else
                              | —

          .assign-customer-card__validation
          .assign-customer-card__rooms
            - const assigned = existingAssignments.filter(a => a.orderId === customer.orderId)
            if assigned.length > 0
              each a in assigned
                .assign-tag(data-room-id=a.roomId)
                  i.fa-solid.fa-door-open
                  |  Phòng #{a.roomNumber} – #{a.hotelName}
                  if a.roomTypeName
                    span.assign-tag__type  (#{a.roomTypeName})
                  span.assign-tag__num  #{a.numPeople} người/phòng
                  button.assign-tag__remove(
                    type="button"
                    title="Bỏ phân công phòng này"
                    onclick="removeAssignment(this)"
                    data-order-id=customer.orderId
                    data-room-id=a.roomId
                  )
                    i.fa-solid.fa-xmark
            else if _isAutoAssigned
              span.assign-customer-card__autoassigned(style="display:inline-flex;align-items:center;gap:6px;color:#047857;background:#ecfdf5;border:1px solid #a7f3d0;padding:6px 10px;border-radius:6px;font-weight:600;font-size:13px")
                i.fa-solid.fa-circle-check
                | Hệ thống đã tự xếp phòng cho khách ở ghép
            else
              span.assign-customer-card__unassigned
                i.fa-solid.fa-triangle-exclamation
                |  Chưa phân công phòng nào

      .assign-col.assign-col--right
        .assign-rooms-panel
          h2.assign-col__title
            i.fa-solid.fa-hotel
            |  Phòng đang giữ chỗ (KS của bạn)
            span.assign-rooms-panel__total#rooms-total-label
              |  (#{holdsByHotel.reduce((s,h) => s + h.rooms.length, 0)} phòng)

          if holdsByHotel.length === 0
            .assign-empty
              i.fa-solid.fa-circle-info
              |  Không có phòng nào của khách sạn bạn được giữ chỗ cho tour này.
          else
            .assign-hotel-tabs#hotel-tabs
              each hg, hi in holdsByHotel
                button.assign-hotel-tab(
                  type="button"
                  data-hotel-idx=hi
                  class=(hi === 0 ? 'assign-hotel-tab--active' : '')
                )
                  i.fa-solid.fa-building
                  |  #{hg.hotelName}
                  span.assign-hotel-tab__count  (#{hg.rooms.length})

            .assign-room-filters
              select#filter-floor.assign-filter-select
                option(value="") Tất cả tầng
              select#filter-type.assign-filter-select
                option(value="") Tất cả loại phòng
              select#filter-status.assign-filter-select
                option(value="") Tất cả trạng thái
                option(value="free") Còn trống
                option(value="assigned") Đã gán
              .assign-filter-count#filter-count

            .assign-room-grid#room-grid

            script#holds-data(type="application/json")
              | !{JSON.stringify(holdsByHotel)}

    .assign-action-box#assign-action-box(style="display:none")
      .assign-action-box__content
        .assign-action-box__info
          p#assign-box-text Chọn các phòng để phân công
          .assign-multi-room-list#assign-multi-room-list
        .assign-action-box__btns
          button#btn-do-assign.btn-primary(type="button" onclick="doAssign()")
            i.fa-solid.fa-link
            span#btn-do-assign-label  Gán phòng
          button#btn-cancel-select.btn-secondary(type="button" onclick="cancelSelect()")
            |  Huỷ chọn

    //- Context menu khi chuột phải vào phòng
    #room-ctx-menu.room-ctx-menu(style="display:none")
      button.room-ctx-menu__item#ctx-view-detail(type="button")
        i.fa-solid.fa-circle-info
        |  Xem chi tiết

    //- Modal xem chi tiết phòng
    #room-detail-modal.room-detail-modal(style="display:none")
      .room-detail-modal__backdrop(onclick="closeRoomDetail()")
      .room-detail-modal__panel
        .room-detail-modal__header
          span#rdm-title.room-detail-modal__title Thông tin phòng
          button.room-detail-modal__close(type="button" onclick="closeRoomDetail()")
            i.fa-solid.fa-xmark
        .room-detail-modal__body#rdm-body

    //- Modal thông báo thay cho alert()
    #assign-notify-modal.room-detail-modal(style="display:none")
      .room-detail-modal__backdrop(onclick="closeAssignNotifyModal()")
      .room-detail-modal__panel(style="max-width:560px")
        .room-detail-modal__header
          span.room-detail-modal__title Thông báo
          button.room-detail-modal__close(type="button" onclick="closeAssignNotifyModal()")
            i.fa-solid.fa-xmark
        .room-detail-modal__body
          .assign-notify-modal__content#assign-notify-modal-content
          .assign-notify-modal__actions(style="display:flex;justify-content:flex-end;margin-top:14px")
            button.btn-primary(type="button" onclick="closeAssignNotifyModal()") OK

    .assign-save-bar
      button#btn-save-assignments.btn-primary(type="button" onclick="saveAllAssignments()")
        i.fa-solid.fa-floppy-disk
        |  Lưu phân công
      span#assign-save-msg

    script.
      var SEGMENT_ID          = "!{String(tourSeg._id)}";
      var PATH_ADMIN          = "!{pathAdmin}";
      var SAVE_URL            = "/" + PATH_ADMIN + "/hotel/tour-assignments/" + SEGMENT_ID + "/save";
      //- Gửi kèm khi có ?hotelId= để server chỉ ghi đè phân công của đúng KS đó
      var SCOPE_HOTEL_ID      = !{JSON.stringify(selectedHotelId || '')};
      var customer            = !{JSON.stringify(customer)};
      var customers           = !{JSON.stringify(customers)};
      var existingAssignments = !{JSON.stringify(existingAssignments)};
      var assignments         = existingAssignments.slice();
      var selectedRoomIds     = [];
      var activeHotelIdx      = 0;

      // Backfill atom meta cho assignments của khách đang xem từ
      // currentAssignmentsByHotel (server đã resolve cho từng holdBookingId).
      // Đảm bảo: (1) room-tile hiển thị badge giới đúng; (2) popup ưu tiên
      // đọc atom từ assignment in-memory (không phụ thuộc lookup).
      (function backfillAssignmentMeta() {
        if (!customer || customer.accommodationMode !== 'shared') return;
        var curByHotel = customer.currentAssignmentsByHotel || [];
        if (!curByHotel.length) return;
        var lookup = {};
        curByHotel.forEach(function(h) {
          (h.rooms || []).forEach(function(rm) {
            if (rm && rm.holdBookingId) lookup[String(rm.holdBookingId)] = rm;
          });
        });
        assignments.forEach(function(a) {
          if (String(a.orderId) !== String(customer.orderId)) return;
          var k = String(a.holdBookingId || '');
          var resolved = lookup[k];
          if (!resolved) return;
          if (!a.gender && resolved.gender) a.gender = resolved.gender;
          if ((!a.atomLabels || a.atomLabels.length === 0) && Array.isArray(resolved.atomLabels) && resolved.atomLabels.length) {
            a.atomLabels = resolved.atomLabels.slice();
          }
          if ((!a.atomAnchorIdxs || a.atomAnchorIdxs.length === 0) && Array.isArray(resolved.atomAnchorIdxs) && resolved.atomAnchorIdxs.length) {
            a.atomAnchorIdxs = resolved.atomAnchorIdxs.slice();
          }
          if (a.usedCapacity == null && resolved.numPeople != null) a.usedCapacity = resolved.numPeople;
        });
      })();

      // Reconcile customer.currentAssignmentsByHotel với assignments in-memory
      // sau mỗi thay đổi (remove/add). Mỗi room entry mang "atom" (atomLabels
      // + atomAnchorIdxs + gender). Bước reconcile:
      //   1) Mark free các atom mà holdBookingId không còn tồn tại trong
      //      assignments (admin đã remove phòng đó).
      //   2) Với mỗi assignment shared mới chưa có atom (holdBookingId không
      //      khớp room nào), claim atom free đầu tiên → atom "di cư" sang
      //      phòng mới mà admin vừa chọn.
      // Đồng thời propagate atomLabels/gender vào assignment để popup hiển thị
      // hành khách đúng phòng mới — không cần reload page.
      function _reconcileCurrentAssignments() {
        if (!customer || customer.accommodationMode !== 'shared') return;
        if (!Array.isArray(customer.currentAssignmentsByHotel)) return;

        var custOrderId = String(customer.orderId);

        customer.currentAssignmentsByHotel.forEach(function(curHotel) {
          var hid = String(curHotel.hotelId);
          var rooms = curHotel.rooms || [];

          // assignments của khách hiện tại tại hotel này
          var myAssignsHere = assignments.filter(function(a) {
            return String(a.orderId) === custOrderId && String(a.hotelId) === hid;
          });
          var activeHoldIds = {};
          myAssignsHere.forEach(function(a) {
            activeHoldIds[String(a.holdBookingId || '')] = true;
          });

          // 1) Mark free atom nếu holdBookingId không còn active
          rooms.forEach(function(rm) {
            var holdId = String(rm.holdBookingId || '');
            if (holdId && !activeHoldIds[holdId]) rm.holdBookingId = '';
          });

          // 2) Claim atom free cho assignment chưa có atom (holdBookingId chưa
          //    xuất hiện ở bất kỳ room entry nào).
          var claimedHoldIds = {};
          rooms.forEach(function(rm) {
            if (rm.holdBookingId) claimedHoldIds[String(rm.holdBookingId)] = true;
          });

          myAssignsHere.forEach(function(a) {
            var holdId = String(a.holdBookingId || '');
            if (!holdId) return;
            // Nếu holdId đã được claim bởi 1 room entry → đảm bảo assignment
            // cũng có atom (đồng bộ thông tin cho render).
            var claimedRoom = null;
            if (claimedHoldIds[holdId]) {
              for (var k = 0; k < rooms.length; k++) {
                if (String(rooms[k].holdBookingId) === holdId) { claimedRoom = rooms[k]; break; }
              }
            } else {
              // Tìm room entry free để claim cho assignment này
              for (var i = 0; i < rooms.length; i++) {
                if (!rooms[i].holdBookingId) {
                  rooms[i].holdBookingId = holdId;
                  claimedHoldIds[holdId] = true;
                  var tile = document.querySelector('.assign-room-tile[data-room-id="' + holdId + '"]');
                  if (tile) {
                    rooms[i].roomId = String(tile.dataset.physicalRoomId || holdId);
                    rooms[i].roomNumber = tile.dataset.roomNumber || rooms[i].roomNumber || '';
                    rooms[i].roomTypeName = tile.dataset.roomType || rooms[i].roomTypeName || '';
                  }
                  claimedRoom = rooms[i];
                  break;
                }
              }
            }
            if (!claimedRoom) return;
            // Propagate vào assignment để popup + render-grid dùng trực tiếp
            // (không phụ thuộc lookup currentAssignmentsByHotel).
            if (!a.gender && claimedRoom.gender) a.gender = claimedRoom.gender;
            if (Array.isArray(claimedRoom.atomLabels) && claimedRoom.atomLabels.length) {
              a.atomLabels = claimedRoom.atomLabels.slice();
            }
            if (Array.isArray(claimedRoom.atomAnchorIdxs) && claimedRoom.atomAnchorIdxs.length) {
              a.atomAnchorIdxs = claimedRoom.atomAnchorIdxs.slice();
            }
            if (claimedRoom.numPeople != null) a.usedCapacity = claimedRoom.numPeople;
          });
        });
      }

      var holdsData = JSON.parse(document.getElementById('holds-data').textContent);
      var tourSegsData = !{JSON.stringify(tourSeg.segments || [])};

      var holdSegmentMap = {};
      (function() {
        holdsData.forEach(function(hotelGroup) {
          (hotelGroup.rooms || []).forEach(function(room) {
            var holdId  = String(room._id);
            var checkIn = room.checkIn ? new Date(room.checkIn).getTime() : null;
            if (checkIn === null) return;
            tourSegsData.forEach(function(seg, idx) {
              var segFrom = new Date(seg.fromDate).getTime();
              if (Math.abs(checkIn - segFrom) < 2 * 86400000) {
                holdSegmentMap[holdId] = idx;
              }
            });
          });
        });
      })();

      function formatSegDate(dateStr) {
        if (!dateStr) return '?';
        var d = new Date(dateStr);
        return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth() + 1)).slice(-2);
      }

      function escHtmlText(s) {
        return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function escAttr(s) {
        return String(s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
      }
      function nl2brEscaped(s) {
        return escHtmlText(s).replace(/\n/g, '<br>');
      }

      function showAssignNotifyModal(message) {
        var modal = document.getElementById('assign-notify-modal');
        var content = document.getElementById('assign-notify-modal-content');
        if (!modal || !content) return;
        content.innerHTML = nl2brEscaped(message || 'Có lỗi xảy ra.');
        modal.style.display = 'flex';
      }

      function closeAssignNotifyModal() {
        var modal = document.getElementById('assign-notify-modal');
        if (modal) modal.style.display = 'none';
      }

      function renderRoomGrid() {
        var grid      = document.getElementById('room-grid');
        var hg        = holdsData[activeHotelIdx];
        if (!hg) { grid.innerHTML = ''; return; }

        var filterFloor  = document.getElementById('filter-floor').value;
        var filterType   = document.getElementById('filter-type').value;
        var filterStatus = document.getElementById('filter-status').value;

        var rooms = hg.rooms.filter(function(r) {
          if (filterFloor  && r.floor        !== filterFloor)  return false;
          if (filterType   && r.roomTypeName !== filterType)   return false;
          var slotKey = String(r._id);
          if (filterStatus === 'free'     && assignments.some(function(a) { return a.holdBookingId === slotKey; })) return false;
          if (filterStatus === 'assigned' && !assignments.some(function(a) { return a.holdBookingId === slotKey; })) return false;
          return true;
        });

        document.getElementById('filter-count').textContent =
          rooms.length + ' / ' + hg.rooms.length + ' phòng';

        if (rooms.length === 0) {
          grid.innerHTML = '<div class="assign-room-grid__empty"><i class="fa-solid fa-magnifying-glass"></i> Không có phòng phù hợp</div>';
          return;
        }

        var physicalRoomCount = {};
        rooms.forEach(function(r) {
          var pid = String(r.roomId || '');
          physicalRoomCount[pid] = (physicalRoomCount[pid] || 0) + 1;
        });

        grid.innerHTML = rooms.map(function(r) {
          var slotId   = String(r._id);
          var physRoomId = String(r.roomId || slotId);
          // 1 phòng có thể được nhiều đơn share (shared cross-order) → lấy
          // toàn bộ assignees, không chỉ 1.
          var assignees = assignments.filter(function(a) { return a.holdBookingId === slotId; });
          var isAssigned  = assignees.length > 0;
          var isSelecting = selectedRoomIds.indexOf(slotId) !== -1;
          var hasMyAssign = assignees.some(function(a) { return a.orderId === customer.orderId; });
          var hasOtherAssign = assignees.some(function(a) { return a.orderId !== customer.orderId; });
          // "Locked" = có đơn khác đang ở phòng và phòng không phải shared của
          // mình. Nếu phòng share cùng giới với đơn mình → vẫn cho chọn.
          var allShared = assignees.length > 0 && assignees.every(function(a) { return a.accommodationMode === 'shared'; });
          var isLocked = !hasMyAssign && hasOtherAssign && !allShared;

          var cls = 'assign-room-tile';
          if (isSelecting)  cls += ' assign-room-tile--selecting';
          else if (isLocked) cls += ' assign-room-tile--other-order assign-room-tile--locked';
          else if (hasMyAssign) cls += ' assign-room-tile--assigned';
          else if (isAssigned) cls += ' assign-room-tile--other-order';

          var showDates = physicalRoomCount[physRoomId] > 1;
          var dateLabel = showDates && r.checkIn && r.checkOut
            ? '<div class="assign-room-tile__dates">' + formatSegDate(r.checkIn) + ' → ' + formatSegDate(r.checkOut) + '</div>'
            : '';

          var assigneeLabel = '';
          if (isAssigned) {
            var names = assignees.map(function(a) { return a.guestName || a.orderCode || ''; });
            var titleStr = names.join(', ');
            var nameHtml = '';
            if (allShared && names.length > 1) {
              nameHtml = names
                .map(function(n) {
                  return '<div><span class="assign-room-tile__assignee-name">' + escHtmlText(n) + '</span></div>';
                })
                .join('');
            } else {
              nameHtml = '<span class="assign-room-tile__assignee-name">' + escHtmlText(names[0] || '') + '</span>';
            }
            var modeLabel = allShared ? 'Ở ghép' : 'Ở riêng';
            var genders = assignees
              .map(function(a) { return a.gender || null; })
              .filter(function(g) { return !!g; });
            var uniqGender = [];
            genders.forEach(function(g) { if (uniqGender.indexOf(g) === -1) uniqGender.push(g); });
            var genderLabel = '';
            if (uniqGender.length === 1) {
              genderLabel = uniqGender[0] === 'male' ? 'Nam' : 'Nữ';
            } else if (uniqGender.length > 1) {
              genderLabel = 'Nam/Nữ';
            }
            assigneeLabel = '<div class="assign-room-tile__assignee" title="' + escAttr(titleStr) + '">'
              + '<i class="fa-solid fa-user-check" aria-hidden="true"></i>'
              + nameHtml
              + '<div style="margin-top:2px;font-size:11px;color:#64748b;line-height:1.2">'
              + escHtmlText(modeLabel)
              + (genderLabel ? ' · ' + escHtmlText(genderLabel) : '')
              + '</div>'
              + '</div>';
          }

          var noteRaw = r.note ? escAttr(r.note) : '';
          return '<div class="' + cls + '" data-room-id="' + slotId + '"'
            + ' data-physical-room-id="' + physRoomId + '"'
            + ' data-room-number="' + (r.roomNumber || '') + '"'
            + ' data-room-type="' + (r.roomTypeName || '') + '"'
            + ' data-room-type-id="' + (r.roomTypeId || '') + '"'
            + ' data-hotel-id="' + (r.hotel && r.hotel.hotelId ? r.hotel.hotelId : '') + '"'
            + ' data-hotel-name="' + (r.hotelName || '') + '"'
            + ' data-base-occ="' + (r.baseOccupancy || 2) + '"'
            + ' data-max-occ="' + (r.maxOccupancy || r.baseOccupancy || 2) + '"'
            + ' data-note="' + noteRaw + '"'
            + ' data-checkin="' + (r.checkIn || '') + '"'
            + ' data-checkout="' + (r.checkOut || '') + '"'
            + ' onclick="selectRoom(\'' + slotId + '\')"'
            + ' oncontextmenu="roomContextMenu(event, \'' + slotId + '\')">'
            + '<div class="assign-room-tile__number">' + (r.roomNumber || '?') + '</div>'
            + '<div class="assign-room-tile__type">' + (r.roomTypeName || '') + '</div>'
            + '<div class="assign-room-tile__occ">' + (r.baseOccupancy || 2) + ' <i class="fa-solid fa-user-group fa-xs"></i></div>'
            + dateLabel
            + assigneeLabel
            + '</div>';
        }).join('');
      }

      function refreshFilters() {
        var hg = holdsData[activeHotelIdx];
        if (!hg) return;
        var floors = []; var types = [];
        hg.rooms.forEach(function(r) {
          if (r.floor && floors.indexOf(r.floor) === -1) floors.push(r.floor);
          if (r.roomTypeName && types.indexOf(r.roomTypeName) === -1) types.push(r.roomTypeName);
        });
        floors.sort(); types.sort();
        var floorSel = document.getElementById('filter-floor');
        var typeSel  = document.getElementById('filter-type');
        floorSel.innerHTML = '<option value="">Tất cả tầng</option>' + floors.map(function(f) { return '<option value="' + f + '">Tầng ' + f + '</option>'; }).join('');
        typeSel.innerHTML  = '<option value="">Tất cả loại phòng</option>' + types.map(function(t) { return '<option value="' + t + '">' + t + '</option>'; }).join('');
      }

      document.querySelectorAll('.assign-filter-select').forEach(function(s) {
        s.addEventListener('change', function() { renderRoomGrid(); });
      });

      document.querySelectorAll('.assign-hotel-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
          document.querySelectorAll('.assign-hotel-tab').forEach(function(t) { t.classList.remove('assign-hotel-tab--active'); });
          tab.classList.add('assign-hotel-tab--active');
          activeHotelIdx = parseInt(tab.dataset.hotelIdx) || 0;
          refreshFilters();
          renderRoomGrid();
        });
      });

      // ── Helper: suy ra giới tính chính của khách shared ───────────────────
      function inferCustomerGender(c) {
        if (!c || !Array.isArray(c.passengers)) return null;
        var males = 0, females = 0;
        c.passengers.forEach(function(p) {
          if (p.type !== 'adult') return;
          if (p.gender === 'male')   males++;
          else if (p.gender === 'female') females++;
        });
        if (males > 0 && females === 0) return 'male';
        if (females > 0 && males === 0) return 'female';
        return null;
      }

      // ── Helper: số chỗ (effective size) khách shared chiếm trong 1 phòng ──
      function inferCustomerSizePerRoom(c) {
        if (!c) return 1;
        var arr = c.sharedRoomRequest || [];
        for (var i = 0; i < arr.length; i++) {
          var allocs = (arr[i] && arr[i].hotelAllocations) || [];
          for (var j = 0; j < allocs.length; j++) {
            var ras = allocs[j].roomAssignments || [];
            if (ras.length) {
              return Math.max(1, Number(ras[0].usedCapacity) || 1);
            }
          }
        }
        return 1;
      }

      // ── Helper: kiểm tra có thể ghép khách hiện tại vào phòng đang có
      //   khách khác hay không. Cho phép khi cả 2 đều là shared, cùng giới
      //   tính, và còn đủ sức chứa. Trả về { ok, message }.
      function canSharedJoinRoom(slotId, existingOthers) {
        if (customer.accommodationMode !== 'shared') {
          return {
            ok: false,
            message:
              'Phòng này đã được gán cho khách "' +
              (existingOthers[0].guestName || existingOthers[0].orderCode) +
              '" (#' + existingOthers[0].orderCode + ').\n' +
              'Hãy bỏ phân công ở đơn đó trước nếu muốn gán lại cho khách hiện tại.',
          };
        }
        var allShared = existingOthers.every(function(a) {
          return a.accommodationMode === 'shared';
        });
        if (!allShared) {
          return {
            ok: false,
            message:
              'Phòng này hiện có khách ở riêng đang giữ. Không thể ghép thêm.\n' +
              'Hãy bỏ phân công ở đơn đó trước nếu muốn gán lại.',
          };
        }
        // Giới tính phòng = giới tính các khách đang ở (đều shared).
        var roomGender = null;
        for (var i = 0; i < existingOthers.length; i++) {
          var g = existingOthers[i].gender || null;
          if (!g) continue;
          if (roomGender === null) roomGender = g;
          else if (roomGender !== g) {
            return {
              ok: false,
              message: 'Phòng này hiện có khách đa giới tính, không thể ghép thêm.',
            };
          }
        }
        var myGender = inferCustomerGender(customer);
        if (roomGender && myGender && roomGender !== myGender) {
          var roomLabel = roomGender === 'male' ? 'nam' : 'nữ';
          var myLabel   = myGender   === 'male' ? 'nam' : 'nữ';
          return {
            ok: false,
            message:
              'Phòng này hiện đang ghép khách ' + roomLabel + '.\n' +
              'Khách hiện tại là ' + myLabel + ', không thể ghép cùng phòng.',
          };
        }
        // Sức chứa
        var tile = document.querySelector('.assign-room-tile[data-room-id="' + slotId + '"]');
        var cap = tile ? parseInt(tile.dataset.baseOcc, 10) : 0;
        if (cap > 0) {
          var usedByOthers = existingOthers.reduce(function(s, a) {
            return s + (Number(a.numPeople) || 0);
          }, 0);
          var myNeed = inferCustomerSizePerRoom(customer);
          if (usedByOthers + myNeed > cap) {
            return {
              ok: false,
              message:
                'Phòng còn ' + Math.max(0, cap - usedByOthers) + ' chỗ trống, ' +
                'không đủ cho ' + myNeed + ' khách của đơn này.',
            };
          }
        }
        return { ok: true };
      }

      // Chọn phòng để gán cho khách hiện tại.
      function selectRoom(roomId) {
        // Lấy các đơn KHÁC đang gán phòng này
        var existingOthers = assignments.filter(function(a) {
          return a.holdBookingId === roomId && a.orderId !== customer.orderId;
        });
        if (existingOthers.length > 0) {
          var check = canSharedJoinRoom(roomId, existingOthers);
          if (!check.ok) {
            showAssignNotifyModal(check.message);
            return;
          }
        }

        var idx = selectedRoomIds.indexOf(roomId);
        if (idx !== -1) {
          selectedRoomIds.splice(idx, 1);
        } else {
          selectedRoomIds.push(roomId);
        }
        renderRoomGrid();
        updateActionBox();
      }

      function updateActionBox() {
        var box = document.getElementById('assign-action-box');
        var txt = document.getElementById('assign-box-text');
        var listEl = document.getElementById('assign-multi-room-list');
        var btnLabel = document.getElementById('btn-do-assign-label');

        if (selectedRoomIds.length > 0) {
          var custName = customer.guestName || customer.orderCode;
          txt.textContent = 'Gán ' + selectedRoomIds.length + ' phòng cho "' + custName + '" (#' + customer.orderCode + ')';
          btnLabel.textContent = '  Gán ' + selectedRoomIds.length + ' phòng';

          var html = '';
          selectedRoomIds.forEach(function(rid) {
            var tile = document.querySelector('.assign-room-tile[data-room-id="' + rid + '"]');
            if (!tile) return;
            html += '<div class="assign-multi-room-item">'
              + '<i class="fa-solid fa-door-open"></i> '
              + 'Phòng <b>' + (tile.dataset.roomNumber || '?') + '</b>'
              + ' – ' + (tile.dataset.hotelName || '')
              + ' <span style="color:#6b7280">(' + (tile.dataset.roomType || '') + ', ' + (tile.dataset.baseOcc || '2') + ' người)</span>'
              + '<button type="button" class="assign-multi-room-remove" onclick="deselectRoom(\'' + rid + '\')">'
              + '<i class="fa-solid fa-xmark"></i></button>'
              + '</div>';
          });
          listEl.innerHTML = html;
          box.style.display = '';
        } else {
          box.style.display = 'none';
          listEl.innerHTML = '';
        }
      }

      function deselectRoom(roomId) {
        var idx = selectedRoomIds.indexOf(roomId);
        if (idx !== -1) selectedRoomIds.splice(idx, 1);
        renderRoomGrid();
        updateActionBox();
      }

      // Gán các phòng đã chọn cho khách hiện tại.
      function doAssign() {
        if (selectedRoomIds.length === 0) return;
        var cust = customer;

        // Phân loại: phòng xung đột thật vs có thể ghép cùng (shared+shared)
        var hardConflicts = [];
        selectedRoomIds.forEach(function(slotId) {
          var existingOthers = assignments.filter(function(a) {
            return a.holdBookingId === slotId && a.orderId !== cust.orderId;
          });
          if (existingOthers.length === 0) return;
          var check = canSharedJoinRoom(slotId, existingOthers);
          if (!check.ok) {
            var tile = document.querySelector('.assign-room-tile[data-room-id="' + slotId + '"]');
            hardConflicts.push(
              'Phòng ' + (tile ? tile.dataset.roomNumber : slotId) +
              ': ' + check.message.replace(/\n+/g, ' ')
            );
          }
        });
        // Khách ở ghép: không cho gán vượt quá số phòng vật lý tối đa
        if (cust.accommodationMode === 'shared' && isAutoAssignedShared()) {
          var expectedMax = getExpectedSharedRoomsAtScope();
          if (expectedMax > 0) {
            var currentBound = assignments.filter(function(a) { return a.orderId === cust.orderId; }).length;
            var newSlots = selectedRoomIds.filter(function(slotId) {
              return !assignments.some(function(a) {
                return a.orderId === cust.orderId && String(a.holdBookingId) === String(slotId);
              });
            });
            if (currentBound + newSlots.length > expectedMax) {
              showAssignNotifyModal(
                'Số lượng phòng được gán vượt quá số phòng vật lý tối đa cho khách ở ghép '
                + '(tối đa ' + expectedMax + ' phòng, hiện đã có ' + currentBound + '). '
                + 'Vui lòng điều chỉnh lại phân phòng.'
              );
              return;
            }
          }
        }

        if (hardConflicts.length > 0) {
          showAssignNotifyModal(
            'Không thể gán các phòng sau:\n\n' +
              hardConflicts.join('\n') +
              '\n\nVui lòng chọn phòng khác hoặc bỏ phân công ở đơn liên quan.'
          );
          // Bỏ những slot bị xung đột thật
          selectedRoomIds = selectedRoomIds.filter(function(slotId) {
            var existingOthers = assignments.filter(function(a) {
              return a.holdBookingId === slotId && a.orderId !== cust.orderId;
            });
            if (existingOthers.length === 0) return true;
            return canSharedJoinRoom(slotId, existingOthers).ok;
          });
          renderRoomGrid();
          updateActionBox();
          return;
        }

        selectedRoomIds.forEach(function(slotId) {
          var roomTile = document.querySelector('.assign-room-tile[data-room-id="' + slotId + '"]');
          if (!roomTile) return;
          var baseOcc = parseFloat(roomTile.dataset.baseOcc);
          if (!baseOcc || baseOcc < 1) baseOcc = 2;
          baseOcc = Math.round(baseOcc);

          // numPeople của entry này là số chỗ riêng đơn này chiếm — với shared
          // dùng usedCapacity thay vì baseOccupancy để cộng dồn vào phòng đúng.
          var myNum = cust.accommodationMode === 'shared'
            ? inferCustomerSizePerRoom(cust)
            : baseOcc;

          var existing = assignments.find(function(a) {
            return a.orderId === cust.orderId && a.holdBookingId === slotId;
          });
          if (!existing) {
            assignments.push({
              orderId:           cust.orderId,
              orderCode:         cust.orderCode,
              guestName:         cust.guestName,
              phone:             cust.phone,
              numPeople:         myNum,
              effectiveOcc:      myNum,
              totalEffOcc:       cust.totalPeople,
              hotelId:           roomTile.dataset.hotelId,
              hotelName:         roomTile.dataset.hotelName,
              roomId:            roomTile.dataset.physicalRoomId || slotId,
              roomNumber:        roomTile.dataset.roomNumber,
              roomTypeName:      roomTile.dataset.roomType,
              holdBookingId:     slotId,
              accommodationMode: cust.accommodationMode || 'private',
              gender:            cust.accommodationMode === 'shared' ? inferCustomerGender(cust) : null,
              atomLabels:        [],
              atomAnchorIdxs:    [],
              usedCapacity:      myNum,
            });
          }
        });

        selectedRoomIds = [];
        document.getElementById('assign-action-box').style.display = 'none';
        _reconcileCurrentAssignments();
        rerenderCustomerCard();
        renderRoomGrid();
      }

      function removeAssignment(btn) {
        var orderId = btn.dataset.orderId;
        var roomId  = btn.dataset.roomId;
        assignments = assignments.filter(function(a) {
          return !(a.orderId === orderId && a.roomId === roomId);
        });
        _reconcileCurrentAssignments();
        rerenderCustomerCard();
        renderRoomGrid();
      }

      function cancelSelect() {
        selectedRoomIds = [];
        document.getElementById('assign-action-box').style.display = 'none';
        renderRoomGrid();
      }

      function validateAssignments(cust, myAssigns) {
        if (!cust.roomSelections || cust.roomSelections.length === 0) return '';
        var needed = {};
        cust.roomSelections.forEach(function(rs) {
          var k = (rs.hotelId||'') + '|' + (rs.roomTypeId||'') + '|' + (rs.fromDate||'') + '|' + (rs.toDate||'');
          if (!needed[k]) needed[k] = { hotelName: rs.hotelName, roomTypeName: rs.roomTypeName, selectedRooms: 0, baseOccupancy: rs.baseOccupancy, fromDate: rs.fromDate, toDate: rs.toDate, hotelId: rs.hotelId, roomTypeId: rs.roomTypeId };
          needed[k].selectedRooms += rs.selectedRooms;
        });

        var assigned = {};
        myAssigns.forEach(function(a) {
          var holdRoom = null;
          holdsData.forEach(function(hg) {
            hg.rooms.forEach(function(r) {
              if (String(r._id) === a.holdBookingId) holdRoom = r;
            });
          });
          if (!holdRoom) return;
          var hId = String(holdRoom.hotel && holdRoom.hotel.hotelId ? holdRoom.hotel.hotelId : '');
          var rtId = holdRoom.roomTypeId ? String(holdRoom.roomTypeId) : '';
          var ci = holdRoom.checkIn ? holdRoom.checkIn.split('T')[0] : '';
          var co = holdRoom.checkOut ? holdRoom.checkOut.split('T')[0] : '';
          Object.keys(needed).forEach(function(k) {
            var n = needed[k];
            var nFrom = n.fromDate ? n.fromDate.split('T')[0] : '';
            var nTo = n.toDate ? n.toDate.split('T')[0] : '';
            if (hId === (n.hotelId||'') && rtId === (n.roomTypeId||'') && ci === nFrom && co === nTo) {
              assigned[k] = (assigned[k] || 0) + 1;
            }
          });
        });

        var shortfall = [];
        var excess = [];
        Object.keys(needed).forEach(function(k) {
          var n = needed[k];
          var got = assigned[k] || 0;
          if (got < n.selectedRooms) {
            shortfall.push('<b>' + n.roomTypeName + '</b> tại ' + n.hotelName + ': gán ' + got + '/' + n.selectedRooms + ' phòng');
          } else if (got > n.selectedRooms) {
            excess.push('<b>' + n.roomTypeName + '</b> tại ' + n.hotelName + ': gán ' + got + '/' + n.selectedRooms + ' phòng (dư ' + (got - n.selectedRooms) + ' phòng)');
          }
        });

        if (shortfall.length === 0 && excess.length === 0 && myAssigns.length > 0) {
          return '<div class="assign-validation-ok"><i class="fa-solid fa-circle-check"></i> Đã gán đủ phòng theo đơn đặt</div>';
        }

        var parts = [];
        if (shortfall.length > 0) {
          parts.push('<div class="assign-validation-warn"><i class="fa-solid fa-triangle-exclamation"></i><div>Chưa gán đủ phòng theo đơn đặt:<br>' + shortfall.join('<br>') + '</div></div>');
        }
        if (excess.length > 0) {
          parts.push('<div class="assign-validation-excess"><i class="fa-solid fa-layer-group"></i><div>Gán dư phòng so với đơn đặt:<br>' + excess.join('<br>') + '</div></div>');
        }
        return parts.join('');
      }

      // Detect: shared mode + đã có roomAssignments tại KS đang xem → "tự xếp phòng".
      function isAutoAssignedShared() {
        if (!customer || customer.accommodationMode !== 'shared') return false;
        var arr = customer.sharedRoomRequest || [];
        for (var i = 0; i < arr.length; i++) {
          var allocs = (arr[i] && arr[i].hotelAllocations) || [];
          for (var j = 0; j < allocs.length; j++) {
            if (SCOPE_HOTEL_ID && String(allocs[j].hotelId) !== String(SCOPE_HOTEL_ID)) continue;
            if ((allocs[j].roomAssignments || []).length > 0) return true;
          }
        }
        return false;
      }

      // Tổng số phòng vật lý cần được gán cho khách shared tại KS đang xem.
      function getExpectedSharedRoomsAtScope() {
        if (!customer || customer.accommodationMode !== 'shared') return 0;
        var total = 0;
        var arr = customer.sharedRoomRequest || [];
        for (var i = 0; i < arr.length; i++) {
          var allocs = (arr[i] && arr[i].hotelAllocations) || [];
          for (var j = 0; j < allocs.length; j++) {
            if (SCOPE_HOTEL_ID && String(allocs[j].hotelId) !== String(SCOPE_HOTEL_ID)) continue;
            total += (allocs[j].roomAssignments || []).length;
          }
        }
        return total;
      }

      function rerenderCustomerCard() {
        var card = document.querySelector('.assign-customer-card--single');
        if (!card) return;
        var myAssigns = assignments.filter(function(a) { return a.orderId === customer.orderId; });
        var container = card.querySelector('.assign-customer-card__rooms');

        var valEl = card.querySelector('.assign-customer-card__validation');
        if (customer.roomSelections && customer.roomSelections.length > 0) {
          valEl.innerHTML = validateAssignments(customer, myAssigns);
        } else if (customer.accommodationMode === 'shared' && isAutoAssignedShared()) {
          var expSh = getExpectedSharedRoomsAtScope();
          if (expSh > 0 && myAssigns.length > expSh) {
            valEl.innerHTML = '<div class="assign-validation-excess"><i class="fa-solid fa-layer-group"></i><div>'
              + 'Số lượng phòng được gán vượt quá số phòng vật lý tối đa cho khách ở ghép '
              + '(' + myAssigns.length + '/' + expSh + '). Vui lòng điều chỉnh lại phân phòng.'
              + '</div></div>';
          } else {
            valEl.innerHTML = '';
          }
        } else {
          valEl.innerHTML = '';
        }

        // Helper: render 1 tag phòng đã gán
        function renderTag(a) {
          var segIdx  = holdSegmentMap[a.holdBookingId];
          var segInfo = segIdx != null && tourSegsData[segIdx]
            ? '<span class="assign-tag__seg">' + formatSegDate(tourSegsData[segIdx].fromDate) + '→' + formatSegDate(tourSegsData[segIdx].toDate) + '</span> '
            : '';
          return '<div class="assign-tag" data-room-id="' + a.roomId + '">'
            + '<i class="fa-solid fa-door-open"></i> '
            + segInfo
            + 'Phòng ' + a.roomNumber + ' – ' + a.hotelName
            + (a.roomTypeName ? ' <span class="assign-tag__type">(' + a.roomTypeName + ')</span>' : '')
            + ' <span class="assign-tag__num">' + a.numPeople + ' người/phòng</span>'
            + '<button class="assign-tag__remove" type="button" title="Bỏ phân công"'
            + ' onclick="removeAssignment(this)" data-order-id="' + a.orderId + '" data-room-id="' + a.roomId + '">'
            + '<i class="fa-solid fa-xmark"></i></button>'
            + '</div>';
        }

        var isSharedAuto = isAutoAssignedShared();
        var expectedShared = isSharedAuto ? getExpectedSharedRoomsAtScope() : 0;
        var bound = myAssigns.length;

        if (isSharedAuto) {
          // ── Mode shared (auto-assign): 3 trạng thái: full / partial / none ──
          var html = '';
          if (bound > 0) {
            html += myAssigns.map(renderTag).join('');
          }
          if (bound > expectedShared && expectedShared > 0) {
            html += '<span class="assign-customer-card__autoassigned"'
              + ' style="display:inline-flex;align-items:center;gap:6px;color:#b91c1c;background:#fef2f2;border:1px solid #fecaca;padding:6px 10px;border-radius:6px;font-weight:600;font-size:13px;margin-top:6px">'
              + '<i class="fa-solid fa-triangle-exclamation"></i>'
              + ' Gán dư ' + bound + '/' + expectedShared + ' phòng vật lý — vượt quá số phòng tối đa cho khách ở ghép. Vui lòng bỏ bớt phân phòng.'
              + '</span>';
          } else if (bound === expectedShared && expectedShared > 0) {
            html += '<span class="assign-customer-card__autoassigned"'
              + ' style="display:inline-flex;align-items:center;gap:6px;color:#047857;background:#ecfdf5;border:1px solid #a7f3d0;padding:6px 10px;border-radius:6px;font-weight:600;font-size:13px;margin-top:6px">'
              + '<i class="fa-solid fa-circle-check"></i>'
              + ' Hệ thống đã tự xếp ' + bound + '/' + expectedShared + ' phòng vật lý cho khách ở ghép'
              + '</span>';
          } else if (bound > 0 && bound < expectedShared) {
            html += '<span class="assign-customer-card__autoassigned"'
              + ' style="display:inline-flex;align-items:center;gap:6px;color:#92400e;background:#fffbeb;border:1px solid #fde68a;padding:6px 10px;border-radius:6px;font-weight:600;font-size:13px;margin-top:6px">'
              + '<i class="fa-solid fa-triangle-exclamation"></i>'
              + ' Đã tự xếp ' + bound + '/' + expectedShared + ' phòng vật lý — còn thiếu ' + (expectedShared - bound) + ' phòng. Vui lòng gán thủ công hoặc giải phóng phòng từ đơn khác.'
              + '</span>';
          } else {
            // bound === 0 && expectedShared > 0
            html += '<span class="assign-customer-card__unassigned">'
              + '<i class="fa-solid fa-triangle-exclamation"></i> Chưa phân công phòng nào'
              + '</span>';
          }
          container.innerHTML = html;
        } else if (bound > 0) {
          container.innerHTML = myAssigns.map(renderTag).join('');
        } else {
          container.innerHTML = '<span class="assign-customer-card__unassigned">'
            + '<i class="fa-solid fa-triangle-exclamation"></i> Chưa phân công phòng nào'
            + '</span>';
        }
      }

      function analyzeAssignmentIssues() {
        var myAssigns = assignments.filter(function(a) { return a.orderId === customer.orderId; });
        var cust = customer;

        // Khách ở ghép (có dữ liệu tự xếp từ Order): không được gán quá số phòng vật lý tối đa
        if (cust.accommodationMode === 'shared' && isAutoAssignedShared()) {
          var expectedShared = getExpectedSharedRoomsAtScope();
          if (expectedShared > 0 && myAssigns.length > expectedShared) {
            return {
              shortfall: false,
              excess: false,
              sharedExcess: true,
              sharedBound: myAssigns.length,
              sharedExpected: expectedShared,
            };
          }
        }

        if (!cust.roomSelections || cust.roomSelections.length === 0) {
          return { shortfall: false, excess: false, sharedExcess: false };
        }
        var needed = {};
        cust.roomSelections.forEach(function(rs) {
          var k = (rs.hotelId||'') + '|' + (rs.roomTypeId||'') + '|' + (rs.fromDate||'') + '|' + (rs.toDate||'');
          if (!needed[k]) needed[k] = 0;
          needed[k] += rs.selectedRooms;
        });

        var assigned = {};
        myAssigns.forEach(function(a) {
          var holdRoom = null;
          holdsData.forEach(function(hg) {
            hg.rooms.forEach(function(r) { if (String(r._id) === a.holdBookingId) holdRoom = r; });
          });
          if (!holdRoom) return;
          var hId = String(holdRoom.hotel && holdRoom.hotel.hotelId ? holdRoom.hotel.hotelId : '');
          var rtId = holdRoom.roomTypeId ? String(holdRoom.roomTypeId) : '';
          var ci = holdRoom.checkIn ? holdRoom.checkIn.split('T')[0] : '';
          var co = holdRoom.checkOut ? holdRoom.checkOut.split('T')[0] : '';
          Object.keys(needed).forEach(function(k) {
            var parts = k.split('|');
            var nFrom = parts[2] ? parts[2].split('T')[0] : '';
            var nTo = parts[3] ? parts[3].split('T')[0] : '';
            if (hId === parts[0] && rtId === parts[1] && ci === nFrom && co === nTo) {
              assigned[k] = (assigned[k] || 0) + 1;
            }
          });
        });

        var hasShortfall = false;
        var hasExcess = false;
        Object.keys(needed).forEach(function(k) {
          var got = assigned[k] || 0;
          if (got < needed[k]) hasShortfall = true;
          else if (got > needed[k]) hasExcess = true;
        });
        return { shortfall: hasShortfall, excess: hasExcess, sharedExcess: false };
      }

      function saveAllAssignments() {
        var btn = document.getElementById('btn-save-assignments');
        var msg = document.getElementById('assign-save-msg');

        var issues = analyzeAssignmentIssues();
        if (issues.sharedExcess) {
          msg.textContent = 'Số lượng phòng được gán vượt quá số phòng vật lý tối đa cho khách ở ghép. Vui lòng điều chỉnh lại phân phòng.';
          msg.style.color = '#ef4444';
          rerenderCustomerCard();
          return;
        }
        if (issues.shortfall || issues.excess) {
          var parts = [];
          if (issues.shortfall) parts.push('Chưa gán đủ phòng đúng loại');
          if (issues.excess) parts.push('Gán dư phòng so với đơn đặt');
          msg.textContent = parts.join(' — ');
          msg.style.color = '#ef4444';
          return;
        }

        btn.disabled = true;
        msg.textContent = 'Đang lưu...';
        msg.style.color = '#6b7280';
        var savePayload = { assignments: assignments };
        if (SCOPE_HOTEL_ID) savePayload.hotelId = SCOPE_HOTEL_ID;
        if (customer && customer.orderId) savePayload.scopeOrderId = customer.orderId;
        fetch(SAVE_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(savePayload),
        })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            btn.disabled = false;
            if (data.success) {
              msg.textContent = data.message || 'Đã lưu thành công!';
              msg.style.color = '#22c55e';
              rerenderBookedAllocatedBlocks();
            } else {
              msg.textContent = data.message || 'Lỗi';
              msg.style.color = '#ef4444';
            }
          })
          .catch(function() {
            btn.disabled = false;
            msg.textContent = 'Lỗi kết nối';
            msg.style.color = '#ef4444';
          });
      }

      // Render lại khối "Phòng đã phân:" từ customer.currentAssignmentsByHotel
      // (đã được reconcile cập nhật đồng bộ với assignments in-memory).
      function rerenderBookedAllocatedBlocks() {
        var containers = document.querySelectorAll('.assign-booked-allocated');
        if (!containers.length) return;
        var curByHotel = (customer && customer.currentAssignmentsByHotel) || [];
        containers.forEach(function(box) {
          var hid = String(box.dataset.hotelId || '');
          var curHotel = curByHotel.find(function(h) { return String(h.hotelId) === hid; });
          var rooms = (curHotel && curHotel.rooms) ? curHotel.rooms.filter(function(rm) { return rm && rm.holdBookingId; }) : [];
          if (rooms.length === 0) {
            // Không có phòng nào được phân — giữ nguyên nội dung server-render
            // (có thể là "Phòng tự gán" hoặc rỗng). Không xoá vì có thể là
            // dạng fallback từ a.roomAssignments.
            return;
          }
          var html = '<div class="assign-booked-row" style="flex-direction:column;align-items:flex-start;gap:4px;font-size:12.5px;margin-top:4px">'
            + '<span style="font-weight:600;color:#0f172a">'
            + '<i class="fa-solid fa-bed" style="margin-right:4px;color:#0ea5e9"></i>'
            + 'Phòng đã phân:'
            + '</span>';
          rooms.forEach(function(ra) {
            html += '<div class="assign-booked-row" style="gap:8px;background:#f0fdf4;padding:6px 8px;border-radius:6px;width:100%;align-items:center;border-left:3px solid #10b981">';
            if (ra.gender) {
              html += '<span style="font-size:11px;padding:2px 6px;border-radius:4px;color:#fff;background:'
                + (ra.gender === 'female' ? '#ec4899' : '#3b82f6') + '">'
                + (ra.gender === 'female' ? 'Phòng nữ' : 'Phòng nam')
                + '</span>';
            }
            html += '<span style="font-weight:600">Phòng ' + escHtmlText(ra.roomNumber || '?') + '</span>';
            html += '<span style="color:#64748b">' + escHtmlText(ra.roomTypeName || 'Phòng') + '</span>';
            if (Array.isArray(ra.atomLabels) && ra.atomLabels.length) {
              html += '<span style="color:#0f172a"> • ' + escHtmlText(ra.atomLabels.join(', ')) + '</span>';
            } else if (ra.guestName) {
              html += '<span style="color:#0f172a"> • ' + escHtmlText(ra.guestName) + '</span>';
            }
            html += '</div>';
          });
          html += '</div>';
          box.innerHTML = html;
        });
      }

      // ── Context menu + Room detail modal ─────────────────────────────────
      var _ctxRoomId = null;
      var ctxMenu    = document.getElementById('room-ctx-menu');
      var rdmModal   = document.getElementById('room-detail-modal');
      var notifyModal = document.getElementById('assign-notify-modal');
      var GUARDIAN_MIN_AGE = 18;

      function parsePaxAge(p) {
        if (p.age === '' || p.age === null || p.age === undefined) return NaN;
        return parseInt(p.age, 10);
      }

      /** Lọc hành khách thuộc phòng theo atomAnchorIdxs (NL 18+ + TE/EB/NL<18 đi cùng). */
      function filterPassengersForRoom(allPax, anchorSet) {
        var adultIdxInRoom = {};
        (allPax || []).forEach(function(p) {
          if (p.type === 'adult' && anchorSet[p.idx]) adultIdxInRoom[p.idx] = true;
        });
        return (allPax || []).filter(function(p) {
          if (p.type === 'adult') {
            if (anchorSet[p.idx]) return true;
            var ageNum = parsePaxAge(p);
            if (!isNaN(ageNum) && ageNum < GUARDIAN_MIN_AGE) {
              return p.guardianIdx !== null && p.guardianIdx !== undefined && !!adultIdxInRoom[p.guardianIdx];
            }
            return false;
          }
          // Em bé: ưu tiên roomGuardianIdx (NL ở cùng phòng KS), fallback guardianIdx (đơn cũ).
          if (p.type === 'baby') {
            var babyAnchor =
              p.roomGuardianIdx !== null && p.roomGuardianIdx !== undefined
                ? p.roomGuardianIdx
                : p.guardianIdx;
            return babyAnchor !== null && babyAnchor !== undefined && !!adultIdxInRoom[babyAnchor];
          }
          return p.guardianIdx !== null && p.guardianIdx !== undefined && !!adultIdxInRoom[p.guardianIdx];
        });
      }

      // Đưa context-menu + modal ra <body> để tránh bị cha cắt (overflow/transform).
      if (ctxMenu && ctxMenu.parentNode !== document.body) document.body.appendChild(ctxMenu);
      if (rdmModal && rdmModal.parentNode !== document.body) document.body.appendChild(rdmModal);
      if (notifyModal && notifyModal.parentNode !== document.body) document.body.appendChild(notifyModal);

      function roomContextMenu(e, slotId) {
        e.preventDefault();
        e.stopPropagation();
        _ctxRoomId = slotId;
        ctxMenu.style.left = Math.min(e.clientX, window.innerWidth - 160) + 'px';
        ctxMenu.style.top  = Math.min(e.clientY, window.innerHeight - 60) + 'px';
        ctxMenu.style.display = 'block';
      }

      document.addEventListener('click', function(e) {
        if (!ctxMenu.contains(e.target)) {
          ctxMenu.style.display = 'none';
          _ctxRoomId = null;
        }
      });

      document.getElementById('ctx-view-detail').addEventListener('click', function() {
        ctxMenu.style.display = 'none';
        if (!_ctxRoomId) return;
        openRoomDetail(_ctxRoomId);
        _ctxRoomId = null;
      });

      function closeRoomDetail() {
        rdmModal.style.display = 'none';
      }

      function formatDate(str) {
        if (!str) return '—';
        var d = new Date(str);
        return ('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)+'/'+d.getFullYear();
      }

      function typeLabel(t) {
        return t === 'child' ? '<span class="rdm-badge rdm-badge--child">Trẻ em</span>'
             : t === 'baby'  ? '<span class="rdm-badge rdm-badge--baby">Em bé</span>'
             : '<span class="rdm-badge rdm-badge--adult">Người lớn</span>';
      }

      // Tìm hold-room data theo slotId trong holdsData (đầy đủ).
      function findHoldRoom(slotId) {
        for (var i = 0; i < holdsData.length; i++) {
          var hg = holdsData[i];
          for (var j = 0; j < (hg.rooms || []).length; j++) {
            if (String(hg.rooms[j]._id) === String(slotId)) return hg.rooms[j];
          }
        }
        return null;
      }

      // Map 1 hold (slot) → roomSelection + roomIndex của khách (nếu private + có roomAssignments).
      // Logic: gom các assignment của khách cùng "bucket" (hotelId + roomTypeId + dates),
      // sort theo holdBookingId để có thứ tự ổn định, vị trí slot trong bucket = roomIndex.
      function mapSlotToCustomerRoom(cust, slotId) {
        if (!cust || !cust.roomSelections || !cust.roomSelections.length) return null;

        var slotHold = findHoldRoom(slotId);
        if (!slotHold) return null;

        var hotelId   = slotHold.hotel && slotHold.hotel.hotelId ? String(slotHold.hotel.hotelId) : '';
        var typeId    = slotHold.roomTypeId ? String(slotHold.roomTypeId) : '';
        var typeName  = slotHold.roomTypeName || '';
        var checkIn   = (slotHold.checkIn || '').split('T')[0];
        var checkOut  = (slotHold.checkOut || '').split('T')[0];

        // Match roomSelection: ưu tiên hotelId + roomTypeId + dates; fallback dùng roomTypeName.
        var matchingRs = cust.roomSelections.find(function(rs) {
          var rsFrom = (rs.fromDate || '').split('T')[0];
          var rsTo   = (rs.toDate || '').split('T')[0];
          var sameHotel = String(rs.hotelId || '') === hotelId;
          var sameType  = typeId
            ? String(rs.roomTypeId || '') === typeId
            : (rs.roomTypeName || '') === typeName;
          return sameHotel && sameType && rsFrom === checkIn && rsTo === checkOut;
        });
        if (!matchingRs || !matchingRs.roomAssignments || !matchingRs.roomAssignments.length) {
          return { roomSelection: matchingRs || null, assignment: null, roomIndex: -1 };
        }

        // Lọc assignments cùng bucket của khách → tính position của slot này.
        var bucketAssigns = assignments.filter(function(a) {
          if (a.orderId !== cust.orderId) return false;
          var hr = findHoldRoom(a.holdBookingId);
          if (!hr) return false;
          var hHId = hr.hotel && hr.hotel.hotelId ? String(hr.hotel.hotelId) : '';
          var hTId = hr.roomTypeId ? String(hr.roomTypeId) : '';
          var hCi  = (hr.checkIn || '').split('T')[0];
          var hCo  = (hr.checkOut || '').split('T')[0];
          var sameType = typeId
            ? hTId === typeId
            : (hr.roomTypeName || '') === typeName;
          return hHId === hotelId && sameType && hCi === checkIn && hCo === checkOut;
        });
        bucketAssigns.sort(function(a, b) {
          return String(a.holdBookingId).localeCompare(String(b.holdBookingId));
        });

        var pos = -1;
        for (var i = 0; i < bucketAssigns.length; i++) {
          if (String(bucketAssigns[i].holdBookingId) === String(slotId)) { pos = i; break; }
        }
        if (pos < 0 || pos >= matchingRs.roomAssignments.length) {
          return { roomSelection: matchingRs, assignment: null, roomIndex: -1 };
        }
        return {
          roomSelection: matchingRs,
          assignment:    matchingRs.roomAssignments[pos],
          roomIndex:     pos,
        };
      }

      function openRoomDetail(slotId) {
        var tile = document.querySelector('.assign-room-tile[data-room-id="' + slotId + '"]');
        if (!tile) return;

        var roomNumber  = tile.dataset.roomNumber || '?';
        var roomType    = tile.dataset.roomType   || '—';
        var hotelName   = tile.dataset.hotelName  || '—';
        var baseOcc     = tile.dataset.baseOcc    || '—';
        var checkIn     = tile.dataset.checkin    || '';
        var checkOut    = tile.dataset.checkout   || '';
        var noteRaw     = tile.dataset.note       || '';

        // 1 phòng có thể được nhiều đơn share (shared cross-order) → lấy tất cả.
        var assignsHere = assignments.filter(function(a) { return a.holdBookingId === slotId; });
        // Để các block legacy tham chiếu `assign`/`cust` không vỡ, dùng entry đầu tiên.
        var assign = assignsHere[0] || null;
        var cust   = assign ? customers.find(function(c) { return c.orderId === assign.orderId; }) : null;

        document.getElementById('rdm-title').textContent =
          'Phòng ' + roomNumber + ' – ' + hotelName;

        // ── PRIORITY 1: lấy danh sách hành khách CỦA PHÒNG NÀY từ roomAssignments của khách
        var perRoomHtml = '';
        if (cust) {
          var mapping = mapSlotToCustomerRoom(cust, slotId);
          if (mapping && mapping.assignment && Array.isArray(mapping.assignment.passengerIdxs)) {
            var paxByIdx = {};
            (cust.passengers || []).forEach(function(p) { paxByIdx[p.idx] = p; });
            var picked = mapping.assignment.passengerIdxs
              .map(function(i) { return paxByIdx[i]; })
              .filter(Boolean);
            var usedCap = mapping.assignment.usedCapacity;
            var titleSuffix = (usedCap !== undefined && usedCap !== null)
              ? ' <span style="font-weight:400;color:#64748b;text-transform:none;letter-spacing:0">· sức chứa quy đổi ' + usedCap + '/' + (mapping.roomSelection.baseOccupancy || baseOcc) + '</span>'
              : '';
            perRoomHtml = '<div class="rdm-section-title"><i class="fa-solid fa-users" style="margin-right:4px"></i>Danh sách khách của phòng này' + titleSuffix + '</div>';
            if (picked.length === 0) {
              perRoomHtml += '<div class="rdm-unassigned"><i class="fa-solid fa-circle-info" style="margin-right:4px"></i>Khách chưa gán hành khách nào vào phòng này.</div>';
            } else {
              perRoomHtml += '<div class="rdm-pax-list">'
                + picked.map(function(p) {
                    var gender = p.gender === 'male' ? ' · Nam' : p.gender === 'female' ? ' · Nữ' : '';
                    var age    = p.age !== undefined && p.age !== '' ? ' · ' + p.age + 't' : '';
                    return '<div class="rdm-pax-row">' + typeLabel(p.type)
                      + '<span class="rdm-pax-name">' + escHtmlText(p.name || '—') + '</span>'
                      + '<span class="rdm-pax-meta">' + age + gender + '</span></div>';
                  }).join('')
                + '</div>';
            }
          }
        }

        // ── PRIORITY 1.3: shared mode — ưu tiên đọc atom đã được reconcile
        // gắn trực tiếp vào assignment in-memory (phản ánh đúng thao tác
        // remove/add của admin trong session, không phụ thuộc reload).
        if (!perRoomHtml && cust && cust.accommodationMode === 'shared') {
          var assignForSlot = assignments.find(function(a) {
            return String(a.holdBookingId) === String(slotId) && String(a.orderId) === String(cust.orderId);
          });
          if (assignForSlot) {
            var slotHoldDr = findHoldRoom(slotId);
            var slotHotelDr = slotHoldDr && slotHoldDr.hotel && slotHoldDr.hotel.hotelId
              ? String(slotHoldDr.hotel.hotelId) : String(assignForSlot.hotelId || '');

            var matchedAtomLabels = null;
            var matchedAtomAnchorIdxs = null;
            var matchedUsedCap = null;

            // 1.3a: lấy từ assignment in-memory (đã được reconcile cập nhật).
            if (Array.isArray(assignForSlot.atomAnchorIdxs) && assignForSlot.atomAnchorIdxs.length) {
              matchedAtomAnchorIdxs = assignForSlot.atomAnchorIdxs.slice();
            }
            if (Array.isArray(assignForSlot.atomLabels) && assignForSlot.atomLabels.length) {
              matchedAtomLabels = assignForSlot.atomLabels.slice();
            }
            if (assignForSlot.usedCapacity != null) matchedUsedCap = assignForSlot.usedCapacity;

            // 1.3b: fallback tra currentAssignmentsByHotel nếu assignment chưa có atom.
            if (!matchedAtomAnchorIdxs && !matchedAtomLabels) {
              var curByHotelArr = (cust.currentAssignmentsByHotel || []);
              for (var ch = 0; ch < curByHotelArr.length && !matchedAtomLabels; ch++) {
                var curHotel = curByHotelArr[ch];
                if (String(curHotel.hotelId) !== slotHotelDr) continue;
                var roomsArr = curHotel.rooms || [];
                for (var rr = 0; rr < roomsArr.length; rr++) {
                  if (String(roomsArr[rr].holdBookingId) === String(slotId)) {
                    matchedAtomLabels = Array.isArray(roomsArr[rr].atomLabels) ? roomsArr[rr].atomLabels : null;
                    matchedAtomAnchorIdxs = Array.isArray(roomsArr[rr].atomAnchorIdxs) ? roomsArr[rr].atomAnchorIdxs : null;
                    matchedUsedCap = roomsArr[rr].numPeople != null ? roomsArr[rr].numPeople : null;
                    break;
                  }
                }
              }
            }

            // Fallback: nếu currentAssignmentsByHotel chưa có (vừa save chưa reload)
            // hoặc thiếu dữ liệu — map theo position trong cùng order+hotel, sắp
            // xếp ổn định theo holdBookingId. Lấy từ Order.sharedRoomRequest.
            if (!matchedAtomLabels || !matchedAtomAnchorIdxs || matchedAtomAnchorIdxs.length === 0) {
              var sameHotelAssigns = assignments.filter(function(a) {
                return String(a.orderId) === String(cust.orderId) && String(a.hotelId) === slotHotelDr;
              });
              sameHotelAssigns.sort(function(a, b) {
                return String(a.holdBookingId).localeCompare(String(b.holdBookingId));
              });
              var posInOrder = -1;
              for (var pi = 0; pi < sameHotelAssigns.length; pi++) {
                if (String(sameHotelAssigns[pi].holdBookingId) === String(slotId)) { posInOrder = pi; break; }
              }
              if (posInOrder >= 0) {
                var raPool = [];
                var srArrFb = cust.sharedRoomRequest || [];
                for (var si2 = 0; si2 < srArrFb.length; si2++) {
                  var allocsFb = srArrFb[si2].hotelAllocations || [];
                  for (var ai2 = 0; ai2 < allocsFb.length; ai2++) {
                    if (String(allocsFb[ai2].hotelId) !== slotHotelDr) continue;
                    var rasFb = allocsFb[ai2].roomAssignments || [];
                    for (var ri2 = 0; ri2 < rasFb.length; ri2++) {
                      raPool.push(rasFb[ri2]);
                    }
                  }
                }
                if (posInOrder < raPool.length) {
                  var raPick = raPool[posInOrder];
                  if (!matchedAtomLabels) matchedAtomLabels = Array.isArray(raPick.atomLabels) ? raPick.atomLabels : null;
                  if (!matchedAtomAnchorIdxs || matchedAtomAnchorIdxs.length === 0) {
                    matchedAtomAnchorIdxs = Array.isArray(raPick.atomAnchorIdxs) ? raPick.atomAnchorIdxs : null;
                  }
                  if (matchedUsedCap == null) matchedUsedCap = raPick.usedCapacity;
                }
              }
            }

            // Derive atomAnchorIdxs từ atomLabels nếu thiếu.
            if ((!matchedAtomAnchorIdxs || matchedAtomAnchorIdxs.length === 0) && Array.isArray(matchedAtomLabels)) {
              var passengersDr = cust.passengers || [];
              var adultByNameDr = {};
              passengersDr.forEach(function(p) {
                if (p.type === 'adult' && p.name) adultByNameDr[String(p.name).trim().toLowerCase()] = p.idx;
              });
              var derivedDr = [];
              matchedAtomLabels.forEach(function(lbl) {
                var m = String(lbl || '').match(/^(.+?)(?:\s+\(.*\))?$/);
                var nm = m ? m[1].trim().toLowerCase() : String(lbl || '').trim().toLowerCase();
                if (adultByNameDr[nm] !== undefined) derivedDr.push(adultByNameDr[nm]);
              });
              if (derivedDr.length > 0) matchedAtomAnchorIdxs = derivedDr;
            }

            if (matchedAtomAnchorIdxs && matchedAtomAnchorIdxs.length) {
              var anchorSetDr = {};
              matchedAtomAnchorIdxs.forEach(function(idx) { anchorSetDr[idx] = true; });
              var allPaxDr = cust.passengers || [];
              var pickedDr = filterPassengersForRoom(allPaxDr, anchorSetDr);
              var usedCapDr = matchedUsedCap != null ? matchedUsedCap : assignForSlot.numPeople;
              var titleSuffixDr = (usedCapDr !== undefined && usedCapDr !== null)
                ? ' <span style="font-weight:400;color:#64748b;text-transform:none;letter-spacing:0">· sức chứa quy đổi ' + usedCapDr + '/' + baseOcc + '</span>'
                : '';
              perRoomHtml = '<div class="rdm-section-title"><i class="fa-solid fa-users" style="margin-right:4px"></i>Danh sách khách của phòng này' + titleSuffixDr + '</div>';
              if (pickedDr.length === 0) {
                perRoomHtml += '<div class="rdm-unassigned"><i class="fa-solid fa-circle-info" style="margin-right:4px"></i>Không tìm thấy hành khách cho phòng này.</div>';
              } else {
                perRoomHtml += '<div class="rdm-pax-list">'
                  + pickedDr.map(function(p) {
                      var gStr = p.gender === 'male' ? ' · Nam' : p.gender === 'female' ? ' · Nữ' : '';
                      var aStr = p.age !== undefined && p.age !== '' ? ' · ' + p.age + 't' : '';
                      return '<div class="rdm-pax-row">' + typeLabel(p.type)
                        + '<span class="rdm-pax-name">' + escHtmlText(p.name || '—') + '</span>'
                        + '<span class="rdm-pax-meta">' + aStr + gStr + '</span></div>';
                    }).join('')
                  + '</div>';
              }
            }
          }
        }

        // ── PRIORITY 1.5: shared mode — resolve hành khách từ atomAnchorIdxs ──
        // Với đơn ở ghép đã có dữ liệu passengers + sharedRoomRequest đầy đủ,
        // dùng bucket-position để xác định roomAssignment entry (giống private
        // mode) rồi lấy atomAnchorIdxs → filter passengers tương ứng.
        if (!perRoomHtml && cust && cust.accommodationMode === 'shared') {
          var slotHoldSh = findHoldRoom(slotId);
          if (slotHoldSh) {
            var shHotelId  = slotHoldSh.hotel && slotHoldSh.hotel.hotelId ? String(slotHoldSh.hotel.hotelId) : '';
            var shTypeId   = slotHoldSh.roomTypeId ? String(slotHoldSh.roomTypeId) : '';
            var shCheckIn  = (slotHoldSh.checkIn  || '').split('T')[0];
            var shCheckOut = (slotHoldSh.checkOut || '').split('T')[0];

            var matchedRa = null;
            var srArr = cust.sharedRoomRequest || [];
            outer: for (var si = 0; si < srArr.length; si++) {
              var sr = srArr[si];
              var srFrom = (sr.fromDate || '').split('T')[0];
              var srTo   = (sr.toDate   || '').split('T')[0];
              if (srFrom !== shCheckIn || srTo !== shCheckOut) continue;
              var allocsArr = sr.hotelAllocations || [];
              for (var ai = 0; ai < allocsArr.length; ai++) {
                var alloc = allocsArr[ai];
                if (String(alloc.hotelId) !== shHotelId) continue;
                // roomAssignments của alloc này — chỉ lấy cùng roomTypeId với slot
                var raArr = (alloc.roomAssignments || []).filter(function(ra) {
                  return String(ra.roomTypeId) === shTypeId;
                });
                if (!raArr.length) continue;
                // Bucket-position: lấy tất cả assignments của order cùng hotel+type+dates, sort ổn định
                var bucketSh = assignments.filter(function(a) {
                  if (a.orderId !== cust.orderId) return false;
                  var hr = findHoldRoom(a.holdBookingId);
                  if (!hr) return false;
                  var hHId = hr.hotel && hr.hotel.hotelId ? String(hr.hotel.hotelId) : '';
                  var hTId = hr.roomTypeId ? String(hr.roomTypeId) : '';
                  var hCi  = (hr.checkIn  || '').split('T')[0];
                  var hCo  = (hr.checkOut || '').split('T')[0];
                  return hHId === shHotelId && hTId === shTypeId && hCi === shCheckIn && hCo === shCheckOut;
                });
                bucketSh.sort(function(a, b) {
                  return String(a.holdBookingId).localeCompare(String(b.holdBookingId));
                });
                var posSh = -1;
                for (var bi = 0; bi < bucketSh.length; bi++) {
                  if (String(bucketSh[bi].holdBookingId) === String(slotId)) { posSh = bi; break; }
                }
                if (posSh >= 0 && posSh < raArr.length) {
                  matchedRa = raArr[posSh];
                  break outer;
                }
              }
            }

            if (matchedRa && Array.isArray(matchedRa.atomAnchorIdxs) && matchedRa.atomAnchorIdxs.length) {
              var anchorSet = {};
              matchedRa.atomAnchorIdxs.forEach(function(idx) { anchorSet[idx] = true; });
              var allPax = cust.passengers || [];
              var pickedSh = filterPassengersForRoom(allPax, anchorSet);
              var usedCapSh = matchedRa.usedCapacity;
              var titleSuffixSh = (usedCapSh !== undefined && usedCapSh !== null)
                ? ' <span style="font-weight:400;color:#64748b;text-transform:none;letter-spacing:0">· sức chứa quy đổi ' + usedCapSh + '/' + baseOcc + '</span>'
                : '';
              perRoomHtml = '<div class="rdm-section-title"><i class="fa-solid fa-users" style="margin-right:4px"></i>Danh sách khách của phòng này' + titleSuffixSh + '</div>';
              if (pickedSh.length === 0) {
                perRoomHtml += '<div class="rdm-unassigned"><i class="fa-solid fa-circle-info" style="margin-right:4px"></i>Không tìm thấy hành khách cho phòng này.</div>';
              } else {
                perRoomHtml += '<div class="rdm-pax-list">'
                  + pickedSh.map(function(p) {
                      var gStr = p.gender === 'male' ? ' · Nam' : p.gender === 'female' ? ' · Nữ' : '';
                      var aStr = p.age !== undefined && p.age !== '' ? ' · ' + p.age + 't' : '';
                      return '<div class="rdm-pax-row">' + typeLabel(p.type)
                        + '<span class="rdm-pax-name">' + escHtmlText(p.name || '—') + '</span>'
                        + '<span class="rdm-pax-meta">' + aStr + gStr + '</span></div>';
                    }).join('')
                  + '</div>';
              }
            }
          }
        }

        // ── PRIORITY 2: parse note snapshot — dùng khi không có passenger data đầy đủ.
        // Note format (mới): "... | atomLabel1 || atomLabel2 || ..." — dấu " || " phân cách
        // các atom, còn dấu ", " bên trong từng atomLabel (để list dependents) được giữ nguyên.
        // Note format (cũ): "... | Tên (NL), Tên (TE), ..." — split theo ", ".
        var passSnapshotHtml = '';
        if (!perRoomHtml && noteRaw) {
          var notePlain = noteRaw.replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"');
          var sep = notePlain.indexOf(' | ');
          if (sep !== -1) {
            var paxStr = notePlain.substring(sep + 3);
            // Thử split theo " || " (format mới) trước, nếu không có thì split theo ", " (format cũ).
            var atomItems = paxStr.indexOf(' || ') !== -1
              ? paxStr.split(' || ').map(function(s) { return s.trim(); }).filter(Boolean)
              : paxStr.split(', ').map(function(s) { return s.trim(); }).filter(Boolean);
            if (atomItems.length) {
              passSnapshotHtml = '<div class="rdm-section-title"><i class="fa-solid fa-users" style="margin-right:4px"></i>Danh sách khách của phòng này</div>'
                + '<div class="rdm-pax-list">'
                + atomItems.map(function(item) {
                    // Format cũ: "Tên (NL|TE|EB)"
                    var m = item.match(/^(.+?)\s+\((NL|TE|EB)\)$/);
                    if (m) {
                      var typMap = { NL: 'adult', TE: 'child', EB: 'baby' };
                      return '<div class="rdm-pax-row">' + typeLabel(typMap[m[2]] || 'adult') + '<span class="rdm-pax-name">' + escHtmlText(m[1]) + '</span></div>';
                    }
                    // Format mới (atomLabel): "Tên (+ TE/EB phụ1, ...)" — render như adult + dependents trong 1 row
                    var mAtom = item.match(/^(.+?)(?:\s+\(\+\s*(.+?)\))?$/);
                    var adultName = mAtom ? mAtom[1].trim() : item;
                    var depsStr   = mAtom && mAtom[2] ? mAtom[2] : '';
                    var rows = '<div class="rdm-pax-row">' + typeLabel('adult') + '<span class="rdm-pax-name">' + escHtmlText(adultName) + '</span></div>';
                    if (depsStr) {
                      // "TE Tên1, EB Tên2" → tách từng dep
                      var deps = depsStr.split(/,\s*/);
                      deps.forEach(function(d) {
                        var dm = d.trim().match(/^(TE|EB)\s+(.+)$/);
                        if (dm) {
                          var dType = dm[1] === 'TE' ? 'child' : 'baby';
                          rows += '<div class="rdm-pax-row">' + typeLabel(dType) + '<span class="rdm-pax-name">' + escHtmlText(dm[2].trim()) + '</span></div>';
                        } else if (d.trim()) {
                          rows += '<div class="rdm-pax-row"><span class="rdm-badge rdm-badge--adult">?</span><span class="rdm-pax-name">' + escHtmlText(d.trim()) + '</span></div>';
                        }
                      });
                    }
                    return rows;
                  }).join('')
                + '</div>';
            }
          }
        }

        // ── PRIORITY 3: fallback đơn cũ — toàn bộ hành khách của đơn (đánh dấu rõ là fallback).
        var custDetailHtml = '';
        if (!perRoomHtml && !passSnapshotHtml && cust && cust.passengers && cust.passengers.length) {
          custDetailHtml = '<div class="rdm-section-title"><i class="fa-solid fa-id-card" style="margin-right:4px"></i>Hành khách của đơn (đơn cũ — chưa gán theo từng phòng)</div>'
            + '<div class="rdm-pax-list">'
            + cust.passengers.map(function(p) {
                var gender = p.gender === 'male' ? ' · Nam' : p.gender === 'female' ? ' · Nữ' : '';
                var age    = p.age !== undefined && p.age !== '' ? ' · ' + p.age + 't' : '';
                return '<div class="rdm-pax-row">' + typeLabel(p.type)
                  + '<span class="rdm-pax-name">' + escHtmlText(p.name || '—') + '</span>'
                  + '<span class="rdm-pax-meta">' + age + gender + '</span></div>';
              }).join('')
            + '</div>';
        }

        var body = '';
        body += '<div class="rdm-info-grid">'
          + '<div class="rdm-info-row"><span class="rdm-info-label">Loại phòng</span><span class="rdm-info-val">' + escHtmlText(roomType) + '</span></div>'
          + '<div class="rdm-info-row"><span class="rdm-info-label">Sức chứa</span><span class="rdm-info-val">' + baseOcc + ' người</span></div>'
          + '<div class="rdm-info-row"><span class="rdm-info-label">Nhận phòng</span><span class="rdm-info-val">' + formatDate(checkIn) + '</span></div>'
          + '<div class="rdm-info-row"><span class="rdm-info-label">Trả phòng</span><span class="rdm-info-val">' + formatDate(checkOut) + '</span></div>'
          + '</div>';

        if (assignsHere.length > 0) {
          body += '<div class="rdm-section-title"><i class="fa-solid fa-user-check" style="margin-right:4px"></i>Khách đã được gán</div>';
          body += assignsHere.map(function(a) {
            var c = customers.find(function(x) { return x.orderId === a.orderId; });
            var modeLabel = (c && c.accommodationMode === 'shared') || a.accommodationMode === 'shared'
              ? '<span class="rdm-badge rdm-badge--shared">Ở ghép</span>'
              : '<span class="rdm-badge rdm-badge--private">Ở riêng</span>';
            var name = (c && c.guestName) || a.guestName || '—';
            var code = (c && c.orderCode) || a.orderCode || '';
            var phone = (c && c.phone) || a.phone || '';
            return '<div class="rdm-cust-row">'
              + modeLabel
              + '<span class="rdm-cust-name">' + escHtmlText(name) + '</span>'
              + '<span class="rdm-cust-code">#' + escHtmlText(code) + '</span>'
              + (phone ? '<span class="rdm-cust-phone"><i class="fa-solid fa-phone" style="margin-right:3px"></i>' + escHtmlText(phone) + '</span>' : '')
              + '</div>';
          }).join('');
        } else {
          body += '<div class="rdm-unassigned"><i class="fa-solid fa-circle-info" style="margin-right:4px"></i>Chưa gán cho khách nào</div>';
        }

        // ── Multi-occupant: nếu có nhiều đơn share, render danh sách hành
        //   khách của TỪNG đơn riêng để admin thấy đầy đủ ai đang ở phòng. ──
        if (assignsHere.length > 1) {
          var multiHtml = '<div class="rdm-section-title" style="margin-top:8px"><i class="fa-solid fa-people-group" style="margin-right:4px"></i>Danh sách khách (theo từng đơn)</div>';
          assignsHere.forEach(function(a) {
            var c2 = customers.find(function(x) { return x.orderId === a.orderId; });
            if (!c2) return;
            var paxByIdx2 = {};
            (c2.passengers || []).forEach(function(p) { paxByIdx2[p.idx] = p; });

            // Resolve atoms cho phòng này theo c2 + slotId (giống Priority 1.5).
            var picked2 = [];
            var matchedRa2 = null;

            // ── PRIORITY: đọc atomAnchorIdxs từ chính assignment in-memory
            //   (đã sync với tourSeg.assignments trong DB) — nguồn sự thật
            //   sau khi admin thao tác. Nếu thiếu, fallback xuống bucket-pos
            //   matching theo cust.sharedRoomRequest như cũ.
            if (Array.isArray(a.atomAnchorIdxs) && a.atomAnchorIdxs.length > 0) {
              var anchorSetDirect = {};
              a.atomAnchorIdxs.forEach(function(i) { anchorSetDirect[i] = true; });
              picked2 = filterPassengersForRoom(c2.passengers || [], anchorSetDirect);
            }

            var slotHold2 = findHoldRoom(slotId);
            if (picked2.length === 0 && slotHold2 && c2.accommodationMode === 'shared' && Array.isArray(c2.sharedRoomRequest)) {
              var hId2 = slotHold2.hotel && slotHold2.hotel.hotelId ? String(slotHold2.hotel.hotelId) : '';
              var tId2 = slotHold2.roomTypeId ? String(slotHold2.roomTypeId) : '';
              var ci2  = (slotHold2.checkIn  || '').split('T')[0];
              var co2  = (slotHold2.checkOut || '').split('T')[0];

              outer2: for (var s2 = 0; s2 < c2.sharedRoomRequest.length; s2++) {
                var sr2 = c2.sharedRoomRequest[s2];
                var f2 = (sr2.fromDate || '').split('T')[0];
                var t2 = (sr2.toDate   || '').split('T')[0];
                if (f2 !== ci2 || t2 !== co2) continue;
                for (var ai2 = 0; ai2 < (sr2.hotelAllocations || []).length; ai2++) {
                  var alloc2 = sr2.hotelAllocations[ai2];
                  if (String(alloc2.hotelId) !== hId2) continue;
                  var raArr2 = (alloc2.roomAssignments || []).filter(function(x) {
                    return String(x.roomTypeId) === tId2;
                  });
                  if (!raArr2.length) continue;
                  // Tìm ra match theo bucket-position trong assignments của c2 cùng bucket
                  var bucket2 = assignments.filter(function(x) {
                    if (x.orderId !== c2.orderId) return false;
                    var hr = findHoldRoom(x.holdBookingId);
                    if (!hr) return false;
                    var hHId = hr.hotel && hr.hotel.hotelId ? String(hr.hotel.hotelId) : '';
                    var hTId = hr.roomTypeId ? String(hr.roomTypeId) : '';
                    var hCi  = (hr.checkIn || '').split('T')[0];
                    var hCo  = (hr.checkOut || '').split('T')[0];
                    return hHId === hId2 && hTId === tId2 && hCi === ci2 && hCo === co2;
                  });
                  bucket2.sort(function(x, y) { return String(x.holdBookingId).localeCompare(String(y.holdBookingId)); });
                  var pos2 = -1;
                  for (var b2 = 0; b2 < bucket2.length; b2++) {
                    if (String(bucket2[b2].holdBookingId) === String(slotId)) { pos2 = b2; break; }
                  }
                  if (pos2 >= 0 && pos2 < raArr2.length) {
                    matchedRa2 = raArr2[pos2];
                    break outer2;
                  }
                }
              }
              if (matchedRa2 && Array.isArray(matchedRa2.atomAnchorIdxs)) {
                var anchorSet2 = {};
                matchedRa2.atomAnchorIdxs.forEach(function(i) { anchorSet2[i] = true; });
                picked2 = filterPassengersForRoom(c2.passengers || [], anchorSet2);
              }
            }

            var usedCap2 = null;
            if (a.usedCapacity != null) usedCap2 = a.usedCapacity;
            else if (matchedRa2 && matchedRa2.usedCapacity != null) usedCap2 = matchedRa2.usedCapacity;
            else if (a.numPeople != null) usedCap2 = a.numPeople;
            var capSuffix2 = (usedCap2 !== undefined && usedCap2 !== null)
              ? ' <span style="font-weight:400;color:#64748b">· sức chứa quy đổi ' + usedCap2 + '/' + baseOcc + '</span>'
              : '';

            multiHtml += '<div style="margin-top:6px;padding:6px;background:#f8fafc;border-radius:6px;border:1px solid #e2e8f0">'
              + '<div style="font-size:12px;color:#475569;margin-bottom:4px">'
              + '<b>' + escHtmlText(c2.guestName || '—') + '</b> · #' + escHtmlText(c2.orderCode || '') + capSuffix2 + '</div>';
            if (picked2.length === 0) {
              multiHtml += '<div class="rdm-unassigned" style="padding:4px"><i class="fa-solid fa-circle-info" style="margin-right:4px"></i>Không xác định được hành khách của đơn này trong phòng.</div>';
            } else {
              multiHtml += '<div class="rdm-pax-list">'
                + picked2.map(function(p) {
                    var g = p.gender === 'male' ? ' · Nam' : p.gender === 'female' ? ' · Nữ' : '';
                    var ag = p.age !== undefined && p.age !== '' ? ' · ' + p.age + 't' : '';
                    return '<div class="rdm-pax-row">' + typeLabel(p.type)
                      + '<span class="rdm-pax-name">' + escHtmlText(p.name || '—') + '</span>'
                      + '<span class="rdm-pax-meta">' + ag + g + '</span></div>';
                  }).join('')
                + '</div>';
            }
            multiHtml += '</div>';
          });
          body += multiHtml;
        } else {
          body += perRoomHtml || passSnapshotHtml || custDetailHtml;
        }

        document.getElementById('rdm-body').innerHTML = body;
        rdmModal.style.display = 'flex';
      }

      refreshFilters();
      renderRoomGrid();
      rerenderCustomerCard();
