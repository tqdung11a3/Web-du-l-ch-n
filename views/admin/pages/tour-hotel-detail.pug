extends ../layouts/default.pug

block main
  h1.box-title Cấu hình khung thời gian – Khách sạn

  //- ── Breadcrumb ──────────────────────────────────────────────────────
  .th-breadcrumb
    a(href=`/${pathAdmin}/tour-hotel/list`)
      i.fa-solid.fa-arrow-left
      |  Danh sách tour
    span.th-sep  /
    span= tour.name

  //- ── Chọn lịch khởi hành ─────────────────────────────────────────────
  .th-departure-select-bar
    label.th-label
      i.fa-solid.fa-calendar-day
      |  Chọn lịch khởi hành:
    select#departure-select.th-select(onchange=`window.location.href='/${pathAdmin}/tour-hotel/detail/${tour._id}?departure='+this.value`)
      option(value="" disabled selected=!departureDateParam) -- Chọn lịch --
      each dep in tour.departuresFormatted
        option(
          value=dep.departureDateStr
          selected=(dep.departureDateStr === departureDateParam)
        ) #{dep.departureDateDisplay} → #{dep.endDateDisplay}

  if !selectedDeparture
    .th-hint
      i.fa-solid.fa-circle-info
      |  Vui lòng chọn một lịch khởi hành bên trên để bắt đầu cấu hình.

  else
    //- ── Header: thông tin departure đang chọn ───────────────────────────
    .th-config-header
      .th-config-header__item
        span.th-config-label Khởi hành
        strong= moment(selectedDeparture.departureDate).format('DD/MM/YYYY')
      .th-config-header__item
        span.th-config-label Kết thúc
        strong= selectedDeparture.endDate ? moment(selectedDeparture.endDate).format('DD/MM/YYYY') : '—'
      .th-config-header__item
        span.th-config-label Tổng ngày
        - const totalDays = selectedDeparture.endDate ? (moment(selectedDeparture.endDate).diff(moment(selectedDeparture.departureDate), 'days') + 1) : 0
        strong= totalDays + ' ngày'
      .th-config-header__item
        span.th-config-label Trạng thái
        if existingSegment
          if existingSegment.status === 'confirmed'
            span.badge.badge--green Đã xác nhận
          else if existingSegment.status === 'pending_approval'
            span.badge.badge--orange Chờ duyệt KS khác
          else if existingSegment.status === 'cancelled'
            span.badge.badge--red Đã huỷ
          else if existingSegment.status === 'rejected'
            - var _rejCompanies = existingSegment.rejectedByCompanyNames && existingSegment.rejectedByCompanyNames.length ? existingSegment.rejectedByCompanyNames : (existingSegment.rejectedByCompanyName ? [existingSegment.rejectedByCompanyName] : [])
            if _rejCompanies.length > 0
              span.badge.badge--red(title=existingSegment.rejectedResponseNote || ('Bị ' + _rejCompanies.join(', ') + ' từ chối liên kết'))
                if _rejCompanies.length === 1
                  |  Đã bị #{_rejCompanies[0]} từ chối
                else
                  |  Đã bị #{_rejCompanies.length} công ty từ chối (#{_rejCompanies.join(', ')})
            else
              span.badge.badge--red Đã bị từ chối
          else
            span.badge.badge--yellow Bản nháp
        else
          span.badge.badge--gray Chưa cấu hình

    //- ── Banner cảnh báo quota phòng ─────────────────────────────────────
    if quotaPressure && (quotaPressure.pressureLevel === 'low' || quotaPressure.pressureLevel === 'exhausted')
      .th-quota-banner(class=quotaPressure.pressureLevel === 'exhausted' ? 'th-quota-banner--exhausted' : 'th-quota-banner--low')
        .th-quota-banner__icon
          if quotaPressure.pressureLevel === 'exhausted'
            i.fa-solid.fa-circle-xmark
          else
            i.fa-solid.fa-triangle-exclamation
        .th-quota-banner__body
          strong
            if quotaPressure.pressureLevel === 'exhausted'
              | Hết phòng trong quota!
            else
              | Quota phòng sắp không đủ
          p
            | Tour còn&nbsp;
            strong #{quotaPressure.seatsRemaining} ghế
            |&nbsp;nhưng sức chứa phòng KS trong quota chỉ còn&nbsp;
            strong ~#{quotaPressure.personCapacityAvailable} chỗ
            |&nbsp;(#{quotaPressure.totalAvailableRooms} phòng trống).
        button#open-additional-rooms-modal.th-quota-banner__cta(type="button")
          i.fa-solid.fa-plus-circle
          |  Yêu cầu bổ sung phòng

    //- ── Số người yêu cầu ────────────────────────────────────────────────
    //- Luôn lấy từ seatsTotal của lịch khởi hành (hoặc tour), không dùng giá trị cũ trong segment
    - const currentSeatsTotal = (selectedDeparture && selectedDeparture.seatsTotal != null ? selectedDeparture.seatsTotal : (tour.seatsTotal || ''))
    .th-pax-row
      label.th-label(for="pax-required")
        i.fa-solid.fa-users
        |  Số người cần bố trí phòng:
      input#pax-required.th-input-number(
        type="number" min="1"
        value=currentSeatsTotal
        placeholder="Nhập số người..."
      )

    //- ── Khung thời gian ─────────────────────────────────────────────────
    h2.th-section-title Khung thời gian lưu trú
    p.th-section-desc Chia khoảng #{moment(selectedDeparture.departureDate).format('DD/MM/YYYY')} → #{selectedDeparture.endDate ? moment(selectedDeparture.endDate).format('DD/MM/YYYY') : '?'} thành các khung. Mỗi khung chọn một hoặc nhiều khách sạn.

    #segments-wrapper.th-segments-wrapper
      //- Dữ liệu cũ sẽ được render bởi JS từ #existing-data

    .th-segments-actions
      button#add-segment-btn.btn-add-segment(type="button")
        i.fa-solid.fa-plus
        |  Thêm khung thời gian

    //- ── Tổng kết & nút hành động ─────────────────────────────────────────
    .th-summary-bar
      .th-summary-item
        span Sức chứa tối thiểu:
        strong#total-capacity-display 0 người
        span.th-summary-hint  (khung yếu nhất)
      .th-summary-item
        span Cần bố trí:
        strong#pax-required-display 0 người
      .th-summary-item#capacity-status-item

    .th-action-bar
      button#save-draft-btn.btn-save-draft(type="button")
        i.fa-solid.fa-floppy-disk
        |  Lưu bản nháp
      button#confirm-btn.btn-confirm(type="button")
        i.fa-solid.fa-circle-check
        if existingSegment && (existingSegment.status === 'confirmed' || existingSegment.status === 'pending_approval' || existingSegment.status === 'rejected')
          |  Xác nhận lại (Re-assign phòng)
        else
          |  Xác nhận & Giữ phòng
      if existingSegment && (existingSegment.status === 'confirmed' || existingSegment.status === 'pending_approval' || existingSegment.status === 'rejected')
        button#cancel-btn.btn-cancel-segment(type="button")
          i.fa-solid.fa-ban
          |  Huỷ & Giải phóng phòng

    //- Modal xác nhận (thay cho hộp thoại confirm của trình duyệt)
    #th-app-dialog.th-app-dialog(aria-hidden="true")
      .th-app-dialog__backdrop
      .th-app-dialog__panel(role="dialog" aria-modal="true" aria-labelledby="th-app-dialog-title")
        .th-app-dialog__header
          h3#th-app-dialog-title.th-app-dialog__title Xác nhận
          button#th-app-dialog-close.th-app-dialog__close(type="button" aria-label="Đóng")
            i.fa-solid.fa-xmark
        #th-app-dialog-body.th-app-dialog__body
        .th-app-dialog__footer
          button#th-app-dialog-cancel.th-app-dialog__btn.th-app-dialog__btn--secondary(type="button") Huỷ
          button#th-app-dialog-ok.th-app-dialog__btn.th-app-dialog__btn--primary(type="button") Tiếp tục

    //- ── Hidden data cho JS ───────────────────────────────────────────────
    //- Khi segment đã bị huỷ, không nạp lại cấu hình cũ vào form → reset trắng.
    script#existing-data(type="application/json")!= JSON.stringify(existingSegment && existingSegment.status === 'cancelled' ? null : existingSegment)
    script#hotels-data(type="application/json")!= JSON.stringify(hotels)
    script#departure-meta(type="application/json")!= JSON.stringify({ tourId: String(tour._id), departureDate: moment(selectedDeparture.departureDate).format('YYYY-MM-DD'), endDate: selectedDeparture.endDate ? moment(selectedDeparture.endDate).format('YYYY-MM-DD') : '' })
    script#path-admin(type="application/json")!= JSON.stringify(pathAdmin)
    script#current-company-id(type="application/json")!= JSON.stringify(currentCompanyId || '')
    script#is-tour-only-admin(type="application/json")!= JSON.stringify(!!isTourOnlyAdmin)
    script#quota-pressure-data(type="application/json")!= JSON.stringify(quotaPressure || null)
    script#hotel-link-status-map(type="application/json")!= JSON.stringify(hotelLinkStatusMap || {})

    //- Modal yêu cầu bổ sung phòng
    #additional-rooms-modal.th-add-rooms-modal(aria-hidden="true" style="display:none")
      .th-add-rooms-modal__backdrop
      .th-add-rooms-modal__panel(role="dialog" aria-modal="true" aria-labelledby="add-rooms-modal-title")
        .th-add-rooms-modal__header
          h3#add-rooms-modal-title Yêu cầu bổ sung phòng
          button#close-additional-rooms-modal.th-add-rooms-modal__close(type="button" aria-label="Đóng")
            i.fa-solid.fa-xmark
        .th-add-rooms-modal__body
          p.th-add-rooms-modal__desc
            | Điền số phòng muốn bổ sung thêm cho từng loại phòng bên dưới. Sau khi gửi, yêu cầu sẽ chờ admin khách sạn duyệt.
          #additional-rooms-table-wrap
            //- Bảng được render bởi JS từ quota-pressure-data
        .th-add-rooms-modal__footer
          button#cancel-additional-rooms-modal.th-add-rooms-modal__btn.th-add-rooms-modal__btn--secondary(type="button") Huỷ
          button#submit-additional-rooms-modal.th-add-rooms-modal__btn.th-add-rooms-modal__btn--primary(type="button")
            i.fa-solid.fa-paper-plane
            |  Gửi yêu cầu

    //- Template HTML cho 1 khung thời gian (dùng bởi JS)
    template#segment-template
      .th-segment-item
        .th-segment-header
          .th-segment-dates
            .th-segment-date-field
              label Từ ngày
              input.seg-from-date(type="date")
            .th-segment-date-field
              label Đến ngày
              input.seg-to-date(type="date")
          .th-segment-header-right
            span.th-segment-capacity-badge Sức chứa: 0
            button.seg-remove-btn(type="button")
              i.fa-solid.fa-trash
              |  Xoá khung

        .th-hotels-in-segment
          .th-add-hotel-row
            select.seg-hotel-select
              option(value="" disabled selected) -- Chọn khách sạn --
            button.seg-add-hotel-btn(type="button")
              i.fa-solid.fa-plus
              |  Thêm khách sạn
            button.seg-suggest-btn(type="button")
              i.fa-solid.fa-wand-magic-sparkles
              |  Gợi ý tự động

          .seg-hotels-list

