extends ../layouts/default.pug
include ../mixins/options.pug

block main
  
  h1.box-title Tạo tour

  //- Section 8
  .section-8
    form(id="tour-create-form")
      .inner-group
        label(for="customId" class="inner-label") ID tour
        input(type="text" id="customId" name="customId" style="font-family:monospace")

      .inner-group
        label(for="name" class="inner-label") Tên tour
        input(type="text" id="name" name="name")

      .inner-group.inner-group--tour-categories
        label(class="inner-label") Danh mục
        .tour-category-checkboxes
          +categoryCheckboxes(categoryList, [])

      .inner-group
        label(class="inner-label") Tags (Loại hình trải nghiệm)
        .tags-wrapper
          .tag-item
            input(type="checkbox" id="tag-adventure" name="tags" value="phiêu lưu")
            label(for="tag-adventure") Phiêu lưu
          .tag-item
            input(type="checkbox" id="tag-beach" name="tags" value="biển")
            label(for="tag-beach") Biển
          .tag-item
            input(type="checkbox" id="tag-culture" name="tags" value="văn hóa")
            label(for="tag-culture") Văn hóa
          .tag-item
            input(type="checkbox" id="tag-mountain" name="tags" value="leo núi")
            label(for="tag-mountain") Leo núi
          .tag-item
            input(type="checkbox" id="tag-city" name="tags" value="tham quan thành phố")
            label(for="tag-city") Tham quan thành phố

      .inner-group
        label(for="position" class="inner-label") Vị trí
        input(type="number" id="position" name="position")

      .inner-group
        label(for="status" class="inner-label") Trạng thái
        select(id="status" name="status")
          option(value="inactive" selected) Tạm dừng
          option(value="active") Hoạt động
        p#status-create-warn.tour-status-create-warn(style="display:none")
          i.fa-solid.fa-triangle-exclamation
          |  Tour mới chưa được liên kết khách sạn nên chưa thể chọn "Hoạt động". Sau khi tạo tour, hãy vào trang Liên kết Tour – Khách sạn để cấu hình, rồi quay lại đây bật hiển thị.

      .inner-group.inner-two-col
        label(for="avatar" class="inner-label") Ảnh đại diện
        .inner-upload-image
          input(
            type="file" 
            id="avatar"
            name="avatar"
            filepond-image
          )

      .inner-group.inner-two-col
        label(for="images" class="inner-label") Danh sách ảnh
        .inner-upload-image-multi
          input(
            type="file" 
            id="images"
            name="images"
            filepond-image-multi
            multiple
            data-allow-reorder="true"
            data-max-files="10"
          )

      .inner-group
        label(class="inner-label") Giá cũ
        .inner-input-list
          .inner-input-item
            label(for="priceAdult") Người lớn
            input(type="number" id="priceAdult" name="priceAdult")
          .inner-input-item
            label(for="priceChildren") Trẻ em (3-11 tuổi)
            input(type="number" id="priceChildren" name="priceChildren")
          .inner-input-item
            label(for="priceBaby") Em bé (0-2 tuổi)
            input(type="number" id="priceBaby" name="priceBaby")

      .inner-group
        label(class="inner-label") Giá mới
        .inner-input-list
          .inner-input-item
            label(for="priceNewAdult") Người lớn
            input(type="number" id="priceNewAdult" name="priceNewAdult")
          .inner-input-item
            label(for="priceNewChildren") Trẻ em (3-11 tuổi)
            input(type="number" id="priceNewChildren" name="priceNewChildren")
          .inner-input-item
            label(for="priceNewBaby") Em bé (0-2 tuổi)
            input(type="number" id="priceNewBaby" name="priceNewBaby")

      //- ==== KHUNG THỜI HẠN KHUYẾN MÃI (giảm theo số tiền cố định) ====
      .inner-group.inner-two-col#manual-discount-group(style="display:none")
        label(class="inner-label") Thời hạn khuyến mãi
        .inner-input-list
          .inner-input-item
            label(for="discountFrom") Từ ngày
            input(type="date" id="discountFrom" name="discountFrom")
          .inner-input-item
            label(for="discountTo") Đến ngày
            input(type="date" id="discountTo" name="discountTo")
        .inner-desc
          | Khung này chỉ dùng khi đã nhập ít nhất một giá cũ (Người lớn / Trẻ em / Em bé).
          br
          | Nếu không muốn khuyến mãi theo thời hạn, hãy xóa hết giá cũ hoặc để 0.  

      //- ==== CÁCH TÍNH GIÁ EM BÉ ====
      .inner-group
        label(class="inner-label") Cách tính giá Em bé
        .inner-input-list
          .inner-input-item
            label(for="babyPricingMode") Chế độ
            select(id="babyPricingMode" name="babyPricingMode")
              option(value="fixed" selected) Cố định (dùng ô Giá mới - Em bé)
              option(value="tiered") Theo bậc (nhiều em bé, nhiều mức %)

      //- Khối cấu hình bậc giá Em bé (chỉ hiện khi chọn "tiered")
      .inner-group#baby-pricing-rules-wrapper(style="display:none")
        label(class="inner-label") Quy tắc bậc giá Em bé
        .inner-desc
          | Ví dụ: Bé 1–2 miễn phí, bé 3–4 = 50% giá Trẻ em, từ bé 5 trở lên = 75% giá Trẻ em.
          br
          | Mỗi dòng tương ứng một khoảng số lượng Em bé.
        .baby-rules-table
          .baby-rules-header
            .baby-rules-cell Bé từ (thứ mấy)
            .baby-rules-cell đến (thứ mấy)
            .baby-rules-cell % so với giá
            .baby-rules-cell Giá tham chiếu
            .baby-rules-cell Thao tác
          .baby-rules-body#baby-rules-body
            //- Hàng mẫu ban đầu
            .baby-rule-row
              .baby-rules-cell
                input.rule-from(type="number" min="1" value="1")
              .baby-rules-cell
                input.rule-to(type="number" min="1" placeholder="VD: 2 (hoặc bỏ trống = trở lên)")
              .baby-rules-cell
                input.rule-percent(type="number" min="0" max="100" value="0")
              .baby-rules-cell
                select.rule-ref
                  option(value="children" selected) Giá Trẻ em
                  option(value="adult") Giá Người lớn
              .baby-rules-cell
                button.type-button.baby-rule-remove(type="button") Xóa
        .baby-rules-actions
          button#baby-rule-add(type="button") + Thêm dòng quy tắc
        //- Input ẩn: nơi JS sẽ ghi JSON để gửi lên server
        input(type="hidden" id="babyPricingRulesJson" name="babyPricingRulesJson")

      //- ==== CẤU HÌNH CHỖ NGỒI EM BÉ ====
      .inner-group
        label(class="inner-label") Cấu hình chỗ ngồi Em bé
        .inner-desc#baby-seat-desc-shared
        .inner-desc#baby-seat-desc-auto(style="display:none")
          | Khi Số em bé tối đa/người lớn = 0, tất cả em bé mặc định chiếm 1 vị trí tour. Không hiển thị lựa chọn ghế riêng.
        .inner-input-list.baby-seat-config-list
          .inner-input-item
            label(for="maxBabiesPerAdult") Số em bé tối đa/người lớn
            input#maxBabiesPerAdult(
              type="number"
              name="maxBabiesPerAdult"
              min="0"
              value="1"
              placeholder="1"
            )
          #babySeatFeeWrap
            .inner-input-item
              label(for="babySeatFee") Phí ghế ngồi riêng (VND/em bé)
              input#babySeatFee(
                type="number"
                name="babySeatFee"
                min="0"
                value="0"
                placeholder="0"
              )
      script.
        (function () {
          var inp = document.getElementById('maxBabiesPerAdult');
          var feeWrap = document.getElementById('babySeatFeeWrap');
          var descShared = document.getElementById('baby-seat-desc-shared');
          var descAuto = document.getElementById('baby-seat-desc-auto');
          function toggle() {
            var v = parseInt(inp.value, 10);
            var isAuto = !isNaN(v) && v === 0;
            if (feeWrap) feeWrap.style.display = isAuto ? 'none' : '';
            if (descShared) descShared.style.display = isAuto ? 'none' : '';
            if (descAuto) descAuto.style.display = isAuto ? '' : 'none';
          }
          inp && inp.addEventListener('input', toggle);
          toggle();
        })();

      //- (ghế đã chuyển vào từng lịch khởi hành bên dưới)

      //- ĐIỂM KHỞI HÀNH
      .inner-group
        label(for="departureCity" class="inner-label") Điểm khởi hành
        select(id="departureCity" name="departureCity")
          option(value="") -- Chọn điểm khởi hành --
          each item in cityList
            option(value=item.id) #{item.name}

      //- ĐỊA ĐIỂM CÓ TRONG TOUR
      .inner-group
        label(class="inner-label") Những địa điểm có trong tour
        
        //- Danh sách tỉnh thành Việt Nam
        .inner-group#vietnam-locations-group
          label(class="inner-label") Địa điểm trong nước (Việt Nam)
          .tour-locations-wrapper#tour-locations-wrapper
            .tour-location-item(data-index="0")
              .inner-input-list
                .inner-input-item
                  label Điểm đến
                  select.location-city
                    option(value="") -- Chọn tỉnh/thành --
                    each city in cityList
                      option(value=city.id) #{city.name}
                .inner-input-item
                  label Các địa điểm nổi tiếng
                  .location-spots-list
                    .location-spot-item
                      .spot-input-group
                        textarea.spot-input(placeholder="VD: Chùa Linh Ứng" rows="2")
                        button(type="button" class="spot-remove-btn") Xóa
                  .spot-actions
                    button(type="button" class="spot-add-btn") + Thêm địa điểm
              .location-actions
                button(type="button" class="location-remove-btn") Xóa điểm đến
          .location-global-actions
            button(type="button" id="location-add-btn") + Thêm điểm đến

        //- Input ẩn: JS sẽ ghi JSON locations trước khi submit
        input(type="hidden" id="locationsJson" name="locations")

      .inner-group
        label(for="time" class="inner-label") Thời gian
        input(type="text" id="time" name="time")

      .inner-group
        label(for="vehicle" class="inner-label") Phương tiện
        input(type="text" id="vehicle" name="vehicle")

      .inner-group.inner-two-col
        label(class="inner-label") Ngày khởi hành & Ngày kết thúc
        .inner-desc Mỗi dòng là một lịch khởi hành. Ngày kết thúc phải sau ngày khởi hành.
        .departures-wrapper#departures-wrapper
          .departure-pair-item(data-index="0")
            .departure-pair-inputs
              .departure-pair-field
                label Ngày khởi hành
                input(type="date" class="departure-date-input")
              .departure-pair-field
                label Ngày kết thúc
                input(type="date" class="end-date-input")
              .departure-pair-field
                label Tổng số ghế
                input(type="number" class="seats-total-input" min="0" placeholder="VD: 40")
              .departure-pair-field
                label Ghế còn lại
                input(type="number" class="seats-remaining-input" min="0" placeholder="VD: 40")
            .departure-pair-field.departure-pair-field--remove
              label(aria-hidden="true") &nbsp;
              button(type="button" class="departure-pair-remove-btn") Xóa
        .departures-actions
          button(type="button" id="departure-pair-add-btn") + Thêm lịch khởi hành
        //- Input ẩn: JS sẽ ghi JSON mảng [{departureDate, endDate, seatsTotal, seatsRemaining}]
        input(type="hidden" id="departuresJson" name="departures")

      .inner-group.inner-two-col
        label(for="information" class="inner-label") Thông tin tour
        textarea(id="information" textarea-mce name="information")

      .inner-group.inner-two-col
        label(class="inner-label") Điểm nổi bật
        .tour-highlights-list
          .tour-highlight-item
            .highlight-input-group
              textarea.highlight-input(placeholder="VD: Tham quan cố đô Huế" rows="2")
              button(type="button" class="highlight-remove-btn") Xóa
        .highlight-actions
          button(type="button" id="highlight-add-btn") + Thêm điểm nổi bật

      .inner-group.inner-two-col
        label(class="inner-label") Bao gồm
        .tour-includes-list
          .tour-include-item
            .include-input-group
              textarea.include-input(placeholder="VD: Vé tham quan các điểm du lịch" rows="2")
              button(type="button" class="include-remove-btn") Xóa
        .include-actions
          button(type="button" id="include-add-btn") + Thêm mục bao gồm

      .inner-group.inner-two-col
        label(class="inner-label") Không bao gồm
        .tour-excludes-list
          .tour-exclude-item
            .exclude-input-group
              textarea.exclude-input(placeholder="VD: Chi phí cá nhân" rows="2")
              button(type="button" class="exclude-remove-btn") Xóa
        .exclude-actions
          button(type="button" id="exclude-add-btn") + Thêm mục không bao gồm

      .inner-group.inner-two-col
        label(class="inner-label") Lịch trình tour
        .inner-schedule
          .inner-schedule-list
            .inner-schedule-item
              .inner-schedule-head
                span(class="inner-schedule-button inner-move")
                  <i class="fa-solid fa-up-down-left-right"></i>
                input(type="text")
                span(class="inner-schedule-button inner-remove")
                  <i class="fa-regular fa-trash-can"></i>
                span(class="inner-schedule-button inner-more")
                  <i class="fa-solid fa-angle-down"></i>
              .inner-schedule-body
                textarea(textarea-mce)
          .inner-schedule-create + Thêm lịch trình

      .inner-button.inner-two-col
        button Tạo mới

    .inner-back
      a(href=`/${pathAdmin}/tour/list`) Quay lại danh sách
  //- End Section 8

  script.
    // ── Cảnh báo khi chọn "Hoạt động" trên trang Tạo tour ──────────────────
    (function () {
      var sel = document.getElementById('status');
      var warn = document.getElementById('status-create-warn');
      if (!sel || !warn) return;
      sel.addEventListener('change', function () {
        if (sel.value === 'active') {
          warn.style.display = '';
          // Trả về giá trị mặc định; server cũng sẽ ép inactive
          sel.value = 'inactive';
        } else {
          warn.style.display = 'none';
        }
      });
    })();

    window.vietnamCities = !{JSON.stringify(cityList || [])};

    // Xử lý thêm/xóa địa điểm nổi tiếng trong locations
    document.addEventListener('DOMContentLoaded', function() {
      // Helper function để tạo spot item
      function createSpotItem() {
        const div = document.createElement('div');
        div.className = 'location-spot-item';
        div.innerHTML = `
          <div class="spot-input-group">
            <textarea class="spot-input" placeholder="VD: Chùa Linh Ứng" rows="2"></textarea>
            <button type="button" class="spot-remove-btn">Xóa</button>
          </div>
        `;
        attachSpotRemoveHandler(div);
        return div;
      }
      
      function attachSpotRemoveHandler(spotItem) {
        const btn = spotItem.querySelector('.spot-remove-btn');
        btn.addEventListener('click', () => {
          const spotsList = spotItem.closest('.location-spots-list');
          if (spotsList.children.length > 1) {
            spotItem.remove();
          } else {
            spotItem.querySelector('.spot-input').value = '';
          }
        });
      }
      
      // Gắn handlers cho tất cả spot items hiện có
      document.querySelectorAll('.location-spot-item').forEach(item => {
        attachSpotRemoveHandler(item);
      });
      
      // Gắn handlers cho nút thêm spot
      document.addEventListener('click', (e) => {
        if (e.target.classList.contains('spot-add-btn')) {
          const spotsList = e.target.closest('.inner-input-item').querySelector('.location-spots-list');
          if (spotsList) {
            spotsList.appendChild(createSpotItem());
          }
        }
      });
    });
    
    // Xử lý thêm/xóa Điểm nổi bật
    document.addEventListener('DOMContentLoaded', function() {
      const highlightsList = document.querySelector('.tour-highlights-list');
      const addBtn = document.getElementById('highlight-add-btn');
      
      if (!highlightsList || !addBtn) return;
      
      function createHighlightItem() {
        const div = document.createElement('div');
        div.className = 'tour-highlight-item';
        div.innerHTML = `
          <div class="highlight-input-group">
            <textarea class="highlight-input" placeholder="VD: Tham quan cố đô Huế" rows="2"></textarea>
            <button type="button" class="highlight-remove-btn">Xóa</button>
          </div>
        `;
        attachHighlightRemoveHandler(div);
        return div;
      }
      
      function attachHighlightRemoveHandler(item) {
        const btn = item.querySelector('.highlight-remove-btn');
        btn.addEventListener('click', () => {
          if (highlightsList.children.length > 1) {
            item.remove();
          } else {
            item.querySelector('.highlight-input').value = '';
          }
        });
      }
      
      highlightsList.querySelectorAll('.tour-highlight-item').forEach(item => {
        attachHighlightRemoveHandler(item);
      });
      
      addBtn.addEventListener('click', () => {
        highlightsList.appendChild(createHighlightItem());
      });
    });
    
    // Xử lý thêm/xóa Bao gồm
    document.addEventListener('DOMContentLoaded', function() {
      const includesList = document.querySelector('.tour-includes-list');
      const addBtn = document.getElementById('include-add-btn');
      
      if (!includesList || !addBtn) return;
      
      function createIncludeItem() {
        const div = document.createElement('div');
        div.className = 'tour-include-item';
        div.innerHTML = `
          <div class="include-input-group">
            <textarea class="include-input" placeholder="VD: Vé tham quan các điểm du lịch" rows="2"></textarea>
            <button type="button" class="include-remove-btn">Xóa</button>
          </div>
        `;
        attachIncludeRemoveHandler(div);
        return div;
      }
      
      function attachIncludeRemoveHandler(item) {
        const btn = item.querySelector('.include-remove-btn');
        btn.addEventListener('click', () => {
          if (includesList.children.length > 1) {
            item.remove();
          } else {
            item.querySelector('.include-input').value = '';
          }
        });
      }
      
      includesList.querySelectorAll('.tour-include-item').forEach(item => {
        attachIncludeRemoveHandler(item);
      });
      
      addBtn.addEventListener('click', () => {
        includesList.appendChild(createIncludeItem());
      });
    });
    
    // Xử lý thêm/xóa Không bao gồm
    document.addEventListener('DOMContentLoaded', function() {
      const excludesList = document.querySelector('.tour-excludes-list');
      const addBtn = document.getElementById('exclude-add-btn');
      
      if (!excludesList || !addBtn) return;
      
      function createExcludeItem() {
        const div = document.createElement('div');
        div.className = 'tour-exclude-item';
        div.innerHTML = `
          <div class="exclude-input-group">
            <textarea class="exclude-input" placeholder="VD: Chi phí cá nhân" rows="2"></textarea>
            <button type="button" class="exclude-remove-btn">Xóa</button>
          </div>
        `;
        attachExcludeRemoveHandler(div);
        return div;
      }
      
      function attachExcludeRemoveHandler(item) {
        const btn = item.querySelector('.exclude-remove-btn');
        btn.addEventListener('click', () => {
          if (excludesList.children.length > 1) {
            item.remove();
          } else {
            item.querySelector('.exclude-input').value = '';
          }
        });
      }
      
      excludesList.querySelectorAll('.tour-exclude-item').forEach(item => {
        attachExcludeRemoveHandler(item);
      });
      
      addBtn.addEventListener('click', () => {
        excludesList.appendChild(createExcludeItem());
      });
    });
    
