extends ../layouts/default.pug
include ../mixins/change-status.pug

block main
  
  h1.box-title Quản lý tour

  // Tab: Tour trong nước (tab Tour nước ngoài đã ẩn)
  .tour-tabs
    a.tour-tab(
      href=`/${pathAdmin}/tour?tab=domestic`
      class=currentTab === "domestic" ? "is-active" : ""
    ) Tour trong nước

  //- ── Cấu hình mức tuổi hành khách ──────────────────────────────────────────
  .age-band-panel
    .age-band-panel__header(onclick="toggleAgeBandPanel()")
      .age-band-panel__header-left
        i.fa-solid.fa-users-gear
        span  Cấu hình mức tuổi hành khách
        span.age-band-panel__subtitle
          |  (Người lớn từ #{(tourAgeBands.childrenMaxAge || 11) + 1} tuổi · Trẻ em #{(tourAgeBands.babyMaxAge || 3) + 1}–#{tourAgeBands.childrenMaxAge || 11} tuổi · Em bé 0–#{tourAgeBands.babyMaxAge || 3} tuổi)
      .age-band-panel__toggle
        i.fa-solid.fa-chevron-down#age-band-chevron

    .age-band-panel__body#age-band-body(style="display:none")
      .age-band-panel__desc
        i.fa-solid.fa-circle-info
        |  Cấu hình này xác định ngưỡng tuổi để phân loại hành khách khi hiển thị và đặt tour. Áp dụng cho tất cả tour của công ty.

      .age-band-grid
        //- Em bé
        .age-band-card.age-band-card--baby
          .age-band-card__icon
            i.fa-solid.fa-baby
          .age-band-card__label Em bé
          .age-band-card__range
            span Từ 0 đến
            input#baby-max-age.age-band-input(
              type="number" min="0" max="10"
              value=tourAgeBands.babyMaxAge !== undefined ? tourAgeBands.babyMaxAge : 3
            )
            span tuổi
          .age-band-card__note Không tính ghế ngồi riêng (tuỳ cài đặt)

        //- Trẻ em
        .age-band-card.age-band-card--children
          .age-band-card__icon
            i.fa-solid.fa-child
          .age-band-card__label Trẻ em
          .age-band-card__range
            span#children-min-display Từ #{(tourAgeBands.babyMaxAge || 3) + 1} đến
            input#children-max-age.age-band-input(
              type="number" min="1" max="17"
              value=tourAgeBands.childrenMaxAge !== undefined ? tourAgeBands.childrenMaxAge : 11
            )
            span tuổi

        //- Người lớn
        .age-band-card.age-band-card--adult
          .age-band-card__icon
            i.fa-solid.fa-person
          .age-band-card__label Người lớn
          .age-band-card__range
            span Từ
            span#adult-min-display #{(tourAgeBands.childrenMaxAge || 11) + 1}
            span tuổi trở lên
          .age-band-card__note Áp dụng giá người lớn đầy đủ

      .age-band-panel__actions
        button#btn-save-age-bands.btn-primary(type="button")
          i.fa-solid.fa-floppy-disk
          |  Lưu cấu hình
        span#age-band-msg

  script.
    function toggleAgeBandPanel() {
      var body    = document.getElementById('age-band-body');
      var chevron = document.getElementById('age-band-chevron');
      var open    = body.style.display !== 'none';
      body.style.display    = open ? 'none' : '';
      chevron.style.transform = open ? '' : 'rotate(180deg)';
    }

    function updateAgeBandDisplay() {
      var babyMax     = parseInt(document.getElementById('baby-max-age').value) || 0;
      var childrenMax = parseInt(document.getElementById('children-max-age').value) || 0;
      var childrenMin = babyMax + 1;
      var adultMin    = childrenMax + 1;

      var childrenMinEl = document.getElementById('children-min-display');
      var adultMinEl    = document.getElementById('adult-min-display');
      var subtitle      = document.querySelector('.age-band-panel__subtitle');

      if (childrenMinEl) childrenMinEl.textContent = 'Từ ' + childrenMin + ' đến';
      if (adultMinEl)    adultMinEl.textContent    = adultMin;
      if (subtitle)      subtitle.textContent      =
        ' (Người lớn từ ' + adultMin + ' tuổi · Trẻ em ' + childrenMin + '–' + childrenMax + ' tuổi · Em bé 0–' + babyMax + ' tuổi)';
    }

    document.getElementById('baby-max-age').addEventListener('input', updateAgeBandDisplay);
    document.getElementById('children-max-age').addEventListener('input', updateAgeBandDisplay);

    document.getElementById('btn-save-age-bands').addEventListener('click', function() {
      var btn         = this;
      var msg         = document.getElementById('age-band-msg');
      var babyMax     = parseInt(document.getElementById('baby-max-age').value);
      var childrenMax = parseInt(document.getElementById('children-max-age').value);

      if (isNaN(babyMax) || isNaN(childrenMax) || childrenMax <= babyMax) {
        msg.textContent = 'Mức tuổi không hợp lệ: trẻ em phải lớn hơn em bé';
        msg.style.color = '#ef4444';
        return;
      }

      btn.disabled = true;
      msg.textContent = 'Đang lưu...';

      fetch('!{`/${pathAdmin}/tour/age-bands`}', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ babyMaxAge: babyMax, childrenMaxAge: childrenMax }),
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          btn.disabled = false;
          msg.textContent = data.message || '';
          msg.style.color = data.success ? '#16a34a' : '#ef4444';
          if (data.success) updateAgeBandDisplay();
        })
        .catch(function() {
          btn.disabled = false;
          msg.textContent = 'Lỗi kết nối';
          msg.style.color = '#ef4444';
        });
    });

  // form giảm giá theo % cho các tour đã chọn
  form#bulk-discount-form.bulk-discount-form
    span.bulk-label Giảm giá nhanh:
    input.bulk-input-percent(
      type="number"
      name="percent"
      min="1"
      max="90"
      placeholder="Giảm % (vd: 10)"
    )
    input.bulk-input-date(type="date" name="discountFrom")
    span.bulk-separator đến
    input.bulk-input-date(type="date" name="discountTo")
    button.bulk-apply-btn(type="submit") Áp dụng cho tour đã chọn
  //- Section 4
  .section-4
    .inner-wrap
      .inner-item
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item
        select
          option(value="") Trạng thái
          option(value="") Hoạt động
          option(value="") Tạm dừng
      .inner-item
        select
          option(value="") Người tạo
          option(value="") Lê Văn A
          option(value="") Lê Văn B
      .inner-item
        input(type="date")
        span -
        input(type="date")
      .inner-item
        select
          option(value="") Danh mục
          option(value="") Danh mục 1
          option(value="") Danh mục 2
      .inner-item
        select
          option(value="") Mức giá
          option(value="") Dưới 2tr
          option(value="") 2tr đến 4tr
          option(value="") 4tr đến 8tr
          option(value="") Trên 8tr
      .inner-item.inner-reset
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5
  .section-5
    .inner-wrap
      +change-status(
        `/${pathAdmin}/tour/change-multi`,
        [
          {
            label: "Hoạt động",
            value: "active"
          },
          {
            label: "Tạm dừng",
            value: "inactive"
          },
          {
            label: "Xóa",
            value: "delete"
          }
        ]
      )
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm" search)
      .inner-button-create
        - const createLink = currentTab === "international" ? `/${pathAdmin}/tour/create?type=international` : `/${pathAdmin}/tour/create?type=domestic`
        a(href=createLink) + Tạo mới
      .inner-button-discount
        a(href=`/${pathAdmin}/tour/discounts`) Tour khuyến mãi
      .inner-button-trash
        a(href=`/${pathAdmin}/tour/trash`) Thùng rác
  //- End Section 5

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th
              input(type="checkbox" class="inner-check" check-all)
            th Tên tour
            th(class="inner-center" title="6 ký tự cuối MongoDB _id, dùng để đối chiếu trên lịch phòng khách sạn") ID tour
            th(class="inner-center") Ảnh đại diện
            th Giá
            th Còn lại
            th(class="inner-center") Đánh giá
            th(class="inner-center") Vị trí
            th(class="inner-center") Trạng thái
            th Tạo bởi
            th Cập nhật bởi
            th Hành động
        tbody
          each item in tourList
            tr
              td
                input(type="checkbox" class="inner-check" check-item=item.id)
              td #{item.name}
              td.inner-center
                span.tour-short-id ##{String(item.id).slice(-6)}
              td.inner-center
                img(src=item.avatar class="inner-avatar")

              // === GIÁ ===
              td
                - const fmt = (n) => {
                -   const v = Number(n);
                -   return Number.isFinite(v) ? v.toLocaleString('vi-VN') : '0';
                - };

                div NL: #{fmt(item.priceNewAdult)}đ
                div TE: #{fmt(item.priceNewChildren)}đ
                if item.babyPricingMode === 'fixed'
                  div EB: #{fmt(item.priceNewBaby)}đ
                else
                  // ghép EB và badge theo bậc, tránh bị kéo giãn
                  div(style="display:inline-flex;align-items:center;gap:6px")
                    span EB:
                    span.badge.badge-blue Theo bậc
              // === CÒN LẠI (GHẾ) ===
              td
                div Còn: #{item.seatsRemaining || 0}
              // === ĐÁNH GIÁ ===
              td.inner-center
                if item.ratingAvg && item.ratingAvg > 0
                  div(style="display:flex;align-items:center;justify-content:center;gap:4px;")
                    span(style="color:#ffa500;font-weight:bold;") ★
                    span(style="font-weight:bold;") #{item.ratingAvg.toFixed(1)}
                    if item.ratingCount && item.ratingCount > 0
                      span(style="color:#999;font-size:12px;") (#{item.ratingCount})
                else
                  span(style="color:#999;") Chưa có đánh giá
              td.inner-center #{item.position}
              td.inner-center
                if (item.status == "active")
                  .badge.badge-green Hoạt động
                else if (item.status == "inactive")
                  .badge.badge-red Tạm dừng
                - var pubInfo = (publishableMap || {})[String(item.id)]
                if item.status !== "active" && pubInfo && !pubInfo.ok
                  .tour-publish-mini-badge(
                    title=(pubInfo.reasons && pubInfo.reasons.length ? pubInfo.reasons.join("\n") : "Tour chưa đủ điều kiện hiển thị")
                  )
                    i.fa-solid.fa-circle-exclamation
                    |  Chưa xuất bản
              td
                div #{item.createdByFullName}
                div.inner-time #{item.createdAtFormat}
              td
                div #{item.updatedByFullName}
                div.inner-time #{item.updatedAtFormat}
              td
                .inner-buttons
                  a(href=`/${pathAdmin}/tour/edit/${item.id}` class="inner-edit")
                    <i class="fa-regular fa-pen-to-square"></i>
                  button(
                    class="inner-delete"
                    button-delete
                    data-api=`/${pathAdmin}/tour/delete/${item.id}`
                  )
                    <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  .section-7
    span.inner-label
      | Hiển thị #{pagination.skip + 1}
      | - #{pagination.skip + tourList.length}
      | của #{pagination.totalRecord}
    select(class="inner-pagination" box-pagination)
      - for (let i = 1; i <= pagination.totalPage; i++)
        option(value=i) Trang #{i}
  //- End Section 7
