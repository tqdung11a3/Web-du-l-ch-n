                    span.badge(class=group.segmentStatus === 'confirmed' ? 'badge--green' : 'badge--yellow')
                      = group.segmentStatus === 'confirmed' ? 'Đã xác nhận' : 'Bản nháp'
                    span.th-sep  |
                    span
                      i.fa-solid.fa-calendar-day
                      |  Khởi hành: #{group.departureDate}  →  #{group.endDate}
                    span.th-sep  |
                    span
                      i.fa-solid.fa-users
                      |  Yêu cầu: #{group.paxRequired} người
                    span.th-sep  |
                    if group.timeFrames && group.timeFrames.length > 1
                      span
                        i.fa-solid.fa-layer-group(style="margin-right:4px;color:#6366f1")
                        | #{group.timeFrames.length} khung thời gian &nbsp;·&nbsp; #{group.totalPeople} người (#{group.totalRooms} phòng tổng)
                    else if group.timeFrames && group.timeFrames.length === 1
                      span
                        i.fa-regular.fa-calendar(style="margin-right:4px")
                        | #{group.timeFrames[0].checkIn} → #{group.timeFrames[0].checkOut}
                        |  &nbsp;·&nbsp; #{group.totalPeople} người (#{group.totalRooms} phòng)
                    else
                      span
                        i.fa-solid.fa-bed
                        |  Đã giữ: #{group.totalPeople} người (#{group.totalRooms} phòng)
                  if unassignedIds.length > 0
                    button.btn-release-holds(
                      type="button"
                      data-panel-id="release-panel-" + group.segmentId
                      data-unassigned-ids=unassignedIds.join(',')
                      onclick="showReleasePanel(this)"
                    )
                      i.fa-solid.fa-unlock
                      |  Giải phóng #{unassignedIds.length} phòng chưa gán

                if group.timeFrames && group.timeFrames.length > 1
                  //- ── Accordion: mỗi khung là 1 nút bấm toggle ──
                  .tf-accordion
                    each tf, tfi in group.timeFrames
                      - var tfPanelId = 'tf-panel-' + group.segmentId + '-' + tfi
                      - var tfBookings = group.bookings.filter(function(b){ return b.tfKey === (tf.checkIn + '_' + tf.checkOut); })
                      - var tfUnassigned = tfBookings.filter(function(b){ return !b.isAssigned; })
                      .tf-accordion-item
                        button.tf-toggle-btn(
                          type="button"
                          data-panel-id=tfPanelId
                          onclick="toggleTfPanel(this.dataset.panelId, this)"
                          aria-expanded="false"
                          aria-controls=tfPanelId
                        )
                          if tf.segmentLabel
                            span.tf-toggle-badge= tf.segmentLabel
                          else
                            span.tf-toggle-badge Đợt #{tfi + 1}
                          span.tf-toggle-dates
                            i.fa-regular.fa-calendar
                            |  #{tf.checkIn}
                            span.tf-toggle-arrow  →
                            | #{tf.checkOut}
                          .tf-toggle-stats
                            span
                              i.fa-solid.fa-users(style="font-size:11px")
                              |  #{tf.totalPeople} người
                            span
                              i.fa-solid.fa-door-open(style="font-size:11px")
                              |  #{tf.totalRooms} phòng
                            if tfUnassigned.length > 0
                              span.badge.badge--yellow #{tfUnassigned.length} chưa gán
                          i.fa-solid.fa-chevron-down.tf-toggle-icon
                        .tf-panel(id=tfPanelId)
                          table.tour-hold-table
                            thead
                              tr
                                th Mã giữ phòng
                                th Loại phòng
                                th Phòng số
                                th Khách đã gán
                                th Nhận phòng
                                th Trả phòng
                                th Trạng thái
                                th Thao tác
                            tbody
                              each b in tfBookings
                                - var effectiveStatus = !b.isAssigned ? 'confirmed' : b.status
                                tr(data-booking-id=b.id data-booking-code=b.code)
                                  td
                                    span.booking-code= b.code
                                  td= b.roomTypeName
                                  td
                                    if b.roomNumber && b.roomNumber !== '—'
                                      span.room-number-badge= b.roomNumber
                                    else
                                      span.text-muted —
                                  td
                                    if b.isAssigned
                                      .th-guest-info
                                        span.th-guest-name= b.guestName
                                        if b.guestPhone
                                          span.th-guest-phone
                                            i.fa-solid.fa-phone(style="font-size:10px")
                                            |  #{b.guestPhone}
                                    else
                                      span.badge.badge--yellow Chưa gán khách
                                  td= b.checkIn
                                  td= b.checkOut
                                  td
                                    - var statusLabel = effectiveStatus === 'confirmed' ? 'Chờ nhận phòng' : effectiveStatus === 'checked_in' ? 'Đang ở' : effectiveStatus === 'checked_out' ? 'Đã trả phòng' : effectiveStatus
                                    - var statusClass = effectiveStatus === 'confirmed' ? 'badge--blue' : effectiveStatus === 'checked_in' ? 'badge--green' : effectiveStatus === 'checked_out' ? 'badge--gray' : 'badge--yellow'
                                    span.badge(class=statusClass)= statusLabel
                                  td.th-action-cell
                                    if effectiveStatus === 'confirmed'
                                      if b.isAssigned
                                        button.btn-th-checkin(
                                          type="button"
                                          data-booking-id=b.id
                                          onclick="tourHoldCheckin(this)"
                                          title="Xác nhận khách đã đến nhận phòng"
                                        )
                                          i.fa-solid.fa-door-open
                                          |  Nhận phòng
                                      else
                                        button.btn-release-single(
                                          type="button"
                                          data-booking-id=b.id
                                          onclick="releaseOneHold(this)"
                                          title="Giải phóng phòng này để nhận đặt phòng thông thường"
                                        )
                                          i.fa-solid.fa-unlock
                                          |  Giải phóng
                                    else if effectiveStatus === 'checked_in'
                                      .th-action-cell__group
                                        button.btn-th-checkout(
                                          type="button"
                                          data-booking-id=b.id
                                          onclick="tourHoldCheckout(this)"
                                          title="Xác nhận khách đã trả phòng"
                                        )
                                          i.fa-solid.fa-right-from-bracket
                                          |  Trả phòng
                                        button.btn-th-revert(
                                          type="button"
                                          data-booking-id=b.id
                                          onclick="tourHoldRevertCheckin(this)"
                                          title="Hoàn tác: trở về Chờ nhận phòng"
                                        )
                                          i.fa-solid.fa-rotate-left
                                          |  Hoàn tác
                                    else if effectiveStatus === 'checked_out'
                                      .th-action-cell__group
                                        span.badge.badge--gray
                                          i.fa-solid.fa-circle-check
                                          |  Hoàn tất
                                        button.btn-th-revert(
                                          type="button"
                                          data-booking-id=b.id
                                          onclick="tourHoldRevertCheckout(this)"
                                          title="Hoàn tác: trở về Đang ở"
                                        )
                                          i.fa-solid.fa-rotate-left
                                          |  Hoàn tác

                else
                  //- ── Chỉ 1 khung thời gian: hiển thị header ngày + bảng trực tiếp ──
                  - var singleTf = group.timeFrames && group.timeFrames.length === 1 ? group.timeFrames[0] : null
                  if singleTf
                    .th-timeframe-header
                      .th-timeframe-header__label
                        if singleTf.segmentLabel
                          span.tf-toggle-badge= singleTf.segmentLabel
                        else
                          span.tf-toggle-badge Khung thời gian
                      .th-timeframe-header__dates
                        i.fa-regular.fa-calendar
                        |  #{singleTf.checkIn}
                        span.tf-toggle-arrow  →
                        | #{singleTf.checkOut}
                      .tf-toggle-stats
                        span
                          i.fa-solid.fa-users(style="font-size:11px")
                          |  #{singleTf.totalPeople} người
                        span
                          i.fa-solid.fa-door-open(style="font-size:11px")
                          |  #{singleTf.totalRooms} phòng
                  table.tour-hold-table
                    thead
                      tr
                        th Mã giữ phòng
                        th Loại phòng
                        th Phòng số
                        th Khách đã gán
                        th Nhận phòng
                        th Trả phòng
                        th Trạng thái
                        th Thao tác
                    tbody
                      each b in group.bookings
                        - var effectiveStatus = !b.isAssigned ? 'confirmed' : b.status
                        tr(data-booking-id=b.id data-booking-code=b.code)
                          td
                            span.booking-code= b.code
                          td= b.roomTypeName
                          td
                            if b.roomNumber && b.roomNumber !== '—'
                              span.room-number-badge= b.roomNumber
                            else
                              span.text-muted —
                          td
                            if b.isAssigned
                              .th-guest-info
                                span.th-guest-name= b.guestName
                                if b.guestPhone
                                  span.th-guest-phone
                                    i.fa-solid.fa-phone(style="font-size:10px")
                                    |  #{b.guestPhone}
                            else
                              span.badge.badge--yellow Chưa gán khách
                          td= b.checkIn
                          td= b.checkOut
                          td
                            - var statusLabel = effectiveStatus === 'confirmed' ? 'Chờ nhận phòng' : effectiveStatus === 'checked_in' ? 'Đang ở' : effectiveStatus === 'checked_out' ? 'Đã trả phòng' : effectiveStatus
                            - var statusClass = effectiveStatus === 'confirmed' ? 'badge--blue' : effectiveStatus === 'checked_in' ? 'badge--green' : effectiveStatus === 'checked_out' ? 'badge--gray' : 'badge--yellow'
                            span.badge(class=statusClass)= statusLabel
                          td.th-action-cell
                            if effectiveStatus === 'confirmed'
                              if b.isAssigned
                                button.btn-th-checkin(
                                  type="button"
                                  data-booking-id=b.id
                                  onclick="tourHoldCheckin(this)"
                                  title="Xác nhận khách đã đến nhận phòng"
                                )
                                  i.fa-solid.fa-door-open
                                  |  Nhận phòng
                              else
                                button.btn-release-single(
                                  type="button"
                                  data-booking-id=b.id
                                  onclick="releaseOneHold(this)"
                                  title="Giải phóng phòng này để nhận đặt phòng thông thường"
                                )
                                  i.fa-solid.fa-unlock
                                  |  Giải phóng
                            else if effectiveStatus === 'checked_in'
                              .th-action-cell__group
                                button.btn-th-checkout(
                                  type="button"
                                  data-booking-id=b.id
                                  onclick="tourHoldCheckout(this)"
                                  title="Xác nhận khách đã trả phòng"
                                )
                                  i.fa-solid.fa-right-from-bracket
                                  |  Trả phòng
                                button.btn-th-revert(
                                  type="button"
                                  data-booking-id=b.id
                                  onclick="tourHoldRevertCheckin(this)"
                                  title="Hoàn tác: trở về Chờ nhận phòng"
                                )
                                  i.fa-solid.fa-rotate-left
                                  |  Hoàn tác
                            else if effectiveStatus === 'checked_out'
                              .th-action-cell__group
                                span.badge.badge--gray
                                  i.fa-solid.fa-circle-check
                                  |  Hoàn tất
                                button.btn-th-revert(
                                  type="button"
                                  data-booking-id=b.id
                                  onclick="tourHoldRevertCheckout(this)"
                                  title="Hoàn tác: trở về Đang ở"
                                )
                                  i.fa-solid.fa-rotate-left
                                  |  Hoàn tác

                if unassignedIds.length > 0
                  .release-confirm-panel(id="release-panel-" + group.segmentId style="display:none")
                    .release-confirm-panel__header
                      i.fa-solid.fa-triangle-exclamation
                      strong  Xác nhận giải phóng phòng chưa gán
                    p.release-confirm-panel__desc Các phòng dưới đây chưa có khách được phân công. Sau khi giải phóng, chúng sẽ trở về trạng thái trống và có thể nhận đặt phòng thông thường.
                    ul.release-confirm-panel__list
                      each b in group.bookings
                        if !b.isAssigned && b.status === 'confirmed'
                          li
                            i.fa-solid.fa-door-closed(style="color:#f59e0b;margin-right:6px")
                            | #{b.roomTypeName}
                            if b.roomNumber && b.roomNumber !== '—'
                              span.room-number-badge(style="margin:0 6px")  #{b.roomNumber}
                            | &nbsp;(#{b.checkIn} → #{b.checkOut})
                    .release-confirm-panel__actions
                      button.btn-release-cancel-panel(
                        type="button"
                        onclick="hideReleasePanel('" + group.segmentId + "')"
                      ) Hủy
                      button.btn-release-confirm(
                        type="button"
                        data-booking-ids=unassignedIds.join(',')
                        onclick="confirmRelease(this)"
                      )
                        i.fa-solid.fa-unlock
                        |  Xác nhận giải phóng #{unassignedIds.length} phòng

          script.
            // ── Tour Hold Search ──
            function filterTourHoldGroups(keyword) {
              var q = (keyword || '').trim().toLowerCase();
              var groups = document.querySelectorAll('.tour-holds-page .tour-hold-group');
              var visibleGroups = 0;
              var visibleRows   = 0;

              groups.forEach(function(g) {
                var name = (g.dataset.tourName || '').toLowerCase();
                var id   = (g.dataset.tourId   || '').toLowerCase();
                var matchesMeta = !q || name.indexOf(q) !== -1 || id.indexOf(q) !== -1;

                // Tìm trong các row booking
                var rows = g.querySelectorAll('tr[data-booking-code]');
                var hasRowMatch = false;
                if (!matchesMeta && q) {
                  rows.forEach(function(row) {
                    if ((row.dataset.bookingCode || '').toLowerCase().indexOf(q) !== -1) {
                      hasRowMatch = true;
                    }
                  });
                }

                var showGroup = matchesMeta || hasRowMatch;
                g.style.display = showGroup ? '' : 'none';

                if (showGroup) {
                  visibleGroups++;

                  // Lọc từng row
                  rows.forEach(function(row) {
                    if (matchesMeta || !q) {
                      // Khớp theo tên/ID tour → hiện tất cả row
                      row.style.display = '';
                    } else {
                      // Khớp theo mã → chỉ hiện row đúng mã
                      var code = (row.dataset.bookingCode || '').toLowerCase();
                      var show = code.indexOf(q) !== -1;
                      row.style.display = show ? '' : 'none';
                      if (show) visibleRows++;
                    }
                  });

                  // Tự mở accordion chứa row khớp
                  if (!matchesMeta && hasRowMatch) {
                    var panels = g.querySelectorAll('.tf-panel');
                    panels.forEach(function(panel) {
                      var panelRows = panel.querySelectorAll('tr[data-booking-code]');
                      var hasVisible = false;
                      panelRows.forEach(function(r) {
                        if (r.style.display !== 'none') hasVisible = true;
                      });
                      if (hasVisible && !panel.classList.contains('tf-panel--open')) {
                        panel.classList.add('tf-panel--open');
                        var btn = g.querySelector('[data-panel-id="' + panel.id + '"]');
                        if (btn) {
                          btn.classList.add('tf-toggle-btn--active');
                          btn.setAttribute('aria-expanded', 'true');
                          var icon = btn.querySelector('.tf-toggle-icon');
                          if (icon) icon.style.transform = 'rotate(180deg)';
                        }
                      }
                    });
                  }
                } else {
                  // Group bị ẩn → reset tất cả row về mặc định
                  rows.forEach(function(row) { row.style.display = ''; });
                }
              });

              var countEl = document.getElementById('thSearchCount');
              if (countEl) {
                if (!q) {
                  countEl.textContent = '';
                } else if (visibleRows > 0) {
                  countEl.textContent = 'Tìm thấy ' + visibleRows + ' phòng';
                } else {
                  countEl.textContent = 'Tìm thấy ' + visibleGroups + ' / ' + groups.length + ' nhóm';
                }
              }
              var clearBtn = document.querySelector('.th-search-bar__clear');
              if (clearBtn) clearBtn.style.display = q ? '' : 'none';
            }
            function clearTourHoldSearch() {
              var inp = document.getElementById('thSearchInput');
              if (inp) { inp.value = ''; inp.focus(); }
              filterTourHoldGroups('');
            }

            function toggleTfPanel(panelId, btn) {
              var panel = document.getElementById(panelId);
              if (!panel) return;
              var icon = btn.querySelector('.tf-toggle-icon');
              var isOpen = panel.classList.contains('tf-panel--open');
              if (isOpen) {
                panel.classList.remove('tf-panel--open');
                btn.classList.remove('tf-toggle-btn--active');
                btn.setAttribute('aria-expanded', 'false');
                if (icon) icon.style.transform = '';
              } else {
                panel.classList.add('tf-panel--open');
                btn.classList.add('tf-toggle-btn--active');
                btn.setAttribute('aria-expanded', 'true');
                if (icon) icon.style.transform = 'rotate(180deg)';
              }
            }
            function _tourHoldUpdateStatus(btn, newStatus, labelProcessing, labelReset, confirmMsg) {
              var bookingId = btn.dataset.bookingId;
              if (!bookingId) return;
              var msg = confirmMsg || (newStatus === 'checked_in'
                ? 'Xác nhận khách tour đã đến nhận phòng?'
                : newStatus === 'checked_out'
                  ? 'Xác nhận khách tour đã trả phòng?'
                  : 'Xác nhận hoàn tác thao tác này?');
              if (!confirm(msg)) return;
              btn.disabled = true;
              btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';
              fetch('/!{pathAdmin}/hotel/booking/update-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ bookingId: bookingId, status: newStatus }),
              })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                  if (data.code === 'success') {
                    location.reload();
                  } else {
                    alert('Lỗi: ' + (data.message || 'Không thể cập nhật trạng thái'));
                    btn.disabled = false;
                    btn.innerHTML = labelReset;
                  }
                })
                .catch(function() {
                  alert('Có lỗi kết nối, vui lòng thử lại.');
                  btn.disabled = false;
                  btn.innerHTML = labelReset;
                });
            }
            function releaseOneHold(btn) {
              var bookingId = btn.dataset.bookingId;
              if (!bookingId) return;
              if (!confirm('Giải phóng phòng này? Phòng sẽ trở về trạng thái trống và có thể nhận đặt phòng thông thường.')) return;
              btn.disabled = true;
              btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
              fetch('/!{pathAdmin}/hotel/booking/release-holds', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ bookingIds: [bookingId] }),
              })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                  if (data.code === 'success') {
                    location.reload();
                  } else {
                    alert('Lỗi: ' + (data.message || 'Không thể giải phóng phòng'));
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-unlock"></i> Giải phóng';
                  }
                })
                .catch(function() {
                  alert('Có lỗi kết nối, vui lòng thử lại.');
                  btn.disabled = false;
                  btn.innerHTML = '<i class="fa-solid fa-unlock"></i> Giải phóng';
                });
            }
            function tourHoldCheckin(btn) {
              _tourHoldUpdateStatus(btn, 'checked_in',
                '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...',
                '<i class="fa-solid fa-door-open"></i> Nhận phòng');
            }
            function tourHoldCheckout(btn) {
              _tourHoldUpdateStatus(btn, 'checked_out',
                '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...',
                '<i class="fa-solid fa-right-from-bracket"></i> Trả phòng');
            }
            function tourHoldRevertCheckin(btn) {
              _tourHoldUpdateStatus(btn, 'confirmed',
                '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...',
                '<i class="fa-solid fa-rotate-left"></i> Hoàn tác nhận phòng',
                'Hoàn tác lại về trạng thái "Chờ nhận phòng"?');
            }
            function tourHoldRevertCheckout(btn) {
              _tourHoldUpdateStatus(btn, 'checked_in',
                '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...',
                '<i class="fa-solid fa-rotate-left"></i> Hoàn tác trả phòng',
                'Hoàn tác lại về trạng thái "Đang ở"?');
            }
            function showReleasePanel(btn) {
              var panelId = btn.dataset.panelId;
              var panel = document.getElementById(panelId);
              if (panel) {
                panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
              }
            }
            function hideReleasePanel(segmentId) {
              var panel = document.getElementById('release-panel-' + segmentId);
              if (panel) panel.style.display = 'none';
            }
            function confirmRelease(btn) {
              var ids = (btn.dataset.bookingIds || '').split(',').filter(Boolean);
              if (!ids.length) return;
              btn.disabled = true;
              btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';
              fetch('/!{pathAdmin}/hotel/booking/release-holds', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ bookingIds: ids }),
              })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                  if (data.code === 'success') {
                    alert(data.message || 'Giải phóng phòng thành công!');
                    location.reload();
                  } else {
                    alert('Lỗi: ' + (data.message || 'Không thể giải phóng phòng'));
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-unlock"></i> Xác nhận giải phóng';
                  }
                })
                .catch(function() {
                  alert('Có lỗi kết nối, vui lòng thử lại.');
                  btn.disabled = false;
                  btn.innerHTML = '<i class="fa-solid fa-unlock"></i> Xác nhận giải phóng';
                });
            }

      //- Tab: Khách hàng
      else if bookingsData.activeTab === 'guest-list'
        .guest-list-page
          //- Header
          .page-header
            .header-left
              h1.page-title Danh sách khách hàng
              p.page-subtitle Khách hàng đã được xếp phòng cụ thể

          //- Search and Filters
          .search-filters
            form#guestSearchForm.guest-search-form(method="GET" action=`/${pathAdmin}/hotel/booking/guest-list`)
              input(type="hidden" name="hotelId" value=selectedHotelId || "")
              .search-row
                .search-group
                  label Tên khách hàng
                  input#guestNameInput(
                    type="text" 
                    name="guestName"
                    placeholder="Nhập tên khách hàng..."
                    value=bookingsData.searchGuestName || ""
                  )
                .search-group
                  label Ngày check-in
                  input#checkInDateInput(
                    type="date" 
                    name="checkInDate"
                    value=bookingsData.searchCheckInDate || ""
                  )
                .search-group
                  label Ngày check-out
                  input#checkOutDateInput(
                    type="date" 
                    name="checkOutDate"
                    value=bookingsData.searchCheckOutDate || ""
                  )
                .search-actions
                  button#guestSearchBtn.search-btn(type="submit")
                    i.fa-solid.fa-search
                    span Tìm kiếm
                  if bookingsData.searchGuestName || bookingsData.searchCheckInDate || bookingsData.searchCheckOutDate
                    a.clear-search-btn(href=`/${pathAdmin}/hotel/booking/guest-list?hotelId=${selectedHotelId || ""}`)
                      i.fa-solid.fa-times
                      span Xóa bộ lọc

          //- Guests Table
          .guests-table-wrapper
            table.guests-table
              thead
                tr
                  th Tên khách hàng
                  th Email
                  th Số điện thoại
                  th Check-in
                  th Check-out
                  th Loại phòng
                  th Số phòng
                  th Người lớn
                  th Trẻ em
                  th Chi tiết trẻ em
                  th Mã booking
              tbody
                if bookingsData.guests && bookingsData.guests.length > 0
                  each guest in bookingsData.guests
                    tr
                      td
                        .guest-name= guest.guestName
                        if guest.cccdImages && guest.cccdImages.length
                          .cccd-gallery.cccd-gallery--inline
                            each img in guest.cccdImages
                              a.cccd-gallery-item(href=img target="_blank")
                                img(src=img alt="CCCD")
                      td
                        .guest-email= guest.guestEmail
                      td
                        .guest-phone= guest.guestPhone || '—'
                      td
                        .check-in-date= guest.checkInDisplay
                      td
                        .check-out-date= guest.checkOutDisplay
                      td
                        .room-type= guest.roomType
                      td
                        .room-number= guest.roomNumber
                      td
                        .adults-count= guest.adults
                      td
                        .children-count= guest.children
                      td
                        if guest.childrenDetails && guest.childrenDetails.length > 0
                          .children-details
                            each child, idx in guest.childrenDetails
                              span.child-age= 'Trẻ ' + (idx + 1) + ': ' + child.age + ' tuổi'
                              if idx < guest.childrenDetails.length - 1
                                br
                        else
                          | —
                      td
                        .booking-code= guest.bookingCode
                else
                  tr
                    td(colspan="11" style="text-align: center; padding: 40px;")
                      .empty-message Chưa có khách hàng nào được xếp phòng

    //- Popup card dùng chung cho calendar
    #booking-info-popup.booking-info-popup(style="display:none")
      button.booking-info-popup__close(type="button" onclick="closeBookingPopup()" aria-label="Đóng")
        i.fa-solid.fa-xmark
      .booking-info-popup__body

    //- JavaScript cho calendar navigation
    - const defaultYear = bookingsData.currentYear || new Date().getFullYear()
    - const defaultMonth = bookingsData.currentMonthNum || (new Date().getMonth() + 1)
    script.
      // ── Popup thông tin booking khi bấm vào thanh lịch ──────────────────────
      function showBookingPopup(e, bar) {
        e.stopPropagation();
        var popup = document.getElementById('booking-info-popup');
        if (!popup) return;

        var isTour     = bar.dataset.isTour === '1';
        var isAssigned = bar.dataset.isAssigned === '1';
        var guest      = bar.dataset.guest || '';
        var tourName   = bar.dataset.tourName || '';
        var tourCode   = bar.dataset.tourCode || '';
        var phone      = bar.dataset.phone || '';
        var checkIn    = bar.dataset.checkIn || '';
        var checkOut   = bar.dataset.checkOut || '';
        var code       = bar.dataset.code || '';
        var status     = bar.dataset.status || '';

        var rows = '';

        if (isTour) {
          rows += '<div class="bip-row bip-row--tour"><i class="fa-solid fa-link"></i><div><span class="bip-label">Tour</span><span class="bip-value">' + (tourName || tourCode || 'Tour hold') + (tourCode ? ' <span class="bip-code">(' + tourCode + ')</span>' : '') + '</span></div></div>';
          if (isAssigned && guest && guest !== 'N/A') {
            rows += '<div class="bip-row"><i class="fa-solid fa-user"></i><div><span class="bip-label">Khách</span><span class="bip-value bip-value--name">' + guest + '</span></div></div>';
          }
          if (phone) {
            rows += '<div class="bip-row"><i class="fa-solid fa-phone"></i><div><span class="bip-label">SĐT</span><span class="bip-value">' + phone + '</span></div></div>';
          }
          if (!isAssigned) {
            rows += '<div class="bip-row bip-row--muted"><i class="fa-solid fa-hourglass-half"></i><div><span class="bip-value">Chưa gán khách</span></div></div>';
          } else if (status === 'checked_in') {
            rows += '<div class="bip-row bip-row--checkedin"><i class="fa-solid fa-door-open"></i><div><span class="bip-value bip-status--checkedin">Đã nhận phòng</span></div></div>';
          } else if (status === 'checked_out') {
            rows += '<div class="bip-row bip-row--checkedout"><i class="fa-solid fa-circle-check"></i><div><span class="bip-value bip-status--checkedout">Đã trả phòng</span></div></div>';
          } else {
            rows += '<div class="bip-row bip-row--waiting"><i class="fa-solid fa-clock"></i><div><span class="bip-value bip-status--waiting">Chờ nhận phòng</span></div></div>';
          }
        } else {
          if (guest && guest !== 'N/A') {
            rows += '<div class="bip-row"><i class="fa-solid fa-user"></i><div><span class="bip-label">Khách</span><span class="bip-value bip-value--name">' + guest + '</span></div></div>';
          }
          if (phone) {
            rows += '<div class="bip-row"><i class="fa-solid fa-phone"></i><div><span class="bip-label">SĐT</span><span class="bip-value">' + phone + '</span></div></div>';
          }
          rows += '<div class="bip-row"><i class="fa-solid fa-hashtag"></i><div><span class="bip-label">Mã</span><span class="bip-value bip-code">' + code + '</span></div></div>';
        }

        if (checkIn || checkOut) {
          rows += '<div class="bip-row"><i class="fa-solid fa-calendar-days"></i><div><span class="bip-label">Ngày</span><span class="bip-value">' + checkIn + ' → ' + checkOut + '</span></div></div>';
        }

        popup.querySelector('.booking-info-popup__body').innerHTML = rows;

        // Định vị popup gần vị trí bấm, tránh ra ngoài màn hình
        popup.style.display = 'block';
        var pw = popup.offsetWidth  || 240;
        var ph = popup.offsetHeight || 160;
        var vw = window.innerWidth;
        var vh = window.innerHeight;
        var x  = e.clientX + 12;
        var y  = e.clientY + 12;
        if (x + pw > vw - 10) x = e.clientX - pw - 12;
        if (y + ph > vh - 10) y = e.clientY - ph - 12;
        popup.style.left = Math.max(8, x) + 'px';
        popup.style.top  = Math.max(8, y) + 'px';
      }

      function closeBookingPopup() {
        var popup = document.getElementById('booking-info-popup');
        if (popup) popup.style.display = 'none';
      }

      document.addEventListener('click', function(e) {
        if (!e.target.closest('.booking-bar') && !e.target.closest('#booking-info-popup')) {
          closeBookingPopup();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeBookingPopup();
      });

      // ── Calendar navigation ──────────────────────────────────────────────────
      document.addEventListener('DOMContentLoaded', function() {
        const prevBtn = document.querySelector('.prev-btn');
        const nextBtn = document.querySelector('.next-btn');
        
        if (prevBtn && nextBtn) {
          // Lấy tháng/năm hiện tại từ URL hoặc data
          const urlParams = new URLSearchParams(window.location.search);
          const currentYear = parseInt(urlParams.get('year')) || #{defaultYear};
          const currentMonth = parseInt(urlParams.get('month')) || #{defaultMonth};
          const currentHotelId = urlParams.get('hotelId') || '';
          
          // Xử lý nút Previous
          prevBtn.addEventListener('click', function() {
            let newYear = currentYear;
            let newMonth = currentMonth - 1;
            
            if (newMonth < 1) {
              newMonth = 12;
              newYear = currentYear - 1;
            }
            
            const newUrl = `/${pathAdmin}/hotel/booking/calendar?year=${newYear}&month=${newMonth}&hotelId=${currentHotelId}`;
            window.location.href = newUrl;
          });
          
          // Xử lý nút Next
          nextBtn.addEventListener('click', function() {
            let newYear = currentYear;
            let newMonth = currentMonth + 1;
            
            if (newMonth > 12) {
              newMonth = 1;
              newYear = currentYear + 1;
            }
            
            const newUrl = `/${pathAdmin}/hotel/booking/calendar?year=${newYear}&month=${newMonth}&hotelId=${currentHotelId}`;
            window.location.href = newUrl;
          });
        }
      });

