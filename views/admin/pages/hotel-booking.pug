                        else
                          span.legend-company-badge.legend-company-badge--cross
                            i.fa-solid.fa-handshake
                            |  #{entry.companyName || 'Công ty khác'}
                      td
                        if entry.timeSegments && entry.timeSegments.length > 0
                          each seg, i in entry.timeSegments
                            span.time-seg-badge= seg.fromDate + ' → ' + seg.toDate
                            if i < entry.timeSegments.length - 1
                              br
                        else
                          | —
                      td= entry.totalRooms + ' phòng'
                      td= entry.totalPeople + ' người'

      //- Tab: Chi tiết 1 tour hold group
      else if bookingsData.activeTab === 'tour-holds-detail'
        .tour-holds-page
          .page-header
            .header-left
              a.btn-tour-hold-back(href=`/${pathAdmin}/hotel/booking/tour-holds?hotelId=${selectedHotelId || ''}`)
                i.fa-solid.fa-arrow-left
                |  Quay lại danh sách
              h1.page-title(style="margin-top:12px") Chi tiết giữ phòng Tour
              p.page-subtitle Danh sách phòng đang được giữ cho tour.

          - var thSearchQ = typeof tourHoldSearchQuery !== 'undefined' ? tourHoldSearchQuery : ''
          - var thSegId = typeof tourHoldDetailSegmentId !== 'undefined' ? tourHoldDetailSegmentId : ''
          if thSegId
            form.th-search-bar.th-search-bar--detail(
