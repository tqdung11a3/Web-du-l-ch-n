                  button.nav-btn.next-btn(type="button" title="Tháng sau")
                    i.fa-solid.fa-chevron-right
                //- Bảng chọn tháng / năm (popover)
                - const pickerYearBase = bookingsData.currentYear || new Date().getFullYear()
                #calendarMonthPicker.calendar-month-picker(style="display:none" role="dialog" aria-label="Chọn tháng và năm")
                  .calendar-month-picker__header
                    span.calendar-month-picker__title Chọn tháng và năm
                    button.calendar-month-picker__close(type="button" title="Đóng" aria-label="Đóng")
                      i.fa-solid.fa-xmark
                  .calendar-month-picker__body
