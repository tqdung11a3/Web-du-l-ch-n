//- views/admin/pages/hotel-booking.pug
extends ../layouts/default.pug

mixin tourHoldGroupContent(group, unassignedBookings, unassignedIds, showDetailInline)
  - var detailPanelId = 'tour-hold-detail-' + group.segmentId
  - showDetailInline = showDetailInline === true
  .tour-hold-group__header
    .tour-hold-group__title
      i.fa-solid.fa-map-location-dot
      strong  #{group.tourName}
      span.tour-short-id-badge ##{group.tourShortId}
      if !group.isOwnCompany && group.tourCompanyName
        span.badge.badge--orange(style="margin-left:8px;font-size:11px")= group.tourCompanyName
    .tour-hold-group__meta
      if group.segmentStatus === 'confirmed'
        span.badge.badge--green Đã xác nhận
      else if group.segmentStatus === 'pending_approval'
        span.badge.badge--orange Chờ duyệt
      else
        span.badge.badge--yellow Bản nháp
      span.th-sep  |
      span
        i.fa-solid.fa-calendar-day
        |  Khởi hành: #{group.departureDate}  →  #{group.endDate}
      span.th-sep  |
      span
        i.fa-solid.fa-users
        |  Yêu cầu: #{group.paxRequired} người
      span.th-sep  |
      if group.timeFrames && group.timeFrames.length > 1
        span
          i.fa-solid.fa-layer-group(style="margin-right:4px;color:#6366f1")
          | #{group.timeFrames.length} khung thời gian &nbsp;·&nbsp; #{group.totalPeople} người (#{group.totalRooms} phòng tổng)
      else if group.timeFrames && group.timeFrames.length === 1
        span
          i.fa-regular.fa-calendar(style="margin-right:4px")
          | #{group.timeFrames[0].checkIn} → #{group.timeFrames[0].checkOut}
          |  &nbsp;·&nbsp; #{group.totalPeople} người (#{group.totalRooms} phòng)
      else
        span
          i.fa-solid.fa-bed
          |  Đã giữ: #{group.totalPeople} người (#{group.totalRooms} phòng)
    .tour-hold-group__actions
      if !showDetailInline
        a.btn-tour-hold-detail(href=`/${pathAdmin}/hotel/booking/tour-holds/detail/${group.segmentId}?hotelId=${selectedHotelId || ''}`)
          i.fa-solid.fa-eye
          |  Xem chi tiết
      if unassignedIds.length > 0
        button.btn-release-holds(
          type="button"
          data-panel-id="release-panel-" + group.segmentId
          data-unassigned-ids=unassignedIds.join(',')
          onclick="showReleasePanel(this)"
        )
          i.fa-solid.fa-unlock
          |  Giải phóng #{unassignedIds.length} phòng chưa gán
  if showDetailInline
    .tour-hold-group__detail(id=detailPanelId)
      if group.timeFrames && group.timeFrames.length > 1
        .tf-accordion
          each tf, tfi in group.timeFrames
            - var tfPanelId = 'tf-panel-' + group.segmentId + '-' + tfi
            - var tfBookings = group.bookings.filter(function(b){ return b.tfKey === (tf.checkIn + '_' + tf.checkOut); })
            - var tfUnassigned = tfBookings.filter(function(b){ return !b.isAssigned; })
            .tf-accordion-item
              button.tf-toggle-btn(type="button" data-panel-id=tfPanelId onclick="toggleTfPanel(this.dataset.panelId, this)" aria-expanded="false" aria-controls=tfPanelId)
                if tf.segmentLabel
                  span.tf-toggle-badge= tf.segmentLabel
                else
                  span.tf-toggle-badge Đợt #{tfi + 1}
                span.tf-toggle-dates
                  i.fa-regular.fa-calendar
                  |  #{tf.checkIn}
                  span.tf-toggle-arrow  →
                  | #{tf.checkOut}
                .tf-toggle-stats
                  span
                    i.fa-solid.fa-users(style="font-size:11px")
                    |  #{tf.totalPeople} người
                  span
                    i.fa-solid.fa-door-open(style="font-size:11px")
                    |  #{tf.totalRooms} phòng
                  if tfUnassigned.length > 0
                    span.badge.badge--yellow #{tfUnassigned.length} chưa gán
                i.fa-solid.fa-chevron-down.tf-toggle-icon
              .tf-panel(id=tfPanelId)
                +tourHoldBookingTable(tfBookings)
      else
        - var singleTf = group.timeFrames && group.timeFrames.length === 1 ? group.timeFrames[0] : null
        if singleTf
          .th-timeframe-header
            .th-timeframe-header__label
              if singleTf.segmentLabel
                span.tf-toggle-badge= singleTf.segmentLabel
              else
                span.tf-toggle-badge Khung thời gian
            .th-timeframe-header__dates
              i.fa-regular.fa-calendar
              |  #{singleTf.checkIn}
              span.tf-toggle-arrow  →
              | #{singleTf.checkOut}
            .tf-toggle-stats
              span
                i.fa-solid.fa-users(style="font-size:11px")
                |  #{singleTf.totalPeople} người
              span
                i.fa-solid.fa-door-open(style="font-size:11px")
                |  #{singleTf.totalRooms} phòng
        +tourHoldBookingTable(group.bookings)
  if unassignedIds.length > 0
    .release-confirm-panel(id="release-panel-" + group.segmentId style="display:none")
      .release-confirm-panel__header
        i.fa-solid.fa-triangle-exclamation
        strong  Xác nhận giải phóng phòng chưa gán
      p.release-confirm-panel__desc Các phòng dưới đây chưa có khách được phân công. Sau khi giải phóng, chúng sẽ trở về trạng thái trống và có thể nhận đặt phòng thông thường.
      ul.release-confirm-panel__list
        each b in group.bookings
          if !b.isAssigned && b.status === 'confirmed'
            li
              i.fa-solid.fa-door-closed(style="color:#f59e0b;margin-right:6px")
              | #{b.roomTypeName}
              if b.roomNumber && b.roomNumber !== '—'
                span.room-number-badge(style="margin:0 6px")  #{b.roomNumber}
              | &nbsp;(#{b.checkIn} → #{b.checkOut})
      .release-confirm-panel__actions
        button.btn-release-cancel-panel(type="button" onclick="hideReleasePanel('" + group.segmentId + "')") Hủy
        button.btn-release-confirm(type="button" data-booking-ids=unassignedIds.join(',') onclick="confirmRelease(this)")
          i.fa-solid.fa-unlock
          |  Xác nhận giải phóng #{unassignedIds.length} phòng

mixin tourHoldBookingTable(bookingsList)
  table.tour-hold-table
    thead
      tr
        th Mã giữ phòng
        th Loại phòng
        th Phòng số
        th Khách đã gán
        th Nhận phòng
        th Trả phòng
        th Trạng thái
        th Thao tác
    tbody
      each b in bookingsList
        - var effectiveStatus = !b.isAssigned ? 'confirmed' : b.status
        tr(data-booking-id=b.id data-booking-code=b.code)
          td
            span.booking-code= b.code
          td= b.roomTypeName
          td
            if b.roomNumber && b.roomNumber !== '—'
              span.room-number-badge= b.roomNumber
            else
              span.text-muted —
          td
            if b.isAssigned
              .th-guest-info
                span.th-guest-name= b.guestName
                if b.guestPhone
                  span.th-guest-phone
                    i.fa-solid.fa-phone(style="font-size:10px")
                    |  #{b.guestPhone}
            else
              span.badge.badge--yellow Chưa gán khách
          td= b.checkIn
          td= b.checkOut
          td.th-status-cell
            - var statusLabel = !b.isAssigned ? 'Trống' : effectiveStatus === 'confirmed' ? 'Chưa nhận phòng' : effectiveStatus === 'checked_in' ? 'Đã nhận phòng' : effectiveStatus === 'checked_out' ? 'Đã trả phòng' : effectiveStatus
            - var statusClass = !b.isAssigned ? 'badge--gray' : effectiveStatus === 'confirmed' ? 'badge--blue' : effectiveStatus === 'checked_in' ? 'badge--green' : effectiveStatus === 'checked_out' ? 'badge--gray' : 'badge--yellow'
            .th-status-wrap
              button.badge.th-status-btn(
                type="button"
                class=statusClass
                data-booking-id=b.id
                data-current-status=effectiveStatus
                onclick=b.isAssigned ? 'toggleStatusDropdown(this)' : 'toggleStatusDropdown(this)'
                title=b.isAssigned ? 'Bấm để đổi trạng thái' : 'Trạng thái khi có khách gán'
              )
                = statusLabel
                i.fa-solid.fa-chevron-down(style="font-size:9px;margin-left:4px;opacity:0.7")
              .th-status-dropdown(style="display:none")
                if !b.isAssigned
                  button.th-status-option.th-status-option--current(type="button" disabled) Trống (hiện tại)
                  .th-status-dropdown-hint Sau khi gán khách:
                button.th-status-option(type="button" data-status="confirmed" onclick=b.isAssigned ? 'selectStatusOption(this)' : '') Chưa nhận phòng
                button.th-status-option(type="button" data-status="checked_in" onclick=b.isAssigned ? 'selectStatusOption(this)' : '') Đã nhận phòng
                button.th-status-option(type="button" data-status="checked_out" onclick=b.isAssigned ? 'selectStatusOption(this)' : '') Đã trả phòng
          td.th-action-cell
            if effectiveStatus === 'confirmed'
              button.btn-release-single(type="button" data-booking-id=b.id onclick="releaseOneHold(this)" title="Giải phóng phòng này")
                i.fa-solid.fa-unlock
                |  Giải phóng
            else
              span.text-muted(style="font-size:12px") —

block main
  .hotel-booking
    //- Sub-sidebar cho tab con
    .booking-sub-sidebar
      - const isListActive = bookingsData && bookingsData.activeTab === 'list'
      - const isRoomManagementActive = bookingsData && bookingsData.activeTab === 'room-management'
      - const isCalendarActive = bookingsData && bookingsData.activeTab === 'calendar'
      - const isGuestListActive = bookingsData && bookingsData.activeTab === 'guest-list'
      - const currentHotelId = selectedHotelId || ''
      if isListActive
        a.sub-menu-item.active(href=`/${pathAdmin}/hotel/booking/list?hotelId=${currentHotelId}`)
          i.fa-solid.fa-list
          span Danh sách
      else
        a.sub-menu-item(href=`/${pathAdmin}/hotel/booking/list?hotelId=${currentHotelId}`)
          i.fa-solid.fa-list
          span Danh sách
      if isRoomManagementActive
        a.sub-menu-item.active(href=`/${pathAdmin}/hotel/booking/room-management?hotelId=${currentHotelId}`)
          i.fa-solid.fa-door-open
          span Quản lý số phòng
      else
        a.sub-menu-item(href=`/${pathAdmin}/hotel/booking/room-management?hotelId=${currentHotelId}`)
          i.fa-solid.fa-door-open
          span Quản lý số phòng
      if isCalendarActive
        a.sub-menu-item.active(href=`/${pathAdmin}/hotel/booking/calendar?hotelId=${currentHotelId}`)
          i.fa-solid.fa-calendar
          span Lịch phòng
      else
        a.sub-menu-item(href=`/${pathAdmin}/hotel/booking/calendar?hotelId=${currentHotelId}`)
          i.fa-solid.fa-calendar
          span Lịch phòng
      if isGuestListActive
        a.sub-menu-item.active(href=`/${pathAdmin}/hotel/booking/guest-list?hotelId=${currentHotelId}`)
          i.fa-solid.fa-users
          span Khách hàng
      else
        a.sub-menu-item(href=`/${pathAdmin}/hotel/booking/guest-list?hotelId=${currentHotelId}`)
          i.fa-solid.fa-users
          span Khách hàng

      - const isTourHoldsActive = bookingsData && (bookingsData.activeTab === 'tour-holds' || bookingsData.activeTab === 'tour-holds-detail')
      if isTourHoldsActive
        a.sub-menu-item.active(href=`/${pathAdmin}/hotel/booking/tour-holds?hotelId=${currentHotelId}`)
          i.fa-solid.fa-link
          span Giữ phòng Tour
      else
        a.sub-menu-item(href=`/${pathAdmin}/hotel/booking/tour-holds?hotelId=${currentHotelId}`)
          i.fa-solid.fa-link
          span Giữ phòng Tour

    //- Main Content
    .booking-main-content
      //- Tab: Danh sách
      if bookingsData.activeTab === 'list'
        .booking-list-page
          //- Header
          .page-header
            .header-left
              h1.page-title Đặt phòng
              p.page-subtitle Quản lý tất cả đặt phòng

          //- Search and Filters
          .search-filters
            .search-bar
              input#bookingSearchInput(
                type="text" 
                placeholder="Tìm theo mã booking, tên khách hàng hoặc email..."
                value=bookingsData.searchQuery || ""
              )
              button#searchBtn.search-btn(type="button")
                i.fa-solid.fa-search

          //- Status Tabs
          .status-tabs
            button.status-tab.active Tất cả
            button.status-tab Chờ xác nhận
            button.status-tab Đã xác nhận
            button.status-tab Đã nhận phòng
            button.status-tab Đã trả phòng
            button.status-tab Đã hủy

          //- Bookings Table
          .bookings-table-wrapper
            table.bookings-table
              thead
                tr
                  th Mã
                  th Khách hàng
                  th Thời gian đặt
                  th Lưu trú
                  th Loại phòng
                  th Người
                  th Số tiền
                  th Trạng thái thanh toán
                  th Trạng thái booking
                  th Phương thức thanh toán
                  th Thao tác
              tbody
                if bookingsData.bookings && bookingsData.bookings.length > 0
                  each booking in bookingsData.bookings
                    tr
                      td
                        .booking-code= booking.bookingId
                      td
                        .customer-info
                          .customer-name= booking.customerName
                          .customer-email= booking.customerEmail
                      td
                        .booking-created-at= booking.createdAtFormat
                      td
                        .stay-info
                          .check-in= booking.checkIn
                          .nights= booking.nights + ' đêm'
                      td
                        .room-info
                          .room-type= booking.roomType
                          .room-count Tổng: #{booking.roomCount} phòng
                      td
                        .people-info
                          if booking.children > 0
                            = booking.adults + ' NL ' + booking.children + ' TE'
                          else
                            = booking.adults + ' NL'
                      td
                        .amount-info
                          .total-amount Tổng: #{(booking.totalAmount / 1000).toFixed(0)}K
                          if booking.paidAmount > 0
                            .paid-amount Đã TT: #{(booking.paidAmount / 1000).toFixed(0)}K
                          if booking.remainingAmount > 0
                            .remaining-amount Còn: #{(booking.remainingAmount / 1000).toFixed(0)}K
                      td
                        - const paymentBadgeClass = `badge-${booking.paymentStatusColor}`
                        .status-badge(class=paymentBadgeClass)= booking.paymentStatus
                      td
                        - const statusBadgeClass = `badge-${booking.statusColor}`
                        .status-badge(class=statusBadgeClass)= booking.status
                      td
                        .payment-method= booking.paymentMethod
                      td
                        .action-buttons
                          a.action-btn.view-btn(href=`/${pathAdmin}/hotel/booking/detail/${booking.bookingId}` title="Xem chi tiết")
                            i.fa-solid.fa-eye
                          button.action-btn.edit-btn(data-booking-id=booking._id data-status=booking.statusValue data-payment-status=booking.paymentStatusValue title="Chỉnh sửa trạng thái")
                            i.fa-solid.fa-pencil
                          button.action-btn.delete-booking-btn(data-booking-id=booking._id data-booking-code=booking.bookingId title="Xóa đơn đặt phòng")
                            i.fa-regular.fa-trash-can
                else
                  tr
                    td(colspan="11" style="text-align: center; padding: 40px;")
                      .empty-message Không có đặt phòng nào
          
          //- Modal chỉnh sửa trạng thái booking
          #editBookingStatusModal.modal(style="display: none;")
            .modal-overlay
            .modal-content
              .modal-header
                h3 Chỉnh sửa trạng thái booking
                button.modal-close(type="button") ×
              .modal-body
                form#editBookingStatusForm
                  input(type="hidden" name="bookingId" id="editBookingId")
                  
                  .form-group
                    label Trạng thái thanh toán
                    select.form-control(name="paymentStatus" id="editPaymentStatus")
                      option(value="unpaid") Chưa thanh toán
                      option(value="paid") Đã thanh toán
                  
                  .form-group
                    label Trạng thái booking
                    select.form-control(name="status" id="editStatus")
                      option(value="pending") Chờ xác nhận
                      option(value="confirmed") Đã xác nhận
                      option(value="checked_in") Đã nhận phòng
                      option(value="checked_out") Đã trả phòng
                      option(value="cancelled") Đã hủy
                  
                  .form-actions
                    button.btn-cancel(type="button") Hủy
                    button.btn-save(type="submit") Lưu thay đổi

      //- Tab: Quản lý số phòng
      else if bookingsData.activeTab === 'room-management'
        .room-management-page
          //- Header
          .page-header
            .header-left
              h1.page-title Quản lý số phòng
              p.page-subtitle Xếp phòng cho booking và xem tình trạng phòng

          //- Pending Bookings Section
          .pending-bookings-section
            h2.section-title Booking cần xếp phòng (#{bookingsData.groupedPendingBookings ? bookingsData.groupedPendingBookings.length : 0})

            if bookingsData.groupedPendingBookings && bookingsData.groupedPendingBookings.length > 0
              .pending-bookings-list
                each group in bookingsData.groupedPendingBookings
                  .pending-booking-group
                    .pending-booking-group__summary
                      .booking-summary-info
                        .summary-code
                          i.fa-solid.fa-hashtag
                          strong  #{group.baseCode}
                          span.summary-sep  —
                          span= group.customerName
                        .summary-rooms
                          i.fa-solid.fa-bed
                          |  #{group.totalRooms} phòng
                          span.summary-sep  ·
                          span= group.roomTypesSummary
                        .summary-dates
                          i.fa-solid.fa-calendar-days
                          |  Check-in: #{group.checkInDisplay}
                          span.summary-sep  |
                          |  Check-out: #{group.checkOutDisplay}
                      button.btn-toggle-detail(
                        type="button"
                        data-group-code=group.baseCode
                        data-group-title=group.baseCode + ' — ' + group.customerName
                        data-group-subtitle=group.totalRooms + ' phòng  ·  ' + group.roomTypesSummary + '   |   ' + group.checkInDisplay + ' → ' + group.checkOutDisplay
                        onclick="openPendingDetailModal(this)"
                      )
                        i.fa-solid.fa-list-ul
                        span  Xem chi tiết
            else
              .empty-message Không có booking nào cần xếp phòng

          //- Modal chi tiết booking cần xếp phòng
          #pendingDetailModal.pending-detail-modal(style="display:none" aria-modal="true" role="dialog")
            .pending-detail-modal__overlay(onclick="closePendingDetailModal()")
            .pending-detail-modal__box
              .pending-detail-modal__header
                .modal-header-info
                  h3#pendingDetailModalTitle.modal-title —
                  p#pendingDetailModalSubtitle.modal-subtitle —
                button.pending-detail-modal__close(type="button" onclick="closePendingDetailModal()" title="Đóng")
                  i.fa-solid.fa-xmark
              .pending-detail-modal__body
                //- Pre-render nội dung từng nhóm, JS chỉ ẩn/hiện đúng nhóm
                each group in bookingsData.groupedPendingBookings
                  .pending-detail-content(id="pending-detail-" + group.baseCode style="display:none")
                    each booking in group.bookings
                      .pending-booking-card(data-booking-id=booking.bookingId data-room-type-id=booking.roomTypeId)
                        .booking-info
                          .booking-code= booking.code + ' - ' + booking.customerName
                          .booking-details
                            span.room-type= booking.roomType + ' × ' + booking.roomCount + ' phòng'
                            if booking.adults
                              span.booking-pax  ·  #{booking.adults} NL
                            if booking.children > 0
                              span.booking-pax= '  ·  ' + booking.childrenText
                          .booking-dates
                            span Check-in: #{booking.checkInDisplay} | Check-out: #{booking.checkOutDisplay}
                        button.btn-assign-room(
                          type="button"
                          data-booking-id=booking.bookingId
                          data-room-type-id=booking.roomTypeId
                          data-check-in=booking.checkIn
                          data-check-out=booking.checkOut
                        )
                          i.fa-solid.fa-door-open
                          span  Xếp phòng

          //- Room Status Section
          .room-status-section
            .room-status-section__header
              h2.section-title Tình trạng phòng

            //- Bộ lọc ngày
            form.rm-date-filter(method="GET" action=`/${pathAdmin}/hotel/booking/room-management`)
              input(type="hidden" name="hotelId" value=bookingsData.selectedHotelId || selectedHotelId)
              .rm-date-filter__fields
                .rm-date-filter__field
                  label.rm-date-filter__label
                    i.fa-solid.fa-calendar-check
                    |  Check-in từ
                  input.rm-date-filter__input(
                    type="date"
                    name="filterFrom"
                    value=bookingsData.filterFrom
                  )
                .rm-date-filter__field
                  label.rm-date-filter__label
                    i.fa-solid.fa-calendar-xmark
                    |  Đến ngày checkout
                  input.rm-date-filter__input(
                    type="date"
                    name="filterTo"
                    value=bookingsData.filterTo
                  )
                button.rm-date-filter__btn(type="submit")
                  i.fa-solid.fa-magnifying-glass
                  |  Lọc
                if bookingsData.isFiltered
                  a.rm-date-filter__clear(href=`/${pathAdmin}/hotel/booking/room-management?hotelId=${bookingsData.selectedHotelId || selectedHotelId}`)
                    i.fa-solid.fa-xmark
                    |  Xoá lọc

            if bookingsData.isFiltered
              .rm-filter-notice
                i.fa-solid.fa-circle-info
                |  Đang hiển thị booking có lịch giao nhau với khoảng&nbsp;
                strong #{bookingsData.filterFrom || '…'} → #{bookingsData.filterTo || '…'}

            if bookingsData.rooms && bookingsData.rooms.length > 0
              //- Bộ lọc có/không có booking + thống kê
              .rm-booking-filter
                button.rm-booking-filter__btn.rm-booking-filter__btn--active(
                  type="button"
                  data-filter="all"
                  onclick="applyRoomBookingFilter('all')"
                )
                  span.rm-booking-filter__label Tất cả
                  span.rm-booking-filter__count#rm-count-all= bookingsData.rooms.length
                button.rm-booking-filter__btn(
                  type="button"
                  data-filter="has"
                  onclick="applyRoomBookingFilter('has')"
                )
                  i.fa-solid.fa-calendar-check(style="color:#22c55e;font-size:11px")
                  span.rm-booking-filter__label  Có booking
                  span.rm-booking-filter__count#rm-count-has 0
                button.rm-booking-filter__btn(
                  type="button"
                  data-filter="none"
                  onclick="applyRoomBookingFilter('none')"
                )
                  i.fa-solid.fa-calendar-xmark(style="color:#94a3b8;font-size:11px")
                  span.rm-booking-filter__label  Trống
                  span.rm-booking-filter__count#rm-count-none 0

              .rooms-table-wrapper
                table.rooms-table#rm-rooms-table
                  thead
                    tr
                      th Số phòng
                      th Loại phòng
                      th Tầng
                      th Tình trạng
                      th= bookingsData.isFiltered ? 'Booking trong khoảng lọc' : 'Booking hiện tại'
                  tbody
                    each room in bookingsData.rooms
                      tr(
                        class=`room-row ${room.statusClass}`
                        data-room-id=room._id
                        data-room-type-id=room.roomTypeId
                        data-has-booking=(room.bookingCount > 0 ? '1' : '0')
                      )
                        td
                          .room-number= room.number
                        td
                          .room-type= room.roomType
                        td
