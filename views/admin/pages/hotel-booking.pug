            .header-right.calendar-header-right
              .calendar-picker-wrap
                .calendar-navigation
                  button.nav-btn.prev-btn(type="button" title="Tháng trước")
                    i.fa-solid.fa-chevron-left
                  .calendar-nav-center
                    span.current-month= bookingsData.currentMonth || 'Tháng 1, 2026'
                    button.nav-btn.calendar-picker-toggle(
                      type="button"
