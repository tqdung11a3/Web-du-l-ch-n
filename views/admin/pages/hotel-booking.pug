              p
                | Không có phòng nào khớp “#{thSearchQ}”.
                br
                small(style="color:#64748b") Thử số phòng (vd 105), mã giữ phòng, hoặc ID tour (mã tuỳ chỉnh hoặc _id MongoDB).
          else
            - var unassignedBookings = group.bookings.filter(function(b){ return !b.isAssigned; })
            - var unassignedIds = unassignedBookings.map(function(b){ return b.id; })
            .tour-hold-group(data-tour-name=group.tourName.toLowerCase() data-tour-id=group.tourShortId.toLowerCase())
              +tourHoldGroupContent(group, unassignedBookings, unassignedIds, true)

          script.
            function toggleTfPanel(panelId, btn) {
              var panel = document.getElementById(panelId);
              if (!panel) return;
              var icon = btn.querySelector('.tf-toggle-icon');
              var isOpen = panel.classList.contains('tf-panel--open');
              if (isOpen) {
                panel.classList.remove('tf-panel--open');
