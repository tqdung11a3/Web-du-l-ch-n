//- views/admin/pages/hotel-booking.pug
extends ../layouts/default.pug

block main
  .hotel-booking
    //- Sub-sidebar cho tab con
    .booking-sub-sidebar
      - const isListActive = bookingsData && bookingsData.activeTab === 'list'
      - const isRoomManagementActive = bookingsData && bookingsData.activeTab === 'room-management'
      - const isCalendarActive = bookingsData && bookingsData.activeTab === 'calendar'
      - const isGuestListActive = bookingsData && bookingsData.activeTab === 'guest-list'
      - const currentHotelId = selectedHotelId || ''
      if isListActive
        a.sub-menu-item.active(href=`/${pathAdmin}/hotel/booking/list?hotelId=${currentHotelId}`)
          i.fa-solid.fa-list
          span Danh sách
      else
        a.sub-menu-item(href=`/${pathAdmin}/hotel/booking/list?hotelId=${currentHotelId}`)
          i.fa-solid.fa-list
          span Danh sách
      if isRoomManagementActive
        a.sub-menu-item.active(href=`/${pathAdmin}/hotel/booking/room-management?hotelId=${currentHotelId}`)
          i.fa-solid.fa-door-open
          span Quản lý số phòng
      else
        a.sub-menu-item(href=`/${pathAdmin}/hotel/booking/room-management?hotelId=${currentHotelId}`)
          i.fa-solid.fa-door-open
          span Quản lý số phòng
      if isCalendarActive
        a.sub-menu-item.active(href=`/${pathAdmin}/hotel/booking/calendar?hotelId=${currentHotelId}`)
          i.fa-solid.fa-calendar
          span Lịch phòng
      else
        a.sub-menu-item(href=`/${pathAdmin}/hotel/booking/calendar?hotelId=${currentHotelId}`)
          i.fa-solid.fa-calendar
          span Lịch phòng
      if isGuestListActive
        a.sub-menu-item.active(href=`/${pathAdmin}/hotel/booking/guest-list?hotelId=${currentHotelId}`)
          i.fa-solid.fa-users
          span Khách hàng
      else
        a.sub-menu-item(href=`/${pathAdmin}/hotel/booking/guest-list?hotelId=${currentHotelId}`)
          i.fa-solid.fa-users
          span Khách hàng

      - const isTourHoldsActive = bookingsData && bookingsData.activeTab === 'tour-holds'
      if isTourHoldsActive
        a.sub-menu-item.active(href=`/${pathAdmin}/hotel/booking/tour-holds?hotelId=${currentHotelId}`)
          i.fa-solid.fa-link
          span Giữ phòng Tour
      else
        a.sub-menu-item(href=`/${pathAdmin}/hotel/booking/tour-holds?hotelId=${currentHotelId}`)
          i.fa-solid.fa-link
          span Giữ phòng Tour

    //- Main Content
    .booking-main-content
      //- Tab: Danh sách
      if bookingsData.activeTab === 'list'
        .booking-list-page
          //- Header
          .page-header
            .header-left
              h1.page-title Đặt phòng
              p.page-subtitle Quản lý tất cả đặt phòng

          //- Search and Filters
          .search-filters
            .search-bar
              input#bookingSearchInput(
                type="text" 
                placeholder="Tìm theo mã booking, tên khách hàng hoặc email..."
                value=bookingsData.searchQuery || ""
              )
              button#searchBtn.search-btn(type="button")
                i.fa-solid.fa-search

          //- Status Tabs
          .status-tabs
            button.status-tab.active Tất cả
            button.status-tab Chờ xác nhận
            button.status-tab Đã xác nhận
            button.status-tab Đã nhận phòng
            button.status-tab Đã trả phòng
            button.status-tab Đã hủy

          //- Bookings Table
          .bookings-table-wrapper
            table.bookings-table
              thead
                tr
                  th Mã
                  th Khách hàng
                  th Thời gian đặt
                  th Lưu trú
                  th Loại phòng
                  th Người
                  th Số tiền
                  th Trạng thái thanh toán
                  th Trạng thái booking
                  th Phương thức thanh toán
                  th Thao tác
              tbody
                if bookingsData.bookings && bookingsData.bookings.length > 0
                  each booking in bookingsData.bookings
                    tr
                      td
                        .booking-code= booking.bookingId
                      td
                        .customer-info
                          .customer-name= booking.customerName
                          .customer-email= booking.customerEmail
                      td
                        .booking-created-at= booking.createdAtFormat
                      td
                        .stay-info
                          .check-in= booking.checkIn
                          .nights= booking.nights + ' đêm'
                      td
                        .room-info
                          .room-type= booking.roomType
                          .room-count Tổng: #{booking.roomCount} phòng
                      td
                        .people-info
                          if booking.children > 0
                            = booking.adults + ' NL ' + booking.children + ' TE'
                          else
                            = booking.adults + ' NL'
                      td
                        .amount-info
                          .total-amount Tổng: #{(booking.totalAmount / 1000).toFixed(0)}K
                          if booking.paidAmount > 0
                            .paid-amount Đã TT: #{(booking.paidAmount / 1000).toFixed(0)}K
                          if booking.remainingAmount > 0
                            .remaining-amount Còn: #{(booking.remainingAmount / 1000).toFixed(0)}K
                      td
                        - const paymentBadgeClass = `badge-${booking.paymentStatusColor}`
                        .status-badge(class=paymentBadgeClass)= booking.paymentStatus
                      td
                        - const statusBadgeClass = `badge-${booking.statusColor}`
                        .status-badge(class=statusBadgeClass)= booking.status
                      td
                        .payment-method= booking.paymentMethod
                      td
                        .action-buttons
                          a.action-btn.view-btn(href=`/${pathAdmin}/hotel/booking/detail/${booking.bookingId}` title="Xem chi tiết")
                            i.fa-solid.fa-eye
                          button.action-btn.edit-btn(data-booking-id=booking._id data-status=booking.statusValue data-payment-status=booking.paymentStatusValue title="Chỉnh sửa trạng thái")
                            i.fa-solid.fa-pencil
                          button.action-btn.delete-booking-btn(data-booking-id=booking._id data-booking-code=booking.bookingId title="Xóa đơn đặt phòng")
                            i.fa-regular.fa-trash-can
                else
                  tr
                    td(colspan="11" style="text-align: center; padding: 40px;")
                      .empty-message Không có đặt phòng nào
          
          //- Modal chỉnh sửa trạng thái booking
          #editBookingStatusModal.modal(style="display: none;")
            .modal-overlay
            .modal-content
              .modal-header
                h3 Chỉnh sửa trạng thái booking
                button.modal-close(type="button") ×
              .modal-body
                form#editBookingStatusForm
                  input(type="hidden" name="bookingId" id="editBookingId")
                  
                  .form-group
                    label Trạng thái thanh toán
                    select.form-control(name="paymentStatus" id="editPaymentStatus")
                      option(value="unpaid") Chưa thanh toán
                      option(value="paid") Đã thanh toán
                  
                  .form-group
                    label Trạng thái booking
                    select.form-control(name="status" id="editStatus")
                      option(value="pending") Chờ xác nhận
                      option(value="confirmed") Đã xác nhận
                      option(value="checked_in") Đã nhận phòng
                      option(value="checked_out") Đã trả phòng
                      option(value="cancelled") Đã hủy
                  
                  .form-actions
                    button.btn-cancel(type="button") Hủy
                    button.btn-save(type="submit") Lưu thay đổi

      //- Tab: Quản lý số phòng
      else if bookingsData.activeTab === 'room-management'
        .room-management-page
          //- Header
          .page-header
            .header-left
              h1.page-title Quản lý số phòng
              p.page-subtitle Xếp phòng cho booking và xem tình trạng phòng

          //- Pending Bookings Section
          .pending-bookings-section
            h2.section-title Booking cần xếp phòng (#{bookingsData.pendingBookings ? bookingsData.pendingBookings.length : 0})
            
            if bookingsData.pendingBookings && bookingsData.pendingBookings.length > 0
              .pending-bookings-list
                each booking in bookingsData.pendingBookings
                  .pending-booking-card(data-booking-id=booking.bookingId data-room-type-id=booking.roomTypeId)
                    .booking-info
                      .booking-code= booking.code + ' - ' + booking.customerName
                      .booking-details
                        span.room-type= booking.roomType + ' × ' + booking.roomCount + ' phòng'
                      .booking-dates
                        span Check-in: #{booking.checkInDisplay} | Check-out: #{booking.checkOutDisplay}
                    button.btn-assign-room(type="button" data-booking-id=booking.bookingId data-room-type-id=booking.roomTypeId data-check-in=booking.checkIn data-check-out=booking.checkOut)
                      i.fa-solid.fa-door-open
                      span Xếp phòng
            else
              .empty-message Không có booking nào cần xếp phòng

          //- Room Status Section
          .room-status-section
            .room-status-section__header
              h2.section-title Tình trạng phòng

            //- Bộ lọc ngày
            form.rm-date-filter(method="GET" action=`/${pathAdmin}/hotel/booking/room-management`)
              input(type="hidden" name="hotelId" value=bookingsData.selectedHotelId || selectedHotelId)
              .rm-date-filter__fields
                .rm-date-filter__field
                  label.rm-date-filter__label
                    i.fa-solid.fa-calendar-check
                    |  Check-in từ
                  input.rm-date-filter__input(
                    type="date"
                    name="filterFrom"
                    value=bookingsData.filterFrom
                  )
                .rm-date-filter__field
                  label.rm-date-filter__label
                    i.fa-solid.fa-calendar-xmark
                    |  Đến ngày checkout
                  input.rm-date-filter__input(
                    type="date"
                    name="filterTo"
                    value=bookingsData.filterTo
                  )
                button.rm-date-filter__btn(type="submit")
                  i.fa-solid.fa-magnifying-glass
                  |  Lọc
                if bookingsData.isFiltered
                  a.rm-date-filter__clear(href=`/${pathAdmin}/hotel/booking/room-management?hotelId=${bookingsData.selectedHotelId || selectedHotelId}`)
                    i.fa-solid.fa-xmark
                    |  Xoá lọc

            if bookingsData.isFiltered
              .rm-filter-notice
                i.fa-solid.fa-circle-info
                |  Đang hiển thị booking có lịch giao nhau với khoảng&nbsp;
                strong #{bookingsData.filterFrom || '…'} → #{bookingsData.filterTo || '…'}

            if bookingsData.rooms && bookingsData.rooms.length > 0
              //- Bộ lọc có/không có booking + thống kê
              .rm-booking-filter
                button.rm-booking-filter__btn.rm-booking-filter__btn--active(
                  type="button"
                  data-filter="all"
                  onclick="applyRoomBookingFilter('all')"
                )
                  span.rm-booking-filter__label Tất cả
                  span.rm-booking-filter__count#rm-count-all= bookingsData.rooms.length
                button.rm-booking-filter__btn(
                  type="button"
                  data-filter="has"
                  onclick="applyRoomBookingFilter('has')"
                )
                  i.fa-solid.fa-calendar-check(style="color:#22c55e;font-size:11px")
                  span.rm-booking-filter__label  Có booking
                  span.rm-booking-filter__count#rm-count-has 0
                button.rm-booking-filter__btn(
                  type="button"
                  data-filter="none"
                  onclick="applyRoomBookingFilter('none')"
                )
                  i.fa-solid.fa-calendar-xmark(style="color:#94a3b8;font-size:11px")
                  span.rm-booking-filter__label  Trống
                  span.rm-booking-filter__count#rm-count-none 0

              .rooms-table-wrapper
                table.rooms-table#rm-rooms-table
                  thead
                    tr
                      th Số phòng
                      th Loại phòng
                      th Tầng
                      th Tình trạng
                      th= bookingsData.isFiltered ? 'Booking trong khoảng lọc' : 'Booking hiện tại'
                  tbody
                    each room in bookingsData.rooms
                      tr(
                        class=`room-row ${room.statusClass}`
                        data-room-id=room._id
                        data-room-type-id=room.roomTypeId
                        data-has-booking=(room.bookingCount > 0 ? '1' : '0')
                      )
                        td
                          .room-number= room.number
                        td
                          .room-type= room.roomType
                        td
                          .room-floor= room.floor
                        td
                          - const badgeClass = room.statusClass === 'available' ? 'badge-green' : (room.statusClass === 'occupied' ? 'badge-red' : 'badge-yellow')
                          .status-badge(class=badgeClass)= room.status
                        td
                          if room.bookingCount && room.bookingCount > 0
                            .booking-info-cell
                              .booking-count-badge= room.bookingCount + ' booking'
                              button.btn-view-bookings(type="button" data-room-id=room._id data-room-number=room.number data-bookings=JSON.stringify(room.bookings))
                                i.fa-solid.fa-eye
                                span Xem chi tiết
                          else
                            | —

              script.
                (function() {
                  var allRows   = Array.from(document.querySelectorAll('#rm-rooms-table tbody tr'));
                  var countAll  = allRows.length;
                  var countHas  = allRows.filter(function(r) { return r.dataset.hasBooking === '1'; }).length;
                  var countNone = countAll - countHas;

                  document.getElementById('rm-count-all').textContent  = countAll;
                  document.getElementById('rm-count-has').textContent  = countHas;
                  document.getElementById('rm-count-none').textContent = countNone;
                })();

                function applyRoomBookingFilter(filter) {
                  // Cập nhật nút active
                  document.querySelectorAll('.rm-booking-filter__btn').forEach(function(btn) {
                    btn.classList.toggle('rm-booking-filter__btn--active', btn.dataset.filter === filter);
                  });

                  // Hiển thị/ẩn hàng
                  var rows = document.querySelectorAll('#rm-rooms-table tbody tr');
                  rows.forEach(function(row) {
                    var has = row.dataset.hasBooking === '1';
                    var show = filter === 'all'
                      || (filter === 'has'  && has)
                      || (filter === 'none' && !has);
                    row.style.display = show ? '' : 'none';
                  });
                }

            else
              .empty-message Chưa có phòng nào

      //- Tab: Lịch phòng
      else if bookingsData.activeTab === 'calendar'
        .booking-calendar-page
          //- Header
          .page-header
            .header-left
              h1.page-title Lịch phòng
              p.page-subtitle Xem tổng quan đặt phòng theo phòng
            .header-right
              .calendar-navigation
                button.nav-btn.prev-btn
                  i.fa-solid.fa-chevron-left
                span.current-month= bookingsData.currentMonth || 'Tháng 1, 2026'
                button.nav-btn.next-btn
                  i.fa-solid.fa-chevron-right

          //- Calendar Grid
          .calendar-grid-wrapper
            .calendar-grid
              //- Header row với dates
              .calendar-header
                .room-header Phòng
                .dates-header
                  //- Render dates động dựa trên tháng/năm
                  - const year = bookingsData.currentYear || new Date().getFullYear()
                  - const month = bookingsData.currentMonthNum || (new Date().getMonth() + 1)
                  - const daysInMonth = moment(`${year}-${month}`, "YYYY-M").daysInMonth()
                  - const firstDayOfMonth = moment(`${year}-${month}-01`, "YYYY-M-DD").day()
                  - const dayNames = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7']
                  - const today = moment()
                  - const currentMonthMoment = moment(`${year}-${month}`, "YYYY-M")
                  
                  //- Render các ngày trong tháng
                  - for (let day = 1; day <= daysInMonth; day++)
                    - const dateMoment = moment(`${year}-${month}-${day}`, "YYYY-M-DD")
                    - const dayName = dayNames[dateMoment.day()]
                    .date-cell
                      = dayName + ' ' + day
              
              //- Room rows (booking khách hàng thật)
              if bookingsData.rooms && bookingsData.rooms.length > 0
                each room in bookingsData.rooms
                  .calendar-row
                    .room-cell
                      .room-number= 'Phòng ' + room.roomNumber
                      .room-type= room.roomType
                    .dates-cell
                      - const year = bookingsData.currentYear || new Date().getFullYear()
                      - const month = bookingsData.currentMonthNum || (new Date().getMonth() + 1)
                      - const daysInMonth = moment(`${year}-${month}`, "YYYY-M").daysInMonth()
                      - for (let day = 1; day <= daysInMonth; day++)
                        .date-cell
                          if room.bookings && room.bookings.length > 0
                            each booking in room.bookings
                              - const bookingStart = moment(booking.startDate)
                              - const bookingEnd = moment(booking.endDate)
                              - const currentDate = moment(`${year}-${month}-${day}`, "YYYY-M-DD")
                              - const isInRange = currentDate.isSameOrAfter(bookingStart, 'day') && currentDate.isBefore(bookingEnd, 'day')
                              if isInRange
                                - const guestName = booking.guestName || 'N/A'
                                - const bookingCode = booking.bookingId || booking.code || 'N/A'
                                - const barClass = booking.isTourHold ? (booking.isAssigned ? (booking.status === 'checked_in' ? 'tour-checkedin-color' : booking.status === 'checked_out' ? 'tour-checkedout-color' : 'tour-assigned-color') : 'tour-hold-color') : (booking.status === 'checked_in' ? 'checked-in-color' : booking.status === 'checked_out' ? 'checked-out-color' : 'booked-color')
                                .booking-bar(
                                  class=barClass
                                  data-guest=guestName
                                  data-tour-name=booking.tourName || ''
                                  data-tour-code=booking.tourShortCode || ''
                                  data-phone=booking.phone || ''
                                  data-check-in=booking.checkInFmt || ''
                                  data-check-out=booking.checkOutFmt || ''
                                  data-code=bookingCode
                                  data-is-tour=booking.isTourHold ? '1' : '0'
                                  data-is-assigned=booking.isAssigned ? '1' : '0'
                                  data-status=booking.status || ''
                                  onclick="showBookingPopup(event, this)"
                                  style="cursor:pointer"
                                )
                                  if booking.isTourHold && booking.isAssigned && booking.status === 'checked_in'
                                    i.fa-solid.fa-door-open(style="font-size:9px;margin-right:2px;opacity:.9")
                                    span= guestName
                                    span.booking-bar-tour-code  #{booking.tourShortCode}
                                  else if booking.isTourHold && booking.isAssigned && booking.status === 'checked_out'
                                    i.fa-solid.fa-circle-check(style="font-size:9px;margin-right:2px;opacity:.8")
                                    span= guestName
                                    span.booking-bar-tour-code  #{booking.tourShortCode}
                                  else if booking.isTourHold && booking.isAssigned
                                    i.fa-solid.fa-user(style="font-size:9px;margin-right:2px;opacity:.8")
                                    span= guestName
                                    span.booking-bar-tour-code  #{booking.tourShortCode}
                                  else if booking.isTourHold
                                    i.fa-solid.fa-link(style="font-size:9px;margin-right:2px;opacity:.8")
                                    span= booking.tourShortCode || 'Tour'
                                  else if booking.status === 'checked_out'
                                    i.fa-solid.fa-circle-check(style="font-size:9px;margin-right:2px;opacity:.8")
                                    span= guestName + ' (' + bookingCode + ')'
                                  else
                                    span= guestName + ' (' + bookingCode + ')'
                                  //- Tooltip hiện khi hover
                                  .bar-tooltip
                                    if booking.isTourHold
                                      .bar-tooltip__row
                                        i.fa-solid.fa-link
                                        span  Tour: #{booking.tourName || 'Tour hold'} (#{booking.tourShortCode})
                                      if booking.isAssigned
                                        .bar-tooltip__row
                                          i.fa-solid.fa-user
                                          span  Khách: #{guestName}
                                        if booking.phone
                                          .bar-tooltip__row
                                            i.fa-solid.fa-phone
                                            span  #{booking.phone}
                                        if booking.status === 'checked_in'
                                          .bar-tooltip__row.bar-tooltip__row--checkedin
                                            i.fa-solid.fa-door-open
                                            span  Đã nhận phòng
                                        else if booking.status === 'checked_out'
                                          .bar-tooltip__row.bar-tooltip__row--checkedout
                                            i.fa-solid.fa-circle-check
                                            span  Đã trả phòng
                                        else
                                          .bar-tooltip__row.bar-tooltip__row--waiting
                                            i.fa-solid.fa-clock
                                            span  Chờ nhận phòng
                                      else
                                        .bar-tooltip__row.bar-tooltip__row--muted
                                          i.fa-solid.fa-hourglass-half
                                          span  Chưa gán khách
                                    else
                                      .bar-tooltip__row
                                        i.fa-solid.fa-user
                                        span  #{guestName}
                                      if booking.phone
                                        .bar-tooltip__row
                                          i.fa-solid.fa-phone
                                          span  #{booking.phone}
                                      .bar-tooltip__row
                                        i.fa-solid.fa-hashtag
                                        span  #{bookingCode}
                                      if booking.status === 'checked_in'
                                        .bar-tooltip__row.bar-tooltip__row--checkedin
                                          i.fa-solid.fa-door-open
                                          span  Đang ở
                                      else if booking.status === 'checked_out'
                                        .bar-tooltip__row.bar-tooltip__row--checkedout
                                          i.fa-solid.fa-circle-check
                                          span  Đã trả phòng
                                    .bar-tooltip__row
                                      i.fa-solid.fa-calendar-days
                                      span  #{booking.checkInFmt} → #{booking.checkOutFmt}
              else
                .calendar-row.empty-state
                  .room-cell(colspan="2" style="text-align: center; padding: 40px;")
                    p Không có phòng nào


          //- Legend trạng thái
          .calendar-legend
            .legend-item
              .legend-color.booked-color
              span Đặt phòng thường (chờ nhận)
            .legend-item
              .legend-color.checked-in-color
              span Đặt phòng thường (đang ở)
            .legend-item
              .legend-color.checked-out-color
              span Đặt phòng thường (đã trả phòng)
            .legend-item
              .legend-color.tour-hold-color
              span Tour – chưa gán khách
            .legend-item
              .legend-color.tour-assigned-color
              span Tour – chờ nhận phòng
            .legend-item
              .legend-color.tour-checkedin-color
              span Tour – đang nhận phòng
            .legend-item
              .legend-color.tour-checkedout-color
              span Tour – đã trả phòng
            .legend-item
              .legend-color.available-color
              span Còn trống

          //- Bảng chú thích mã tour hold
          if bookingsData.tourHoldLegend && bookingsData.tourHoldLegend.length > 0
            .tour-hold-legend-box
              h3.tour-hold-legend-title
                i.fa-solid.fa-link
                |  Chú thích – Phòng giữ cho Tour
              table.tour-hold-legend-table
                thead
                  tr
                    th ID tour (6 ký tự cuối)
                    th Tên tour
                    th Khung thời gian lưu trú
                    th Tổng phòng
                    th Sức chứa
                tbody
                  each entry in bookingsData.tourHoldLegend
                    tr
                      td
                        span.tour-short-code= entry.shortCode
                      td= entry.tourName
                      td
                        if entry.timeSegments && entry.timeSegments.length > 0
                          each seg, i in entry.timeSegments
                            span.time-seg-badge= seg.fromDate + ' → ' + seg.toDate
                            if i < entry.timeSegments.length - 1
                              br
                        else
                          | —
                      td= entry.totalRooms + ' phòng'
                      td= entry.totalPeople + ' người'

      //- Tab: Giữ phòng Tour
      else if bookingsData.activeTab === 'tour-holds'
        .tour-holds-page
          .page-header
            .header-left
              h1.page-title Giữ phòng cho Tour
              p.page-subtitle Các phòng đang được giữ cho đoàn tour. Quản lý ở tab "Liên kết Tour – Khách sạn".

          if !bookingsData.tourHoldGroups || bookingsData.tourHoldGroups.length === 0
            .empty-state-box
              i.fa-solid.fa-circle-info
              p  Chưa có phòng nào đang được giữ cho tour tại khách sạn này.

          else
            .th-search-bar
              .th-search-bar__inner
                i.fa-solid.fa-magnifying-glass.th-search-bar__icon
                input#thSearchInput.th-search-bar__input(
                  type="text"
                  placeholder="Tìm theo tên tour, ID tour hoặc mã giữ phòng…"
                  oninput="filterTourHoldGroups(this.value)"
