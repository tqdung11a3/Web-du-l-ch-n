          button#th-app-dialog-ok.th-app-dialog__btn.th-app-dialog__btn--primary(type="button") Tiếp tục

    script.
      function showHbConfirm(opts) {
        opts = opts || {};
        var message = opts.message || '';
        var title = opts.title || 'Xác nhận';
        var confirmText = opts.confirmText || 'Tiếp tục';
        var cancelText = opts.cancelText || 'Huỷ';
        var wrap = document.getElementById('th-app-dialog');
        if (!wrap) return Promise.resolve(window.confirm(message));

        return new Promise(function (resolve) {
          var titleEl = document.getElementById('th-app-dialog-title');
          var bodyEl = document.getElementById('th-app-dialog-body');
          var okBtn = document.getElementById('th-app-dialog-ok');
          var cancelBtn = document.getElementById('th-app-dialog-cancel');
          var closeBtn = document.getElementById('th-app-dialog-close');
          var backdrop = wrap.querySelector('.th-app-dialog__backdrop');
          if (!titleEl || !bodyEl || !okBtn || !cancelBtn || !closeBtn || !backdrop) {
            resolve(window.confirm(message));
            return;
          }

          titleEl.textContent = title;
          bodyEl.textContent = message;
          okBtn.textContent = confirmText;
          cancelBtn.textContent = cancelText;

          var settled = false;
          function finish(val) {
            if (settled) return;
            settled = true;
            wrap.classList.remove('is-open');
            wrap.setAttribute('aria-hidden', 'true');
            document.removeEventListener('keydown', onKey);
            okBtn.removeEventListener('click', onOk);
            cancelBtn.removeEventListener('click', onCancel);
            closeBtn.removeEventListener('click', onCancel);
            backdrop.removeEventListener('click', onCancel);
            resolve(val);
          }
          function onOk() { finish(true); }
          function onCancel() { finish(false); }
          function onKey(ev) { if (ev.key === 'Escape') onCancel(); }

          okBtn.addEventListener('click', onOk);
          cancelBtn.addEventListener('click', onCancel);
          closeBtn.addEventListener('click', onCancel);
          backdrop.addEventListener('click', onCancel);
          document.addEventListener('keydown', onKey);

          wrap.classList.add('is-open');
          wrap.setAttribute('aria-hidden', 'false');
          okBtn.focus();
        });
      }

    //- JavaScript cho calendar navigation
    - const defaultYear = bookingsData.currentYear || new Date().getFullYear()
    - const defaultMonth = bookingsData.currentMonthNum || (new Date().getMonth() + 1)
    script.
      var OWN_COMPANY_NAME = "!{ownCompanyName || ''}";
    script.
      // ── Popup thông tin booking khi bấm vào thanh lịch ──────────────────────
      function showBookingPopup(e, bar) {
        e.stopPropagation();
        var popup = document.getElementById('booking-info-popup');
        if (!popup) return;

        var isTour          = bar.dataset.isTour === '1';
        var isAssigned      = bar.dataset.isAssigned === '1';
        var guest           = bar.dataset.guest || '';
        var tourName        = bar.dataset.tourName || '';
        var tourCode        = bar.dataset.tourCode || '';
        var phone           = bar.dataset.phone || '';
        var checkIn         = bar.dataset.checkIn || '';
        var checkOut        = bar.dataset.checkOut || '';
        var code            = bar.dataset.code || '';
        var status          = bar.dataset.status || '';
        var isOwnCompany    = bar.dataset.isOwnCompany !== '0';
        var tourCompanyName = bar.dataset.tourCompanyName || '';
        var noteRaw         = bar.dataset.note || '';

        var coOccupants = [];
        try { coOccupants = JSON.parse(bar.dataset.coOccupants || '[]'); } catch(e) {}

        var rows = '';

        if (isTour) {
          rows += '<div class="bip-row bip-row--tour"><i class="fa-solid fa-link"></i><div><span class="bip-label">Tour</span><span class="bip-value">' + (tourName || tourCode || 'Tour hold') + (tourCode ? ' <span class="bip-code">(' + tourCode + ')</span>' : '') + '</span></div></div>';
          if (isOwnCompany) {
            var ownLabel = OWN_COMPANY_NAME ? OWN_COMPANY_NAME + ' (Công ty mình)' : 'Công ty mình';
            rows += '<div class="bip-row bip-row--company-own"><i class="fa-solid fa-building"></i><div><span class="bip-label">Công ty</span><span class="bip-value bip-company--own">' + ownLabel + '</span></div></div>';
          } else {
            rows += '<div class="bip-row bip-row--company-cross"><i class="fa-solid fa-handshake"></i><div><span class="bip-label">Công ty</span><span class="bip-value bip-company--cross">' + (tourCompanyName || 'Công ty khác') + '</span></div></div>';
          }

          if (!isAssigned) {
            rows += '<div class="bip-row bip-row--muted"><i class="fa-solid fa-hourglass-half"></i><div><span class="bip-value">Chưa gán khách</span></div></div>';
          } else if (coOccupants.length > 1) {
            // Phòng ghép nhiều đơn: hiển thị từng khách với trạng thái riêng
            var statusLabelMap = { confirmed: 'Chưa nhận phòng', checked_in: 'Đã nhận phòng', checked_out: 'Đã trả phòng' };
            var statusClsMap   = { confirmed: 'bip-status--waiting', checked_in: 'bip-status--checkedin', checked_out: 'bip-status--checkedout' };
            var statusIconMap  = { confirmed: 'fa-clock', checked_in: 'fa-door-open', checked_out: 'fa-circle-check' };
            rows += '<div class="bip-row"><i class="fa-solid fa-people-group"></i><div><span class="bip-label">Khách ở ghép</span></div></div>';
            coOccupants.forEach(function(co) {
              var coStatus = co.guestStatus || 'confirmed';
              var coStatusLabel = statusLabelMap[coStatus] || coStatus;
              var coStatusCls   = statusClsMap[coStatus]  || '';
              var coStatusIcon  = statusIconMap[coStatus] || 'fa-clock';
              rows += '<div class="bip-co-row">'
                + '<div class="bip-co-name"><i class="fa-solid fa-user" style="font-size:10px;margin-right:4px;opacity:.6"></i>'
                + '<span class="bip-value--name">' + (co.guestName || '—') + '</span>'
                + (co.orderCode ? ' <span class="bip-code" style="font-size:10px">#' + co.orderCode + '</span>' : '')
                + '</div>'
                + (co.phone ? '<div class="bip-co-meta"><i class="fa-solid fa-phone" style="font-size:9px;margin-right:3px;opacity:.5"></i>' + co.phone + '</div>' : '')
                + '<div class="bip-co-status ' + coStatusCls + '"><i class="fa-solid ' + coStatusIcon + '" style="font-size:9px;margin-right:3px"></i>' + coStatusLabel + '</div>'
                + '</div>';
            });
          } else {
            // Khách ở riêng (single occupant private)
            var accModeLocal = bar.dataset.accMode || '';
            if (accModeLocal === 'private') {
              rows += '<div class="bip-row"><i class="fa-solid fa-door-closed"></i><div><span class="bip-label">Hình thức</span><span class="bip-value" style="background:#f1f5f9;color:#475569;padding:1px 8px;border-radius:6px;font-size:12px">Ở riêng</span></div></div>';
            }
            if (guest && guest !== 'N/A') {
            rows += '<div class="bip-row"><i class="fa-solid fa-user"></i><div><span class="bip-label">Khách</span><span class="bip-value bip-value--name">' + guest + '</span></div></div>';
          }
          if (phone) {
            rows += '<div class="bip-row"><i class="fa-solid fa-phone"></i><div><span class="bip-label">SĐT</span><span class="bip-value">' + phone + '</span></div></div>';
          }
            if (status === 'checked_in') {
              rows += '<div class="bip-row bip-row--checkedin"><i class="fa-solid fa-door-open"></i><div><span class="bip-label">Trạng thái</span><span class="bip-value bip-status--checkedin">Đã nhận phòng</span></div></div>';
          } else if (status === 'checked_out') {
              rows += '<div class="bip-row bip-row--checkedout"><i class="fa-solid fa-circle-check"></i><div><span class="bip-label">Trạng thái</span><span class="bip-value bip-status--checkedout">Đã trả phòng</span></div></div>';
          } else {
              rows += '<div class="bip-row bip-row--waiting"><i class="fa-solid fa-clock"></i><div><span class="bip-label">Trạng thái</span><span class="bip-value bip-status--waiting">Chưa nhận phòng</span></div></div>';
            }
          }
        } else {
          if (guest && guest !== 'N/A') {
            rows += '<div class="bip-row"><i class="fa-solid fa-user"></i><div><span class="bip-label">Khách</span><span class="bip-value bip-value--name">' + guest + '</span></div></div>';
          }
          if (phone) {
            rows += '<div class="bip-row"><i class="fa-solid fa-phone"></i><div><span class="bip-label">SĐT</span><span class="bip-value">' + phone + '</span></div></div>';
          }
          rows += '<div class="bip-row"><i class="fa-solid fa-hashtag"></i><div><span class="bip-label">Mã</span><span class="bip-value bip-code">' + code + '</span></div></div>';
        }

        if (checkIn || checkOut) {
          rows += '<div class="bip-row"><i class="fa-solid fa-calendar-days"></i><div><span class="bip-label">Ngày</span><span class="bip-value">' + checkIn + ' → ' + checkOut + '</span></div></div>';
        }

        // ── Danh sách hành khách của phòng này ─────────────────────────────────
        var typeMap = { adult: 'Người lớn', child: 'Trẻ em', baby: 'Em bé' };
        var clsMap  = { adult: 'bip-pax--adult', child: 'bip-pax--child', baby: 'bip-pax--baby' };
        var typeMapShort = { NL: 'Người lớn', TE: 'Trẻ em', EB: 'Em bé' };
        var clsMapShort  = { NL: 'bip-pax--adult', TE: 'bip-pax--child', EB: 'bip-pax--baby' };
        var paxBlockHtml = '';

        // PRIORITY 1: data-room-pax (server đã resolve → chính xác cho cả đơn cũ).
        var roomPaxRaw = bar.dataset.roomPax || '';
        var accMode    = bar.dataset.accMode || '';
        if (roomPaxRaw) {
          try {
            var paxArr = JSON.parse(roomPaxRaw);
            if (Array.isArray(paxArr) && paxArr.length) {
              var title = accMode === 'shared' ? 'Khách ở ghép (phòng này)' : 'Khách của phòng này';
              paxBlockHtml = '<div class="bip-pax-block">'
                + '<div class="bip-pax-title"><i class="fa-solid fa-users" style="margin-right:5px;color:#6366f1"></i>' + title + '</div>'
                + '<div class="bip-pax-list">'
                + paxArr.map(function(p) {
                    var meta = '';
                    if (p.age !== undefined && p.age !== '' && p.age !== null) meta += ' · ' + p.age + 't';
                    if (p.gender === 'male')   meta += ' · Nam';
                    if (p.gender === 'female') meta += ' · Nữ';
                    return '<div class="bip-pax-row">'
                      + '<span class="bip-pax-badge ' + (clsMap[p.type] || '') + '">' + (typeMap[p.type] || p.type) + '</span>'
                      + '<span class="bip-pax-name">' + (p.name || '—') + '</span>'
                      + (meta ? '<span class="bip-pax-meta">' + meta + '</span>' : '')
                      + '</div>';
                  }).join('')
                + '</div></div>';
            }
          } catch (e) { /* ignore */ }
        }

        // PRIORITY 2: parse note snapshot (đơn mới có suffix "| Name (NL), ...").
        if (!paxBlockHtml && noteRaw) {
          var sep = noteRaw.indexOf(' | ');
          if (sep !== -1) {
            var paxStr   = noteRaw.substring(sep + 3);
            var isShared = noteRaw.indexOf('[Tour Booking/Share]') !== -1;
            var paxItems = paxStr.split(', ').map(function(s){ return s.trim(); }).filter(Boolean);
            if (paxItems.length) {
              var title2 = isShared ? 'Khách ở ghép (phòng này)' : 'Khách của phòng này';
              paxBlockHtml = '<div class="bip-pax-block">'
                + '<div class="bip-pax-title"><i class="fa-solid fa-users" style="margin-right:5px;color:#6366f1"></i>' + title2 + '</div>'
                + '<div class="bip-pax-list">'
                + paxItems.map(function(item) {
                    var m = item.match(/^(.+?)\s+\((NL|TE|EB)\)$/);
                    if (!m) return '<div class="bip-pax-row"><span class="bip-pax-badge">' + item + '</span></div>';
                    var t = m[2];
                    return '<div class="bip-pax-row">'
                      + '<span class="bip-pax-badge ' + (clsMapShort[t] || '') + '">' + (typeMapShort[t] || t) + '</span>'
                      + '<span class="bip-pax-name">' + m[1] + '</span>'
                      + '</div>';
                  }).join('')
                + '</div></div>';
            }
          }
        }

        rows += paxBlockHtml;

        popup.querySelector('.booking-info-popup__body').innerHTML = rows;

        // Định vị popup gần vị trí bấm, tránh ra ngoài màn hình
        popup.style.display = 'block';
        var pw = popup.offsetWidth  || 240;
        var ph = popup.offsetHeight || 160;
        var vw = window.innerWidth;
        var vh = window.innerHeight;
        var x  = e.clientX + 12;
        var y  = e.clientY + 12;
        if (x + pw > vw - 10) x = e.clientX - pw - 12;
        if (y + ph > vh - 10) y = e.clientY - ph - 12;
        popup.style.left = Math.max(8, x) + 'px';
        popup.style.top  = Math.max(8, y) + 'px';
      }

      function closeBookingPopup() {
        var popup = document.getElementById('booking-info-popup');
        if (popup) popup.style.display = 'none';
      }

      document.addEventListener('click', function(e) {
        if (!e.target.closest('.booking-bar') && !e.target.closest('#booking-info-popup')) {
          closeBookingPopup();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeBookingPopup();
      });

      // ── Calendar navigation + bảng chọn tháng/năm ───────────────────────────
      document.addEventListener('DOMContentLoaded', function() {
        const prevBtn = document.querySelector('.booking-calendar-page .prev-btn');
        const nextBtn = document.querySelector('.booking-calendar-page .next-btn');
        const pickerWrap = document.querySelector('.booking-calendar-page .calendar-picker-wrap');
        const picker = document.getElementById('calendarMonthPicker');
        const pickerToggle = document.querySelector('.booking-calendar-page .calendar-picker-toggle');
        const pickerClose = document.querySelector('.booking-calendar-page .calendar-month-picker__close');
        const yearSel = document.getElementById('calendarPickerYear');

        if (!pickerWrap || !picker) return;

          const urlParams = new URLSearchParams(window.location.search);
        let currentYear = parseInt(urlParams.get('year')) || #{defaultYear};
        let currentMonth = parseInt(urlParams.get('month')) || #{defaultMonth};
          const currentHotelId = urlParams.get('hotelId') || '';
          
        function goCalendar(y, m) {
          const newUrl = `/${pathAdmin}/hotel/booking/calendar?year=${y}&month=${m}&hotelId=${encodeURIComponent(currentHotelId)}`;
          window.location.href = newUrl;
        }

        function syncPickerYearSelect() {
          if (!yearSel) return;
          const y = String(currentYear);
          let opt = yearSel.querySelector('option[value="' + y + '"]');
          if (!opt) {
            opt = document.createElement('option');
            opt.value = y;
            opt.textContent = y;
            yearSel.appendChild(opt);
          }
          yearSel.value = y;
        }

        function setPickerOpen(open) {
          picker.style.display = open ? 'block' : 'none';
          if (pickerToggle) pickerToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }

        function togglePicker() {
          const isOpen = picker.style.display === 'block';
          if (isOpen) setPickerOpen(false);
          else {
            syncPickerYearSelect();
            setPickerOpen(true);
          }
        }

        if (pickerToggle) pickerToggle.addEventListener('click', function (e) {
          e.stopPropagation();
          togglePicker();
        });
        if (pickerClose) pickerClose.addEventListener('click', function () { setPickerOpen(false); });

        document.addEventListener('click', function (e) {
          if (!pickerWrap.contains(e.target)) setPickerOpen(false);
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && picker && picker.style.display === 'block') setPickerOpen(false);
        });

        picker.querySelectorAll('.calendar-month-picker__cell').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const m = parseInt(btn.getAttribute('data-month'), 10);
            const y = yearSel ? parseInt(yearSel.value, 10) : currentYear;
            if (!m || m < 1 || m > 12 || !y) return;
            goCalendar(y, m);
          });
        });

        if (prevBtn && nextBtn) {
          prevBtn.addEventListener('click', function() {
            let newYear = currentYear;
            let newMonth = currentMonth - 1;
            if (newMonth < 1) { newMonth = 12; newYear = currentYear - 1; }
            goCalendar(newYear, newMonth);
          });
          nextBtn.addEventListener('click', function() {
            let newYear = currentYear;
            let newMonth = currentMonth + 1;
            if (newMonth > 12) { newMonth = 1; newYear = currentYear + 1; }
            goCalendar(newYear, newMonth);
          });
        }
      });

  //- Modal chi tiết booking
  script.
    function openPendingDetailModal(btn) {
      var groupCode = btn.dataset.groupCode;
      var modal     = document.getElementById('pendingDetailModal');

      // Cập nhật tiêu đề modal
      document.getElementById('pendingDetailModalTitle').textContent    = btn.dataset.groupTitle    || groupCode;
      document.getElementById('pendingDetailModalSubtitle').textContent = btn.dataset.groupSubtitle || '';

      // Ẩn tất cả nội dung, chỉ hiện đúng nhóm được chọn
      document.querySelectorAll('.pending-detail-content').forEach(function (el) {
        el.style.display = 'none';
      });
      var content = document.getElementById('pending-detail-' + groupCode);
      if (content) content.style.display = 'flex';

      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closePendingDetailModal() {
      var modal = document.getElementById('pendingDetailModal');
      if (modal) modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closePendingDetailModal();
    });

    // ── Modal danh sách booking đã xếp (tab "Thay đổi phòng") ──
    function openChangeRoomDetailModal(btn) {
      var groupCode = btn.dataset.groupCode;
      var modal     = document.getElementById('changeRoomDetailModal');
      if (!modal) return;
      document.getElementById('changeRoomDetailModalTitle').textContent    = btn.dataset.groupTitle    || groupCode;
      document.getElementById('changeRoomDetailModalSubtitle').textContent = btn.dataset.groupSubtitle || '';
      modal.querySelectorAll('.pending-detail-content').forEach(function (el) { el.style.display = 'none'; });
      var content = document.getElementById('change-room-detail-' + groupCode);
      if (content) content.style.display = 'flex';
      // Ẩn nút hoàn tất khi mở nhóm mới
      var footer = document.getElementById('changeRoomModalFooter');
      if (footer) footer.style.display = 'none';
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeChangeRoomDetailModal() {
      var modal = document.getElementById('changeRoomDetailModal');
      if (modal) modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    // Nút "Hoàn tất & Tải lại" trong footer modal
    (function () {
      var btn = document.getElementById('btnChangeRoomFinish');
      if (btn) btn.addEventListener('click', function () { window.location.reload(); });
    })();

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeChangeRoomDetailModal();
    });

    // ── Đổi phòng: pick phòng cùng loại, không trùng lịch ──
    (function () {
      // Kiểm tra tất cả card trong nhóm hiện tại đã đổi chưa → hiện nút hoàn tất
      function checkAllDone() {
        var content = Array.from(document.querySelectorAll('.pending-detail-content'))
          .find(function (el) { return el.style.display !== 'none' && el.style.display !== ''; });
        if (!content) return;
        var cards = Array.from(content.querySelectorAll('.pending-booking-card'));
        var allDone = cards.length > 0 && cards.every(function (card) {
          return card.dataset.changed === '1';
        });
        var footer = document.getElementById('changeRoomModalFooter');
        if (footer) footer.style.display = allDone ? 'flex' : 'none';
      }

      function parseDMY(str) {
        if (!str) return null;
        var parts = str.split('/');
        if (parts.length !== 3) return null;
        var d = parts[0], m = parts[1], y = parts[2];
        return new Date(y + '-' + m.padStart(2,'0') + '-' + d.padStart(2,'0'));
      }
      function overlapsHalfOpen(aISO, bISO, cDMY, dDMY) {
        var a = aISO ? new Date(aISO) : null;
        var b = bISO ? new Date(bISO) : null;
        var c = parseDMY(cDMY);
        var d = parseDMY(dDMY);
        if (!a || !b || !c || !d) return false;
        return a < d && c < b;
      }

      // sourceBtnEl: nút .btn-change-room trên card, dùng để cập nhật UI sau khi đổi xong
      function showReassignModal(bookingId, currentRoomId, currentRoomNumber, candidates, sourceBtnEl) {
        // Xoá modal cũ nếu còn
        var old = document.getElementById('reassignRoomModal');
        if (old) old.remove();

        var html = ''
          + '<div class="assign-room-modal reassign-room-modal active" id="reassignRoomModal">'
          + '  <div class="modal-content">'
          + '    <div class="modal-header">'
          + '      <h3>Đổi phòng</h3>'
          + '      <button class="modal-close" type="button"><i class="fa-solid fa-times"></i></button>'
          + '    </div>'
          + '    <div class="modal-body">'
          + '      <div class="booking-summary">'
          + '        <p><strong>Phòng hiện tại:</strong> ' + currentRoomNumber + '</p>'
          + '        <p>Chọn phòng mới cùng loại, không trùng lịch:</p>'
          + '      </div>'
          + '      <div class="available-rooms-list">'
          +          candidates.map(function (r) {
                       return ''
                         + '<label class="room-option">'
                         + '  <input type="radio" name="newRoomId" value="' + r.roomId + '" class="room-input">'
                         + '  <div class="room-option-info">'
                         + '    <div class="room-option-number">Phòng ' + r.number + '</div>'
                         + '    <div class="room-option-type">Tầng ' + (r.floor || '—') + '</div>'
                         + '  </div>'
                         + '</label>';
                     }).join('')
          + '      </div>'
          + '    </div>'
          + '    <div class="modal-footer">'
          + '      <button class="btn-modal btn-cancel" type="button">Hủy</button>'
          + '      <button class="btn-modal btn-confirm" type="button" disabled>Xác nhận đổi</button>'
          + '    </div>'
          + '  </div>'
          + '</div>';

        document.body.insertAdjacentHTML('beforeend', html);
        var modal = document.getElementById('reassignRoomModal');
        var closeBtn = modal.querySelector('.modal-close');
        var cancelBtn = modal.querySelector('.btn-cancel');
        var confirmBtn = modal.querySelector('.btn-confirm');
        var inputs = modal.querySelectorAll('.room-input');

        function close() { modal.remove(); }
        closeBtn.addEventListener('click', close);
        cancelBtn.addEventListener('click', close);
        modal.addEventListener('click', function (e) { if (e.target === modal) close(); });

        inputs.forEach(function (inp) {
          inp.addEventListener('change', function () {
            confirmBtn.disabled = !modal.querySelector('.room-input:checked');
          });
        });

        confirmBtn.addEventListener('click', function () {
          var chosen = modal.querySelector('.room-input:checked');
          if (!chosen) return;
          var newRoomId = chosen.value;
          var newRoomNumber = chosen.closest('.room-option').querySelector('.room-option-number').textContent.replace('Phòng ', '').trim();
          confirmBtn.disabled = true;
          confirmBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';

          fetch('/admin/hotel/booking/reassign-room', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ bookingId: bookingId, newRoomId: newRoomId }),
          })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data.code === 'success') {
                // Đóng modal chọn phòng
                modal.remove();

                // Cập nhật card: đánh dấu xong, cập nhật label phòng, vô hiệu hoá nút đổi
                if (sourceBtnEl) {
                  var card = sourceBtnEl.closest('.pending-booking-card');
                  if (card) {
                    card.dataset.changed = '1';
                    // Cập nhật label "Phòng hiện tại"
                    var roomLabel = card.querySelector('.cr-room-label');
                    if (roomLabel) roomLabel.textContent = newRoomNumber;
                    // Cập nhật data trên nút để lần đổi tiếp lấy đúng currentRoomId/Number
                    sourceBtnEl.dataset.currentRoomId     = newRoomId;
                    sourceBtnEl.dataset.currentRoomNumber = newRoomNumber;
                    // Đổi giao diện nút
                    sourceBtnEl.disabled = true;
                    sourceBtnEl.innerHTML = '<i class="fa-solid fa-circle-check"></i> Đã đổi';
                    sourceBtnEl.style.cssText = 'background:#16a34a;cursor:not-allowed;opacity:.85;';
                    card.style.opacity = '0.7';
                  }
                }

                if (typeof Notyf !== 'undefined') {
                  new Notyf({ duration: 2000, position: { x: 'right', y: 'top' } }).success(data.message || 'Đổi phòng thành công!');
                }

                // Kiểm tra có phải tất cả card xong chưa
                checkAllDone();
              } else {
                if (typeof Notyf !== 'undefined') {
                  new Notyf({ duration: 4000, position: { x: 'right', y: 'top' } }).error(data.message || 'Có lỗi xảy ra!');
                } else {
                  alert(data.message || 'Có lỗi xảy ra!');
                }
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Xác nhận đổi';
              }
            })
            .catch(function () {
              alert('Có lỗi mạng khi đổi phòng!');
              confirmBtn.disabled = false;
              confirmBtn.textContent = 'Xác nhận đổi';
            });
        });
      }

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-change-room');
        if (!btn || btn.id === 'btnChangeRoomFinish') return;
        e.preventDefault();

        var bookingId         = btn.dataset.bookingId;
        var roomTypeId        = btn.dataset.roomTypeId;
        var currentRoomId     = btn.dataset.currentRoomId;
        var currentRoomNumber = btn.dataset.currentRoomNumber;
        var checkIn           = btn.dataset.checkIn;
        var checkOut          = btn.dataset.checkOut;

        var catalog = [];
        var dataEl = document.getElementById('crRoomsData');
        if (dataEl) {
          try { catalog = JSON.parse(dataEl.textContent); } catch (e) { catalog = []; }
        }

        var candidates = catalog
          .filter(function (room) {
            return String(room.roomTypeId) === String(roomTypeId)
                && String(room._id) !== String(currentRoomId);
          })
          .filter(function (room) {
            var list = room.bookings || [];
            return !list.some(function (b) {
              if (String(b.bookingId) === String(bookingId)) return false;
              return overlapsHalfOpen(checkIn, checkOut, b.checkIn, b.checkOut);
            });
          })
          .map(function (room) {
            return {
              roomId: room._id,
              number: room.number,
              floor:  room.floor,
            };
          });

        if (candidates.length === 0) {
          if (typeof Notyf !== 'undefined') {
            new Notyf({ duration: 4000, position: { x: 'right', y: 'top' } }).error('Không còn phòng trống cùng loại trong khoảng thời gian này!');
          } else {
            alert('Không còn phòng trống cùng loại trong khoảng thời gian này!');
          }
          return;
        }

        showReassignModal(bookingId, currentRoomId, currentRoomNumber, candidates, btn);
      });
    })();

  style.
    /* ── Thẻ tóm tắt ── */
    .pending-booking-group { border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; margin-bottom: 12px; background: #fff; }
    .pending-booking-group__summary { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; background: #fefce8; gap: 12px; }
    .booking-summary-info { display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 0; }
    .summary-code { font-size: 14px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
    .summary-code strong { color: #1e40af; }
    .summary-rooms { font-size: 13px; color: #374151; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
    .summary-rooms i { color: #6366f1; }
    .summary-dates { font-size: 13px; color: #6b7280; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
    .summary-dates i { color: #0ea5e9; }
    .summary-sep { color: #d1d5db; }
    .btn-toggle-detail { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; background: #fff; border: 1px solid #d1d5db; border-radius: 8px; font-size: 13px; font-weight: 600; color: #374151; cursor: pointer; white-space: nowrap; transition: background .15s, border-color .15s; flex-shrink: 0; }
    .btn-toggle-detail:hover { background: #f3f4f6; border-color: #9ca3af; }
    .booking-pax { color: #6b7280; font-size: 12px; }
    /* ── Passenger block trong booking popup ── */
    .bip-pax-block { margin-top: 6px; border-top: 1px solid #e2e8f0; padding-top: 8px; }
    .bip-pax-title { font-size: 11.5px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .4px; margin-bottom: 6px; }
    .bip-pax-list { display: flex; flex-direction: column; gap: 4px; }
    .bip-pax-row { display: flex; align-items: center; gap: 7px; font-size: 13px; flex-wrap: wrap; }
    .bip-pax-name { color: #0f172a; font-weight: 500; }
    .bip-pax-meta { color: #64748b; font-size: 11.5px; }
    .bip-pax-badge { display: inline-flex; align-items: center; padding: 1px 7px; border-radius: 999px; font-size: 11px; font-weight: 600; white-space: nowrap; background: #e2e8f0; color: #475569; }
    .bip-pax--adult { background: #dbeafe; color: #1e40af; }
    .bip-pax--child { background: #fef3c7; color: #92400e; }
    .bip-pax--baby  { background: #fce7f3; color: #9d174d; }
    /* ── Modal chi tiết ── */
    /* z-index > .header (9999) và .hotel-selector-bar (9997) — tránh bị che bởi thanh chọn KS */
    .pending-detail-modal { position: fixed; inset: 0; z-index: 10050; display: flex; align-items: center; justify-content: center; }
    .pending-detail-modal__overlay { position: absolute; inset: 0; background: rgba(0,0,0,.45); }
    .pending-detail-modal__box { position: relative; background: #fff; border-radius: 14px; box-shadow: 0 8px 40px rgba(0,0,0,.18); width: 92%; max-width: 680px; max-height: 80vh; display: flex; flex-direction: column; overflow: hidden; }
    .pending-detail-modal__header { display: flex; align-items: flex-start; justify-content: space-between; padding: 18px 20px 14px; border-bottom: 1px solid #e5e7eb; background: #f8fafc; gap: 12px; }
    .modal-header-info { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .modal-title { font-size: 16px; font-weight: 700; color: #1e3a8a; margin: 0; }
    .modal-subtitle { font-size: 12px; color: #6b7280; margin: 0; }
    .pending-detail-modal__close { flex-shrink: 0; background: none; border: none; cursor: pointer; font-size: 18px; color: #6b7280; padding: 2px 6px; border-radius: 6px; transition: background .15s, color .15s; line-height: 1; }
    .pending-detail-modal__close:hover { background: #fee2e2; color: #dc2626; }
    .pending-detail-modal__body { overflow-y: auto; padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
    .pending-detail-content { flex-direction: column; gap: 10px; }
    .pending-detail-modal__footer { padding: 14px 20px; border-top: 1px solid #e5e7eb; background: #f8f9ff; justify-content: center; }
    .btn-change-room-finish { display: inline-flex; align-items: center; gap: 8px; padding: 10px 28px; background: #2d3e90; color: #fff; border: none; border-radius: 8px; font-size: 15px; font-weight: 700; cursor: pointer; transition: background .15s; }
    .btn-change-room-finish:hover { background: #243270; }
    /* Tab Thay đổi phòng — màu chính #2d3e90 */
    .change-room-page .pending-booking-group__summary { background: linear-gradient(180deg, #f8f9ff 0%, #eef1fb 100%); border-bottom: 1px solid #d8ddf0; }
    .change-room-page .summary-code strong { color: #2d3e90; }
    .change-room-page .summary-rooms i { color: #2d3e90; }
    .change-room-page .btn-toggle-detail:hover { border-color: #2d3e90; color: #2d3e90; background: #eef1fb; }
    #changeRoomDetailModal .pending-detail-modal__header { background: linear-gradient(180deg, #2d3e90 0%, #243270 100%); border-bottom: none; }
    #changeRoomDetailModal .modal-title { color: #fff; }
    #changeRoomDetailModal .modal-subtitle { color: rgba(255,255,255,.85); }
    #changeRoomDetailModal .pending-detail-modal__close { color: rgba(255,255,255,.9); }
