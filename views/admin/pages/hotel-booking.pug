                  .tour-hold-group(data-tour-name=group.tourName.toLowerCase() data-tour-id=group.tourShortId.toLowerCase() data-booking-codes=allCodes data-company-type="own")
                    - var unassignedBookings = group.bookings.filter(function(b){ return !b.isAssigned; })
                    - var unassignedIds = unassignedBookings.map(function(b){ return b.id; })
                    +tourHoldGroupContent(group, unassignedBookings, unassignedIds)

            //- ── Panel: Tour liên kết từ công ty khác ──
            #thPanelCross.th-company-panel(style="display:none")
              if !bookingsData.crossTourHoldGroups || bookingsData.crossTourHoldGroups.length === 0
                .empty-state-box(style="margin-top:24px")
                  i.fa-solid.fa-circle-info
                  p  Chưa có phòng nào đang được giữ cho tour liên kết từ công ty khác tại khách sạn này.
              else
                each group in bookingsData.crossTourHoldGroups
                  - var allCodes = group.bookings.map(function(b){ return b.code.toLowerCase(); }).join(' ')
                  .tour-hold-group(data-tour-name=group.tourName.toLowerCase() data-tour-id=group.tourShortId.toLowerCase() data-booking-codes=allCodes data-company-type="cross")
                    - var unassignedBookings = group.bookings.filter(function(b){ return !b.isAssigned; })
                    - var unassignedIds = unassignedBookings.map(function(b){ return b.id; })
                    +tourHoldGroupContent(group, unassignedBookings, unassignedIds)

          script.
            // ── Tour Hold Detail Toggle ──
            function toggleTourHoldDetail(btn) {
              var panelId = btn.dataset.panelId;
              var panel = document.getElementById(panelId);
              if (!panel) return;
              var labelEl = btn.querySelector('.btn-tour-hold-detail__label');
              var chev = btn.querySelector('.btn-tour-hold-detail__chev');
              var isOpen = panel.style.display !== 'none';
              if (isOpen) {
                panel.style.display = 'none';
                btn.setAttribute('aria-expanded', 'false');
                btn.classList.remove('btn-tour-hold-detail--open');
                if (labelEl) labelEl.textContent = ' Xem chi tiết';
                if (chev) chev.style.transform = '';
              } else {
                panel.style.display = '';
                btn.setAttribute('aria-expanded', 'true');
                btn.classList.add('btn-tour-hold-detail--open');
                if (labelEl) labelEl.textContent = ' Ẩn chi tiết';
                if (chev) chev.style.transform = 'rotate(180deg)';
              }
            }

            // ── Tour Hold Tab ──
            function switchTourHoldTab(type) {
              var ownTab   = document.getElementById('thTabOwn');
              var crossTab = document.getElementById('thTabCross');
              var ownPanel   = document.getElementById('thPanelOwn');
              var crossPanel = document.getElementById('thPanelCross');
              if (type === 'own') {
                ownTab.classList.add('th-company-tab--active');
                crossTab.classList.remove('th-company-tab--active');
                ownPanel.style.display = '';
                crossPanel.style.display = 'none';
              } else {
                crossTab.classList.add('th-company-tab--active');
                ownTab.classList.remove('th-company-tab--active');
                crossPanel.style.display = '';
                ownPanel.style.display = 'none';
              }
              // Reset search when switching tabs
              var inp = document.getElementById('thSearchInput');
              if (inp && inp.value) { inp.value = ''; filterTourHoldGroups(''); }
            }

            // ── Tour Hold Search ──
            function filterTourHoldGroups(keyword) {
              var q = (keyword || '').trim().toLowerCase();
              // Only search within the active panel
              var activePanel = document.querySelector('.th-company-panel:not([style*="display: none"]):not([style*="display:none"])') ||
                                document.getElementById('thPanelOwn');
              var groups = activePanel ? activePanel.querySelectorAll('.tour-hold-group') : document.querySelectorAll('.tour-holds-page .tour-hold-group');
              var visibleGroups = 0;
              var visibleRows   = 0;

              groups.forEach(function(g) {
                var name = (g.dataset.tourName || '').toLowerCase();
                var id   = (g.dataset.tourId   || '').toLowerCase();
                var matchesMeta = !q || name.indexOf(q) !== -1 || id.indexOf(q) !== -1;

                // Tìm trong các row booking
                var rows = g.querySelectorAll('tr[data-booking-code]');
                var hasRowMatch = false;
                if (!matchesMeta && q) {
                  rows.forEach(function(row) {
                    if ((row.dataset.bookingCode || '').toLowerCase().indexOf(q) !== -1) {
                      hasRowMatch = true;
                    }
                  });
                }

                var showGroup = matchesMeta || hasRowMatch;
                g.style.display = showGroup ? '' : 'none';

                if (showGroup) {
                  visibleGroups++;

                  // Lọc từng row
                  rows.forEach(function(row) {
                    if (matchesMeta || !q) {
                      // Khớp theo tên/ID tour → hiện tất cả row
                      row.style.display = '';
                    } else {
                      // Khớp theo mã → chỉ hiện row đúng mã
                      var code = (row.dataset.bookingCode || '').toLowerCase();
                      var show = code.indexOf(q) !== -1;
                      row.style.display = show ? '' : 'none';
                      if (show) visibleRows++;
                    }
                  });

                  // Tự mở accordion chứa row khớp
                  if (!matchesMeta && hasRowMatch) {
                    var panels = g.querySelectorAll('.tf-panel');
                    panels.forEach(function(panel) {
                      var panelRows = panel.querySelectorAll('tr[data-booking-code]');
                      var hasVisible = false;
                      panelRows.forEach(function(r) {
                        if (r.style.display !== 'none') hasVisible = true;
                      });
                      if (hasVisible && !panel.classList.contains('tf-panel--open')) {
                        panel.classList.add('tf-panel--open');
                        var btn = g.querySelector('[data-panel-id="' + panel.id + '"]');
                        if (btn) {
                          btn.classList.add('tf-toggle-btn--active');
                          btn.setAttribute('aria-expanded', 'true');
                          var icon = btn.querySelector('.tf-toggle-icon');
                          if (icon) icon.style.transform = 'rotate(180deg)';
                        }
                      }
                    });
                  }
                } else {
                  // Group bị ẩn → reset tất cả row về mặc định
                  rows.forEach(function(row) { row.style.display = ''; });
                }
              });

              var countEl = document.getElementById('thSearchCount');
              if (countEl) {
                if (!q) {
                  countEl.textContent = '';
                } else if (visibleRows > 0) {
                  countEl.textContent = 'Tìm thấy ' + visibleRows + ' phòng';
                } else {
                  countEl.textContent = 'Tìm thấy ' + visibleGroups + ' / ' + groups.length + ' nhóm';
                }
              }
              var clearBtn = document.querySelector('.th-search-bar__clear');
              if (clearBtn) clearBtn.style.display = q ? '' : 'none';
            }
            function clearTourHoldSearch() {
              var inp = document.getElementById('thSearchInput');
              if (inp) { inp.value = ''; inp.focus(); }
              filterTourHoldGroups('');
            }

            function toggleTfPanel(panelId, btn) {
              var panel = document.getElementById(panelId);
              if (!panel) return;
              var icon = btn.querySelector('.tf-toggle-icon');
              var isOpen = panel.classList.contains('tf-panel--open');
              if (isOpen) {
                panel.classList.remove('tf-panel--open');
                btn.classList.remove('tf-toggle-btn--active');
                btn.setAttribute('aria-expanded', 'false');
                if (icon) icon.style.transform = '';
              } else {
                panel.classList.add('tf-panel--open');
                btn.classList.add('tf-toggle-btn--active');
                btn.setAttribute('aria-expanded', 'true');
                if (icon) icon.style.transform = 'rotate(180deg)';
              }
            }
            // ── Status dropdown ──────────────────────────────────────────────────
            var _openStatusWrap = null;
            function toggleStatusDropdown(btn) {
              var wrap = btn.closest('.th-status-wrap');
              var dropdown = wrap ? wrap.querySelector('.th-status-dropdown') : null;
              if (!dropdown) return;
              var isOpen = dropdown.style.display !== 'none';
              // Đóng mọi dropdown đang mở
              document.querySelectorAll('.th-status-dropdown').forEach(function(d) { d.style.display = 'none'; });
              if (!isOpen) {
                dropdown.style.display = 'block';
                _openStatusWrap = wrap;
              } else {
                _openStatusWrap = null;
              }
            }
            document.addEventListener('click', function(e) {
              if (_openStatusWrap && !_openStatusWrap.contains(e.target)) {
                _openStatusWrap.querySelector('.th-status-dropdown').style.display = 'none';
                _openStatusWrap = null;
              }
            });
            function selectStatusOption(optionBtn) {
              var newStatus = optionBtn.dataset.status;
              var wrap = optionBtn.closest('.th-status-wrap');
              var statusBtn = wrap ? wrap.querySelector('.th-status-btn') : null;
              var bookingId = statusBtn ? statusBtn.dataset.bookingId : null;
              var currentStatus = statusBtn ? statusBtn.dataset.currentStatus : null;
              if (!bookingId || !newStatus || newStatus === currentStatus) {
                if (wrap) wrap.querySelector('.th-status-dropdown').style.display = 'none';
                return;
              }
              var labelMap = { confirmed: 'Chưa nhận phòng', checked_in: 'Đã nhận phòng', checked_out: 'Đã trả phòng' };
              var dd = wrap ? wrap.querySelector('.th-status-dropdown') : null;
              if (dd) dd.style.display = 'none';
              showHbConfirm({
                title: 'Xác nhận đổi trạng thái',
                message: 'Đổi trạng thái sang "' + (labelMap[newStatus] || newStatus) + '"?',
                confirmText: 'Xác nhận',
                cancelText: 'Huỷ',
              }).then(function(ok) {
                if (!ok) return;
                if (statusBtn) {
                  statusBtn.disabled = true;
                  statusBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
                }
                fetch('/!{pathAdmin}/hotel/booking/update-status', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ bookingId: bookingId, status: newStatus }),
                })
                  .then(function(r) { return r.json(); })
                  .then(function(data) {
                    if (data.code === 'success') {
                      location.reload();
                    } else {
                      alert('Lỗi: ' + (data.message || 'Không thể cập nhật trạng thái'));
                      if (statusBtn) statusBtn.disabled = false;
                      location.reload();
                    }
                  })
                  .catch(function() {
                    alert('Có lỗi kết nối, vui lòng thử lại.');
                    if (statusBtn) statusBtn.disabled = false;
                  });
              });
            }
            function releaseOneHold(btn) {
              var bookingId = btn.dataset.bookingId;
              if (!bookingId) return;
              showHbConfirm({
                title: 'Giải phóng phòng',
                message: 'Giải phóng phòng này? Phòng sẽ trở về trạng thái trống và có thể nhận đặt phòng thông thường.',
                confirmText: 'Giải phóng',
                cancelText: 'Huỷ',
              }).then(function(ok) {
                if (!ok) return;
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
                fetch('/!{pathAdmin}/hotel/booking/release-holds', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ bookingIds: [bookingId] }),
                })
                  .then(function(r) { return r.json(); })
                  .then(function(data) {
                    if (data.code === 'success') {
                      location.reload();
                    } else {
                      alert('Lỗi: ' + (data.message || 'Không thể giải phóng phòng'));
                      btn.disabled = false;
                      btn.innerHTML = '<i class="fa-solid fa-unlock"></i> Giải phóng';
                    }
                  })
                  .catch(function() {
                    alert('Có lỗi kết nối, vui lòng thử lại.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-unlock"></i> Giải phóng';
                  });
              });
            }
            function showReleasePanel(btn) {
              var panelId = btn.dataset.panelId;
              var panel = document.getElementById(panelId);
              if (panel) {
                panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
              }
            }
            function hideReleasePanel(segmentId) {
              var panel = document.getElementById('release-panel-' + segmentId);
              if (panel) panel.style.display = 'none';
            }
            function confirmRelease(btn) {
              var ids = (btn.dataset.bookingIds || '').split(',').filter(Boolean);
              if (!ids.length) return;
              btn.disabled = true;
              btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';
              fetch('/!{pathAdmin}/hotel/booking/release-holds', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ bookingIds: ids }),
              })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                  if (data.code === 'success') {
                    alert(data.message || 'Giải phóng phòng thành công!');
                    location.reload();
                  } else {
                    alert('Lỗi: ' + (data.message || 'Không thể giải phóng phòng'));
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-unlock"></i> Xác nhận giải phóng';
                  }
                })
                .catch(function() {
                  alert('Có lỗi kết nối, vui lòng thử lại.');
                  btn.disabled = false;
                  btn.innerHTML = '<i class="fa-solid fa-unlock"></i> Xác nhận giải phóng';
                });
            }

      //- Tab: Khách hàng
      else if bookingsData.activeTab === 'guest-list'
        .guest-list-page
          //- Header
          .page-header
            .header-left
              h1.page-title Danh sách khách hàng
