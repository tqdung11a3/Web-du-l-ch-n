    #changeRoomDetailModal .pending-detail-modal__footer { background: #eef1fb; border-top-color: #d8ddf0; }
    .reassign-room-modal .modal-header { background: linear-gradient(180deg, #2d3e90 0%, #243270 100%); border-bottom: none; }
    .reassign-room-modal .modal-header h3 { color: #fff; }
    .reassign-room-modal .modal-close { color: rgba(255,255,255,.9); }
    .reassign-room-modal .modal-close:hover { background: rgba(255,255,255,.15); color: #fff; }
    .reassign-room-modal .booking-summary { background: #eef1fb; border: 1px solid #d8ddf0; }
    .reassign-room-modal .booking-summary strong { color: #2d3e90; }
