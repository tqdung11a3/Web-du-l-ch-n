                                ) Tháng #{m}

          //- Calendar Grid
          .calendar-grid-wrapper
            .calendar-grid
              //- Header row với dates
              .calendar-header
                .room-header Phòng
                .dates-header
                  //- Render dates động dựa trên tháng/năm
                  - const year = bookingsData.currentYear || new Date().getFullYear()
                  - const month = bookingsData.currentMonthNum || (new Date().getMonth() + 1)
                  - const daysInMonth = moment(`${year}-${month}`, "YYYY-M").daysInMonth()
                  - const firstDayOfMonth = moment(`${year}-${month}-01`, "YYYY-M-DD").day()
                  - const dayNames = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7']
                  - const today = moment()
                  - const currentMonthMoment = moment(`${year}-${month}`, "YYYY-M")
                  
                  //- Render các ngày trong tháng
                  - for (let day = 1; day <= daysInMonth; day++)
                    - const dateMoment = moment(`${year}-${month}-${day}`, "YYYY-M-DD")
                    - const dayName = dayNames[dateMoment.day()]
                    .date-cell
                      = dayName + ' ' + day
              
              //- Room rows (booking khách hàng thật)
              if bookingsData.rooms && bookingsData.rooms.length > 0
                each room in bookingsData.rooms
                  .calendar-row
