        i.fa-solid.fa-xmark
      .booking-info-popup__body

    //- Xác nhận (thay window.confirm) — Giữ phòng Tour & thao tác liên quan
    #th-app-dialog.th-app-dialog(aria-hidden="true")
      .th-app-dialog__backdrop
      .th-app-dialog__panel(role="dialog" aria-modal="true" aria-labelledby="th-app-dialog-title")
        .th-app-dialog__header
          h3#th-app-dialog-title.th-app-dialog__title Xác nhận
          button#th-app-dialog-close.th-app-dialog__close(type="button" aria-label="Đóng")
            i.fa-solid.fa-xmark
        #th-app-dialog-body.th-app-dialog__body
        .th-app-dialog__footer
          button#th-app-dialog-cancel.th-app-dialog__btn.th-app-dialog__btn--secondary(type="button") Huỷ
          button#th-app-dialog-ok.th-app-dialog__btn.th-app-dialog__btn--primary(type="button") Tiếp tục

    script.
      function showHbConfirm(opts) {
        opts = opts || {};
        var message = opts.message || '';
        var title = opts.title || 'Xác nhận';
        var confirmText = opts.confirmText || 'Tiếp tục';
        var cancelText = opts.cancelText || 'Huỷ';
        var wrap = document.getElementById('th-app-dialog');
        if (!wrap) return Promise.resolve(window.confirm(message));

        return new Promise(function (resolve) {
          var titleEl = document.getElementById('th-app-dialog-title');
          var bodyEl = document.getElementById('th-app-dialog-body');
          var okBtn = document.getElementById('th-app-dialog-ok');
          var cancelBtn = document.getElementById('th-app-dialog-cancel');
          var closeBtn = document.getElementById('th-app-dialog-close');
          var backdrop = wrap.querySelector('.th-app-dialog__backdrop');
          if (!titleEl || !bodyEl || !okBtn || !cancelBtn || !closeBtn || !backdrop) {
            resolve(window.confirm(message));
            return;
          }

          titleEl.textContent = title;
          bodyEl.textContent = message;
          okBtn.textContent = confirmText;
          cancelBtn.textContent = cancelText;

          var settled = false;
          function finish(val) {
            if (settled) return;
            settled = true;
            wrap.classList.remove('is-open');
            wrap.setAttribute('aria-hidden', 'true');
            document.removeEventListener('keydown', onKey);
            okBtn.removeEventListener('click', onOk);
            cancelBtn.removeEventListener('click', onCancel);
            closeBtn.removeEventListener('click', onCancel);
            backdrop.removeEventListener('click', onCancel);
            resolve(val);
          }
          function onOk() { finish(true); }
          function onCancel() { finish(false); }
          function onKey(ev) { if (ev.key === 'Escape') onCancel(); }

          okBtn.addEventListener('click', onOk);
          cancelBtn.addEventListener('click', onCancel);
          closeBtn.addEventListener('click', onCancel);
          backdrop.addEventListener('click', onCancel);
          document.addEventListener('keydown', onKey);

          wrap.classList.add('is-open');
          wrap.setAttribute('aria-hidden', 'false');
          okBtn.focus();
        });
      }

    //- JavaScript cho calendar navigation
    - const defaultYear = bookingsData.currentYear || new Date().getFullYear()
    - const defaultMonth = bookingsData.currentMonthNum || (new Date().getMonth() + 1)
    script.
      var OWN_COMPANY_NAME = "!{ownCompanyName || ''}";
    script.
      // ── Popup thông tin booking khi bấm vào thanh lịch ──────────────────────
      function showBookingPopup(e, bar) {
        e.stopPropagation();
        var popup = document.getElementById('booking-info-popup');
        if (!popup) return;

        var isTour          = bar.dataset.isTour === '1';
        var isAssigned      = bar.dataset.isAssigned === '1';
        var guest           = bar.dataset.guest || '';
        var tourName        = bar.dataset.tourName || '';
        var tourCode        = bar.dataset.tourCode || '';
        var phone           = bar.dataset.phone || '';
        var checkIn         = bar.dataset.checkIn || '';
        var checkOut        = bar.dataset.checkOut || '';
        var code            = bar.dataset.code || '';
        var status          = bar.dataset.status || '';
        var isOwnCompany    = bar.dataset.isOwnCompany !== '0';
        var tourCompanyName = bar.dataset.tourCompanyName || '';

        var rows = '';

        if (isTour) {
          rows += '<div class="bip-row bip-row--tour"><i class="fa-solid fa-link"></i><div><span class="bip-label">Tour</span><span class="bip-value">' + (tourName || tourCode || 'Tour hold') + (tourCode ? ' <span class="bip-code">(' + tourCode + ')</span>' : '') + '</span></div></div>';
          if (isOwnCompany) {
            var ownLabel = OWN_COMPANY_NAME ? OWN_COMPANY_NAME + ' (Công ty mình)' : 'Công ty mình';
            rows += '<div class="bip-row bip-row--company-own"><i class="fa-solid fa-building"></i><div><span class="bip-label">Công ty</span><span class="bip-value bip-company--own">' + ownLabel + '</span></div></div>';
          } else {
            rows += '<div class="bip-row bip-row--company-cross"><i class="fa-solid fa-handshake"></i><div><span class="bip-label">Công ty</span><span class="bip-value bip-company--cross">' + (tourCompanyName || 'Công ty khác') + '</span></div></div>';
          }
          if (isAssigned && guest && guest !== 'N/A') {
            rows += '<div class="bip-row"><i class="fa-solid fa-user"></i><div><span class="bip-label">Khách</span><span class="bip-value bip-value--name">' + guest + '</span></div></div>';
          }
          if (phone) {
            rows += '<div class="bip-row"><i class="fa-solid fa-phone"></i><div><span class="bip-label">SĐT</span><span class="bip-value">' + phone + '</span></div></div>';
          }
          if (!isAssigned) {
            rows += '<div class="bip-row bip-row--muted"><i class="fa-solid fa-hourglass-half"></i><div><span class="bip-value">Chưa gán khách</span></div></div>';
          } else if (status === 'checked_in') {
            rows += '<div class="bip-row bip-row--checkedin"><i class="fa-solid fa-door-open"></i><div><span class="bip-value bip-status--checkedin">Đã nhận phòng</span></div></div>';
          } else if (status === 'checked_out') {
            rows += '<div class="bip-row bip-row--checkedout"><i class="fa-solid fa-circle-check"></i><div><span class="bip-value bip-status--checkedout">Đã trả phòng</span></div></div>';
          } else {
            rows += '<div class="bip-row bip-row--waiting"><i class="fa-solid fa-clock"></i><div><span class="bip-value bip-status--waiting">Chờ nhận phòng</span></div></div>';
          }
        } else {
          if (guest && guest !== 'N/A') {
            rows += '<div class="bip-row"><i class="fa-solid fa-user"></i><div><span class="bip-label">Khách</span><span class="bip-value bip-value--name">' + guest + '</span></div></div>';
          }
          if (phone) {
            rows += '<div class="bip-row"><i class="fa-solid fa-phone"></i><div><span class="bip-label">SĐT</span><span class="bip-value">' + phone + '</span></div></div>';
          }
          rows += '<div class="bip-row"><i class="fa-solid fa-hashtag"></i><div><span class="bip-label">Mã</span><span class="bip-value bip-code">' + code + '</span></div></div>';
        }

        if (checkIn || checkOut) {
          rows += '<div class="bip-row"><i class="fa-solid fa-calendar-days"></i><div><span class="bip-label">Ngày</span><span class="bip-value">' + checkIn + ' → ' + checkOut + '</span></div></div>';
        }

        popup.querySelector('.booking-info-popup__body').innerHTML = rows;

        // Định vị popup gần vị trí bấm, tránh ra ngoài màn hình
        popup.style.display = 'block';
        var pw = popup.offsetWidth  || 240;
        var ph = popup.offsetHeight || 160;
        var vw = window.innerWidth;
        var vh = window.innerHeight;
        var x  = e.clientX + 12;
        var y  = e.clientY + 12;
        if (x + pw > vw - 10) x = e.clientX - pw - 12;
        if (y + ph > vh - 10) y = e.clientY - ph - 12;
        popup.style.left = Math.max(8, x) + 'px';
        popup.style.top  = Math.max(8, y) + 'px';
      }

      function closeBookingPopup() {
        var popup = document.getElementById('booking-info-popup');
        if (popup) popup.style.display = 'none';
      }

      document.addEventListener('click', function(e) {
        if (!e.target.closest('.booking-bar') && !e.target.closest('#booking-info-popup')) {
          closeBookingPopup();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeBookingPopup();
      });

      // ── Calendar navigation + bảng chọn tháng/năm ───────────────────────────
      document.addEventListener('DOMContentLoaded', function() {
        const prevBtn = document.querySelector('.booking-calendar-page .prev-btn');
        const nextBtn = document.querySelector('.booking-calendar-page .next-btn');
        const pickerWrap = document.querySelector('.booking-calendar-page .calendar-picker-wrap');
        const picker = document.getElementById('calendarMonthPicker');
        const pickerToggle = document.querySelector('.booking-calendar-page .calendar-picker-toggle');
        const pickerClose = document.querySelector('.booking-calendar-page .calendar-month-picker__close');
        const yearSel = document.getElementById('calendarPickerYear');

        if (!pickerWrap || !picker) return;

        const urlParams = new URLSearchParams(window.location.search);
        let currentYear = parseInt(urlParams.get('year')) || #{defaultYear};
        let currentMonth = parseInt(urlParams.get('month')) || #{defaultMonth};
        const currentHotelId = urlParams.get('hotelId') || '';

        function goCalendar(y, m) {
          const newUrl = `/${pathAdmin}/hotel/booking/calendar?year=${y}&month=${m}&hotelId=${encodeURIComponent(currentHotelId)}`;
          window.location.href = newUrl;
        }

        function syncPickerYearSelect() {
          if (!yearSel) return;
          const y = String(currentYear);
          let opt = yearSel.querySelector('option[value="' + y + '"]');
          if (!opt) {
            opt = document.createElement('option');
            opt.value = y;
            opt.textContent = y;
            yearSel.appendChild(opt);
          }
          yearSel.value = y;
        }

        function setPickerOpen(open) {
          picker.style.display = open ? 'block' : 'none';
          if (pickerToggle) pickerToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }

        function togglePicker() {
          const isOpen = picker.style.display === 'block';
          if (isOpen) setPickerOpen(false);
          else {
            syncPickerYearSelect();
            setPickerOpen(true);
          }
        }

        if (pickerToggle) pickerToggle.addEventListener('click', function (e) {
          e.stopPropagation();
          togglePicker();
        });
        if (pickerClose) pickerClose.addEventListener('click', function () { setPickerOpen(false); });

        document.addEventListener('click', function (e) {
          if (!pickerWrap.contains(e.target)) setPickerOpen(false);
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && picker && picker.style.display === 'block') setPickerOpen(false);
        });

        picker.querySelectorAll('.calendar-month-picker__cell').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const m = parseInt(btn.getAttribute('data-month'), 10);
            const y = yearSel ? parseInt(yearSel.value, 10) : currentYear;
            if (!m || m < 1 || m > 12 || !y) return;
            goCalendar(y, m);
          });
        });

        if (prevBtn && nextBtn) {
          prevBtn.addEventListener('click', function() {
            let newYear = currentYear;
            let newMonth = currentMonth - 1;
            if (newMonth < 1) { newMonth = 12; newYear = currentYear - 1; }
            goCalendar(newYear, newMonth);
          });
          nextBtn.addEventListener('click', function() {
            let newYear = currentYear;
            let newMonth = currentMonth + 1;
            if (newMonth > 12) { newMonth = 1; newYear = currentYear + 1; }
            goCalendar(newYear, newMonth);
          });
        }
      });

  //- Modal chi tiết booking
  script.
    function openPendingDetailModal(btn) {
      var groupCode = btn.dataset.groupCode;
      var modal     = document.getElementById('pendingDetailModal');

      // Cập nhật tiêu đề modal
      document.getElementById('pendingDetailModalTitle').textContent    = btn.dataset.groupTitle    || groupCode;
      document.getElementById('pendingDetailModalSubtitle').textContent = btn.dataset.groupSubtitle || '';

      // Ẩn tất cả nội dung, chỉ hiện đúng nhóm được chọn
      document.querySelectorAll('.pending-detail-content').forEach(function (el) {
        el.style.display = 'none';
      });
      var content = document.getElementById('pending-detail-' + groupCode);
      if (content) content.style.display = 'flex';

      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closePendingDetailModal() {
      var modal = document.getElementById('pendingDetailModal');
      if (modal) modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closePendingDetailModal();
    });

