//- views/admin/pages/hotel-room-edit.pug
extends ../layouts/default.pug

block main
  .room-individual-edit-page
    .page-header
      h1.page-title Chỉnh sửa phòng
      p.page-subtitle Chỉnh sửa thông tin phòng #{room.roomNumber}

    .section-8
      form(id="hotel-room-edit-form")
        input(type="hidden" name="hotelId" value=hotelId)
        input(type="hidden" name="roomId" value=room._id)

        .inner-group
          label(for="roomNumber" class="inner-label") Số phòng *
          input#roomNumber(
            type="text"
            name="roomNumber"
            value=room.roomNumber
            placeholder="VD: 101, 201, 301..."
            required
          )

        .inner-group
          label(for="floor" class="inner-label") Tầng *
          input#floor(
            type="text"
            name="floor"
            value=room.floor
            placeholder="VD: Tầng 1, Tầng 2..."
            required
          )

        .inner-group
          label(for="roomType" class="inner-label") Loại phòng *
          select#roomType(name="roomTypeId" required)
            option(value="") -- Chọn loại phòng --
            if roomTypes && roomTypes.length > 0
              each rt in roomTypes
                option(value=rt._id selected=(String(rt._id) === String(room.roomTypeId)))= rt.name

        .inner-group
          label(for="status" class="inner-label") Trạng thái *
          select#status(name="status" required)
            option(value="vacant" selected=(room.status === 'vacant')) Trống
            option(value="occupied" selected=(room.status === 'occupied')) Đang sử dụng
            option(value="cleaning" selected=(room.status === 'cleaning')) Đang dọn
            option(value="out_of_service" selected=(room.status === 'out_of_service')) Ngừng hoạt động

        .inner-button.inner-two-col
          button(type="submit") Lưu phòng
          a.btn-secondary(href=`/${pathAdmin}/hotel/${hotelId}/rooms/list`) Hủy

  script.
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('hotel-room-edit-form');
      const hotelId = '#{hotelId}';
      const roomId = '#{room._id}';

      if (form) {
        form.addEventListener('submit', async function(e) {
          e.preventDefault();

          const formData = new FormData(form);
          const data = Object.fromEntries(formData);

          try {
            const response = await fetch(`/${pathAdmin}/hotel/${hotelId}/rooms/${roomId}/edit`, {
              method: 'PATCH',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(data)
            });

            const result = await response.json();

            if (result.code === 'success') {
              notify.success(result.message);
              setTimeout(() => {
                window.location.href = `/${pathAdmin}/hotel/${hotelId}/rooms/list`;
              }, 1000);
            } else {
              notify.error(result.message || 'Có lỗi xảy ra!');
            }
          } catch (error) {
            console.error('Error submitting form:', error);
            notify.error('Có lỗi xảy ra khi lưu thông tin!');
          }
        });
      }
    });
