extends ../layouts/default.pug

block main
  h1.box-title Phân công phòng khách sạn cho khách tour

  //- ── Breadcrumb ────────────────────────────────────────────────────────────
  .th-breadcrumb
    a(href=`/${pathAdmin}/tour-hotel/list`)
      i.fa-solid.fa-arrow-left
      |  Danh sách tour
    span.th-sep  /
    a(href=`/${pathAdmin}/tour-hotel/detail/${tourSeg.tourId}?departure=${moment(tourSeg.departureDate).format('YYYY-MM-DD')}`)
      = tour ? tour.name : 'Tour'
    span.th-sep  /
    span Phân công phòng

  if readOnly
    .assign-readonly-banner(style="margin:12px 0;padding:12px 14px;background:#fef3c7;border:1px solid #fcd34d;border-radius:8px;color:#92400e;display:flex;align-items:center;gap:8px;")
      i.fa-solid.fa-circle-info
      span Khách sạn đã tiếp nhận việc phân phòng cho tour. Trang này chỉ dùng để xem kết quả.

  //- ── Thông tin chuyến ──────────────────────────────────────────────────────
  .assign-info-bar
    .assign-info-bar__item
      i.fa-solid.fa-map-route
      span= tour ? tour.name : 'Tour'
    .assign-info-bar__item
      i.fa-solid.fa-calendar-day
      span  Khởi hành: #{departureDateDisplay}
    .assign-info-bar__item
      i.fa-solid.fa-calendar-check
      span  Kết thúc: #{moment(tourSeg.endDate).format('DD/MM/YYYY')}
    .assign-info-bar__item
      i.fa-solid.fa-users
      span  Cần bố trí: #{tourSeg.paxRequired} người

  //- ── Danh sách khách hàng ────────────────────────────────────────────────
  .assign-customer-list-section
    h2.assign-col__title
      i.fa-solid.fa-list-check
      |  Khách hàng đã đặt (#{customers.length} đơn)

    if customers.length === 0
      .assign-empty
        i.fa-solid.fa-circle-info
        |  Chưa có đơn hàng thanh toán nào cho lịch khởi hành này.
    else
      .assign-cust-table-wrap
        table.assign-cust-table
          thead
            tr
              th STT
              th Khách hàng
              th Số điện thoại
              th Mã đơn hàng
              th Số người
              th Trạng thái gán phòng
              th Thao tác
          tbody
            each cust, idx in customers
              tr
                td= idx + 1
                td
                  .assign-cust-table__name
                    i.fa-solid.fa-user
                    |  #{cust.guestName || 'Khách'}
                td= cust.phone || '—'
                td
                  span.assign-cust-table__code= '#' + cust.orderCode
                td
                  span.assign-pax-badge.assign-pax-badge--adult
                    | #{cust.quantityAdult} NL
                  if cust.quantityChildren > 0
                    |  
                    span.assign-pax-badge.assign-pax-badge--child
                      | #{cust.quantityChildren} TE
                  if cust.quantityBaby > 0
                    |  
                    span.assign-pax-badge.assign-pax-badge--baby
                      | #{cust.quantityBaby} EB
                td
                  if cust.assignStatus === 'complete'
                    span.assign-status-badge.assign-status-badge--complete
                      i.fa-solid.fa-circle-check
                      |  Đã gán đủ
                  else if cust.assignStatus === 'excess'
                    span.assign-status-badge.assign-status-badge--excess
                      i.fa-solid.fa-layer-group
                      |  Gán dư phòng
                  else if cust.assignStatus === 'partial'
                    span.assign-status-badge.assign-status-badge--partial
                      i.fa-solid.fa-clock
                      |  Gán chưa đủ (#{cust.assignedCount} phòng)
                  else
                    span.assign-status-badge.assign-status-badge--none
                      i.fa-solid.fa-triangle-exclamation
                      |  Chưa gán phòng
                td
                  a.btn-assign-detail(href=`/${pathAdmin}/tour-hotel/assign/${tourSeg._id}?orderId=${cust.orderId}`)
                    i.fa-solid.fa-eye
                    |  Xem chi tiết
