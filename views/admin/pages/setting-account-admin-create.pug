extends ../layouts/default.pug

block main
  
  h1.box-title Tạo tài khoản quản trị

  //- Section 8
  .section-8
    form(id="setting-account-admin-create-form")
      .inner-group
        label(for="fullName" class="inner-label") Họ tên
        input(type="text" id="fullName" name="fullName")
      .inner-group
        label(for="email" class="inner-label") Email
        input(type="email" id="email" name="email")
      .inner-group
        label(for="phone" class="inner-label") Số điện thoại
        input(type="text" id="phone" name="phone")
      //- Tạm ẩn khối Nhóm quyền
      //- .inner-group
      //-   label(for="role" class="inner-label") Nhóm quyền
      //-   select(id="role" name="role")
      //-     each item in roleList
      //-       option(value=item.id) #{item.name}
      .inner-group
        label(for="tabAccessScope" class="inner-label") Phân quyền
        - var _defScope = typeof tabAccessScopeDefault !== "undefined" ? tabAccessScopeDefault : "inherit"
        select#tabAccessScope(name="tabAccessScope")
          each opt in tabAccessScopeOptions
            option(value=opt.value selected=(opt.value === _defScope)) #{opt.label}
      .inner-group#account-admin-assigned-hotel-wrap(style="display: none;")
        label(for="assignedHotelId" class="inner-label") Khách sạn được phân công
        select#assignedHotelId(name="assignedHotelId")
          option(value="") -- Chọn khách sạn --
          each h in (companyHotels || [])
            option(value=h._id) #{h.name}
        if !(companyHotels && companyHotels.length)
          p.inner-note(style="margin-top:6px;font-size:13px;opacity:0.85;") Chưa có khách sạn nào trong công ty. Hãy tạo khách sạn trước khi gán nhân viên.
      .inner-group
        label(for="positionCompany" class="inner-label") Chức vụ
        input(type="text" id="positionCompany" name="positionCompany")
      .inner-group
        label(for="status" class="inner-label") Trạng thái
        select(id="status" name="status")
          option(value="initial") Khởi tạo
          option(value="active") Hoạt động
          option(value="inactive") Tạm dừng
      .inner-group
        label(for="password" class="inner-label") Mật khẩu
        input(type="text" id="password" name="password")
      .inner-group.inner-two-col
        label(for="avatar" class="inner-label") Ảnh đại diện
        .inner-upload-image
          input(
            type="file" 
            id="avatar"
            name="avatar"
            filepond-image
            )
      .inner-button.inner-two-col
        button Tạo mới
    .inner-back
      a(href=`/${pathAdmin}/setting/account-admin/list`) Quay lại danh sách
  //- End Section 8