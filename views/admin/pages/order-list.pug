extends ../layouts/default.pug

block main
  
  h1.box-title Quản lý đơn hàng

  //- Section 4
  .section-4
    .inner-wrap
      .inner-item
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item
        select
          option(value="") Trạng thái
          option(value="") Hoạt động
          option(value="") Tạm dừng
      .inner-item
        input(type="date")
        span -
        input(type="date")
      .inner-item
        select
          option(value="") Phương thức thanh toán
          option(value="") Tiền mặt
          option(value="") ZaloPay
          option(value="") VNPay
          option(value="") Chuyển khoản
      .inner-item
        select
          option(value="") Trạng thái thanh toán
          option(value="") Chưa thanh toán
          option(value="") Đã thanh toán
      .inner-item.inner-reset
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5
  .section-5
    .inner-wrap
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm")
  //- End Section 5

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th Mã
            th Thông tin khách
            th Danh sách tour
            th Thanh toán
            th Trạng thái
            th.inner-center Ngày đặt
            th Hành động
        tbody
          each orderDetail in orderList
            tr
              td
                .inner-code #{orderDetail.code}
              td
                div Họ tên: #{orderDetail.fullName}
                div SĐT: #{orderDetail.phone}
                div Ghi chú: #{orderDetail.note}
              td
                .inner-list
                  each item in orderDetail.items
                    .inner-item
                      .inner-image
                        img(src=item.avatar, alt="")
                      .inner-info
                        .inner-name #{item.name}
                        .inner-quantity
                          div Người lớn: #{item.quantityAdult} x #{item.priceNewAdult.toLocaleString("vi-VN")}đ
                          div Trẻ em: #{item.quantityChildren} x #{item.priceNewChildren.toLocaleString("vi-VN")}đ
                          div Em bé: #{item.quantityBaby} x #{item.babyUnitForUi.toLocaleString("vi-VN")}đ
              td
                div Tạm tính: #{orderDetail.subTotalView.toLocaleString("vi-VN")}đ
                div Giảm: #{orderDetail.discountView.toLocaleString("vi-VN")}đ
                //- div Mã giảm: TOURMUAHE2024
                div Thanh toán: #{orderDetail.totalView.toLocaleString("vi-VN")}đ
                div PTTT: #{orderDetail.paymentMethodName}
                div TTTT: #{orderDetail.paymentStatusName}
              td
                - const statusBadgeClass = `badge badge-${orderDetail.statusInfo.color}`
                div(class=statusBadgeClass) #{orderDetail.statusInfo.label}
                //- .badge.badge-green Đã duyệt
                //- .badge.badge-red Đã hủy
              td.inner-center
                div #{orderDetail.createdAtTime}
                div #{orderDetail.createdAtDate}
              td
                .inner-buttons
                  a(href=`/${pathAdmin}/order/edit/${orderDetail._id}` class="inner-edit")
                    <i class="fa-regular fa-pen-to-square"></i>
                  button(class="inner-delete" data-order-id=orderDetail._id type="button")
                    <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  .section-7
    span.inner-label Hiển thị 1 - 9 của 78
    select(class="inner-pagination")
      option(value="") Trang 1
      option(value="") Trang 2
      option(value="") Trang 3
  //- End Section 7

  script.
    // Xử lý xóa đơn hàng
    document.addEventListener('DOMContentLoaded', function() {
      const deleteButtons = document.querySelectorAll('.inner-delete');
      
      deleteButtons.forEach(button => {
        button.addEventListener('click', function() {
          const orderId = this.getAttribute('data-order-id');
          
          if (!orderId) {
            alert('Không tìm thấy ID đơn hàng!');
            return;
          }
          
          if (!confirm('Bạn có chắc chắn muốn xóa đơn hàng này? Hành động này không thể hoàn tác!')) {
            return;
          }
          
          fetch(`/${pathAdmin}/order/delete/${orderId}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
            },
          })
          .then(res => res.json())
          .then(data => {
            if (data.code === 'success') {
              alert(data.message);
              location.reload();
            } else {
              alert(data.message || 'Có lỗi xảy ra khi xóa đơn hàng!');
            }
          })
          .catch(error => {
            console.error('Error deleting order:', error);
            alert('Có lỗi xảy ra khi xóa đơn hàng!');
          });
        });
      });
    });