extends ../layouts/default.pug

block main
  - var _saOrdersCtx = typeof companyContext !== 'undefined' && companyContext && companyContext._id

  if _saOrdersCtx
    .box-head
      a.button.button-outline(
        href=`/${pathAdmin}/super-admin/orders/company/${companyContext._id}`
        style="margin-bottom:12px;display:inline-flex;align-items:center;gap:8px;"
      )
        i.fa-solid.fa-arrow-left
        |  Chọn loại đơn
      h1.box-title(style="margin-top:0")= pageTitle || ('Đơn tour — ' + companyContext.name)
  else
    h1.box-title Quản lý đơn hàng

  //- Section 4
  .section-4
    .inner-wrap
      .inner-item
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item
        select
          option(value="") Trạng thái
          option(value="") Hoạt động
          option(value="") Tạm dừng
      .inner-item
        input(type="date")
        span -
        input(type="date")
      .inner-item
        select
          option(value="") Phương thức thanh toán
          option(value="") Tiền mặt
          option(value="") ZaloPay
          option(value="") VNPay
          option(value="") Chuyển khoản
      .inner-item
        select
          option(value="") Trạng thái thanh toán
          option(value="") Chưa thanh toán
          option(value="") Đã thanh toán
      .inner-item.inner-reset
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5
  .section-5
    .inner-wrap
      form.inner-search.order-search-form(method="GET" action=_saOrdersCtx ? `/${pathAdmin}/super-admin/orders/company/${companyContext._id}/tours` : `/${pathAdmin}/order/list`)
        .order-search-fields
          .order-search-field
            i.fa-solid.fa-hashtag
            input(
              type="text"
              name="keyword"
              placeholder="Mã đơn hàng..."
              value=keyword || ""
              autocomplete="off"
            )
          .order-search-field
            i.fa-solid.fa-user
            input(
              type="text"
              name="searchName"
              placeholder="Tên khách hàng..."
              value=searchName || ""
              autocomplete="off"
            )
          .order-search-field
            i.fa-solid.fa-phone
            input(
              type="text"
              name="searchPhone"
              placeholder="Số điện thoại..."
              value=searchPhone || ""
              autocomplete="off"
            )
          .order-search-field
            i.fa-solid.fa-map-location-dot
            input(
              type="text"
              name="searchTour"
              placeholder="Tên tour du lịch..."
              value=searchTour || ""
              autocomplete="off"
            )
          button.order-search-btn(type="submit")
            i.fa-solid.fa-magnifying-glass
            |  Tìm kiếm
          - const hasSearch = keyword || searchName || searchPhone || searchTour
          if hasSearch
            a.order-search-clear(href=_saOrdersCtx ? `/${pathAdmin}/super-admin/orders/company/${companyContext._id}/tours` : `/${pathAdmin}/order/list` title="Xoá tìm kiếm")
              i.fa-solid.fa-xmark
              |  Xoá
  //- End Section 5

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th Mã
            th Thông tin khách
            th Danh sách tour
            th Thanh toán
            th Trạng thái
            th.inner-center Ngày đặt
            th Hành động
        tbody
          each orderDetail in orderList
            tr
              td
                .inner-code #{orderDetail.code}
              td
                div Họ tên: #{orderDetail.fullName}
                div SĐT: #{orderDetail.phone}
                div Ghi chú: #{orderDetail.note}
              td
                .inner-list
                  each item in orderDetail.items
                    .inner-item
                      .inner-image
                        img(src=item.avatar, alt="")
                      .inner-info
                        .inner-name #{item.name}
                        if item.departureDateDisplay
                          .inner-departure
                            i.fa-solid.fa-calendar-day
                            |  #{item.departureDateDisplay}
                        .inner-quantity
                          div Người lớn: #{item.quantityAdult} x #{item.priceNewAdult.toLocaleString("vi-VN")}đ
                          div Trẻ em: #{item.quantityChildren} x #{item.priceNewChildren.toLocaleString("vi-VN")}đ
                          div Em bé: #{item.quantityBaby} x #{item.babyUnitForUi.toLocaleString("vi-VN")}đ
              td
                div Tạm tính: #{orderDetail.subTotalView.toLocaleString("vi-VN")}đ
                div Giảm: #{orderDetail.discountView.toLocaleString("vi-VN")}đ
                //- div Mã giảm: TOURMUAHE2024
                div Thanh toán: #{orderDetail.totalView.toLocaleString("vi-VN")}đ
                div PTTT: #{orderDetail.paymentMethodName}
                div TTTT: #{orderDetail.paymentStatusName}
              td
                - const statusBadgeClass = `badge badge-${orderDetail.statusInfo.color}`
                div(class=statusBadgeClass) #{orderDetail.statusInfo.label}
                //- .badge.badge-green Đã duyệt
                //- .badge.badge-red Đã hủy
              td.inner-center
                div #{orderDetail.createdAtTime}
                div #{orderDetail.createdAtDate}
              td
                .inner-buttons
                  if _saOrdersCtx
                    a.inner-btn.inner-btn-view(href=`/${pathAdmin}/super-admin/orders/company/${companyContext._id}/tour/${orderDetail._id}` title="Xem chi tiết")
                      i.fa-solid.fa-eye
                  else
                    a(href=`/${pathAdmin}/order/edit/${orderDetail._id}` class="inner-edit")
                      i.fa-regular.fa-pen-to-square
                    button(class="inner-delete" data-order-id=orderDetail._id type="button")
                      i.fa-regular.fa-trash-can
  //- End Section 6

  //- Section 7
  if pagination && pagination.totalPage > 1
    .section-7
      span.inner-label
        | Hiển thị #{pagination.skip + 1}
        | - #{pagination.skip + orderList.length}
        | của #{pagination.totalRecord}
      select(class="inner-pagination" box-pagination)
        - for (let i = 1; i <= pagination.totalPage; i++)
          option(value=i selected=(i === pagination.currentPage)) Trang #{i}
  //- End Section 7

  //- Delete order modal
  .order-delete-modal-backdrop#order-delete-modal-backdrop(style="display:none")
    .order-delete-modal
      .order-delete-modal__header
        span.order-delete-modal__title Xóa đơn hàng
      .order-delete-modal__body
        p Bạn có chắc chắn muốn xóa đơn hàng này? Hành động này không thể hoàn tác.
      .order-delete-modal__footer
        button.order-delete-modal__btn.order-delete-modal__btn-cancel(type="button") Hủy
        button.order-delete-modal__btn.order-delete-modal__btn-confirm(type="button") Xóa đơn

  script.
    // Xử lý xóa đơn hàng với modal confirm (không dùng window.confirm)
    document.addEventListener('DOMContentLoaded', function() {
      var deleteButtons = document.querySelectorAll('.inner-delete:not([disabled])');
      var backdrop = document.getElementById('order-delete-modal-backdrop');
      var btnCancel = backdrop ? backdrop.querySelector('.order-delete-modal__btn-cancel') : null;
      var btnConfirm = backdrop ? backdrop.querySelector('.order-delete-modal__btn-confirm') : null;
      var currentDeleteId = null;

      function orderListNotyf() {
        if (typeof Notyf === 'undefined') return null;
        return new Notyf({ duration: 3000, position: { x: 'right', y: 'top' } });
      }

      function openDeleteModal(orderId) {
        currentDeleteId = orderId || null;
        if (!backdrop) return;
        backdrop.style.display = 'flex';
      }

      function closeDeleteModal() {
        currentDeleteId = null;
        if (!backdrop) return;
        backdrop.style.display = 'none';
      }

      deleteButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          var orderId = this.getAttribute('data-order-id');
          if (!orderId) {
            var nf0 = orderListNotyf();
            if (nf0) nf0.error('Không tìm thấy ID đơn hàng!');
            else alert('Không tìm thấy ID đơn hàng!');
            return;
          }
          openDeleteModal(orderId);
        });
      });

      if (btnCancel) {
        btnCancel.addEventListener('click', function() {
          closeDeleteModal();
        });
      }

      if (btnConfirm) {
        btnConfirm.addEventListener('click', function() {
          if (!currentDeleteId) {
            closeDeleteModal();
            return;
          }

          fetch(`/${pathAdmin}/order/delete/${currentDeleteId}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
            },
          })
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (data.code === 'success') {
                var nf = orderListNotyf();
                var msg = data.message || 'Đã xóa đơn hàng thành công!';
                if (nf) {
                  nf.success(msg);
                  setTimeout(function() { window.location.reload(); }, 600);
                } else {
                  alert(msg);
                  window.location.reload();
                }
              } else {
                var nfErr = orderListNotyf();
                if (nfErr) nfErr.error(data.message || 'Có lỗi xảy ra khi xóa đơn hàng!');
                else alert(data.message || 'Có lỗi xảy ra khi xóa đơn hàng!');
              }
            })
            .catch(function(error) {
              console.error('Error deleting order:', error);
              var nfCatch = orderListNotyf();
              if (nfCatch) nfCatch.error('Có lỗi xảy ra khi xóa đơn hàng!');
              else alert('Có lỗi xảy ra khi xóa đơn hàng!');
            })
            .finally(function() {
              closeDeleteModal();
            });
        });
      }
    });

  style.
    .order-delete-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1500;
    }
    .order-delete-modal {
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.25);
      padding: 16px 18px 14px;
      width: 360px;
      max-width: calc(100% - 32px);
      font-size: 13px;
      color: #0f172a;
    }
    .order-delete-modal__header {
      font-weight: 600;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
    }
    .order-delete-modal__title {
      font-size: 14px;
    }
    .order-delete-modal__body {
      margin-bottom: 12px;
      color: #4b5563;
      line-height: 1.5;
    }
    .order-delete-modal__footer {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }
    .order-delete-modal__btn {
      border-radius: 999px;
      padding: 5px 14px;
      font-size: 12.5px;
      border: 1px solid transparent;
      cursor: pointer;
    }
    .order-delete-modal__btn-cancel {
      background: #f3f4f6;
      color: #374151;
      border-color: #e5e7eb;
    }
    .order-delete-modal__btn-cancel:hover {
      background: #e5e7eb;
    }
    .order-delete-modal__btn-confirm {
      background: #dc2626;
      color: #fff;
      border-color: #b91c1c;
    }
    .order-delete-modal__btn-confirm:hover {
      background: #b91c1c;
    }