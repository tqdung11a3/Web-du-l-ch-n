extends ../layouts/default.pug

block main
  - var _htaListHotelQs = (typeof selectedHotelId !== 'undefined' && selectedHotelId) ? ('?hotelId=' + encodeURIComponent(String(selectedHotelId))) : ''
  h1.box-title Phân phòng cho tour

  .th-intro
    p Chọn tour-segment có phòng của khách sạn bạn đã được giữ chỗ để phân khách vào phòng. Lọc theo khách sạn bằng thanh chọn khách sạn ở đầu trang (giống Dashboard, Đặt phòng, v.v.).

  form.th-search-form(method="GET" action=`/${pathAdmin}/hotel/tour-assignments`)
    if selectedHotelId
      input(type="hidden" name="hotelId" value=selectedHotelId)
    .th-search-row
      input.th-search-input(
        type="text"
        name="q"
        placeholder="Tìm theo tên tour..."
        value=(searchKeyword || "")
      )
      button.th-search-btn(type="submit")
        i.fa-solid.fa-magnifying-glass
        |  Tìm kiếm
      a.th-search-reset(href=`/${pathAdmin}/hotel/tour-assignments${selectedHotelId ? ('?hotelId=' + encodeURIComponent(String(selectedHotelId))) : ''}`) Xóa lọc

  if !rows || rows.length === 0
    .th-empty
      i.fa-solid.fa-circle-info
      span  Chưa có tour-segment nào có phòng được giữ chỗ tại khách sạn của công ty bạn.
  else
    .assign-cust-table-wrap
      table.assign-cust-table
        thead
          tr
            th STT
            th Tour
            th Khởi hành
            th Kết thúc
            th Khách sạn (của bạn)
            th Số phòng giữ
            th Đã phân
            th Còn lại
            th Thao tác
        tbody
          each row, idx in rows
            tr
              td= idx + 1
              td
                .assign-cust-table__name
                  if row.tourAvatar
                    img(src=row.tourAvatar alt=row.tourName style="width:28px;height:28px;border-radius:4px;margin-right:6px;object-fit:cover;vertical-align:middle;")
                  else
                    i.fa-solid.fa-map-route(style="margin-right:6px")
                  | #{row.tourName}
              td= row.departureDateDisplay
              td= row.endDateDisplay
              td
                if row.hotelsInScope && row.hotelsInScope.length
                  each h, i in row.hotelsInScope
                    if i > 0
                      | , 
                    span= h.name
                else
                  | —
              td
                span.assign-status-badge.assign-status-badge--partial= row.holdCount
              td
                span.assign-status-badge.assign-status-badge--complete= row.assignedCount
              td
                if row.pendingCount > 0
                  span.assign-status-badge.assign-status-badge--none= row.pendingCount
                else
                  span.assign-status-badge.assign-status-badge--complete
                    i.fa-solid.fa-check
              td
                a.btn-assign-detail(
                  href=`/${pathAdmin}/hotel/tour-assignments/${row.segmentId}${_htaListHotelQs}`
                  data-has-customers=(row.hasCustomers ? '1' : '0')
                  data-tour-name=row.tourName
                )
                  i.fa-solid.fa-user-tag
                  |  Phân phòng

  //- Popup giữa màn hình khi chưa có khách đặt
  #hta-no-customer-dialog.th-app-dialog(aria-hidden="true")
    .th-app-dialog__backdrop
    .th-app-dialog__panel(role="alertdialog" aria-modal="true" aria-labelledby="hta-no-customer-dialog-title")
      .th-app-dialog__header
        h3#hta-no-customer-dialog-title.th-app-dialog__title
          i.fa-solid.fa-circle-info(style="color:#f59e0b;margin-right:8px")
          | Chưa thể phân phòng
        button#hta-no-customer-dialog-close.th-app-dialog__close(type="button" aria-label="Đóng")
          i.fa-solid.fa-xmark
      #hta-no-customer-dialog-body.th-app-dialog__body
      .th-app-dialog__footer
        button#hta-no-customer-dialog-ok.th-app-dialog__btn.th-app-dialog__btn--primary(type="button") Đã hiểu

  script.
    document.addEventListener('DOMContentLoaded', function () {
      var hotelName = !{JSON.stringify(typeof selectedHotelName !== 'undefined' ? selectedHotelName : '')};
      var dialog = document.getElementById('hta-no-customer-dialog');
      var dialogBody = document.getElementById('hta-no-customer-dialog-body');
      var dialogClose = document.getElementById('hta-no-customer-dialog-close');
      var dialogOk = document.getElementById('hta-no-customer-dialog-ok');
      var dialogBackdrop = dialog ? dialog.querySelector('.th-app-dialog__backdrop') : null;

      function openNoCustomerDialog(message) {
        if (!dialog || !dialogBody) {
          alert(message);
          return;
        }
        dialogBody.textContent = message;
        dialog.classList.add('is-open');
        dialog.setAttribute('aria-hidden', 'false');
      }

      function closeNoCustomerDialog() {
        if (!dialog) return;
        dialog.classList.remove('is-open');
        dialog.setAttribute('aria-hidden', 'true');
      }

      if (dialogClose) dialogClose.addEventListener('click', closeNoCustomerDialog);
      if (dialogOk) dialogOk.addEventListener('click', closeNoCustomerDialog);
      if (dialogBackdrop) dialogBackdrop.addEventListener('click', closeNoCustomerDialog);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && dialog && dialog.classList.contains('is-open')) {
          closeNoCustomerDialog();
        }
      });

      document.querySelectorAll('.btn-assign-detail').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          if (btn.getAttribute('data-has-customers') !== '0') return;
          e.preventDefault();
          var tourName = btn.getAttribute('data-tour-name') || 'tour này';
          var msg = hotelName
            ? 'Khách sạn «' + hotelName + '» chưa có khách nào đặt «' + tourName + '».\n\nVui lòng đợi khách đặt tour trước khi phân phòng.'
            : 'Chưa có khách nào đặt phòng tại khách sạn của bạn cho «' + tourName + '».\n\nVui lòng đợi khách đặt tour trước khi phân phòng.';
          openNoCustomerDialog(msg);
        });
      });
    });

  style.
    .th-search-form {
      margin: 12px 0 16px 0;
    }
    .th-search-row {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }
    .th-search-input {
      min-width: 260px;
      height: 38px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      padding: 0 12px;
      font-size: 14px;
    }
    .th-search-btn {
      height: 38px;
      border: 0;
      border-radius: 8px;
      padding: 0 14px;
      background: #2d3e90;
      color: #fff;
      font-weight: 600;
      cursor: pointer;
    }
    .th-search-reset {
      height: 38px;
      display: inline-flex;
      align-items: center;
      padding: 0 12px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      color: #374151;
      text-decoration: none;
      font-size: 13px;
    }
