extends ../layouts/default.pug

block main
  
  // ... phần box-head
  .box-head
    h1.box-title Tổng quan
    if companyName
      a.company-badge(href=`/${pathAdmin}/company/info`)= companyName


  //- Section 1
  .section-1
    .inner-item
      .inner-icon
        img(src="/admin/assets/images/section-1-icon-1.svg", alt="")
      .inner-content
        .inner-title Tài khoản quản trị
        .inner-number #{overview.totalAdmin.toLocaleString("vi-VN")}
    .inner-item
      .inner-icon
        img(src="/admin/assets/images/section-1-icon-2.svg", alt="")
      .inner-content
        .inner-title Đơn hàng
        .inner-number #{overview.totalOrder.toLocaleString("vi-VN")}
    .inner-item
      .inner-icon
        img(src="/admin/assets/images/section-1-icon-3.svg", alt="")
      .inner-content
        .inner-title Doanh thu
        .inner-number #{overview.totalRevenue.toLocaleString("vi-VN")}đ
  //- End Section 1

  //- Section 2
  .section-2
    .inner-head
      .inner-title Biểu đồ doanh thu
      .inner-filter
        input(type="month" input-change-month)
    .inner-chart
      canvas(id="revenue-chart")
  //- End Section 2

  //- Section 5: Recent Activities
  if isScoped && recentActivities && recentActivities.length > 0
    .section-5-recent-activities
      .inner-head
        h2.inner-title Hoạt động gần đây
      .inner-activities-list
        each activity in recentActivities
          .activity-item
            - const dotClass = `dot-${activity.color}`
            .activity-dot(class=dotClass)
            .activity-content
              .activity-text= activity.activity
              .activity-time= activity.timeAgo
  //- End Section 5

