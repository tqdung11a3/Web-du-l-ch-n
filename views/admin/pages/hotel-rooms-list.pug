//- views/admin/pages/hotel-rooms-list.pug
extends ../layouts/default.pug

block main
  .rooms-list-page
    //- Header
    .page-header
      .header-left
        h1.page-title Danh sách phòng
        p.page-subtitle Quản lý từng phòng cụ thể
      .header-right
        - const currentHotelId = typeof hotelId !== 'undefined' ? hotelId : ''
        - const createRoomUrl = currentHotelId && currentHotelId !== 'all' ? `/${pathAdmin}/hotel/rooms/create?hotelId=${currentHotelId}` : `/${pathAdmin}/hotel/rooms/create`
        a.btn-add-room(href=createRoomUrl)
          i.fa-solid.fa-plus
          span Thêm phòng

    //- Filter Tabs
    .filter-tabs
      button.filter-tab.active Tất cả
      button.filter-tab Trống
      button.filter-tab Đang sử dụng
      button.filter-tab Ngừng hoạt động

    //- Rooms Table
    .rooms-table-wrapper
      table.rooms-table
        thead
          tr
            th Số phòng
            th Tầng
            th Loại
            th Trạng thái
            th Thao tác
        tbody
          if roomsData.rooms && roomsData.rooms.length > 0
            each room in roomsData.rooms
              tr
                td
                  .room-number= room.roomNumber
                td= room.floor
                td= room.roomType
                td
                  - const badgeClass = `badge-${room.statusColor}`
                  .status-badge(class=badgeClass)= room.status
                td
                  .action-buttons
                    a.action-btn.edit-btn(href=`/${pathAdmin}/hotel/${hotelId}/rooms/${room._id}/edit`)
                      i.fa-solid.fa-pencil
                    button.action-btn.delete-btn(
                      type="button"
                      data-room-id=room._id
                      title="Xóa phòng"
                      aria-label="Xóa phòng"
                    )
                      i.fa-solid.fa-trash
          else
            tr
              td(colspan="5" style="text-align: center; padding: 40px;")
                .empty-message Không có phòng nào

    //- Phân trang theo tầng
    - var fp = typeof floorPagination !== 'undefined' ? floorPagination : null
    if fp && fp.totalPages > 0
      .rooms-floor-bar.rooms-floor-bar--below
        .rooms-floor-bar__info
          if fp.currentFloor
            strong= fp.currentFloor
            span  (#{fp.currentFloorRoomCount} phòng)
          else
            span Chưa có phòng
        if fp.totalPages > 1
          .rooms-floor-bar__nav
            - var prevPage = fp.currentPage > 1 ? fp.currentPage - 1 : null
            - var nextPage = fp.currentPage < fp.totalPages ? fp.currentPage + 1 : null
            if prevPage
              a.rooms-floor-nav-btn(href=`/${pathAdmin}/hotel/${hotelId}/rooms/list?page=${prevPage}` title="Tầng trước")
                i.fa-solid.fa-chevron-left
            else
              span.rooms-floor-nav-btn.rooms-floor-nav-btn--disabled
                i.fa-solid.fa-chevron-left
            select.rooms-floor-select(box-pagination)
              each f in fp.floors
                option(value=f.page selected=(f.page === fp.currentPage))= f.floor + ' (' + f.roomCount + ' phòng)'
            if nextPage
              a.rooms-floor-nav-btn(href=`/${pathAdmin}/hotel/${hotelId}/rooms/list?page=${nextPage}` title="Tầng sau")
                i.fa-solid.fa-chevron-right
            else
              span.rooms-floor-nav-btn.rooms-floor-nav-btn--disabled
                i.fa-solid.fa-chevron-right
            span.rooms-floor-bar__counter Trang #{fp.currentPage}/#{fp.totalPages}

    //- Summary Cards
    .summary-cards
      .summary-card
        .card-label Tổng số phòng
        .card-value= roomsData.summary ? roomsData.summary.total : 0
      .summary-card
        .card-label Còn trống
        .card-value= roomsData.summary ? roomsData.summary.vacant : 0
      .summary-card
        .card-label Đang sử dụng
        .card-value= roomsData.summary ? roomsData.summary.inUse : 0
      .summary-card
        .card-label Ngừng hoạt động
        .card-value= roomsData.summary ? roomsData.summary.outOfService : 0

  script.
    // Filter tabs functionality
    document.addEventListener('DOMContentLoaded', function() {
      const filterTabs = document.querySelectorAll('.filter-tab');
      const tableRows = document.querySelectorAll('.rooms-table tbody tr');
      
      filterTabs.forEach(tab => {
        tab.addEventListener('click', function() {
          // Remove active class from all tabs
          filterTabs.forEach(t => t.classList.remove('active'));
          // Add active class to clicked tab
          this.classList.add('active');
          
          const filterText = this.textContent.trim();
          
          // Filter rows
          tableRows.forEach(row => {
            if (row.querySelector('.empty-message')) {
              return; // Skip empty message row
            }
            
            const statusBadge = row.querySelector('.status-badge');
            if (!statusBadge) return;
            
            const statusText = statusBadge.textContent.trim();
            
            if (filterText === 'Tất cả') {
              row.style.display = '';
            } else if (filterText === 'Trống' && statusText === 'Trống') {
              row.style.display = '';
            } else if (filterText === 'Đang sử dụng' && statusText === 'Đang sử dụng') {
              row.style.display = '';
            } else if (filterText === 'Đang dọn' && statusText === 'Đang dọn') {
              row.style.display = '';
            } else if (filterText === 'Ngừng hoạt động' && statusText === 'Ngừng hoạt động') {
              row.style.display = '';
            } else {
              row.style.display = 'none';
            }
          });
        });
      });

      // Xóa phòng
      const roomsListHotelId = !{JSON.stringify(String(hotelId || ''))};
      document.querySelectorAll('.delete-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          const roomId = btn.getAttribute('data-room-id');
          if (!roomId || !roomsListHotelId) return;
          if (!confirm('Bạn có chắc muốn xóa phòng này? Thao tác không thể hoàn tác.')) return;
          try {
            const res = await fetch('/' + pathAdmin + '/hotel/' + roomsListHotelId + '/rooms/' + roomId, {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
            });
            const result = await res.json();
            if (result.code === 'success') {
              if (typeof notify !== 'undefined' && notify.success) notify.success(result.message);
              else alert(result.message);
              window.location.reload();
            } else {
              if (typeof notify !== 'undefined' && notify.error) notify.error(result.message || 'Có lỗi xảy ra!');
              else alert(result.message || 'Có lỗi xảy ra!');
            }
          } catch (e) {
            if (typeof notify !== 'undefined' && notify.error) notify.error('Có lỗi kết nối khi xóa phòng!');
            else alert('Có lỗi kết nối khi xóa phòng!');
          }
        });
      });
    });

