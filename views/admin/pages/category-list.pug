extends ../layouts/default.pug
include ../mixins/change-status.pug

block main
  
  h1.box-title Quản lý danh mục

  //- Section 4
  .section-4
    .inner-wrap
      .inner-item
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item
        select(filter-status)
          option(value="") Trạng thái
          option(value="active") Hoạt động
          option(value="inactive") Tạm dừng
      .inner-item
        select(filter-created-by)
          option(value="") Người tạo
          each item in accountAdminList
            option(value=item.id) #{item.fullName}
      .inner-item
        input(type="date" filter-start-date)
        span -
        input(type="date" filter-end-date)
      .inner-item.inner-reset(filter-reset)
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5
  .section-5
    .inner-wrap
      +change-status(
        `/${pathAdmin}/category/change-multi`,
        [
          {
            label: "Hoạt động",
            value: "active"
          },
          {
            label: "Tạm dừng",
            value: "inactive"
          },
          {
            label: "Xóa",
            value: "delete"
          }
        ]
      )
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm" search)
      .inner-button-create
        a(href=`/${pathAdmin}/category/create`) + Tạo mới 
  //- End Section 5

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th
              input(type="checkbox" class="inner-check" check-all)
            th Tên danh mục
            th(class="inner-center") Ảnh đại diện
            th(class="inner-center") Vị trí
            th(class="inner-center") Trạng thái
            th Tạo bởi
            th Cập nhật bởi
            th Hành động
        tbody
          each item in categoryList
            tr
              td
                input(type="checkbox" class="inner-check" check-item=item.id)
              td #{item.name}
              td(class="inner-center")
                img(src=item.avatar class="inner-avatar")
              td(class="inner-center") #{item.position}
              td(class="inner-center")
                if (item.status == "active")
                  .badge.badge-green Hoạt động
                else if (item.status == "inactive")
                  .badge.badge-red Tạm dừng
              td
                div #{item.createdByFullName}
                div.inner-time #{item.createdAtFormat}
              td
                div #{item.updatedByFullName}
                div.inner-time #{item.updatedAtFormat}
              td
                .inner-buttons
                  a(href=`/${pathAdmin}/category/edit/${item.id}` class="inner-edit")
                    <i class="fa-regular fa-pen-to-square"></i>
                  button(
                    class="inner-delete"
                    button-delete
                    data-api=`/${pathAdmin}/category/delete/${item.id}`
                    )
                    <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  include ../partials/section-7.pug
  //- End Section 7