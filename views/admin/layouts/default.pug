doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{pageTitle}
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css")
    link(rel="stylesheet", href="https://unpkg.com/filepond@^4/dist/filepond.css")
    link(rel="stylesheet", href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
    link(rel="stylesheet", href="/admin/assets/css/style.css")
    link(rel="stylesheet", href="/admin/assets/css/hotel-booking.css")
    link(rel="stylesheet", href="/admin/assets/css/hotel-customers.css")
    link(rel="stylesheet", href="/admin/assets/css/notification.css")
    
    script(src="https://cdn.tiny.cloud/1/rijgljx4ucnbxnd0bua0bmwyynhvrpr0pmhir2pccx9jc8xe/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous")
    script.
      const pathAdmin = "#{pathAdmin}";
    script(src="/admin/assets/js/tinymce-config.js") 
  body
    
    //- Header
    include ../partials/header.pug
    //- End Header

    //- Tab Switch (chỉ hiển thị cho company admin)
    if account && !account.isSuperAdmin
      include ../partials/admin-tab-switch.pug
    //- End Tab Switch

    //- Hotel Selector (chỉ hiển thị khi ở tab Khách sạn - sẽ được điều khiển bởi JS)
    if account && !account.isSuperAdmin
      include ../partials/hotel-selector.pug
    //- End Hotel Selector

    //- Sider (tự động chọn sidebar phù hợp)
    if account && account.isSuperAdmin
      include ../partials/super-admin-sider.pug
    else
      include ../partials/sider.pug
    //- End Sider

    //- Main
    main.main
      block main
    //- End Main

    script(src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js")
    script(src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.js")
    script(src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.js") 
    script(src="https://unpkg.com/filepond@^4/dist/filepond.js")
    script(src="https://cdn.jsdelivr.net/npm/chart.js") 
    script(src="https://unpkg.com/just-validate@latest/dist/just-validate.production.min.js")
    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js") 
    script(src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js")
    script(src="https://cdn.jsdelivr.net/npm/moment@2.29.4/locale/vi.js")
    script(src="/admin/assets/js/notify.js")
    script(src="/admin/assets/js/script.js")
    script(src="/admin/assets/js/hotel-booking.js")
    script(src="/admin/assets/js/notification.js")
    if pageTitle && (pageTitle.includes('Liên kết Tour') || pageTitle.includes('Cấu hình khung'))
      script(src="/admin/assets/js/tour-hotel.js")